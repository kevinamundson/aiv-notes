# Auth.js / NextAuth v5 — GitHub OAuth
# Callback URL: {AUTH_URL}/api/auth/callback/github
AUTH_SECRET=
AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated GitHub usernames allowed to create/update/delete notes
WRITER_ALLOWLIST=kevinamundson

# Optional: Vercel Blob for durable note storage on Hobby
# When unset, FsNoteStore writes under data/aiv-notes/
BLOB_READ_WRITE_TOKEN=
