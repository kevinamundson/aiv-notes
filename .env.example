# Auth.js / NextAuth v5 — GitHub OAuth
# Callback URL: {AUTH_URL}/api/auth/callback/github
AUTH_SECRET=
AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated GitHub usernames allowed to create/update/delete notes
WRITER_ALLOWLIST=kevinamundson

# Vercel Blob for durable note storage (required on Vercel Hobby — FS is EROFS).
# Local next dev without VERCEL uses FsNoteStore when this is unset.
# Prefer runtime env (not baked at build). Private store: leave BLOB_ACCESS unset or private.
BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=private
# When the Blob store is connected to the Vercel project, OIDC may also work via:
# BLOB_STORE_ID=  (plus VERCEL_OIDC_TOKEN issued by the platform)

# Optional: local BLB-Draft USX corpus (same draft — never silent BSB fallback)
# BLB_DRAFT_USX_DIR=/workspace/aiv-translations/blb-draft/usx
# BLB_DRAFT_MANIFEST=/workspace/aiv-translations/blb-draft/manifest.json
