<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.1">
<book code="MAT" style="id">BLB-Draft</book>

<para style="h">Matthew</para>

<para style="toc1">Matthew</para>

<para style="rem">sourceUrl=https://literalbible.com/blb.docx fetchedAtUtc=2026-09-01T15:43:00Z status=draft id=BLB-Draft spec=USFM-USX 3.1.1 char:add=docx-italic note:f=docx-footnotes note:x=docx-heading-crossrefs</para>

<chapter number="1" style="c" sid="MAT 1"/>

<para style="s">The Genealogy of Jesus</para>

<para style="p"><verse number="1" style="v" sid="MAT 1:1"/><note caller="-" style="x"><char style="xt" closed="false">Luke 3:23–38</char></note><note caller="-" style="x"><char style="xt" closed="false">Ruth 4:18–22</char></note>The book of the genealogy of Jesus Christ, son of David, son of Abraham: <verse eid="MAT 1:1"/></para>

<para style="q1"><verse number="2" style="v" sid="MAT 1:2"/>Abraham begat Isaac, </para>

<para style="q1" vid="MAT 1:2">and Isaac begat Jacob, </para>

<para style="q1" vid="MAT 1:2">and Jacob begat Judah and his brothers. <verse eid="MAT 1:2"/></para>

<para style="q1"><verse number="3" style="v" sid="MAT 1:3"/>And Judah begat Perez and Zerah out of Tamar, </para>

<para style="q1" vid="MAT 1:3">and Perez begat Hezron, </para>

<para style="q1" vid="MAT 1:3">and Hezron begat Aram. <note caller="+" style="f"><char style="fr" closed="false">1.3 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Aram</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Ram</char><char style="ft" closed="false">; also in verse 4; see 1 Chronicles 2:9–10.</char></note><verse eid="MAT 1:3"/></para>

<para style="q1"><verse number="4" style="v" sid="MAT 1:4"/>And Aram begat Amminadab, </para>

<para style="q1" vid="MAT 1:4">and Amminadab begat Nahshon, </para>

<para style="q1" vid="MAT 1:4">and Nahshon begat Salmon. <verse eid="MAT 1:4"/></para>

<para style="q1"><verse number="5" style="v" sid="MAT 1:5"/>And Salmon begat Boaz out of Rahab, </para>

<para style="q1" vid="MAT 1:5">and Boaz begat Obed out of Ruth, </para>

<para style="q1" vid="MAT 1:5">and Obed begat Jesse, <verse eid="MAT 1:5"/></para>

<para style="q1"><verse number="6" style="v" sid="MAT 1:6"/>and Jesse begat David the king. </para>

<para style="p" vid="MAT 1:6">And: </para>

<para style="q1" vid="MAT 1:6">David begat Solomon out of her who <char style="add">was</char> of Uriah, <note caller="+" style="f"><char style="fr" closed="false">1.6 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">David the king</char></note><verse eid="MAT 1:6"/></para>

<para style="q1"><verse number="7" style="v" sid="MAT 1:7"/>and Solomon begat Rehoboam, </para>

<para style="q1" vid="MAT 1:7">and Rehoboam begat Abijah, </para>

<para style="q1" vid="MAT 1:7">and Abijah begat Asaph.<note caller="+" style="f"><char style="fr" closed="false">1.7 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Asaph</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Asa</char><char style="ft" closed="false">; also in verse 8; see 1 Chronicles 3:10.</char></note> <verse eid="MAT 1:7"/></para>

<para style="q1"><verse number="8" style="v" sid="MAT 1:8"/>And Asaph begat Jehoshaphat, </para>

<para style="q1" vid="MAT 1:8">and Jehoshaphat begat Joram, </para>

<para style="q1" vid="MAT 1:8">and Joram begat Uzziah. <verse eid="MAT 1:8"/></para>

<para style="q1"><verse number="9" style="v" sid="MAT 1:9"/>And Uzziah begat Jotham, </para>

<para style="q1" vid="MAT 1:9">and Jotham begat Ahaz, </para>

<para style="q1" vid="MAT 1:9">and Ahaz begat Hezekiah. <verse eid="MAT 1:9"/></para>

<para style="q1"><verse number="10" style="v" sid="MAT 1:10"/>And Hezekiah begat Manasseh, </para>

<para style="q1" vid="MAT 1:10">and Manasseh begat Amos,<note caller="+" style="f"><char style="fr" closed="false">1.10 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Amos</char><char style="ft" closed="false"> is a variant spelling of </char><char style="fq" closed="false">Amon</char><char style="ft" closed="false">; twice in this verse; see 1 Chronicles 3:14.</char></note> </para>

<para style="q1" vid="MAT 1:10">and Amos begat Josiah, <verse eid="MAT 1:10"/></para>

<para style="q1"><verse number="11" style="v" sid="MAT 1:11"/>and Josiah begat Jeconiah and his brothers </para>

<para style="q2" vid="MAT 1:11">at the deportation to Babylon. <verse eid="MAT 1:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 1:12"/>And after the deportation to Babylon: </para>

<para style="q1" vid="MAT 1:12">Jeconiah begat Shealtiel, </para>

<para style="q1" vid="MAT 1:12">and Shealtiel begat Zerubbabel, <verse eid="MAT 1:12"/></para>

<para style="q1"><verse number="13" style="v" sid="MAT 1:13"/>and Zerubbabel begat Abiud, </para>

<para style="q1" vid="MAT 1:13">and Abiud begat Eliakim, </para>

<para style="q1" vid="MAT 1:13">and Eliakim begat Azor. <verse eid="MAT 1:13"/></para>

<para style="q1"><verse number="14" style="v" sid="MAT 1:14"/>And Azor begat Zadok, </para>

<para style="q1" vid="MAT 1:14">and Zadok begat Achim, </para>

<para style="q1" vid="MAT 1:14">and Achim begat Eliud. <verse eid="MAT 1:14"/></para>

<para style="q1"><verse number="15" style="v" sid="MAT 1:15"/>And Eliud begat Eleazar, </para>

<para style="q1" vid="MAT 1:15">and Eleazar begat Matthan, </para>

<para style="q1" vid="MAT 1:15">and Matthan begat Jacob, <verse eid="MAT 1:15"/></para>

<para style="q1"><verse number="16" style="v" sid="MAT 1:16"/>and Jacob begat Joseph, the husband of Mary, </para>

<para style="q2" vid="MAT 1:16">out of whom was begotten Jesus, the One being called Christ. <verse eid="MAT 1:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 1:17"/>Therefore all the generations from Abraham until David <char style="add">were</char> fourteen generations, and from David until the deportation to Babylon fourteen generations, and from the deportation to Babylon until the Christ fourteen generations. <verse eid="MAT 1:17"/></para>

<para style="s">The Birth of JesusIsaiah 7:10–16</para>

<para style="p"><verse number="18" style="v" sid="MAT 1:18"/><note caller="-" style="x"><char style="xt" closed="false">Luke 2:1–7</char></note>Now the birth of Jesus Christ was thus: His mother Mary, having been betrothed to Joseph, before their coming together was found having in womb from the Holy Spirit. <verse eid="MAT 1:18"/></para>

<para style="p"><verse number="19" style="v" sid="MAT 1:19"/>And Joseph her husband, being righteous and not willing to make an example of her, resolved to send her away secretly. <verse eid="MAT 1:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 1:20"/>But <char style="add">on</char> his having pondered these things, behold, an angel of the Lord appeared to him in a dream, saying, “Joseph son of David, you should not be afraid to receive Mary <char style="add">as</char> your wife, for that having been begotten in her is from the Holy Spirit. <verse eid="MAT 1:20"/></para>

<para style="p"><verse number="21" style="v" sid="MAT 1:21"/>And she will bear a Son, and you will call His name Jesus,<note caller="+" style="f"><char style="fr" closed="false">1.21 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Jesus</char><char style="ft" closed="false"> means </char><char style="fq" closed="false">The LORD saves</char><char style="ft" closed="false">.</char></note> for He will save His people from their sins.” <verse eid="MAT 1:21"/></para>

<para style="p"><verse number="22" style="v" sid="MAT 1:22"/>And all this has come to pass so that it might be fulfilled, that having been spoken by the Lord through the prophet, saying, <verse eid="MAT 1:22"/></para>

<para style="q1"><verse number="23" style="v" sid="MAT 1:23"/>“Behold, the virgin will have in womb, </para>

<para style="q2" vid="MAT 1:23">and she will bear a son, </para>

<para style="q1" vid="MAT 1:23">and they will call His name Immanuel,” </para>

<para style="q2" vid="MAT 1:23">which is, being translated, “God with us.<note caller="+" style="f"><char style="fr" closed="false">1.23 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">they will call Him Immanuel</char><char style="ft" closed="false">; Isaiah 7:14 (see also DSS)</char></note>” <note caller="+" style="f"><char style="fr" closed="false">1.23 </char><char style="ft" closed="false"> See Isaiah 7:14, Isaiah 8:8, and Isaiah 8:10.</char></note><verse eid="MAT 1:23"/></para>

<para style="p"><verse number="24" style="v" sid="MAT 1:24"/>And Joseph, having been awoken from sleep, did as the angel of the Lord commanded him and received his wife. <verse eid="MAT 1:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 1:25"/>And he did not know her<note caller="+" style="f"><char style="fr" closed="false">1.25 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">he had no union with her</char></note> until she bore a Son,<note caller="+" style="f"><char style="fr" closed="false">1.25 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">her firstborn Son</char></note> and he called His name Jesus. <verse eid="MAT 1:25"/></para>

<chapter eid="MAT 1"/>

<chapter number="2" style="c" sid="MAT 2"/>

<para style="s">The Pilgrimage of the Magi</para>

<para style="p"><verse number="1" style="v" sid="MAT 2:1"/><note caller="-" style="x"><char style="xt" closed="false">Micah 5:1–6</char></note>Now <char style="add">on</char> Jesus having been born in Bethlehem of Judea in the days of Herod the king, behold, Magi from the east arrived in Jerusalem, <verse eid="MAT 2:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 2:2"/>saying, “Where is the One having been born King of the Jews? For we saw His star in the east<note caller="+" style="f"><char style="fr" closed="false">2.2 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">in the rising</char><char style="ft" closed="false">; that is, the rising of the sun; also in verse 9.</char></note> and came to worship Him.” <verse eid="MAT 2:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 2:3"/>And King Herod,<note caller="+" style="f"><char style="fr" closed="false">2.3 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">Herod the king </char></note> having heard, was troubled, and all Jerusalem with him. <verse eid="MAT 2:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 2:4"/>And having gathered together all the chief priests and scribes of the people, he was inquiring of them where the Christ is born. <verse eid="MAT 2:4"/></para>

<para style="p"><verse number="5" style="v" sid="MAT 2:5"/>And they said to him, “In Bethlehem of Judea, for thus it has been written through the prophet: <verse eid="MAT 2:5"/></para>

<para style="q1"><verse number="6" style="v" sid="MAT 2:6"/>‘And you, Bethlehem, land of Judah, </para>

<para style="q2" vid="MAT 2:6">are by no means least among the rulers of Judah, </para>

<para style="q1" vid="MAT 2:6">for out of you will come forth One leading, </para>

<para style="q2" vid="MAT 2:6">who will shepherd My people Israel.’” <note caller="+" style="f"><char style="fr" closed="false">2.6 </char><char style="ft" closed="false"> Micah 5:2; see also 2 Samuel 5:2.</char></note><verse eid="MAT 2:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 2:7"/>Then Herod, having called the Magi secretly, learned exactly of them the time of the appearing star. <verse eid="MAT 2:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 2:8"/>And having sent them to Bethlehem, he said, “Having gone, search carefully for the Child; and when you⁺ shall have found <char style="add">Him</char>, report to me, so that I also, having come, may worship Him.” <verse eid="MAT 2:8"/></para>

<para style="p"><verse number="9" style="v" sid="MAT 2:9"/>And having heard the king, they went, and behold, the star that they saw in the east went before them until, having come, it stood over where the Child was. <verse eid="MAT 2:9"/></para>

<para style="p"><verse number="10" style="v" sid="MAT 2:10"/>And having seen the star, they rejoiced <char style="add">with</char> exceedingly great joy. <verse eid="MAT 2:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 2:11"/>And having come into the house, they saw<note caller="+" style="f"><char style="fr" closed="false">2.11 </char><char style="ft" closed="false"> Stephanus TR </char><char style="fq" closed="false">they found</char></note> the Child with His mother Mary, and having fallen down, they worshiped Him. And having opened their treasures, they offered to Him gifts: gold and frankincense and myrrh. <verse eid="MAT 2:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 2:12"/>And having been divinely warned in a dream not to return to Herod, through another way they withdrew to their country. <verse eid="MAT 2:12"/></para>

<para style="s">The Flight to EgyptHosea 11:1–7</para>

<para style="p"><verse number="13" style="v" sid="MAT 2:13"/>And <char style="add">on</char> their having withdrawn, behold, an angel of the Lord appears to Joseph in a dream saying, “Having arisen, take the Child and His mother and flee into Egypt. And be there until I should tell you, for Herod is about to seek the Child to destroy Him.” <verse eid="MAT 2:13"/></para>

<para style="p"><verse number="14" style="v" sid="MAT 2:14"/>And having arisen, he took the Child and His mother by night and withdrew into Egypt, <verse eid="MAT 2:14"/></para>

<para style="p"><verse number="15" style="v" sid="MAT 2:15"/>and there he was until the death of Herod, so that it might be fulfilled, that having been spoken by the Lord through the prophet, saying, “Out of Egypt I called My Son.” <note caller="+" style="f"><char style="fr" closed="false">2.15 </char><char style="ft" closed="false"> Hosea 11:1</char></note><verse eid="MAT 2:15"/></para>

<para style="s">Weeping and Great MourningJeremiah 31:1–25</para>

<para style="p"><verse number="16" style="v" sid="MAT 2:16"/>Then Herod, having seen that he was mocked by the Magi, was exceedingly enraged. And having sent forth, he put to death all the boys in Bethlehem and in all its borders from two years old and under, according to the time that he learned exactly from the Magi. <verse eid="MAT 2:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 2:17"/>Then was fulfilled that having been spoken through the prophet Jeremiah, saying: <verse eid="MAT 2:17"/></para>

<para style="q1"><verse number="18" style="v" sid="MAT 2:18"/>“A voice was heard in Ramah, </para>

<para style="q2" vid="MAT 2:18">weeping and much mourning, </para>

<para style="q1" vid="MAT 2:18">Rachel weeping <char style="add">for</char> her children; </para>

<para style="q2" vid="MAT 2:18">and she would not be comforted, </para>

<para style="q2" vid="MAT 2:18">because they are not.”<note caller="+" style="f"><char style="fr" closed="false">2.18 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">lamentation and weeping</char></note> <note caller="+" style="f"><char style="fr" closed="false">2.18 </char><char style="ft" closed="false"> Jeremiah 31:15</char></note><verse eid="MAT 2:18"/></para>

<para style="s">The Return to NazarethLuke 2:39–40</para>

<para style="p"><verse number="19" style="v" sid="MAT 2:19"/>But <char style="add">on</char> Herod having died, behold, an angel of the Lord appears in a dream to Joseph in Egypt, <verse eid="MAT 2:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 2:20"/>saying, “Having arisen, take the Child and His mother and go into the land of Israel, for those seeking the life of the Child have died.” <verse eid="MAT 2:20"/></para>

<para style="p"><verse number="21" style="v" sid="MAT 2:21"/>And having arisen, he took the Child and His mother and came into the land of Israel. <verse eid="MAT 2:21"/></para>

<para style="p"><verse number="22" style="v" sid="MAT 2:22"/>But having heard that Archelaus reigns over Judea in place of his father Herod, he was afraid to depart <char style="add">to</char> there. And having been divinely warned in a dream, he withdrew to the parts of Galilee. <verse eid="MAT 2:22"/></para>

<para style="p"><verse number="23" style="v" sid="MAT 2:23"/>And having come, he dwelt in a city being called Nazareth, so that it might be fulfilled, that having been spoken through the prophets, that “He will be called a Nazarene.” <verse eid="MAT 2:23"/></para>

<chapter eid="MAT 2"/>

<chapter number="3" style="c" sid="MAT 3"/>

<para style="s">The Mission of John the Baptist</para>

<para style="p"><verse number="1" style="v" sid="MAT 3:1"/><note caller="-" style="x"><char style="xt" closed="false">John 1:19–28</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 3:1–20</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 1:1–8</char></note><note caller="-" style="x"><char style="xt" closed="false">Isaiah 40:1–5</char></note>Now in those days John the Baptist comes, preaching in the wilderness<note caller="+" style="f"><char style="fr" closed="false">3.1 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">desert</char></note> of Judea <verse eid="MAT 3:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 3:2"/>and saying, “Repent, for the kingdom of the heavens has drawn near.” <verse eid="MAT 3:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 3:3"/>For this is the one having been spoken of through Isaiah the prophet, saying, </para>

<para style="q1" vid="MAT 3:3">“A voice of one crying in the wilderness: </para>

<para style="q2" vid="MAT 3:3">‘Prepare the way of the Lord; </para>

<para style="q2" vid="MAT 3:3">make straight His paths.’” <note caller="+" style="f"><char style="fr" closed="false">3.3 </char><char style="ft" closed="false"> Isaiah 40:3 (see also LXX)</char></note><verse eid="MAT 3:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 3:4"/>And John himself had his clothing of camel’s hair and a belt of leather around his waist, and his food was locusts and wild honey. <verse eid="MAT 3:4"/></para>

<para style="p"><verse number="5" style="v" sid="MAT 3:5"/>At that time they were going out to him—Jerusalem and all Judea and all the region around the Jordan. <verse eid="MAT 3:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 3:6"/>And they were being baptized in the Jordan River<note caller="+" style="f"><char style="fr" closed="false">3.6 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">in the Jordan</char></note> by him, confessing their sins. <verse eid="MAT 3:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 3:7"/>But having seen many of the Pharisees and Sadducees coming to his baptism, he said to them, “Offspring of vipers, who warned you⁺ to flee from the coming wrath? <verse eid="MAT 3:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 3:8"/>Therefore produce fruit<note caller="+" style="f"><char style="fr" closed="false">3.8 </char><char style="ft" closed="false"> TR </char><char style="fq" closed="false">fruits</char></note> worthy of repentance. <verse eid="MAT 3:8"/></para>

<para style="p"><verse number="9" style="v" sid="MAT 3:9"/>And do not think to say in yourselves, ‘We have Abraham <char style="add">as</char> father.’ For I say to you⁺ that out of these stones God is able to raise up children to Abraham. <verse eid="MAT 3:9"/></para>

<para style="p"><verse number="10" style="v" sid="MAT 3:10"/>And already the ax is laid to the root of the trees; therefore every tree not producing good fruit is cut down and is thrown into fire. <verse eid="MAT 3:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 3:11"/>I indeed baptize you⁺ in water unto repentance, but the One coming after me is mightier than I, of whom I am not sufficient to carry the sandals. He will baptize you⁺ in the Holy Spirit and fire,<note caller="+" style="f"><char style="fr" closed="false">3.11 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">with water</char></note> <note caller="+" style="f"><char style="fr" closed="false">3.11 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">with the Holy Spirit and fire</char><char style="ft" closed="false">; BYZ does not include </char><char style="fq" closed="false">and fire</char><char style="ft" closed="false">.</char></note><verse eid="MAT 3:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 3:12"/>whose winnowing fork <char style="add">is</char> in His hand, and He will thoroughly cleanse His threshing floor and will gather His wheat into the barn; but He will burn up the chaff with unquenchable fire.” <verse eid="MAT 3:12"/></para>

<para style="s">The Baptism of JesusMark 1:9–11</para>

<para style="p"><verse number="13" style="v" sid="MAT 3:13"/><note caller="-" style="x"><char style="xt" closed="false">John 1:29–34</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 3:21–22</char></note>Then Jesus comes from Galilee to the Jordan to John to be baptized by him. <verse eid="MAT 3:13"/></para>

<para style="p"><verse number="14" style="v" sid="MAT 3:14"/>But John was preventing Him, saying, “I have need to be baptized by You, and You come to me?” <verse eid="MAT 3:14"/></para>

<para style="p"><verse number="15" style="v" sid="MAT 3:15"/>But answering, Jesus said to him, <char style="wj">“Permit it presently; for thus it is fitting to us to fulfill all righteousness.”</char> Then he permits Him. <verse eid="MAT 3:15"/></para>

<para style="p"><verse number="16" style="v" sid="MAT 3:16"/>And having been baptized, Jesus immediately went up from the water; and behold, the heavens were opened,<note caller="+" style="f"><char style="fr" closed="false">3.16 </char><char style="ft" closed="false"> NA, BYZ, and TR </char><char style="fq" closed="false">the heavens were opened to Him</char></note> and He saw<note caller="+" style="f"><char style="fr" closed="false">3.16 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">and he saw</char><char style="ft" closed="false">; see John 1:32–33.</char></note> the Spirit of God descending as a dove and coming upon Him. <verse eid="MAT 3:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 3:17"/>And behold, a voice out of the heavens, saying, “This is My Son, the Beloved, in whom I was well pleased.” <verse eid="MAT 3:17"/></para>

<chapter eid="MAT 3"/>

<chapter number="4" style="c" sid="MAT 4"/>

<para style="s">The Temptation of Jesus</para>

<para style="p"><verse number="1" style="v" sid="MAT 4:1"/><note caller="-" style="x"><char style="xt" closed="false">Luke 4:1–13</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 1:12–13</char></note>Then Jesus was led up into the wilderness<note caller="+" style="f"><char style="fr" closed="false">4.1 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">desert</char></note> by the Spirit to be tempted by the devil. <verse eid="MAT 4:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 4:2"/>And having fasted forty days and forty nights, afterward He was hungry. <verse eid="MAT 4:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 4:3"/>And the one tempting, having come to Him, said, “If You are the Son of God, speak, that these stones might become loaves.” <verse eid="MAT 4:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 4:4"/>But answering, He said, <char style="wj">“It has been written: </char></para>

<para style="q1" vid="MAT 4:4">‘Not on bread alone shall the man live, </para>

<para style="q2" vid="MAT 4:4">but on every word coming out through the mouth of God.’” <note caller="+" style="f"><char style="fr" closed="false">4.4 </char><char style="ft" closed="false"> Deuteronomy 8:3</char></note><verse eid="MAT 4:4"/></para>

<para style="p"><verse number="5" style="v" sid="MAT 4:5"/>Then the devil takes Him to the holy city, and he set Him on the pinnacle of the temple, <verse eid="MAT 4:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 4:6"/>and he says to Him, “If You are the Son of God, throw Yourself down. For it has been written: </para>

<para style="q1" vid="MAT 4:6">‘He will command His angels concerning You, </para>

<para style="q2" vid="MAT 4:6">and on hands they will lift You up, </para>

<para style="q1" vid="MAT 4:6">lest ever You might strike Your foot </para>

<para style="q2" vid="MAT 4:6">against a stone.’” <note caller="+" style="f"><char style="fr" closed="false">4.6 </char><char style="ft" closed="false"> Psalm 91:11–12</char></note><verse eid="MAT 4:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 4:7"/>Jesus said to him, <char style="wj">“Again it has been written: ‘You shall not test the Lord your God.’”</char> <note caller="+" style="f"><char style="fr" closed="false">4.7 </char><char style="ft" closed="false"> Deuteronomy 6:16</char></note><verse eid="MAT 4:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 4:8"/>Again the devil takes Him to a mountain exceedingly high and shows to Him all the kingdoms of the world and their glory. <verse eid="MAT 4:8"/></para>

<para style="p"><verse number="9" style="v" sid="MAT 4:9"/>And he said to Him, “All these things I will give to You if, falling down, You worship me.” <verse eid="MAT 4:9"/></para>

<para style="p"><verse number="10" style="v" sid="MAT 4:10"/>Then Jesus says to him, <char style="wj">“Go away, Satan! For it has been written: ‘You shall worship the Lord your God, and Him only shall you serve.’</char><note caller="+" style="f"><char style="fr" closed="false">4.10 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">Get behind Me</char></note><char style="wj">”</char> <note caller="+" style="f"><char style="fr" closed="false">4.10 </char><char style="ft" closed="false"> Deuteronomy 6:13</char></note><verse eid="MAT 4:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 4:11"/>Then the devil leaves Him, and behold, angels came and were ministering to Him. <verse eid="MAT 4:11"/></para>

<para style="s">Jesus Begins His MinistryIsaiah 9:1–7</para>

<para style="p"><verse number="12" style="v" sid="MAT 4:12"/><note caller="-" style="x"><char style="xt" closed="false">Luke 4:14–15</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 1:14–15</char></note>And having heard that John was delivered up, He withdrew into Galilee. <verse eid="MAT 4:12"/></para>

<para style="p"><verse number="13" style="v" sid="MAT 4:13"/>And having left Nazareth, having come, He dwelt at Capernaum, which <char style="add">is</char> by the sea in the borders of Zebulun and Naphtali, <verse eid="MAT 4:13"/></para>

<para style="p"><verse number="14" style="v" sid="MAT 4:14"/>that it might be fulfilled, that having been spoken through Isaiah the prophet, saying: <verse eid="MAT 4:14"/></para>

<para style="q1"><verse number="15" style="v" sid="MAT 4:15"/>“Land of Zebulun </para>

<para style="q2" vid="MAT 4:15">and land of Naphtali, </para>

<para style="q1" vid="MAT 4:15">way of the sea, beyond the Jordan, </para>

<para style="q2" vid="MAT 4:15">Galilee of the Gentiles— <verse eid="MAT 4:15"/></para>

<para style="q1"><verse number="16" style="v" sid="MAT 4:16"/>the people sitting in darkness </para>

<para style="q2" vid="MAT 4:16">saw a great light, </para>

<para style="q1" vid="MAT 4:16">and to those sitting in the region and shadow of death, </para>

<para style="q2" vid="MAT 4:16">a light dawned on them.” <note caller="+" style="f"><char style="fr" closed="false">4.16 </char><char style="ft" closed="false"> Isaiah 9:1–2</char></note><verse eid="MAT 4:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 4:17"/>From that time Jesus began to proclaim and to say, <char style="wj">“Repent, for the kingdom of the heavens has drawn near.”</char> <verse eid="MAT 4:17"/></para>

<para style="s">The First DisciplesMark 1:16–20</para>

<para style="p"><verse number="18" style="v" sid="MAT 4:18"/><note caller="-" style="x"><char style="xt" closed="false">John 1:35–42</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 5:1–11</char></note>And walking by the Sea of Galilee, He saw two brothers, Simon called Peter and his brother Andrew, casting a net into the sea; for they were fishermen. <verse eid="MAT 4:18"/></para>

<para style="p"><verse number="19" style="v" sid="MAT 4:19"/>And He says to them, <char style="wj">“Come after Me, and I will make you⁺ fishers of men.”</char> <verse eid="MAT 4:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 4:20"/>And immediately, having left the nets, they followed Him. <verse eid="MAT 4:20"/></para>

<para style="p"><verse number="21" style="v" sid="MAT 4:21"/>And having gone on from there, He saw two others, brothers, James <char style="add">son</char> of Zebedee and his brother John, in the boat with their father Zebedee, mending their nets; and He called them. <verse eid="MAT 4:21"/></para>

<para style="p"><verse number="22" style="v" sid="MAT 4:22"/>And immediately, having left the boat and their father, they followed Him. <verse eid="MAT 4:22"/></para>

<para style="s">Jesus Heals the MultitudesMark 3:7–12</para>

<para style="p"><verse number="23" style="v" sid="MAT 4:23"/><note caller="-" style="x"><char style="xt" closed="false">Luke 6:17–19</char></note>And He was going about in all Galilee, teaching in their synagogues, and proclaiming the gospel of the kingdom, and healing every disease and every sickness among the people. <verse eid="MAT 4:23"/></para>

<para style="p"><verse number="24" style="v" sid="MAT 4:24"/>And the news of Him went out into all Syria. And they brought to Him all the ill having various diseases and oppressing torments, and being possessed by demons, and being epileptics, and paralytics, and He healed them. <verse eid="MAT 4:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 4:25"/>And <char style="add">there</char> followed Him many crowds from Galilee, and the Decapolis,<note caller="+" style="f"><char style="fr" closed="false">4.25 </char><char style="ft" closed="false"> That is, the Ten Cities</char></note> and Jerusalem, and Judea, and beyond the Jordan. <verse eid="MAT 4:25"/></para>

<chapter eid="MAT 4"/>

<chapter number="5" style="c" sid="MAT 5"/>

<para style="s">The Sermon on the Mount</para>

<para style="p"><verse number="1" style="v" sid="MAT 5:1"/>And having seen the crowds, He went up onto the mountain. And <char style="add">on</char> His having sat down, His disciples came to Him. <verse eid="MAT 5:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 5:2"/>And having opened His mouth, He was teaching them, saying: <verse eid="MAT 5:2"/></para>

<para style="s">The BeatitudesPsalm 1:1–6</para>

<para style="q1"><verse number="3" style="v" sid="MAT 5:3"/><note caller="-" style="x"><char style="xt" closed="false">Luke 6:20–23</char></note>“Blessed <char style="add">are</char> the poor in spirit, </para>

<para style="q2" vid="MAT 5:3">because theirs is the kingdom of the heavens. <verse eid="MAT 5:3"/></para>

<para style="q1"><verse number="4" style="v" sid="MAT 5:4"/>Blessed <char style="add">are</char> those mourning, </para>

<para style="q2" vid="MAT 5:4">because they will be comforted. <verse eid="MAT 5:4"/></para>

<para style="q1"><verse number="5" style="v" sid="MAT 5:5"/>Blessed <char style="add">are</char> the meek, </para>

<para style="q2" vid="MAT 5:5">because they will inherit the earth. <note caller="+" style="f"><char style="fr" closed="false">5.5 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">Blessed are those who exercise strength under control, because they will inherit the land</char><char style="ft" closed="false">; see Psalm 37:11.</char></note><verse eid="MAT 5:5"/></para>

<para style="q1"><verse number="6" style="v" sid="MAT 5:6"/>Blessed <char style="add">are</char> those hungering and thirsting for righteousness, </para>

<para style="q2" vid="MAT 5:6">because they will be filled. <verse eid="MAT 5:6"/></para>

<para style="q1"><verse number="7" style="v" sid="MAT 5:7"/>Blessed <char style="add">are</char> the merciful, </para>

<para style="q2" vid="MAT 5:7">because they will receive mercy. <verse eid="MAT 5:7"/></para>

<para style="q1"><verse number="8" style="v" sid="MAT 5:8"/>Blessed <char style="add">are</char> the pure in heart, </para>

<para style="q2" vid="MAT 5:8">because they will see God. <verse eid="MAT 5:8"/></para>

<para style="q1"><verse number="9" style="v" sid="MAT 5:9"/>Blessed <char style="add">are</char> the peacemakers, </para>

<para style="q2" vid="MAT 5:9">because they will be called sons of God. <verse eid="MAT 5:9"/></para>

<para style="q1"><verse number="10" style="v" sid="MAT 5:10"/>Blessed <char style="add">are</char> those having been persecuted on account of righteousness, </para>

<para style="q2" vid="MAT 5:10">because theirs is the kingdom of the heavens. <verse eid="MAT 5:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 5:11"/>Blessed are you⁺ when they may reproach you⁺ and may persecute <char style="add">you</char> and may say all evil<note caller="+" style="f"><char style="fr" closed="false">5.11 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">every evil thing</char></note> against you⁺, lying, on account of Me. <verse eid="MAT 5:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 5:12"/>Rejoice and exult, because your⁺ reward <char style="add">is</char> great in the heavens; for thus they persecuted the prophets before you⁺. <verse eid="MAT 5:12"/></para>

<para style="s">Salt and LightMark 9:49–50</para>

<para style="p"><verse number="13" style="v" sid="MAT 5:13"/><note caller="-" style="x"><char style="xt" closed="false">Philippians 2:12–18</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 14:34–35</char></note>You⁺ are the salt of the earth. But if the salt should become tasteless, with what will it be salted? For nothing is it potent any longer except, having been cast out, to be trampled upon by men. <verse eid="MAT 5:13"/></para>

<para style="p"><verse number="14" style="v" sid="MAT 5:14"/>You⁺ are the light of the world. A city lying on a hill is not able to be hidden. <verse eid="MAT 5:14"/></para>

<para style="p"><verse number="15" style="v" sid="MAT 5:15"/>Nor do they light a lamp and put it under the basket, but upon the lampstand, and it shines to all those in the house. <verse eid="MAT 5:15"/></para>

<para style="p"><verse number="16" style="v" sid="MAT 5:16"/>Thus let your⁺ light shine before men, so that they may see your⁺ good works and may glorify your⁺ Father who <char style="add">is</char> in the heavens. <verse eid="MAT 5:16"/></para>

<para style="s">The Fulfillment of the Law</para>

<para style="p"><verse number="17" style="v" sid="MAT 5:17"/>Do not suppose that I came to abolish the Law or the Prophets. I did not come to abolish, but to fulfill. <verse eid="MAT 5:17"/></para>

<para style="p"><verse number="18" style="v" sid="MAT 5:18"/>For truly I say to you⁺, until the heaven and the earth should pass away, not even one iota, or one stroke of a letter, shall pass away from the Law, until everything should come to pass. <verse eid="MAT 5:18"/></para>

<para style="p"><verse number="19" style="v" sid="MAT 5:19"/>Whoever then may break one of the least of these commandments and may teach men thus, he will be called least in the kingdom of the heavens; but whoever may do and may teach <char style="add">them</char>, this one will be called great in the kingdom of the heavens. <verse eid="MAT 5:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 5:20"/>For I say to you⁺ that unless your⁺ righteousness should abound more than <char style="add">that</char> of the scribes and Pharisees, you⁺ shall certainly not enter into the kingdom of the heavens. <verse eid="MAT 5:20"/></para>

<para style="s">Anger and ReconciliationLuke 12:57–59</para>

<para style="p"><verse number="21" style="v" sid="MAT 5:21"/>You⁺ heard that it was said to the ancients, ‘You shall not murder,’<note caller="+" style="f"><char style="fr" closed="false">5.21 </char><char style="ft" closed="false"> Exodus 20:13; Deuteronomy 5:17</char></note> and, ‘Whoever may murder will be liable to the judgment.’ <verse eid="MAT 5:21"/></para>

<para style="p"><verse number="22" style="v" sid="MAT 5:22"/>But I say to you⁺ that everyone being angry with his brother<note caller="+" style="f"><char style="fr" closed="false">5.22 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">without cause</char><char style="ft" closed="false">.</char></note> will be liable to the judgment, and whoever may say to his brother, ‘Raca,’<note caller="+" style="f"><char style="fr" closed="false">5.22 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Raca</char><char style="ft" closed="false"> is an Aramaic expression of contempt.</char></note> will be liable to the Sanhedrin.<note caller="+" style="f"><char style="fr" closed="false">5.22 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the Council</char></note> But whoever may say, ‘Fool!’ will be liable to the Gehenna of fire.<note caller="+" style="f"><char style="fr" closed="false">5.22 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the hell of fire</char></note> <verse eid="MAT 5:22"/></para>

<para style="p"><verse number="23" style="v" sid="MAT 5:23"/>Therefore, if you may offer your gift at the altar, and there may remember that your brother has something against you, <verse eid="MAT 5:23"/></para>

<para style="p"><verse number="24" style="v" sid="MAT 5:24"/>leave your gift there before the altar and first go, be reconciled to your brother, and then, having come, offer your gift. <verse eid="MAT 5:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 5:25"/>Be agreeing quickly with your adversary while you are with him in the way, lest ever the adversary may deliver you to the judge, and the judge to the officer, and you will be cast into prison. <verse eid="MAT 5:25"/></para>

<para style="p"><verse number="26" style="v" sid="MAT 5:26"/>Truly I say to you, you shall never come out from there until you should pay back the last kodrantes.<note caller="+" style="f"><char style="fr" closed="false">5.26 </char><char style="ft" closed="false"> That is, a Roman copper coin worth about 1/64 of a denarius</char></note> <verse eid="MAT 5:26"/></para>

<para style="s">AdulteryLeviticus 18:1–30</para>

<para style="p"><verse number="27" style="v" sid="MAT 5:27"/>You⁺ heard that it was said,<note caller="+" style="f"><char style="fr" closed="false">5.27 </char><char style="ft" closed="false"> GOC and TR include </char><char style="fq" closed="false">to the ancients</char><char style="ft" closed="false">.</char></note> ‘You shall not commit adultery.’<note caller="+" style="f"><char style="fr" closed="false">5.27 </char><char style="ft" closed="false"> Exodus 20:14; Deuteronomy 5:18</char></note> <verse eid="MAT 5:27"/></para>

<para style="p"><verse number="28" style="v" sid="MAT 5:28"/>But I say to you⁺ that everyone looking at a woman in order to desire her already committed adultery with her in his heart. <verse eid="MAT 5:28"/></para>

<para style="p"><verse number="29" style="v" sid="MAT 5:29"/>Now if your right eye causes you to stumble, pluck it out and cast <char style="add">it</char> from you. For it is better for you that one of your members should perish and not <char style="add">that</char> your whole body should be cast into Gehenna.<note caller="+" style="f"><char style="fr" closed="false">5.29 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">hell</char><char style="ft" closed="false">; also in verse 30</char></note> <verse eid="MAT 5:29"/></para>

<para style="p"><verse number="30" style="v" sid="MAT 5:30"/>And if your right hand causes you to stumble, cut it off and cast <char style="add">it</char> from you. For it is better for you that one of your members should perish and not <char style="add">that</char> your whole body should go away<note caller="+" style="f"><char style="fr" closed="false">5.30 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">should be cast</char></note> into Gehenna. <verse eid="MAT 5:30"/></para>

<para style="s">DivorceDeuteronomy 24:1–5</para>

<para style="p"><verse number="31" style="v" sid="MAT 5:31"/><note caller="-" style="x"><char style="xt" closed="false">Luke 16:18</char></note>And it was said, ‘Whoever may send away his wife, let him give to her a certificate of divorce.’<note caller="+" style="f"><char style="fr" closed="false">5.31 </char><char style="ft" closed="false"> Deuteronomy 24:1</char></note> <verse eid="MAT 5:31"/></para>

<para style="p"><verse number="32" style="v" sid="MAT 5:32"/>But I say to you⁺ that everyone sending away his wife, except <char style="add">for</char> the reason of sexual immorality, causes her to commit adultery.<note caller="+" style="f"><char style="fr" closed="false">5.32 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">whoever sends away</char></note> And whoever shall marry her <char style="add">who</char> has been sent away, he commits adultery. <note caller="+" style="f"><char style="fr" closed="false">5.32 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">brings adultery upon her</char></note><verse eid="MAT 5:32"/></para>

<para style="s">Oaths and VowsNumbers 30:1–16</para>

<para style="p"><verse number="33" style="v" sid="MAT 5:33"/>Again, you⁺ heard that it was said to the ancients, ‘You shall not swear falsely, but you shall repay your oaths to the Lord.’<note caller="+" style="f"><char style="fr" closed="false">5.33 </char><char style="ft" closed="false"> Numbers 30:2</char></note> <verse eid="MAT 5:33"/></para>

<para style="p"><verse number="34" style="v" sid="MAT 5:34"/>But I say to you⁺ not to swear at all: neither by heaven, because it is the throne of God; <verse eid="MAT 5:34"/></para>

<para style="p"><verse number="35" style="v" sid="MAT 5:35"/>nor by the earth, because it is the footstool for His feet; nor by Jerusalem, because it is the city of the great King. <verse eid="MAT 5:35"/></para>

<para style="p"><verse number="36" style="v" sid="MAT 5:36"/>Nor may you swear by your head, because you are not able to make one hair white or black. <verse eid="MAT 5:36"/></para>

<para style="p"><verse number="37" style="v" sid="MAT 5:37"/>But let your⁺ word ‘Yes’ be ‘Yes,’ <char style="add">and</char> ‘No,’ ‘No.’ And that which <char style="add">is</char> more than these comes from the evil one.<note caller="+" style="f"><char style="fr" closed="false">5.37 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">from evil</char></note> <verse eid="MAT 5:37"/></para>

<para style="s">Love Your EnemiesLeviticus 24:17–23</para>

<para style="p"><verse number="38" style="v" sid="MAT 5:38"/><note caller="-" style="x"><char style="xt" closed="false">Luke 6:27–36</char></note>You⁺ heard that it was said, ‘Eye for eye and tooth for tooth.’<note caller="+" style="f"><char style="fr" closed="false">5.38 </char><char style="ft" closed="false"> Exodus 21:24; Leviticus 24:20; Deuteronomy 19:21</char></note> <verse eid="MAT 5:38"/></para>

<para style="p"><verse number="39" style="v" sid="MAT 5:39"/>But I say to you⁺ not to resist the evil <char style="add">person</char>. But whoever may strike you on your right cheek,<note caller="+" style="f"><char style="fr" closed="false">5.39 </char><char style="ft" closed="false"> RP </char><char style="fq" closed="false">the right cheek</char></note> turn to him also the other. <verse eid="MAT 5:39"/></para>

<para style="p"><verse number="40" style="v" sid="MAT 5:40"/>And the one wanting to sue you and to take your tunic, yield to him also the cloak. <verse eid="MAT 5:40"/></para>

<para style="p"><verse number="41" style="v" sid="MAT 5:41"/>And whoever will compel you <char style="add">to go</char> one milion,<note caller="+" style="f"><char style="fr" closed="false">5.41 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">one milion</char><char style="ft" closed="false">, that is, a Roman mile, is approximately 4,855 feet or 1,480 meters</char></note> go with him two. <verse eid="MAT 5:41"/></para>

<para style="p"><verse number="42" style="v" sid="MAT 5:42"/>To the one asking you, you should give, and from the one wanting to borrow from you, you should not turn away. <verse eid="MAT 5:42"/></para>

<para style="p"><verse number="43" style="v" sid="MAT 5:43"/>You⁺ heard that it was said, ‘You shall love your neighbor and shall hate your enemy.’ <note caller="+" style="f"><char style="fr" closed="false">5.43 </char><char style="ft" closed="false"> Leviticus 19:18</char></note><verse eid="MAT 5:43"/></para>

<para style="p"><verse number="44" style="v" sid="MAT 5:44"/>But I say to you⁺, love your⁺ enemies and pray for those persecuting you⁺,<note caller="+" style="f"><char style="fr" closed="false">5.44 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">love your enemies, bless those cursing you, do good to those hating you, and pray for those mistreating you and persecuting you</char><char style="ft" closed="false">; see Luke 6:27–28.</char></note> <verse eid="MAT 5:44"/></para>

<para style="p"><verse number="45" style="v" sid="MAT 5:45"/>so that you⁺ may be sons of your⁺ Father who <char style="add">is</char> in the heavens. For He makes His sun rise on evil and good, and He sends rain on righteous and unrighteous. <verse eid="MAT 5:45"/></para>

<para style="p"><verse number="46" style="v" sid="MAT 5:46"/>For if you⁺ love those loving you⁺, what reward do you⁺ have? Do not also the tax collectors do the same? <verse eid="MAT 5:46"/></para>

<para style="p"><verse number="47" style="v" sid="MAT 5:47"/>And if you⁺ greet only your⁺ brothers,<note caller="+" style="f"><char style="fr" closed="false">5.47 </char><char style="ft" closed="false"> BYZ </char><char style="fq" closed="false">friends</char></note> what extraordinary <char style="add">thing</char> do you⁺ do? Do not also the Gentiles<note caller="+" style="f"><char style="fr" closed="false">5.47 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">tax collectors</char></note> do the same? <verse eid="MAT 5:47"/></para>

<para style="p"><verse number="48" style="v" sid="MAT 5:48"/>You⁺ shall be perfect, therefore, as your⁺ heavenly Father<note caller="+" style="f"><char style="fr" closed="false">5.48 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">Father in heaven</char></note> is perfect. <verse eid="MAT 5:48"/></para>

<chapter eid="MAT 5"/>

<chapter number="6" style="c" sid="MAT 6"/>

<para style="s">Giving to the Needy</para>

<para style="p"><verse number="1" style="v" sid="MAT 6:1"/><note caller="-" style="x"><char style="xt" closed="false">Deuteronomy 15:7–11</char></note><char style="add">“</char> And beware not to do your⁺ righteousness<note caller="+" style="f"><char style="fr" closed="false">6.1 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">charitable acts</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">alms</char></note> before men in order to be seen by them. Otherwise, you⁺ have no reward from your⁺ Father who <char style="add">is</char> in the heavens. <verse eid="MAT 6:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 6:2"/>Therefore, when you may do charity, do not sound a trumpet before you, as the hypocrites do in the synagogues and in the streets so that they may be glorified by men. Truly I say to you⁺, they have their reward in full. <verse eid="MAT 6:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 6:3"/>But <char style="add">in</char> your doing charity, do not let your left <char style="add">hand</char> know what your right hand is doing, <verse eid="MAT 6:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 6:4"/>so that your charity may be in secret. And your Father, the One seeing in secret, will reward to you.<note caller="+" style="f"><char style="fr" closed="false">6.4 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">will Himself reward you</char></note> <verse eid="MAT 6:4"/></para>

<para style="s">The Lord’s PrayerLuke 11:1–4</para>

<para style="p"><verse number="5" style="v" sid="MAT 6:5"/>And when you⁺ may pray, you⁺ shall not be like the hypocrites, because they love to pray standing in the synagogues and on the corners of the streets so that they might be seen by men. Truly I say to you⁺, they have their reward in full. <verse eid="MAT 6:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 6:6"/>But you, when you may pray, enter into your inner room, and having shut your door, pray to your Father, the One in secret. And your Father, the One seeing in secret, will reward to you.<note caller="+" style="f"><char style="fr" closed="false">6.6 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">will reward you openly</char></note> <verse eid="MAT 6:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 6:7"/>And praying, do not use vain repetitions like the Gentiles, for they think that in their many words they will be heard. <verse eid="MAT 6:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 6:8"/>Therefore do not be like them, for your⁺ Father<note caller="+" style="f"><char style="fr" closed="false">6.8 </char><char style="ft" closed="false"> WH </char><char style="fq" closed="false">God your Father</char></note> knows of what things you⁺ have need before your⁺ asking Him. <verse eid="MAT 6:8"/></para>

<para style="p"><verse number="9" style="v" sid="MAT 6:9"/>Therefore pray you⁺ this way: </para>

<para style="q1" vid="MAT 6:9">‘Our Father who <char style="add">is</char> in the heavens, </para>

<para style="q2" vid="MAT 6:9">hallowed be Your name. <verse eid="MAT 6:9"/></para>

<para style="q1"><verse number="10" style="v" sid="MAT 6:10"/>Your kingdom come. </para>

<para style="q2" vid="MAT 6:10">Your will be done, </para>

<para style="q2" vid="MAT 6:10">as in heaven, also upon earth. <verse eid="MAT 6:10"/></para>

<para style="q1"><verse number="11" style="v" sid="MAT 6:11"/>Give us today our necessary bread. <verse eid="MAT 6:11"/></para>

<para style="q1"><verse number="12" style="v" sid="MAT 6:12"/>And forgive us our debts, </para>

<para style="q2" vid="MAT 6:12">as we also have forgiven our debtors. <note caller="+" style="f"><char style="fr" closed="false">6.12 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">forgive</char></note><verse eid="MAT 6:12"/></para>

<para style="q1"><verse number="13" style="v" sid="MAT 6:13"/>And lead us not into temptation, </para>

<para style="q2" vid="MAT 6:13">but deliver us from the evil one.’ <note caller="+" style="f"><char style="fr" closed="false">6.13 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">from evil</char><char style="ft" closed="false">; Greek </char><char style="fq" closed="false">apo tou ponērou</char><char style="ft" closed="false">, literally, </char><char style="fq" closed="false">"from the evil,"</char><char style="ft" closed="false"> where </char><char style="fq" closed="false">evil</char><char style="ft" closed="false"> is singular, is variously interpreted as referring to evil in general or a specific evil entity. BYZ and TR include </char><char style="fq" closed="false">For Yours is the kingdom and the power and the glory forever. Amen.</char></note><verse eid="MAT 6:13"/></para>

<para style="p"><verse number="14" style="v" sid="MAT 6:14"/>For if you⁺ forgive men their trespasses, your⁺ heavenly Father will also forgive you⁺. <verse eid="MAT 6:14"/></para>

<para style="p"><verse number="15" style="v" sid="MAT 6:15"/>But if you⁺ do not forgive men their trespasses, neither will your⁺ Father forgive your⁺ trespasses. <note caller="+" style="f"><char style="fr" closed="false">6.15 </char><char style="ft" closed="false"> NA and SBL </char><char style="fq" closed="false">if you do not forgive men</char></note><verse eid="MAT 6:15"/></para>

<para style="s">Proper Fasting</para>

<para style="p"><verse number="16" style="v" sid="MAT 6:16"/>And when you⁺ may fast, do not be as the hypocrites, gloomy-faced; for they disfigure their faces so that they might appear to men <char style="add">as</char> fasting. Truly I say to you⁺, they have their reward in full. <verse eid="MAT 6:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 6:17"/>But you, fasting, anoint your head and wash your face, <verse eid="MAT 6:17"/></para>

<para style="p"><verse number="18" style="v" sid="MAT 6:18"/>so that you might not appear to men <char style="add">as</char> fasting, but to your Father, the One in secret. And your Father, the One seeing in secret, will reward you.<note caller="+" style="f"><char style="fr" closed="false">6.18 </char><char style="ft" closed="false"> GOC and TR </char><char style="fq" closed="false">will reward you openly</char></note> <verse eid="MAT 6:18"/></para>

<para style="s">Treasures in HeavenLuke 12:32–34</para>

<para style="p"><verse number="19" style="v" sid="MAT 6:19"/>Do not treasure up for yourselves treasures on the earth, where moth and rust<note caller="+" style="f"><char style="fr" closed="false">6.19 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">worm</char><char style="ft" closed="false">; also in verse 20</char></note> disfigure, and where thieves break in and steal. <verse eid="MAT 6:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 6:20"/>But treasure up for yourselves treasures in heaven, where neither moth nor rust disfigure, and where thieves do not break in, nor do they steal. <verse eid="MAT 6:20"/></para>

<para style="p"><verse number="21" style="v" sid="MAT 6:21"/>For where your treasure is, there will be also your heart. <verse eid="MAT 6:21"/></para>

<para style="s">The Lamp of the BodyLuke 11:33–36</para>

<para style="p"><verse number="22" style="v" sid="MAT 6:22"/>The lamp of the body is the eye. Therefore if your eye is sound,<note caller="+" style="f"><char style="fr" closed="false">6.22 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">if your eye is good</char><char style="ft" closed="false">; see Proverbs 22:9</char></note> your whole body will be full of light. <verse eid="MAT 6:22"/></para>

<para style="p"><verse number="23" style="v" sid="MAT 6:23"/>But if your eye is evil,<note caller="+" style="f"><char style="fr" closed="false">6.23 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">if your eye is bad</char><char style="ft" closed="false">; see Proverbs 23:6 and Proverbs 28:22</char></note> your whole body will be full of darkness. If then the light that <char style="add">is</char> in you is darkness, how great <char style="add">is</char> the darkness! <verse eid="MAT 6:23"/></para>

<para style="p"><verse number="24" style="v" sid="MAT 6:24"/>No one is able to serve two masters. For either he will hate the one and he will love the other, or he will hold to one and he will despise the other. You⁺ are not able to serve God and mammon. <verse eid="MAT 6:24"/></para>

<para style="s">Do Not WorryLuke 12:22–31</para>

<para style="p"><verse number="25" style="v" sid="MAT 6:25"/>Because of this I say to you⁺, do not be anxious for your⁺ life, what you⁺ might eat or<note caller="+" style="f"><char style="fr" closed="false">6.25 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">and</char></note> what you⁺ might drink, nor for your⁺ body, what you⁺ might put on. Is not life more than food, and the body <char style="add">more</char> than clothing? <verse eid="MAT 6:25"/></para>

<para style="p"><verse number="26" style="v" sid="MAT 6:26"/>Look at the birds of the sky, that they do not sow, nor do they reap, nor do they gather into barns, and your⁺ heavenly Father feeds them. Are you⁺ not much more valuable than they? <verse eid="MAT 6:26"/></para>

<para style="p"><verse number="27" style="v" sid="MAT 6:27"/>And who of you⁺, being anxious, is able to add to his lifespan one cubit?<note caller="+" style="f"><char style="fr" closed="false">6.27 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">to his height one cubit</char><char style="ft" closed="false">; a cubit in reference to time is a small unit of time; in reference to length it is approximately 18 inches or 45 centimeters.</char></note> <verse eid="MAT 6:27"/></para>

<para style="p"><verse number="28" style="v" sid="MAT 6:28"/>And why are you⁺ anxious about clothing? Consider carefully the lilies of the field, how they grow: They do not labor, nor do they spin. <verse eid="MAT 6:28"/></para>

<para style="p"><verse number="29" style="v" sid="MAT 6:29"/>Yet I say to you⁺ that not even Solomon in all his glory was clothed like one of these. <verse eid="MAT 6:29"/></para>

<para style="p"><verse number="30" style="v" sid="MAT 6:30"/>But if God thus clothes the grass of the field, being today and tomorrow being thrown into the furnace, <char style="add">will He</char> not much more you⁺, O little of faith? <verse eid="MAT 6:30"/></para>

<para style="p"><verse number="31" style="v" sid="MAT 6:31"/>Therefore do not be anxious, saying, ‘What shall we eat?’ or ‘What shall we drink?’ or ‘<char style="add">With</char> what shall we be clothed?’ <verse eid="MAT 6:31"/></para>

<para style="p"><verse number="32" style="v" sid="MAT 6:32"/>For the nations seek after all these things. For your⁺ heavenly Father knows that you⁺ have need of all of these. <verse eid="MAT 6:32"/></para>

<para style="p"><verse number="33" style="v" sid="MAT 6:33"/>But seek first the kingdom of God and His righteousness, and all these things will be added to you⁺. <note caller="+" style="f"><char style="fr" closed="false">6.33 </char><char style="ft" closed="false"> SBL, WH, and NE </char><char style="fq" closed="false">seek first His kingdom</char><char style="ft" closed="false">; see also Luke 12:31.</char></note><verse eid="MAT 6:33"/></para>

<para style="p"><verse number="34" style="v" sid="MAT 6:34"/>Therefore do not be anxious for tomorrow, for tomorrow will be anxious for itself.<note caller="+" style="f"><char style="fr" closed="false">6.34 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">will be anxious for the things of itself</char></note> Sufficient to the day <char style="add">is</char> its evil. <verse eid="MAT 6:34"/></para>

<chapter eid="MAT 6"/>

<chapter number="7" style="c" sid="MAT 7"/>

<para style="s">Judging Others</para>

<para style="p"><verse number="1" style="v" sid="MAT 7:1"/><note caller="-" style="x"><char style="xt" closed="false">Romans 14:1–12</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 6:37–42</char></note><char style="add">“</char> Do not judge, that you⁺ may not be judged. <verse eid="MAT 7:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 7:2"/>For in what judgment you⁺ judge, you⁺ will be judged; and in what measure you⁺ measure, it will be measured to you⁺. <verse eid="MAT 7:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 7:3"/>And why do you look at the splinter that <char style="add">is</char> in the eye of your brother, but not notice the beam in your <char style="add">own</char> eye? <verse eid="MAT 7:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 7:4"/>Or how will you say to your brother, ‘Permit that I might cast out the splinter from your eye,’ and behold, the beam <char style="add">is</char> in your eye? <verse eid="MAT 7:4"/></para>

<para style="p"><verse number="5" style="v" sid="MAT 7:5"/>Hypocrite! First cast out the beam from your eye, and then you will see clearly to cast out the splinter from the eye of your brother. <verse eid="MAT 7:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 7:6"/>Do not give what <char style="add">is</char> holy to the dogs, nor cast your⁺ pearls before the pigs, lest they will trample them among their feet and, having turned, tear you⁺ to pieces. <verse eid="MAT 7:6"/></para>

<para style="s">Ask, Seek, KnockLuke 11:5–13</para>

<para style="p"><verse number="7" style="v" sid="MAT 7:7"/>Ask, and it will be given to you⁺; seek, and you⁺ will find; knock, and it will be opened to you⁺. <verse eid="MAT 7:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 7:8"/>For everyone asking receives; and the one seeking finds; and to the one knocking, it will be opened. <verse eid="MAT 7:8"/></para>

<para style="p"><verse number="9" style="v" sid="MAT 7:9"/>Or which man is of you⁺ who, <char style="add">if</char> his son will ask for bread, will give to him a stone, <verse eid="MAT 7:9"/></para>

<para style="p"><verse number="10" style="v" sid="MAT 7:10"/>or also, <char style="add">if</char> he will ask for a fish, will give to him a serpent? <verse eid="MAT 7:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 7:11"/>Therefore if you⁺, being evil, know to give good gifts to your⁺ children, how much more will your⁺ Father who <char style="add">is</char> in the heavens give good things to those asking Him! <verse eid="MAT 7:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 7:12"/>All things, therefore, as many as you⁺ may want that men may do to you⁺, so also you⁺ do to them, for this is the Law and the Prophets. <verse eid="MAT 7:12"/></para>

<para style="s">The Narrow GateLuke 13:22–30</para>

<para style="p"><verse number="13" style="v" sid="MAT 7:13"/>Enter through the narrow gate, because wide <char style="add">is</char> the gate and broad the way that is leading to destruction, and many are those entering through it. <verse eid="MAT 7:13"/></para>

<para style="p"><verse number="14" style="v" sid="MAT 7:14"/>For narrow <char style="add">is</char> the gate and compressed the way that <char style="add">is</char> leading to life, and few are those finding it. <verse eid="MAT 7:14"/></para>

<para style="s">A Tree and Its FruitLuke 6:43–45</para>

<para style="p"><verse number="15" style="v" sid="MAT 7:15"/>Beware of the false prophets, who come to you⁺ in sheep’s clothing, but inwardly are ravenous wolves. <verse eid="MAT 7:15"/></para>

<para style="p"><verse number="16" style="v" sid="MAT 7:16"/>From their fruits you⁺ will recognize them. <char style="add">Do</char> they gather grapes from thorns, or figs from thistles? <verse eid="MAT 7:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 7:17"/>Thus every good tree produces good fruits, but the rotten tree produces evil fruits. <verse eid="MAT 7:17"/></para>

<para style="p"><verse number="18" style="v" sid="MAT 7:18"/>A good tree is not able to produce evil fruits, nor a rotten tree to produce good fruits. <verse eid="MAT 7:18"/></para>

<para style="p"><verse number="19" style="v" sid="MAT 7:19"/>Every tree not producing good fruit is cut down and is thrown into fire. <verse eid="MAT 7:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 7:20"/>Therefore from their fruits you⁺ will recognize them. <verse eid="MAT 7:20"/></para>

<para style="p"><verse number="21" style="v" sid="MAT 7:21"/>Not everyone who <char style="add">is</char> saying to Me, ‘Lord, Lord,’ will enter into the kingdom of the heavens, but the one doing the will of My Father who <char style="add">is</char> in the heavens. <verse eid="MAT 7:21"/></para>

<para style="p"><verse number="22" style="v" sid="MAT 7:22"/>Many will say to Me in that day, ‘Lord, Lord, did we not prophesy in Your name, and <char style="add">in</char> Your name cast out demons, and in Your name do many miracles?’ <verse eid="MAT 7:22"/></para>

<para style="p"><verse number="23" style="v" sid="MAT 7:23"/>And then I will profess to them, ‘I never knew you⁺; depart from Me, <char style="add">you</char> working lawlessness!’ <verse eid="MAT 7:23"/></para>

<para style="s">The House on the RockLuke 6:46–49</para>

<para style="p"><verse number="24" style="v" sid="MAT 7:24"/>Therefore everyone who hears these words of Mine and does them will be likened to a wise man who built his house on the rock. <verse eid="MAT 7:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 7:25"/>And the rain came down, and the rivers came, and the winds blew and fell upon that house; and it did not fall, for it had been founded on the rock. <verse eid="MAT 7:25"/></para>

<para style="p"><verse number="26" style="v" sid="MAT 7:26"/>And everyone who <char style="add">is</char> hearing these words of Mine and not doing them will be likened to a foolish man who built his house on the sand. <verse eid="MAT 7:26"/></para>

<para style="p"><verse number="27" style="v" sid="MAT 7:27"/>And the rain came down, and the rivers came, and the winds blew and beat upon that house; and it fell—and its fall was great!” <verse eid="MAT 7:27"/></para>

<para style="s">The Authority of Jesus</para>

<para style="p"><verse number="28" style="v" sid="MAT 7:28"/>And it came to pass when Jesus finished these words <char style="add">that</char> the crowds were astonished at His teaching. <verse eid="MAT 7:28"/></para>

<para style="p"><verse number="29" style="v" sid="MAT 7:29"/>For He was teaching them as One having authority, and not as their scribes. </para>

<para style="p" vid="MAT 7:29"> TR <char style="add">measured again</char> BYZ and TR <char style="add">and</char> WH <char style="add">wide and broad is the way</char> F35 <char style="add">Every tree, then,</char> BYZ and TR <char style="add">I will liken to</char> BYZ and TR <char style="add">the scribes</char><verse eid="MAT 7:29"/></para>

<chapter eid="MAT 7"/>

<chapter number="8" style="c" sid="MAT 8"/>

<para style="s">The Leper’s Prayer</para>

<para style="p"><verse number="1" style="v" sid="MAT 8:1"/><note caller="-" style="x"><char style="xt" closed="false">Luke 5:12–16</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 1:40–45</char></note><note caller="-" style="x"><char style="xt" closed="false">Leviticus 14:1–32</char></note>And <char style="add">on</char> His having come down from the mountain, many crowds followed Him. <verse eid="MAT 8:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 8:2"/>And behold, a leper,<note caller="+" style="f"><char style="fr" closed="false">8.2 </char><char style="ft" closed="false"> A </char><char style="fq" closed="false">leper</char><char style="ft" closed="false"> was one afflicted with a skin disease. See Leviticus 13.</char></note> having come, was kneeling down to Him, saying, “Lord, if You are willing, You are able to cleanse me.” <verse eid="MAT 8:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 8:3"/>And having stretched out the hand, He touched him, saying, <char style="wj">“I am willing; be cleansed!”</char> And immediately his leprosy was cleansed. <verse eid="MAT 8:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 8:4"/>And Jesus says to him, <char style="wj">“See that you tell no one. But go, show yourself to the priest, and offer the gift that Moses commanded, for a testimony to them.”</char><note caller="+" style="f"><char style="fr" closed="false">8.4 </char><char style="ft" closed="false"> See Leviticus 14:1–32.</char></note> <verse eid="MAT 8:4"/></para>

<para style="s">The Faith of the CenturionLuke 7:1–10</para>

<para style="p"><verse number="5" style="v" sid="MAT 8:5"/><note caller="-" style="x"><char style="xt" closed="false">John 4:43–54</char></note>And <char style="add">on</char> His having entered into Capernaum, a centurion came to Him, imploring Him <verse eid="MAT 8:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 8:6"/>and saying, “Lord, my servant<note caller="+" style="f"><char style="fr" closed="false">8.6 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">child</char><char style="ft" closed="false">; also in verses 8 and 13</char></note> is laid in the house a paralytic, terribly tormented.” <verse eid="MAT 8:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 8:7"/>And He says to him, <char style="wj">“I, having gone, will heal him.”</char> <verse eid="MAT 8:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 8:8"/>But answering, the centurion said, “Lord, I am not fit that You should enter under my roof; but only say a word, and my servant will be healed. <verse eid="MAT 8:8"/></para>

<para style="p"><verse number="9" style="v" sid="MAT 8:9"/>For I also am a man under<note caller="+" style="f"><char style="fr" closed="false">8.9 </char><char style="ft" closed="false"> WH </char><char style="fq" closed="false">set under</char></note> authority, having soldiers under me. And I say to this one, ‘Go,’ and he goes; and to another, ‘Come,’ and he comes; and to my servant, ‘Do this,’ and he does.” <verse eid="MAT 8:9"/></para>

<para style="p"><verse number="10" style="v" sid="MAT 8:10"/>And having heard, Jesus marveled and said to those following, <char style="wj">“Truly I say to you⁺, with no one in Israel did I find such great faith.</char><note caller="+" style="f"><char style="fr" closed="false">8.10 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">Truly I say to you, in Israel I did not find such great faith</char></note><char style="wj"> </char><verse eid="MAT 8:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 8:11"/><char style="wj">And I say to you⁺ that many will come from east and west and will recline with Abraham and Isaac and Jacob in the kingdom of the heavens. </char><verse eid="MAT 8:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 8:12"/><char style="wj">But the sons of the kingdom will be cast out into the outer darkness—there will be weeping and gnashing of the teeth.”</char> <verse eid="MAT 8:12"/></para>

<para style="p"><verse number="13" style="v" sid="MAT 8:13"/>And Jesus said to the centurion, <char style="wj">“Go! As you believed, let it be to you.”</char> And his servant<note caller="+" style="f"><char style="fr" closed="false">8.13 </char><char style="ft" closed="false"> SBL, TH, WH </char><char style="fq" closed="false">the servant</char></note> was healed in that very hour. <verse eid="MAT 8:13"/></para>

<para style="s">Jesus Heals at Peter’s HouseMark 1:29–34</para>

<para style="p"><verse number="14" style="v" sid="MAT 8:14"/><note caller="-" style="x"><char style="xt" closed="false">Luke 4:38–41</char></note>And Jesus, having come to the house of Peter, saw his mother-in-law laid and having a fever. <verse eid="MAT 8:14"/></para>

<para style="p"><verse number="15" style="v" sid="MAT 8:15"/>And He touched her hand, and the fever left her; and she arose and was serving Him.<note caller="+" style="f"><char style="fr" closed="false">8.15 </char><char style="ft" closed="false"> TR </char><char style="fq" closed="false">them</char></note> <verse eid="MAT 8:15"/></para>

<para style="p"><verse number="16" style="v" sid="MAT 8:16"/>And evening having come, they brought to Him many being possessed by demons, and He cast out the spirits with a word and healed all those being ill, <verse eid="MAT 8:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 8:17"/>so that it might be fulfilled, that having been spoken through Isaiah the prophet, saying: </para>

<para style="q1" vid="MAT 8:17">“He Himself took our infirmities, </para>

<para style="q2" vid="MAT 8:17">and carried the diseases.” <note caller="+" style="f"><char style="fr" closed="false">8.17 </char><char style="ft" closed="false"> Isaiah 53:4</char></note><verse eid="MAT 8:17"/></para>

<para style="s">The Cost of DiscipleshipLuke 9:57–62</para>

<para style="p"><verse number="18" style="v" sid="MAT 8:18"/><note caller="-" style="x"><char style="xt" closed="false">John 6:59–66</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 14:25–33</char></note>And Jesus, having seen a great crowd<note caller="+" style="f"><char style="fr" closed="false">8.18 </char><char style="ft" closed="false"> SBL, BYZ, and TR </char><char style="fq" closed="false">great crowds</char></note> around Him, commanded to go away to the other side.<note caller="+" style="f"><char style="fr" closed="false">8.18 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">to the other side of the sea</char><char style="ft" closed="false">, that is, the Sea of Galilee</char></note> <verse eid="MAT 8:18"/></para>

<para style="p"><verse number="19" style="v" sid="MAT 8:19"/>And having come, one scribe said to Him, “Teacher, I will follow You wherever You may go.” <verse eid="MAT 8:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 8:20"/>And Jesus says to him, <char style="wj">“The foxes have holes, and the birds of the air nests, but the Son of Man has nowhere He might lay the head.”</char> <verse eid="MAT 8:20"/></para>

<para style="p"><verse number="21" style="v" sid="MAT 8:21"/>And another of His disciples<note caller="+" style="f"><char style="fr" closed="false">8.21 </char><char style="ft" closed="false"> F35, SBL, TH, WH </char><char style="fq" closed="false">the disciples</char></note> said to Him, “Lord, allow me first to go away and to bury my father.” <verse eid="MAT 8:21"/></para>

<para style="p"><verse number="22" style="v" sid="MAT 8:22"/>But Jesus says to him, <char style="wj">“Follow Me, and leave the dead to bury their own dead.”</char> <verse eid="MAT 8:22"/></para>

<para style="s">Jesus Calms the StormPsalm 107:1–43</para>

<para style="p"><verse number="23" style="v" sid="MAT 8:23"/><note caller="-" style="x"><char style="xt" closed="false">Luke 8:22–25</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 4:35–41</char></note>And <char style="add">on</char> His having entered into the boat, His disciples followed Him. <verse eid="MAT 8:23"/></para>

<para style="p"><verse number="24" style="v" sid="MAT 8:24"/>And behold, a great storm arose in the sea, so that the boat was being covered by the waves; but He Himself was sleeping. <verse eid="MAT 8:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 8:25"/>And having come, they awoke<note caller="+" style="f"><char style="fr" closed="false">8.25 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">the disciples awoke</char><char style="ft" closed="false">; GOC and TR </char><char style="fq" closed="false">His disciples awoke</char></note> Him, saying, “Lord, save us! We are perishing!” <verse eid="MAT 8:25"/></para>

<para style="p"><verse number="26" style="v" sid="MAT 8:26"/>And He says to them, <char style="wj">“Why are you⁺ cowardly, O little of faith?”</char> Then, having arisen, He rebuked the winds and the sea, and there was a great calm. <verse eid="MAT 8:26"/></para>

<para style="p"><verse number="27" style="v" sid="MAT 8:27"/>And the men marveled, saying, “What kind is this, that even the winds and the sea obey Him?” <verse eid="MAT 8:27"/></para>

<para style="s">The Demons and the PigsMark 5:1–20</para>

<para style="p"><verse number="28" style="v" sid="MAT 8:28"/><note caller="-" style="x"><char style="xt" closed="false">Luke 8:26–39</char></note>And <char style="add">on</char> His having come to the other side, to the region of the Gadarenes,<note caller="+" style="f"><char style="fr" closed="false">8.28 </char><char style="ft" closed="false"> BYZ, TR, and GOC </char><char style="fq" closed="false">Gergesenes</char><char style="ft" closed="false">; other manuscripts </char><char style="fq" closed="false">Gerasenes</char></note> two <char style="add">men</char> being possessed by demons met Him, coming out of the tombs, extremely violent, so as for no one to have strength to pass by that way. <verse eid="MAT 8:28"/></para>

<para style="p"><verse number="29" style="v" sid="MAT 8:29"/>And behold, they cried out, saying, “What to us and to You, Son<note caller="+" style="f"><char style="fr" closed="false">8.29 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">Jesus, Son</char></note> of God? Did You come here to torment us before the time?” <verse eid="MAT 8:29"/></para>

<para style="p"><verse number="30" style="v" sid="MAT 8:30"/>Now there was far off from them a herd of many pigs feeding. <verse eid="MAT 8:30"/></para>

<para style="p"><verse number="31" style="v" sid="MAT 8:31"/>And the demons were imploring Him, saying, “If You cast us out, send us away into<note caller="+" style="f"><char style="fr" closed="false">8.31 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">permit us to go away into</char></note> the herd of pigs.” <verse eid="MAT 8:31"/></para>

<para style="p"><verse number="32" style="v" sid="MAT 8:32"/>And He said to them, <char style="wj">“Go!”</char> And having gone out, they went away into the pigs,<note caller="+" style="f"><char style="fr" closed="false">8.32 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">the herd of pigs</char></note> and behold, all the herd<note caller="+" style="f"><char style="fr" closed="false">8.32 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">all the herd of pigs</char></note> rushed down the steep bank into the sea and died in the waters. <verse eid="MAT 8:32"/></para>

<para style="p"><verse number="33" style="v" sid="MAT 8:33"/>And those feeding <char style="add">them</char> fled, and having gone away into the city, they related everything, and the <char style="add">matter</char> of those being possessed by demons. <verse eid="MAT 8:33"/></para>

<para style="p"><verse number="34" style="v" sid="MAT 8:34"/>And behold, all the city went out to meet Jesus. And having seen Him, they implored <char style="add">Him</char> that He might depart from their borders. <verse eid="MAT 8:34"/></para>

<chapter eid="MAT 8"/>

<chapter number="9" style="c" sid="MAT 9"/>

<para style="s">Jesus Heals a Paralytic</para>

<para style="p"><verse number="1" style="v" sid="MAT 9:1"/><note caller="-" style="x"><char style="xt" closed="false">Luke 5:17–26</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 2:1–12</char></note>And having entered into a boat, He crossed over, and He came into <char style="add">His</char> own city. <verse eid="MAT 9:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 9:2"/>And behold, they were bringing to Him a paralytic lying on a bed. And Jesus, having seen their faith, said to the paralytic, <char style="wj">“Take courage, child; your sins are forgiven.</char><note caller="+" style="f"><char style="fr" closed="false">9.2 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">your sins are forgiven you</char></note><char style="wj">”</char> <verse eid="MAT 9:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 9:3"/>And behold, some of the scribes said to themselves, “This One blasphemes!” <verse eid="MAT 9:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 9:4"/>And Jesus, having known<note caller="+" style="f"><char style="fr" closed="false">9.4 </char><char style="ft" closed="false"> NA, BYZ, and TR </char><char style="fq" closed="false">having seen</char></note> their thoughts, said, <char style="wj">“Why do you⁺ think evil in your⁺ hearts? </char><verse eid="MAT 9:4"/></para>

<para style="p"><verse number="5" style="v" sid="MAT 9:5"/><char style="wj">For which is easier: to say, ‘Your sins are forgiven,</char><note caller="+" style="f"><char style="fr" closed="false">9.5 </char><char style="ft" closed="false"> ALT and TR </char><char style="fq" closed="false">forgiven you</char></note><char style="wj">’ or to say, ‘Arise and walk’? </char><verse eid="MAT 9:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 9:6"/><char style="wj">But so that you⁺ may know that the Son of Man has authority on the earth to forgive sins...”</char> Then He says to the paralytic, <char style="wj">“Having arisen, take up your mat and go to your house.”</char> <verse eid="MAT 9:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 9:7"/>And having arisen, he went away to his house. <verse eid="MAT 9:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 9:8"/>And the crowds, having seen, feared<note caller="+" style="f"><char style="fr" closed="false">9.8 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">marveled</char></note> and glorified God, the One having given such authority to men. <verse eid="MAT 9:8"/></para>

<para style="s">Jesus Calls MatthewMark 2:13–17</para>

<para style="p"><verse number="9" style="v" sid="MAT 9:9"/><note caller="-" style="x"><char style="xt" closed="false">Luke 5:27–32</char></note>And Jesus, passing on from there, saw a man called Matthew sitting at the tax booth, and He says to him, <char style="wj">“Follow Me.”</char> And having risen up, he followed Him. <verse eid="MAT 9:9"/></para>

<para style="p"><verse number="10" style="v" sid="MAT 9:10"/>And it came to pass <char style="add">in</char> His reclining in the house, that behold, many tax collectors and sinners, having come, were reclining with Jesus and His disciples. <verse eid="MAT 9:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 9:11"/>And having seen, the Pharisees were saying to His disciples, “Why does your⁺ Teacher eat<note caller="+" style="f"><char style="fr" closed="false">9.11 </char><char style="ft" closed="false"> F35 </char><char style="fq" closed="false">eat and drink</char></note> with the tax collectors and sinners?” <verse eid="MAT 9:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 9:12"/>But having heard, He said,<note caller="+" style="f"><char style="fr" closed="false">9.12 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">But Jesus, having heard, said to them</char></note> <char style="wj">“Those being strong have no need of a physician, but those being ill. </char><verse eid="MAT 9:12"/></para>

<para style="p"><verse number="13" style="v" sid="MAT 9:13"/><char style="wj">But having gone, learn what is ‘I desire mercy and not sacrifice.’ For I did not come to call the righteous, but sinners.</char><note caller="+" style="f"><char style="fr" closed="false">9.13 </char><char style="ft" closed="false"> Hosea 6:6</char></note><char style="wj">”</char> <note caller="+" style="f"><char style="fr" closed="false">9.13 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">but sinners, to repentance</char><char style="ft" closed="false">; see Luke 5:32.</char></note><verse eid="MAT 9:13"/></para>

<para style="s">Questions about FastingMark 2:18–20</para>

<para style="p"><verse number="14" style="v" sid="MAT 9:14"/><note caller="-" style="x"><char style="xt" closed="false">Luke 5:33–35</char></note>Then the disciples of John come to Him, saying, “Why do we and the Pharisees fast much,<note caller="+" style="f"><char style="fr" closed="false">9.14 </char><char style="ft" closed="false"> NE and WH do not include </char><char style="fq" closed="false">much</char><char style="ft" closed="false">.</char></note> but Your disciples do not fast?” <verse eid="MAT 9:14"/></para>

<para style="p"><verse number="15" style="v" sid="MAT 9:15"/>And Jesus said to them, <char style="wj">“Are the sons of the bridechamber able to mourn as long as the bridegroom is with them? But days will come when the bridegroom shall have been taken away from them, and then they will fast. </char><verse eid="MAT 9:15"/></para>

<para style="s">The Patches and the WineskinsMark 2:21–22</para>

<para style="p"><verse number="16" style="v" sid="MAT 9:16"/><note caller="-" style="x"><char style="xt" closed="false">Luke 5:36–39</char></note>But no one puts a patch of unshrunk cloth on an old garment, for the filling up of it pulls away from the garment, and a worse tear happens. <verse eid="MAT 9:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 9:17"/>Nor do they put new wine into old wineskins; and if otherwise, the wineskins are burst, and the wine is poured out, and the wineskins are destroyed. But they put new wine into new wineskins, and both are preserved.” <verse eid="MAT 9:17"/></para>

<para style="s">The Healing Touch of JesusMark 5:21–43</para>

<para style="p"><verse number="18" style="v" sid="MAT 9:18"/><note caller="-" style="x"><char style="xt" closed="false">Luke 8:40–56</char></note><char style="add">In</char> His speaking these things to them, behold, one ruler, having come, was kneeling down to Him, saying, “My daughter just now died, but having come, lay Your hand upon her, and she will live.” <verse eid="MAT 9:18"/></para>

<para style="p"><verse number="19" style="v" sid="MAT 9:19"/>And having arisen, Jesus was following him, as well as His disciples. <verse eid="MAT 9:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 9:20"/>And behold, a woman having a flow of blood twelve years, having come behind <char style="add">Him</char>, touched the fringe of His garment. <verse eid="MAT 9:20"/></para>

<para style="p"><verse number="21" style="v" sid="MAT 9:21"/>For she was saying within herself, “If only I shall touch His garment, I will be saved.” <verse eid="MAT 9:21"/></para>

<para style="p"><verse number="22" style="v" sid="MAT 9:22"/>And Jesus, having turned<note caller="+" style="f"><char style="fr" closed="false">9.22 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">having turned around</char></note> and having seen her, said, <char style="wj">“Take courage, daughter; your faith has saved you.”</char> And the woman was saved from that hour. <verse eid="MAT 9:22"/></para>

<para style="p"><verse number="23" style="v" sid="MAT 9:23"/>And Jesus, having come into the house of the ruler and having seen the flute players and the crowd making a commotion, <verse eid="MAT 9:23"/></para>

<para style="p"><verse number="24" style="v" sid="MAT 9:24"/>was saying, <char style="wj">“Withdraw, for the girl did not die, but sleeps.”</char> And they were laughing at Him. <verse eid="MAT 9:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 9:25"/>And when the crowd was put outside, having entered, He took hold of her hand, and the girl arose. <verse eid="MAT 9:25"/></para>

<para style="p"><verse number="26" style="v" sid="MAT 9:26"/>And this report went out into all that land. <verse eid="MAT 9:26"/></para>

<para style="s">Jesus Heals the Blind and MuteMark 7:31–37</para>

<para style="p"><verse number="27" style="v" sid="MAT 9:27"/>And Jesus passing on from there, two blind <char style="add">men</char> followed Him, crying out and saying, “Have mercy on us, Son of David!” <verse eid="MAT 9:27"/></para>

<para style="p"><verse number="28" style="v" sid="MAT 9:28"/>And having come into the house, the blind <char style="add">men</char> came to Him, and Jesus says to them, <char style="wj">“Do you⁺ believe that I am able to do this?”</char> </para>

<para style="p" vid="MAT 9:28">They say to Him, “Yes, Lord.” <verse eid="MAT 9:28"/></para>

<para style="p"><verse number="29" style="v" sid="MAT 9:29"/>Then He touched their eyes, saying, <char style="wj">“According to your⁺ faith let it be to you⁺.”</char> <verse eid="MAT 9:29"/></para>

<para style="p"><verse number="30" style="v" sid="MAT 9:30"/>And their eyes were opened. And Jesus strictly instructed them, saying, <char style="wj">“See, let no one know!”</char> <verse eid="MAT 9:30"/></para>

<para style="p"><verse number="31" style="v" sid="MAT 9:31"/>But having gone out, they reported <char style="add">about</char> Him in all that land. <verse eid="MAT 9:31"/></para>

<para style="p"><verse number="32" style="v" sid="MAT 9:32"/>And <char style="add">in</char> their going out, behold, they brought to Him a mute man possessed by a demon. <verse eid="MAT 9:32"/></para>

<para style="p"><verse number="33" style="v" sid="MAT 9:33"/>And the demon having been cast out, the mute <char style="add">man</char> spoke. And the crowds marveled, saying, “Never thus was it seen in Israel!” <verse eid="MAT 9:33"/></para>

<para style="p"><verse number="34" style="v" sid="MAT 9:34"/>But the Pharisees were saying, “By the prince of the demons He casts out the demons.” <verse eid="MAT 9:34"/></para>

<para style="s">The Lord of the HarvestLuke 10:1–12</para>

<para style="p"><verse number="35" style="v" sid="MAT 9:35"/>And Jesus was going throughout all the cities and the villages, teaching in their synagogues, and proclaiming the gospel of the kingdom, and healing every disease and every sickness.<note caller="+" style="f"><char style="fr" closed="false">9.35 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">among the people</char><char style="ft" closed="false">.</char></note> <verse eid="MAT 9:35"/></para>

<para style="p"><verse number="36" style="v" sid="MAT 9:36"/>And having seen the crowds, He was moved with compassion for them, because they were wearied<note caller="+" style="f"><char style="fr" closed="false">9.36 </char><char style="ft" closed="false"> GOC and TR </char><char style="fq" closed="false">faint</char></note> and cast away, as sheep not having a shepherd. <verse eid="MAT 9:36"/></para>

<para style="p"><verse number="37" style="v" sid="MAT 9:37"/>Then He says to His disciples, <char style="wj">“The harvest indeed is much, but the workers are few. </char><verse eid="MAT 9:37"/></para>

<para style="p"><verse number="38" style="v" sid="MAT 9:38"/><char style="wj">Therefore implore the Lord of the harvest, that He might put forth workers into His harvest.”</char> <verse eid="MAT 9:38"/></para>

<chapter eid="MAT 9"/>

<chapter number="10" style="c" sid="MAT 10"/>

<para style="s">The Twelve Apostles</para>

<para style="p"><verse number="1" style="v" sid="MAT 10:1"/><note caller="-" style="x"><char style="xt" closed="false">Luke 6:12–16</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 3:13–19</char></note>And having summoned His twelve disciples, He gave them authority over unclean spirits, so as to cast them out and to heal every disease and every sickness. <verse eid="MAT 10:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 10:2"/>And these are the names of the twelve apostles: first Simon who <char style="add">is</char> called Peter, and his brother Andrew; and James the <char style="add">son</char> of Zebedee, and his brother John; <verse eid="MAT 10:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 10:3"/>Philip and Bartholomew; Thomas and Matthew the tax collector; James the <char style="add">son</char> of Alphaeus, and Thaddaeus;<note caller="+" style="f"><char style="fr" closed="false">10.3 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">Lebbaeus called Thaddaeus</char></note> <verse eid="MAT 10:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 10:4"/>Simon the Cananean,<note caller="+" style="f"><char style="fr" closed="false">10.4 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">Simon the Zealot</char></note> and Judas Iscariot, the one also having betrayed Him. <verse eid="MAT 10:4"/></para>

<para style="s">The Ministry of the TwelveMark 6:7–13</para>

<para style="p"><verse number="5" style="v" sid="MAT 10:5"/><note caller="-" style="x"><char style="xt" closed="false">Luke 9:1–6</char></note>These twelve Jesus sent forth, having instructed them, saying: <char style="wj">“Do not go into the way of the Gentiles, and into a city of the Samaritans do not enter. </char><verse eid="MAT 10:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 10:6"/><char style="wj">But go rather to the lost sheep of the house of Israel. </char><verse eid="MAT 10:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 10:7"/><char style="wj">And going, proclaim, saying, ‘The kingdom of the heavens has drawn near.’ </char><verse eid="MAT 10:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 10:8"/><char style="wj">Heal the ailing, raise the dead,</char><note caller="+" style="f"><char style="fr" closed="false">10.8 </char><char style="ft" closed="false"> BYZ does not include </char><char style="fq" closed="false">raise the dead</char><char style="ft" closed="false">; TR includes </char><char style="fq" closed="false">raise the dead</char><char style="ft" closed="false"> after </char><char style="fq" closed="false">cleanse the lepers</char><char style="ft" closed="false">.</char></note><char style="wj"> cleanse the lepers,</char><note caller="+" style="f"><char style="fr" closed="false">10.8 </char><char style="ft" closed="false"> A </char><char style="fq" closed="false">leper</char><char style="ft" closed="false"> was one afflicted with a skin disease. See Leviticus 13.</char></note><char style="wj"> cast out demons. Freely you⁺ received; freely give. </char><verse eid="MAT 10:8"/></para>

<para style="p"><verse number="9" style="v" sid="MAT 10:9"/>Acquire neither gold nor silver nor copper in your⁺ belts, <verse eid="MAT 10:9"/></para>

<para style="p"><verse number="10" style="v" sid="MAT 10:10"/>nor a bag for the way, nor two tunics, nor sandals, nor a staff;<note caller="+" style="f"><char style="fr" closed="false">10.10 </char><char style="ft" closed="false"> BYZ, Scrivener TR </char><char style="fq" closed="false">nor staffs</char></note> for the worker <char style="add">is</char> worthy of his food. <verse eid="MAT 10:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 10:11"/>And into whatever city or village you⁺ may enter, inquire who is worthy in it, and remain there until you⁺ may go out. <verse eid="MAT 10:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 10:12"/>And entering into the house, greet it. <verse eid="MAT 10:12"/></para>

<para style="p"><verse number="13" style="v" sid="MAT 10:13"/>And if indeed the house is worthy, let your⁺ peace come upon it; but if it is not worthy, let your⁺ peace return to you⁺. <verse eid="MAT 10:13"/></para>

<para style="p"><verse number="14" style="v" sid="MAT 10:14"/>And whoever may not receive you⁺ nor hear your⁺ words, going forth out of the house or that city, shake off the dust of your⁺ feet. <verse eid="MAT 10:14"/></para>

<para style="p"><verse number="15" style="v" sid="MAT 10:15"/>Truly I say to you⁺, it will be more bearable for the land of Sodom and of Gomorrah in the day of judgment than for that city. <verse eid="MAT 10:15"/></para>

<para style="s">Sheep among Wolves2 Timothy 1:3–12</para>

<para style="p"><verse number="16" style="v" sid="MAT 10:16"/>Behold, I send you⁺ forth as sheep in the midst of wolves; therefore be shrewd as the serpents and innocent as the doves. <verse eid="MAT 10:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 10:17"/>But beware of men; for they will deliver you⁺ up into the councils, and in their synagogues they will flog you⁺. <verse eid="MAT 10:17"/></para>

<para style="p"><verse number="18" style="v" sid="MAT 10:18"/>And you⁺ will be led before governors and also kings on account of Me, for a testimony to them and to the nations. <verse eid="MAT 10:18"/></para>

<para style="p"><verse number="19" style="v" sid="MAT 10:19"/>And when they may deliver you⁺ up, do not be anxious how or what you⁺ shall speak; for it will be given to you⁺ in that hour what you⁺ shall speak. <verse eid="MAT 10:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 10:20"/>For you⁺ are not the ones speaking, but the Spirit of your⁺ Father speaking in you⁺. <verse eid="MAT 10:20"/></para>

<para style="p"><verse number="21" style="v" sid="MAT 10:21"/>And brother will deliver up brother to death, and father, child; and children will rise up against parents and will put them to death. <verse eid="MAT 10:21"/></para>

<para style="p"><verse number="22" style="v" sid="MAT 10:22"/>And you⁺ will be hated by all because of My name; but the one having endured to the end, this one will be saved. <verse eid="MAT 10:22"/></para>

<para style="p"><verse number="23" style="v" sid="MAT 10:23"/>And when they may persecute you⁺ in one city, flee to the other.<note caller="+" style="f"><char style="fr" closed="false">10.23 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">flee to another</char></note> For truly I say to you⁺, you⁺ shall not have completed the cities of Israel until the Son of Man shall come. <verse eid="MAT 10:23"/></para>

<para style="p"><verse number="24" style="v" sid="MAT 10:24"/>A disciple is not above the teacher, nor a servant above his master. <verse eid="MAT 10:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 10:25"/>Aufficient to the disciple <char style="add">is</char> that he may become like his teacher, and the servant like his master. If the master of the house they have called Beelzebul,<note caller="+" style="f"><char style="fr" closed="false">10.25 </char><char style="ft" closed="false"> WH </char><char style="fq" closed="false">Beezeboul</char><char style="ft" closed="false">; Vulgate </char><char style="fq" closed="false">Beelzebub</char></note> how much more the members of his household! <verse eid="MAT 10:25"/></para>

<para style="s">Fear God AloneLuke 12:4–7</para>

<para style="p"><verse number="26" style="v" sid="MAT 10:26"/>Therefore do not fear them. For nothing is concealed that will not be revealed, and hidden that will not be known. <verse eid="MAT 10:26"/></para>

<para style="p"><verse number="27" style="v" sid="MAT 10:27"/>What I say to you⁺ in the darkness, say in the light; and what you⁺ hear in the ear, proclaim upon the housetops. <verse eid="MAT 10:27"/></para>

<para style="p"><verse number="28" style="v" sid="MAT 10:28"/>And do not be afraid of those killing the body but not being able to kill the soul. But fear, rather, the One being able to destroy both soul and body in Gehenna.<note caller="+" style="f"><char style="fr" closed="false">10.28 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">hell</char></note> <verse eid="MAT 10:28"/></para>

<para style="p"><verse number="29" style="v" sid="MAT 10:29"/>Are not two sparrows sold for an assarion?<note caller="+" style="f"><char style="fr" closed="false">10.29 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">a penny</char><char style="ft" closed="false">; an assarion was a Roman copper coin worth about 1/16 of a denarius</char></note> And not one of them will fall to the ground apart from your⁺ Father. <verse eid="MAT 10:29"/></para>

<para style="p"><verse number="30" style="v" sid="MAT 10:30"/>And even the hairs of your⁺ head are all numbered. <verse eid="MAT 10:30"/></para>

<para style="p"><verse number="31" style="v" sid="MAT 10:31"/>Therefore do not be afraid; you⁺ are more valuable than many sparrows. <verse eid="MAT 10:31"/></para>

<para style="s">Confessing ChristLuke 12:8–12</para>

<para style="p"><verse number="32" style="v" sid="MAT 10:32"/>Therefore everyone who will confess in Me before men, I will also confess in him before My Father who <char style="add">is</char> in the heavens. <verse eid="MAT 10:32"/></para>

<para style="p"><verse number="33" style="v" sid="MAT 10:33"/>But whoever shall deny Me before men, I also will deny him before My Father who <char style="add">is</char> in the heavens. <verse eid="MAT 10:33"/></para>

<para style="s">Not Peace but a SwordMicah 7:1–6</para>

<para style="p"><verse number="34" style="v" sid="MAT 10:34"/><note caller="-" style="x"><char style="xt" closed="false">Luke 12:49–53</char></note>Do not think that I came to cast peace upon the earth; I did not come to cast peace, but a sword. <verse eid="MAT 10:34"/></para>

<para style="p"><verse number="35" style="v" sid="MAT 10:35"/>For I came to set at variance: </para>

<para style="q1" vid="MAT 10:35">‘A man against his father, </para>

<para style="q2" vid="MAT 10:35">and a daughter against her mother, </para>

<para style="q2" vid="MAT 10:35">and a daughter-in-law against her mother-in-law. <verse eid="MAT 10:35"/></para>

<para style="q1"><verse number="36" style="v" sid="MAT 10:36"/>And the enemies of the man <char style="add">are</char> the members of his household.’ <note caller="+" style="f"><char style="fr" closed="false">10.36 </char><char style="ft" closed="false"> Micah 7:6</char></note><verse eid="MAT 10:36"/></para>

<para style="p"><verse number="37" style="v" sid="MAT 10:37"/>The one loving father or mother above Me is not worthy of Me, and the one loving son or daughter above Me is not worthy of Me. <verse eid="MAT 10:37"/></para>

<para style="p"><verse number="38" style="v" sid="MAT 10:38"/>And whoever does not take his cross and follow after Me is not worthy of Me. <verse eid="MAT 10:38"/></para>

<para style="p"><verse number="39" style="v" sid="MAT 10:39"/>The one having found his life will lose it, and the one having lost his life on account of Me will find it. <verse eid="MAT 10:39"/></para>

<para style="s">The Reward of Service2 Kings 4:8–17</para>

<para style="p"><verse number="40" style="v" sid="MAT 10:40"/>The one receiving you⁺ receives Me, and the one receiving Me receives the One having sent Me. <verse eid="MAT 10:40"/></para>

<para style="p"><verse number="41" style="v" sid="MAT 10:41"/>The one receiving a prophet in the name of a prophet will receive the reward of a prophet, and the one receiving a righteous <char style="add">man</char> in the name of a righteous <char style="add">man</char> will receive the reward of a righteous <char style="add">man</char>. <verse eid="MAT 10:41"/></para>

<para style="p"><verse number="42" style="v" sid="MAT 10:42"/>And whoever shall give to drink to one of these little ones merely a cup of cold <char style="add">water</char> in the name of a disciple, truly I say to you⁺, he shall certainly not lose his reward.” <verse eid="MAT 10:42"/></para>

<chapter eid="MAT 10"/>

<chapter number="11" style="c" sid="MAT 11"/>

<para style="s">John’s Inquiry</para>

<para style="p"><verse number="1" style="v" sid="MAT 11:1"/><note caller="-" style="x"><char style="xt" closed="false">Luke 7:18–23</char></note>And it came to pass, when Jesus finished commanding His twelve disciples, <char style="add">that</char> He departed from there to teach and to preach in their cities.<note caller="+" style="f"><char style="fr" closed="false">11.1 </char><char style="ft" closed="false"> That is, in the towns of Galilee</char></note> <verse eid="MAT 11:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 11:2"/>And John, having heard in the prison the works of the Christ, having sent through his disciples,<note caller="+" style="f"><char style="fr" closed="false">11.2 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">he sent two of his disciples</char></note> <verse eid="MAT 11:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 11:3"/>said to Him, “Are You the coming One, or do we look for another?” <verse eid="MAT 11:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 11:4"/>And answering, Jesus said to them, <char style="wj">“Having gone, report to John what you⁺ hear and see: </char><verse eid="MAT 11:4"/></para>

<para style="p"><verse number="5" style="v" sid="MAT 11:5"/><char style="wj">The blind receive sight and the lame walk, the lepers</char><note caller="+" style="f"><char style="fr" closed="false">11.5 </char><char style="ft" closed="false"> A </char><char style="fq" closed="false">leper</char><char style="ft" closed="false"> was one afflicted with a skin disease. See Leviticus 13.</char></note><char style="wj"> are cleansed and the deaf hear and the dead are raised and the poor have good news proclaimed. </char><verse eid="MAT 11:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 11:6"/><char style="wj">And blessed is the one who shall not be caused to stumble in Me.</char><note caller="+" style="f"><char style="fr" closed="false">11.6 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">who is not offended by Me</char></note><char style="wj">”</char> <verse eid="MAT 11:6"/></para>

<para style="s">Jesus Testifies about JohnMalachi 3:1–5</para>

<para style="p"><verse number="7" style="v" sid="MAT 11:7"/><note caller="-" style="x"><char style="xt" closed="false">Luke 7:24–35</char></note>And <char style="add">as</char> these are going, Jesus began to speak to the crowds about John: <char style="wj">“What did you⁺ go out into the wilderness</char><note caller="+" style="f"><char style="fr" closed="false">11.7 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">desert</char></note><char style="wj"> to see? A reed shaken by the wind? </char><verse eid="MAT 11:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 11:8"/><char style="wj">But what did you⁺ go out to see? A man having been dressed in soft garments? Behold, those wearing soft garments are in the houses of kings. </char><verse eid="MAT 11:8"/></para>

<para style="p"><verse number="9" style="v" sid="MAT 11:9"/><char style="wj">But what did you⁺ go out to see? A prophet?</char><note caller="+" style="f"><char style="fr" closed="false">11.9 </char><char style="ft" closed="false"> SBL and WH </char><char style="fq" closed="false">But why did you go out? To see a prophet?</char></note><char style="wj"> Yes, I say to you⁺, and one more than a prophet. </char><verse eid="MAT 11:9"/></para>

<para style="p"><verse number="10" style="v" sid="MAT 11:10"/><char style="wj">This is he about whom it has been written:</char> </para>

<para style="q1" vid="MAT 11:10">‘Behold, I send My messenger before Your face, </para>

<para style="q2" vid="MAT 11:10">who will prepare Your way before You.’<note caller="+" style="f"><char style="fr" closed="false">11.10 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">For this</char></note> <note caller="+" style="f"><char style="fr" closed="false">11.10 </char><char style="ft" closed="false"> Malachi 3:1</char></note><verse eid="MAT 11:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 11:11"/>Truly I say to you⁺, among <char style="add">those</char> born of women there has not risen one greater than John the Baptist. Yet the least in the kingdom of the heavens is greater than he. <verse eid="MAT 11:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 11:12"/>And from the days of John the Baptist until now, the kingdom of the heavens is subject to violence,<note caller="+" style="f"><char style="fr" closed="false">11.12 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">is forcefully advancing</char></note> and the violent seize it. <verse eid="MAT 11:12"/></para>

<para style="p"><verse number="13" style="v" sid="MAT 11:13"/>For all the Prophets and the Law prophesied until John. <verse eid="MAT 11:13"/></para>

<para style="p"><verse number="14" style="v" sid="MAT 11:14"/>And if you⁺ are willing to receive <char style="add">it</char>, he is Elijah, the one being about to come.<note caller="+" style="f"><char style="fr" closed="false">11.14 </char><char style="ft" closed="false"> See Malachi 4:5.</char></note> <verse eid="MAT 11:14"/></para>

<para style="p"><verse number="15" style="v" sid="MAT 11:15"/>The one having ears,<note caller="+" style="f"><char style="fr" closed="false">11.15 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">ears to hear</char></note> let him hear! <verse eid="MAT 11:15"/></para>

<para style="p"><verse number="16" style="v" sid="MAT 11:16"/>But to what will I liken this generation? It is like children<note caller="+" style="f"><char style="fr" closed="false">11.16 </char><char style="ft" closed="false"> TR </char><char style="fq" closed="false">little children</char></note> sitting in the marketplaces<note caller="+" style="f"><char style="fr" closed="false">11.16 </char><char style="ft" closed="false"> ALT, F35 </char><char style="fq" closed="false">marketplace</char></note> and calling out to others,<note caller="+" style="f"><char style="fr" closed="false">11.16 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">to one another</char></note> <verse eid="MAT 11:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 11:17"/>saying: </para>

<para style="q1" vid="MAT 11:17">‘We played the flute for you⁺, </para>

<para style="q2" vid="MAT 11:17">and you⁺ did not dance; </para>

<para style="q1" vid="MAT 11:17">we sang a dirge,<note caller="+" style="f"><char style="fr" closed="false">11.17 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">for you</char><char style="ft" closed="false">.</char></note> </para>

<para style="q2" vid="MAT 11:17">and you⁺ did not mourn.’ <verse eid="MAT 11:17"/></para>

<para style="p"><verse number="18" style="v" sid="MAT 11:18"/>For John came neither eating nor drinking, and they say, ‘He has a demon!’ <verse eid="MAT 11:18"/></para>

<para style="p"><verse number="19" style="v" sid="MAT 11:19"/>The Son of Man came eating and drinking, and they say, ‘Behold, a man, a glutton and a drunkard, a friend of tax collectors and of sinners!’ But wisdom was justified from her works.<note caller="+" style="f"><char style="fr" closed="false">11.19 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">by her children</char></note>” <verse eid="MAT 11:19"/></para>

<para style="s">Woe to the UnrepentantLuke 10:13–16</para>

<para style="p"><verse number="20" style="v" sid="MAT 11:20"/>Then He began to reproach the cities in which most of His miracles happened, because they did not repent. <verse eid="MAT 11:20"/></para>

<para style="p"><verse number="21" style="v" sid="MAT 11:21"/><char style="wj">“Woe to you, Chorazin! Woe to you, Bethsaida! For if the miracles having happened in you⁺ had happened in Tyre and Sidon, long ago in</char><note caller="+" style="f"><char style="fr" closed="false">11.21 </char><char style="ft" closed="false"> GOC </char><char style="fq" closed="false">sitting in</char></note><char style="wj"> sackcloth and ashes they would have repented. </char><verse eid="MAT 11:21"/></para>

<para style="p"><verse number="22" style="v" sid="MAT 11:22"/><char style="wj">But I say to you⁺, for Tyre and Sidon it will be more bearable in the day of judgment than for you⁺. </char><verse eid="MAT 11:22"/></para>

<para style="p"><verse number="23" style="v" sid="MAT 11:23"/>And you, Capernaum, to heaven will you be lifted up? To Hades you will be brought down!<note caller="+" style="f"><char style="fr" closed="false">11.23 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">And you, Capernaum, which is lifted to heaven, will be brought down to Hades!</char></note> For if the miracles having happened in you had happened in Sodom, it would have remained until <char style="add">this</char> day. <verse eid="MAT 11:23"/></para>

<para style="p"><verse number="24" style="v" sid="MAT 11:24"/>But I say to you⁺ that it will be more bearable for the land of Sodom in the day of judgment than for you.” <verse eid="MAT 11:24"/></para>

<para style="s">Rest for the WearyLuke 10:21–24</para>

<para style="p"><verse number="25" style="v" sid="MAT 11:25"/>In that time, answering, Jesus said, <char style="wj">“I acknowledge You, Father, Lord of the heaven and of the earth, because You hid these things from the wise and intelligent, and You revealed them to little children. </char><verse eid="MAT 11:25"/></para>

<para style="p"><verse number="26" style="v" sid="MAT 11:26"/><char style="wj">Yes, Father, because of this it was good pleasure before You. </char><verse eid="MAT 11:26"/></para>

<para style="p"><verse number="27" style="v" sid="MAT 11:27"/>All things were delivered to Me by My Father. And no one knows the Son except the Father, nor does anyone know the Father except the Son and <char style="add">the one</char> to whom the Son may resolve to reveal <char style="add">Him</char>. <verse eid="MAT 11:27"/></para>

<para style="p"><verse number="28" style="v" sid="MAT 11:28"/>Come to Me, all those toiling and burdened, and I will give you⁺ rest. <verse eid="MAT 11:28"/></para>

<para style="p"><verse number="29" style="v" sid="MAT 11:29"/>Take up My yoke upon you⁺ and learn from Me, because I am gentle and humble <char style="add">in</char> heart, and you⁺ will find rest <char style="add">for</char> your⁺ souls. <verse eid="MAT 11:29"/></para>

<para style="p"><verse number="30" style="v" sid="MAT 11:30"/>For My yoke <char style="add">is</char> easy and My burden is light.” <verse eid="MAT 11:30"/></para>

<chapter eid="MAT 11"/>

<chapter number="12" style="c" sid="MAT 12"/>

<para style="s">The Lord of the Sabbath</para>

<para style="p"><verse number="1" style="v" sid="MAT 12:1"/><note caller="-" style="x"><char style="xt" closed="false">Luke 6:1–5</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 2:23–28</char></note><note caller="-" style="x"><char style="xt" closed="false">1 Samuel 21:1–7</char></note>At that time Jesus went through the grainfields on the Sabbaths, and His disciples were hungry, and they began to pluck the heads of grain and to eat. <verse eid="MAT 12:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 12:2"/>And the Pharisees, having seen, said to Him, “Behold, Your disciples do what it is not lawful to do on a Sabbath.” <verse eid="MAT 12:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 12:3"/>And He said to them, <char style="wj">“Did you⁺ not read what David did when he was hungry, and those with him— </char><verse eid="MAT 12:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 12:4"/><char style="wj">how he entered into the house of God, and they ate the loaves of the presentation,</char><note caller="+" style="f"><char style="fr" closed="false">12.4 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the Bread of the Presence</char></note><char style="wj"> which it was not lawful for him to eat, nor for those with him, except for the priests only? </char><verse eid="MAT 12:4"/></para>

<para style="p"><verse number="5" style="v" sid="MAT 12:5"/>Or did you⁺ not read in the Law that on the Sabbath the priests in the temple profane the Sabbath and are guiltless? <verse eid="MAT 12:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 12:6"/>But I say to you⁺ that a greater One than the temple is here. <verse eid="MAT 12:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 12:7"/>But if you⁺ had known what is ‘I desire mercy and not sacrifice,’ then you⁺ would not have condemned the guiltless. <note caller="+" style="f"><char style="fr" closed="false">12.7 </char><char style="ft" closed="false"> Hosea 6:6</char></note><verse eid="MAT 12:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 12:8"/>For the Son of Man is Lord of the<note caller="+" style="f"><char style="fr" closed="false">12.8 </char><char style="ft" closed="false"> GOC and TR </char><char style="fq" closed="false">even of the</char></note> Sabbath.” <verse eid="MAT 12:8"/></para>

<para style="s">Jesus Heals on the SabbathMark 3:1–6</para>

<para style="p"><verse number="9" style="v" sid="MAT 12:9"/><note caller="-" style="x"><char style="xt" closed="false">Luke 6:6–11</char></note>And having departed from there, He went into their synagogue. <verse eid="MAT 12:9"/></para>

<para style="p"><verse number="10" style="v" sid="MAT 12:10"/>And behold, a man having a withered hand, and they asked Him, saying, “Is it lawful to heal on the Sabbaths?” so that they might accuse Him. <verse eid="MAT 12:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 12:11"/>And He said to them, <char style="wj">“What man will there be of you⁺ who will have one sheep, and if this one should fall into a pit on the Sabbaths, will not take hold of it and will raise it up? </char><verse eid="MAT 12:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 12:12"/><char style="wj">How much more valuable, therefore, is a man than a sheep! Therefore it is lawful on the Sabbaths to do good.”</char> <verse eid="MAT 12:12"/></para>

<para style="p"><verse number="13" style="v" sid="MAT 12:13"/>Then He says to the man, <char style="wj">“Stretch out your hand.”</char> And he stretched <char style="add">it</char> out, and it was restored, sound as the other. <verse eid="MAT 12:13"/></para>

<para style="p"><verse number="14" style="v" sid="MAT 12:14"/>And the Pharisees, having gone out, took counsel against Him, how they might destroy Him. <verse eid="MAT 12:14"/></para>

<para style="s">God’s Chosen ServantIsaiah 42:1–9</para>

<para style="p"><verse number="15" style="v" sid="MAT 12:15"/>And Jesus, having known, withdrew from there. And many crowds followed Him,<note caller="+" style="f"><char style="fr" closed="false">12.15 </char><char style="ft" closed="false"> SBL and WH </char><char style="fq" closed="false">Many followed Him</char></note> and He healed them all, <verse eid="MAT 12:15"/></para>

<para style="p"><verse number="16" style="v" sid="MAT 12:16"/>and He warned them that they should not make Him known, <verse eid="MAT 12:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 12:17"/>so that it might be fulfilled, that having been spoken by Isaiah the prophet, saying: <verse eid="MAT 12:17"/></para>

<para style="q1"><verse number="18" style="v" sid="MAT 12:18"/>“Behold My servant, </para>

<para style="q2" vid="MAT 12:18">whom I chose, </para>

<para style="q1" vid="MAT 12:18">My Beloved, </para>

<para style="q2" vid="MAT 12:18">in whom My soul was well pleased. </para>

<para style="q1" vid="MAT 12:18">I will put My Spirit upon Him, </para>

<para style="q2" vid="MAT 12:18">and He will proclaim judgment to the nations. <verse eid="MAT 12:18"/></para>

<para style="q1"><verse number="19" style="v" sid="MAT 12:19"/>He will not quarrel, nor will He cry out; </para>

<para style="q2" vid="MAT 12:19">nor will anyone hear His voice in the streets. <verse eid="MAT 12:19"/></para>

<para style="q1"><verse number="20" style="v" sid="MAT 12:20"/>A bruised reed He will not break, </para>

<para style="q2" vid="MAT 12:20">and a smoldering wick He will not quench, </para>

<para style="q1" vid="MAT 12:20">until He should put forth judgment to victory. <verse eid="MAT 12:20"/></para>

<para style="q2"><verse number="21" style="v" sid="MAT 12:21"/>And in His name the nations will hope.” <note caller="+" style="f"><char style="fr" closed="false">12.21 </char><char style="ft" closed="false"> Isaiah 42:1–4 (see also LXX)</char></note><verse eid="MAT 12:21"/></para>

<para style="s">A House DividedMark 3:20–27</para>

<para style="p"><verse number="22" style="v" sid="MAT 12:22"/><note caller="-" style="x"><char style="xt" closed="false">Luke 11:14–23</char></note>Then was brought to Him one possessed by a demon, blind and mute, and He healed him, in order for the mute <char style="add">man</char><note caller="+" style="f"><char style="fr" closed="false">12.22 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">the blind and mute man</char></note> to speak and to see. <verse eid="MAT 12:22"/></para>

<para style="p"><verse number="23" style="v" sid="MAT 12:23"/>And all the crowds were amazed and were saying, “Is this the Son<note caller="+" style="f"><char style="fr" closed="false">12.23 </char><char style="ft" closed="false"> GOC and F35 </char><char style="fq" closed="false">the Christ, the Son</char></note> of David?” <verse eid="MAT 12:23"/></para>

<para style="p"><verse number="24" style="v" sid="MAT 12:24"/>And the Pharisees, having heard, said, “This <char style="add">man</char> does not cast out the demons except by Beelzebul,<note caller="+" style="f"><char style="fr" closed="false">12.24 </char><char style="ft" closed="false"> WH </char><char style="fq" closed="false">Beezeboul</char><char style="ft" closed="false">; Vulgate </char><char style="fq" closed="false">Beelzebub</char><char style="ft" closed="false">; also in verse 27</char></note> ruler of the demons.” <verse eid="MAT 12:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 12:25"/>And knowing their thoughts, He said to them, <char style="wj">“Every kingdom having been divided against itself is brought to desolation, and every city or house having been divided against itself will not stand. </char><verse eid="MAT 12:25"/></para>

<para style="p"><verse number="26" style="v" sid="MAT 12:26"/><char style="wj">And if Satan casts out Satan, he was divided against himself. How then will his kingdom stand? </char><verse eid="MAT 12:26"/></para>

<para style="p"><verse number="27" style="v" sid="MAT 12:27"/><char style="wj">And if I cast out demons by Beelzebul, by whom do your⁺ sons</char><note caller="+" style="f"><char style="fr" closed="false">12.27 </char><char style="ft" closed="false"> GOC </char><char style="fq" closed="false">will your sons</char></note><char style="wj"> cast them out? Because of this, they will be your⁺ judges. </char><verse eid="MAT 12:27"/></para>

<para style="p"><verse number="28" style="v" sid="MAT 12:28"/><char style="wj">But if I cast out demons by the Spirit of God, then the kingdom of God has come upon you⁺.</char> <verse eid="MAT 12:28"/></para>

<para style="p"><verse number="29" style="v" sid="MAT 12:29"/>Or how is anyone able to enter into the house of the strong <char style="add">man</char> and to plunder his goods, unless first he should bind the strong <char style="add">man</char>? And then he will plunder<note caller="+" style="f"><char style="fr" closed="false">12.29 </char><char style="ft" closed="false"> F35 </char><char style="fq" closed="false">can plunder</char></note> his house. <verse eid="MAT 12:29"/></para>

<para style="p"><verse number="30" style="v" sid="MAT 12:30"/>The one not being with Me is against Me, and the one not gathering with Me scatters. <verse eid="MAT 12:30"/></para>

<para style="s">The Unpardonable SinMark 3:28–30</para>

<para style="p"><verse number="31" style="v" sid="MAT 12:31"/>Because of this I say to you⁺, every sin and blasphemy will be forgiven men; but the blasphemy of the Spirit will not be forgiven.<note caller="+" style="f"><char style="fr" closed="false">12.31 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">will not be forgiven men</char></note> <verse eid="MAT 12:31"/></para>

<para style="p"><verse number="32" style="v" sid="MAT 12:32"/>And whoever may speak a word against the Son of Man, it will be forgiven him; but whoever may speak against the Holy Spirit, it will not be forgiven him—neither in this age<note caller="+" style="f"><char style="fr" closed="false">12.32 </char><char style="ft" closed="false"> BYZ </char><char style="fq" closed="false">the present age</char></note> nor in the coming one. <verse eid="MAT 12:32"/></para>

<para style="s">Good and Bad FruitLuke 6:43–45</para>

<para style="p"><verse number="33" style="v" sid="MAT 12:33"/>Either make the tree good and its fruit good, or make the tree rotten and its fruit rotten. For by the fruit, the tree is known. <verse eid="MAT 12:33"/></para>

<para style="p"><verse number="34" style="v" sid="MAT 12:34"/>Offspring of vipers, how are you⁺ able to speak good things, being evil? For out of the abundance of the heart, the mouth speaks. <verse eid="MAT 12:34"/></para>

<para style="p"><verse number="35" style="v" sid="MAT 12:35"/>The good man out of his good treasure<note caller="+" style="f"><char style="fr" closed="false">12.35 </char><char style="ft" closed="false"> TR includes </char><char style="fq" closed="false">of the heart</char><char style="ft" closed="false">.</char></note> puts forth good things, and the evil man out of his evil treasure puts forth evil things. <verse eid="MAT 12:35"/></para>

<para style="p"><verse number="36" style="v" sid="MAT 12:36"/>And I say to you⁺ that every careless word that men will speak, they will give an account concerning it in the day of judgment. <verse eid="MAT 12:36"/></para>

<para style="p"><verse number="37" style="v" sid="MAT 12:37"/>For by your words you will be justified, and by your words you will be condemned.” <verse eid="MAT 12:37"/></para>

<para style="s">The Sign of JonahJonah 3:1–10</para>

<para style="p"><verse number="38" style="v" sid="MAT 12:38"/><note caller="-" style="x"><char style="xt" closed="false">Luke 11:29–32</char></note>Then some of the scribes and Pharisees answered Him,<note caller="+" style="f"><char style="fr" closed="false">12.38 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">answered</char></note> saying, “Teacher, we want to see a sign from You.” <verse eid="MAT 12:38"/></para>

<para style="p"><verse number="39" style="v" sid="MAT 12:39"/>And answering, He said to them, <char style="wj">“An evil and adulterous generation seeks after a sign, and no sign will be given to it except the sign of Jonah the prophet. </char><verse eid="MAT 12:39"/></para>

<para style="p"><verse number="40" style="v" sid="MAT 12:40"/><char style="wj">For just as Jonah</char><note caller="+" style="f"><char style="fr" closed="false">12.40 </char><char style="ft" closed="false"> GOC </char><char style="fq" closed="false">Jonah the prophet</char></note><char style="wj"> was in the belly of the great fish three days and three nights, so the Son of Man will be in the heart of the earth three days and three nights. </char><verse eid="MAT 12:40"/></para>

<para style="p"><verse number="41" style="v" sid="MAT 12:41"/>The men of Nineveh will stand up in the judgment with this generation and will condemn it; for they repented at the preaching of Jonah, and behold, One greater<note caller="+" style="f"><char style="fr" closed="false">12.41 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">something greater</char><char style="ft" closed="false">; also in verse 42</char></note> than Jonah <char style="add">is</char> here. <verse eid="MAT 12:41"/></para>

<para style="p"><verse number="42" style="v" sid="MAT 12:42"/>The Queen of the South will rise up in the judgment with this generation and will condemn it; for she came from the ends of the earth to hear the wisdom of Solomon, and behold, One greater than Solomon is here. <verse eid="MAT 12:42"/></para>

<para style="s">An Unclean Spirit ReturnsLuke 11:24–26</para>

<para style="p"><verse number="43" style="v" sid="MAT 12:43"/>Now when the unclean spirit may go out from the man, it passes through waterless places seeking rest and does not find <char style="add">it</char>. <verse eid="MAT 12:43"/></para>

<para style="p"><verse number="44" style="v" sid="MAT 12:44"/>Then it says, ‘I will return to my house from which I came out.’ And having come, it finds <char style="add">it</char> being unoccupied, and swept, and put in order. <verse eid="MAT 12:44"/></para>

<para style="p"><verse number="45" style="v" sid="MAT 12:45"/>Then it goes and takes along with itself seven other spirits more evil than itself, and having entered, they dwell there; and the last of that man becomes worse than the first. So also will it be to this evil generation.” <verse eid="MAT 12:45"/></para>

<para style="s">Jesus’ Mother and BrothersMark 3:31–35</para>

<para style="p"><verse number="46" style="v" sid="MAT 12:46"/><note caller="-" style="x"><char style="xt" closed="false">Luke 8:19–21</char></note>Now <char style="add">in</char> His still speaking to the crowds, behold, His mother and brothers had stood outside, seeking to speak to Him. <verse eid="MAT 12:46"/></para>

<para style="p"><verse number="47" style="v" sid="MAT 12:47"/>And someone said to Him, “Behold, Your mother and Your brothers are standing outside, seeking to speak to You.”<note caller="+" style="f"><char style="fr" closed="false">12.47 </char><char style="ft" closed="false"> WH does not include verse 47.</char></note> <verse eid="MAT 12:47"/></para>

<para style="p"><verse number="48" style="v" sid="MAT 12:48"/>And answering, He said to the one speaking to Him, <char style="wj">“Who is My mother, and who are My brothers?”</char> <verse eid="MAT 12:48"/></para>

<para style="p"><verse number="49" style="v" sid="MAT 12:49"/>And having stretched out His hand to His disciples, He said, <char style="wj">“Behold, My mother and My brothers. </char><verse eid="MAT 12:49"/></para>

<para style="p"><verse number="50" style="v" sid="MAT 12:50"/><char style="wj">For whoever shall do the will of My Father who is in the heavens, he is My brother and sister and mother.”</char> <verse eid="MAT 12:50"/></para>

<chapter eid="MAT 12"/>

<chapter number="13" style="c" sid="MAT 13"/>

<para style="s">The Parable of the Sower</para>

<para style="p"><verse number="1" style="v" sid="MAT 13:1"/><note caller="-" style="x"><char style="xt" closed="false">Luke 8:4–8</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 4:1–9</char></note>In that day,<note caller="+" style="f"><char style="fr" closed="false">13.1 </char><char style="ft" closed="false"> RP and TR </char><char style="fq" closed="false">And in that day</char></note> Jesus, having gone out of the house, was sitting by the sea. <verse eid="MAT 13:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 13:2"/>And many crowds were gathered together to Him so that He, having entered into a boat,<note caller="+" style="f"><char style="fr" closed="false">13.2 </char><char style="ft" closed="false"> RP and TR </char><char style="fq" closed="false">into the boat</char></note> sat down, and all the crowd stood on the shore. <verse eid="MAT 13:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 13:3"/>And He spoke to them many things in parables, saying, <char style="wj">“Behold, the one sowing went out to sow. </char><verse eid="MAT 13:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 13:4"/><char style="wj">And in his sowing, some indeed fell along the path, and the birds, having come, devoured them. </char><verse eid="MAT 13:4"/></para>

<para style="p"><verse number="5" style="v" sid="MAT 13:5"/>And others fell upon the rocky <char style="add">places</char>, where it did not have much soil, and immediately it sprang up because of it not having depth of soil. <verse eid="MAT 13:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 13:6"/>And the sun having risen, they were scorched, and because of not having root, they withered. <verse eid="MAT 13:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 13:7"/>And others fell upon the thorns, and the thorns came up and choked them. <verse eid="MAT 13:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 13:8"/>And others fell upon the good soil and were giving fruit—some indeed a hundredfold, and some sixty, and some thirty. <verse eid="MAT 13:8"/></para>

<para style="p"><verse number="9" style="v" sid="MAT 13:9"/>The one having ears,<note caller="+" style="f"><char style="fr" closed="false">13.9 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">ears to hear</char><char style="ft" closed="false">; also in verse 43</char></note> let him hear.” <verse eid="MAT 13:9"/></para>

<para style="s">The Purpose of Jesus’ ParablesIsaiah 6:1–13</para>

<para style="p"><verse number="10" style="v" sid="MAT 13:10"/><note caller="-" style="x"><char style="xt" closed="false">Luke 8:9–10</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 4:10–12</char></note>And having come, the disciples said to Him, “Why do You speak to them in parables?” <verse eid="MAT 13:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 13:11"/>And answering, He said to them, <char style="wj">“Because to you⁺ it has been given to know the mysteries of the kingdom of the heavens, but to these it has not been given. </char><verse eid="MAT 13:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 13:12"/><char style="wj">For whoever has, it will be given to him, and he will be in abundance. And whoever does not have, even what he has will be taken away from him. </char><verse eid="MAT 13:12"/></para>

<para style="p"><verse number="13" style="v" sid="MAT 13:13"/><char style="wj">Because of this I speak to them in parables:</char> </para>

<para style="q1" vid="MAT 13:13">‘Because seeing, they do not see, </para>

<para style="q2" vid="MAT 13:13">and hearing, they do not hear, nor do they understand.’<note caller="+" style="f"><char style="fr" closed="false">13.13 </char><char style="ft" closed="false"> See Deuteronomy 29:4, Isaiah 42:20, Jeremiah 5:21, and Ezekiel 12:2.</char></note> <verse eid="MAT 13:13"/></para>

<para style="p"><verse number="14" style="v" sid="MAT 13:14"/>And in them is fulfilled the prophecy of Isaiah, saying: </para>

<para style="q1" vid="MAT 13:14">‘In hearing you⁺ will hear and never understand; </para>

<para style="q2" vid="MAT 13:14">and seeing, you⁺ will see and never perceive. <verse eid="MAT 13:14"/></para>

<para style="q1"><verse number="15" style="v" sid="MAT 13:15"/>For the heart of this people grew dull, </para>

<para style="q2" vid="MAT 13:15">and they barely hear with the ears, </para>

<para style="q2" vid="MAT 13:15">and they closed their eyes, </para>

<para style="q1" vid="MAT 13:15">lest ever they might see with the eyes, </para>

<para style="q2" vid="MAT 13:15">and might hear with the ears, </para>

<para style="q2" vid="MAT 13:15">and might understand with the heart, </para>

<para style="q1" vid="MAT 13:15">and might return, and I will heal them.’ <note caller="+" style="f"><char style="fr" closed="false">13.15 </char><char style="ft" closed="false"> Isaiah 6:9–10 (see also LXX)</char></note><verse eid="MAT 13:15"/></para>

<para style="p"><verse number="16" style="v" sid="MAT 13:16"/>But blessed <char style="add">are</char> your⁺ eyes because they see, and your⁺ ears because they hear. <verse eid="MAT 13:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 13:17"/>For truly I say to you⁺ that many prophets and righteous <char style="add">men</char> desired to see what you⁺ see and did not see, and to hear what you⁺ hear and did not hear. <verse eid="MAT 13:17"/></para>

<para style="s">The Parable of the Sower ExplainedMark 4:13–20</para>

<para style="p"><verse number="18" style="v" sid="MAT 13:18"/><note caller="-" style="x"><char style="xt" closed="false">Luke 8:11–15</char></note>You⁺, therefore, hear the parable of the one having sown: <verse eid="MAT 13:18"/></para>

<para style="p"><verse number="19" style="v" sid="MAT 13:19"/>Everyone hearing the word of the kingdom and not understanding, the evil one comes and snatches away that having been sown in his heart. This is the one having been sown<note caller="+" style="f"><char style="fr" closed="false">13.19 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the seed sown</char><char style="ft" closed="false">; also in verses 20, 22, and 23</char></note> along the path. <verse eid="MAT 13:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 13:20"/>And that having been sown upon the rocky <char style="add">places</char>, this is the one hearing the word and immediately receiving<note caller="+" style="f"><char style="fr" closed="false">13.20 </char><char style="ft" closed="false"> GOC </char><char style="fq" closed="false">accepting and receiving</char></note> it with joy. <verse eid="MAT 13:20"/></para>

<para style="p"><verse number="21" style="v" sid="MAT 13:21"/>And he has no root in himself, but is temporary. But <char style="add">on</char> tribulation or persecution having come because of the word, immediately he is caused to stumble. <verse eid="MAT 13:21"/></para>

<para style="p"><verse number="22" style="v" sid="MAT 13:22"/>And that having been sown among the thorns, this is the one hearing the word, and the anxiety of this age and the deceit of riches choke the word, and it becomes unfruitful. <verse eid="MAT 13:22"/></para>

<para style="p"><verse number="23" style="v" sid="MAT 13:23"/>But that having been sown on the good soil, this is the one hearing the word and understanding, who indeed bears fruit and produces—some indeed a hundredfold, and some sixty, and some thirty.” <verse eid="MAT 13:23"/></para>

<para style="s">The Parable of the WeedsEzekiel 17:1–10</para>

<para style="p"><verse number="24" style="v" sid="MAT 13:24"/>He put before them another parable, saying, <char style="wj">“The kingdom of the heavens was likened to a man having sown good seed in his field. </char><verse eid="MAT 13:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 13:25"/><char style="wj">And while the men are sleeping, his enemy came and sowed weeds in the midst of the wheat, and went away. </char><verse eid="MAT 13:25"/></para>

<para style="p"><verse number="26" style="v" sid="MAT 13:26"/><char style="wj">And when the plants sprouted and produced fruit, then the weeds also appeared. </char><verse eid="MAT 13:26"/></para>

<para style="p"><verse number="27" style="v" sid="MAT 13:27"/>And having come, the servants of the master of the house said to him, ‘Sir, did you not sow good seed in your field? From where, then, does it have weeds?’ <verse eid="MAT 13:27"/></para>

<para style="p"><verse number="28" style="v" sid="MAT 13:28"/>And he said to them, ‘An enemy did this.’ </para>

<para style="p" vid="MAT 13:28">And the servants said to him, ‘Then do you desire <char style="add">that</char>, having gone away, we should collect them?’ <verse eid="MAT 13:28"/></para>

<para style="p"><verse number="29" style="v" sid="MAT 13:29"/>And he said, ‘No, lest collecting the weeds, you⁺ might uproot the wheat with them. <verse eid="MAT 13:29"/></para>

<para style="p"><verse number="30" style="v" sid="MAT 13:30"/>Allow both to grow together until the harvest, and in the time of the harvest I will say to the harvesters: First collect the weeds and bind them into bundles in order to burn them up; but gather together the wheat into my barn.’” <verse eid="MAT 13:30"/></para>

<para style="s">The Parable of the Mustard SeedMark 4:30–34</para>

<para style="p"><verse number="31" style="v" sid="MAT 13:31"/><note caller="-" style="x"><char style="xt" closed="false">Luke 13:18–19</char></note>He put before them another parable, saying: <char style="wj">“The kingdom of the heavens is like a grain of mustard, which a man, having taken, sowed in his field, </char><verse eid="MAT 13:31"/></para>

<para style="p"><verse number="32" style="v" sid="MAT 13:32"/><char style="wj">which indeed is smallest of all the seeds, but when it may be grown, it is greater than the garden plants</char><note caller="+" style="f"><char style="fr" closed="false">13.32 </char><char style="ft" closed="false"> GOC and F35 </char><char style="fq" closed="false">all the garden plants</char></note><char style="wj"> and becomes a tree, so as for the birds of the sky to come and to lodge in its branches.”</char> <verse eid="MAT 13:32"/></para>

<para style="s">The Parable of the LeavenLuke 13:20–21</para>

<para style="p"><verse number="33" style="v" sid="MAT 13:33"/>He spoke to them another parable: <char style="wj">“The kingdom of the heavens is like leaven that a woman, having taken, hid in three measures of flour, until all of it was leavened.”</char> <verse eid="MAT 13:33"/></para>

<para style="s">I Will Open My Mouth in ParablesPsalm 78:1–72</para>

<para style="p"><verse number="34" style="v" sid="MAT 13:34"/>All these things Jesus spoke in parables to the crowds, and without a parable He was not speaking to them, <verse eid="MAT 13:34"/></para>

<para style="p"><verse number="35" style="v" sid="MAT 13:35"/>so that it might be fulfilled, that having been spoken through the prophet, saying: </para>

<para style="q1" vid="MAT 13:35">“I will open My mouth in parables; </para>

<para style="q2" vid="MAT 13:35">I will utter things hidden from the foundation <char style="add">of</char> the world.” <note caller="+" style="f"><char style="fr" closed="false">13.35 </char><char style="ft" closed="false"> Psalm 78:2 (see also LXX); SBL, NE, and WH do not include </char><char style="fq" closed="false">of the world</char><char style="ft" closed="false">.</char></note><verse eid="MAT 13:35"/></para>

<para style="s">The Parable of the Weeds ExplainedZephaniah 1:1–6</para>

<para style="p"><verse number="36" style="v" sid="MAT 13:36"/>Then, having dismissed the crowds, He went into the house.<note caller="+" style="f"><char style="fr" closed="false">13.36 </char><char style="ft" closed="false"> GOC </char><char style="fq" closed="false">His house</char></note> And His disciples came to Him, saying, “Explain to us the parable of the weeds of the field.” <verse eid="MAT 13:36"/></para>

<para style="p"><verse number="37" style="v" sid="MAT 13:37"/>And answering, He said, <char style="wj">“The One sowing the good seed is the Son of Man; </char><verse eid="MAT 13:37"/></para>

<para style="p"><verse number="38" style="v" sid="MAT 13:38"/><char style="wj">and the field is the world; and the good seed, these are the sons of the kingdom; and the weeds are the sons of the evil one; </char><verse eid="MAT 13:38"/></para>

<para style="p"><verse number="39" style="v" sid="MAT 13:39"/><char style="wj">and the enemy having sown them is the devil; and the harvest is the consummation of the age; and the harvesters are angels. </char><verse eid="MAT 13:39"/></para>

<para style="p"><verse number="40" style="v" sid="MAT 13:40"/>Therefore, as the weeds are gathered together and are burned up in fire, so will it be in the consummation of the age.<note caller="+" style="f"><char style="fr" closed="false">13.40 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">of this age</char></note> <verse eid="MAT 13:40"/></para>

<para style="p"><verse number="41" style="v" sid="MAT 13:41"/>The Son of Man will send forth His angels, and they will gather out of His kingdom all the stumbling blocks and those doing lawlessness, <verse eid="MAT 13:41"/></para>

<para style="p"><verse number="42" style="v" sid="MAT 13:42"/>and they will cast them into the furnace of the fire—there will be weeping and gnashing of the teeth. <verse eid="MAT 13:42"/></para>

<para style="p"><verse number="43" style="v" sid="MAT 13:43"/>Then the righteous will shine forth as the sun in the kingdom of their Father. </para>

<para style="p" vid="MAT 13:43">The one having ears, let him hear. <note caller="+" style="f"><char style="fr" closed="false">13.43 </char><char style="ft" closed="false"> See Daniel 12:3.</char></note><verse eid="MAT 13:43"/></para>

<para style="s">The Parables of the Treasure and the Pearl</para>

<para style="p"><verse number="44" style="v" sid="MAT 13:44"/>The kingdom<note caller="+" style="f"><char style="fr" closed="false">13.44 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">Again, the kingdom</char></note> of the heavens is like treasure hidden in the field, which a man, having found, hid. And from his joy, he goes and he sells all that he has, and he buys that field. <verse eid="MAT 13:44"/></para>

<para style="p"><verse number="45" style="v" sid="MAT 13:45"/>Again, the kingdom of the heavens is like a man, a merchant, seeking fine pearls. <verse eid="MAT 13:45"/></para>

<para style="p"><verse number="46" style="v" sid="MAT 13:46"/>And having found one very precious pearl, having gone away, he has sold all things, as many as he had, and bought it. <verse eid="MAT 13:46"/></para>

<para style="s">The Parable of the Net</para>

<para style="p"><verse number="47" style="v" sid="MAT 13:47"/>Again, the kingdom of the heavens is like a dragnet having been cast into the sea and having gathered together of every kind, <verse eid="MAT 13:47"/></para>

<para style="p"><verse number="48" style="v" sid="MAT 13:48"/>which, when it was filled, having drawn <char style="add">it</char> up on the shore and having sat down, they collected the good into vessels, and they cast out the bad. <verse eid="MAT 13:48"/></para>

<para style="p"><verse number="49" style="v" sid="MAT 13:49"/>So will it be in the consummation of the age: The angels will go out and will separate the evil from the midst of the righteous <verse eid="MAT 13:49"/></para>

<para style="p"><verse number="50" style="v" sid="MAT 13:50"/>and will cast them into the furnace of the fire—there will be weeping and gnashing of the teeth. <verse eid="MAT 13:50"/></para>

<para style="p"><verse number="51" style="v" sid="MAT 13:51"/>Did you⁺ understand all these things?<note caller="+" style="f"><char style="fr" closed="false">13.51 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">Jesus asked them</char><char style="ft" closed="false">.</char></note>” </para>

<para style="p" vid="MAT 13:51">They say to Him, “Yes.<note caller="+" style="f"><char style="fr" closed="false">13.51 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">Yes, Lord</char></note>” <verse eid="MAT 13:51"/></para>

<para style="p"><verse number="52" style="v" sid="MAT 13:52"/>And He said to them, <char style="wj">“Because of this, every scribe having been discipled in the kingdom of the heavens is like a man, a master of a house, who puts forth out of his treasure new and old.”</char> <verse eid="MAT 13:52"/></para>

<para style="s">The Rejection at NazarethMark 6:1–6</para>

<para style="p"><verse number="53" style="v" sid="MAT 13:53"/><note caller="-" style="x"><char style="xt" closed="false">Luke 4:16–30</char></note>And it came to pass, when Jesus finished these parables, <char style="add">that</char> He withdrew from there. <verse eid="MAT 13:53"/></para>

<para style="p"><verse number="54" style="v" sid="MAT 13:54"/>And having come into His hometown, He was teaching them in their synagogue, so that they are astonished and are saying, “From where unto this One <char style="add">is</char> this wisdom and the miracles?” <verse eid="MAT 13:54"/></para>

<para style="p"><verse number="55" style="v" sid="MAT 13:55"/>Is this not the son of the carpenter? <char style="add">Is</char> not His mother called Mary, and His brothers James and Joseph and Simon and Judas? <note caller="+" style="f"><char style="fr" closed="false">13.55 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">Joses</char><char style="ft" closed="false">; see Mark 6:3.</char></note><verse eid="MAT 13:55"/></para>

<para style="p"><verse number="56" style="v" sid="MAT 13:56"/>And are not all His sisters with us? Then from where <char style="add">are</char> unto this One all these things?” <verse eid="MAT 13:56"/></para>

<para style="p"><verse number="57" style="v" sid="MAT 13:57"/>And they were taking offense at Him. But Jesus said to them, <char style="wj">“A prophet is not without honor, except in his hometown and in his house.”</char> <verse eid="MAT 13:57"/></para>

<para style="p"><verse number="58" style="v" sid="MAT 13:58"/>And He did not do many miracles there, because of their unbelief. <verse eid="MAT 13:58"/></para>

<chapter eid="MAT 13"/>

<chapter number="14" style="c" sid="MAT 14"/>

<para style="s">The Beheading of John</para>

<para style="p"><verse number="1" style="v" sid="MAT 14:1"/><note caller="-" style="x"><char style="xt" closed="false">Luke 9:7–9</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 6:14–29</char></note>At that time Herod the tetrarch heard the news of Jesus, <verse eid="MAT 14:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 14:2"/>and he said to his servants, “This is John the Baptist; he was raised from the dead! And because of this, the miraculous powers are working in him.” <verse eid="MAT 14:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 14:3"/>For Herod, having seized John, bound him and put <char style="add">him</char> in prison because of Herodias, the wife of Philip his brother. <verse eid="MAT 14:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 14:4"/>For John was saying to him, “It is not lawful for you to have her.” <verse eid="MAT 14:4"/></para>

<para style="p"><verse number="5" style="v" sid="MAT 14:5"/>And wanting to kill him, he feared the crowd, because they were holding him as a prophet. <verse eid="MAT 14:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 14:6"/>But the birthday of Herod having come,<note caller="+" style="f"><char style="fr" closed="false">14.6 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">When Herod's birthday was being celebrated</char></note> the daughter of Herodias danced in the midst and pleased Herod, <verse eid="MAT 14:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 14:7"/>whereupon he promised with an oath to give to her whatever she might ask. <verse eid="MAT 14:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 14:8"/>And having been urged on by her mother, she says, “Give to me here upon a platter the head of John the Baptist.” <verse eid="MAT 14:8"/></para>

<para style="p"><verse number="9" style="v" sid="MAT 14:9"/>And the king, having been made sorrowful because of the oaths and those reclining with <char style="add">him</char>, commanded <char style="add">it</char> to be given. <verse eid="MAT 14:9"/></para>

<para style="p"><verse number="10" style="v" sid="MAT 14:10"/>And having sent, he beheaded John in the prison. <verse eid="MAT 14:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 14:11"/>And his head was brought on a platter and was given to the girl, and she brought <char style="add">it</char> to her mother. <verse eid="MAT 14:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 14:12"/>And having come, his disciples took up the body and buried it. And having come, they reported <char style="add">it</char> to Jesus. <verse eid="MAT 14:12"/></para>

<para style="s">The Feeding of the Five ThousandMark 6:30–44</para>

<para style="p"><verse number="13" style="v" sid="MAT 14:13"/><note caller="-" style="x"><char style="xt" closed="false">John 6:1–15</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 9:10–17</char></note>And having heard, Jesus withdrew from there in a boat to a wilderness place by Himself. And having heard, the crowds followed Him on foot from the cities. <verse eid="MAT 14:13"/></para>

<para style="p"><verse number="14" style="v" sid="MAT 14:14"/>And having gone out, He saw<note caller="+" style="f"><char style="fr" closed="false">14.14 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">And Jesus, having gone out, saw</char></note> a great crowd and was moved with compassion toward them, and He healed their sick. <verse eid="MAT 14:14"/></para>

<para style="p"><verse number="15" style="v" sid="MAT 14:15"/>And evening having come, the disciples<note caller="+" style="f"><char style="fr" closed="false">14.15 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">His disciples</char></note> came to Him, saying, “This place is desolate, and the time already is gone by. Therefore dismiss the crowds so that, having gone to the villages, they might buy food for themselves.” <verse eid="MAT 14:15"/></para>

<para style="p"><verse number="16" style="v" sid="MAT 14:16"/>But Jesus said to them, <char style="wj">“They have no need to go away. You⁺ give them something to eat.”</char> <verse eid="MAT 14:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 14:17"/>And they say to Him, “We have nothing here except five loaves and two fish.” <verse eid="MAT 14:17"/></para>

<para style="p"><verse number="18" style="v" sid="MAT 14:18"/>And He said, <char style="wj">“Bring them here to Me.”</char> <verse eid="MAT 14:18"/></para>

<para style="p"><verse number="19" style="v" sid="MAT 14:19"/>And having commanded the crowds to sit down on the grass, having taken the five loaves and the two fish, having looked up to the heaven, He blessed. And having broken, He gave the loaves to the disciples, and the disciples to the crowds. <verse eid="MAT 14:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 14:20"/>And all ate and were satisfied, and they took up the superabounding of the fragments, twelve hand-baskets full. <verse eid="MAT 14:20"/></para>

<para style="p"><verse number="21" style="v" sid="MAT 14:21"/>And those eating were about five thousand men, apart from women and children. <verse eid="MAT 14:21"/></para>

<para style="s">Jesus Walks on WaterMark 6:45–52</para>

<para style="p"><verse number="22" style="v" sid="MAT 14:22"/><note caller="-" style="x"><char style="xt" closed="false">John 6:16–21</char></note>And immediately He compelled<note caller="+" style="f"><char style="fr" closed="false">14.22 </char><char style="ft" closed="false"> RP and TR </char><char style="fq" closed="false">Jesus compelled</char></note> the disciples<note caller="+" style="f"><char style="fr" closed="false">14.22 </char><char style="ft" closed="false"> RP and CT </char><char style="fq" closed="false">His disciples</char></note> to enter into the boat and to go before Him to the other side, until He might dismiss the crowds. <verse eid="MAT 14:22"/></para>

<para style="p"><verse number="23" style="v" sid="MAT 14:23"/>And having dismissed the crowds, He went up on the mountain by Himself to pray. And evening having come, He was there alone, <verse eid="MAT 14:23"/></para>

<para style="p"><verse number="24" style="v" sid="MAT 14:24"/>and the boat, being now many stadia from the land,<note caller="+" style="f"><char style="fr" closed="false">14.24 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">far from the land</char><char style="ft" closed="false">; a stadion was about 607 feet or 185 meters; BYZ and TR </char><char style="fq" closed="false">being now in the midst of the sea</char><char style="ft" closed="false">.</char></note> is distressed by the waves, for the wind was contrary. <verse eid="MAT 14:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 14:25"/>And in the fourth watch of the night<note caller="+" style="f"><char style="fr" closed="false">14.25 </char><char style="ft" closed="false"> That is, between three and six in the morning</char></note> He went to them, walking on the sea. <verse eid="MAT 14:25"/></para>

<para style="p"><verse number="26" style="v" sid="MAT 14:26"/>And the disciples, having seen Him walking on the sea, were troubled, saying, “It is a ghost!” And they cried out in fear. <verse eid="MAT 14:26"/></para>

<para style="p"><verse number="27" style="v" sid="MAT 14:27"/>But immediately Jesus spoke to them, saying, <char style="wj">“Take courage! I am He! Do not”</char> be afraid. <verse eid="MAT 14:27"/></para>

<para style="p"><verse number="28" style="v" sid="MAT 14:28"/>And answering Him, Peter said, “Lord, if You are <char style="add">He</char>, command me to come to You on the waters.” <verse eid="MAT 14:28"/></para>

<para style="p"><verse number="29" style="v" sid="MAT 14:29"/>And He said, <char style="wj">“Come.”</char> And having gone down from the boat, Peter walked on the waters and came to Jesus. <verse eid="MAT 14:29"/></para>

<para style="p"><verse number="30" style="v" sid="MAT 14:30"/>And seeing the strong wind,<note caller="+" style="f"><char style="fr" closed="false">14.30 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">But when he saw the strength of the wind</char><char style="ft" closed="false">; NE and WH do not include </char><char style="fq" closed="false">strong</char><char style="ft" closed="false">.</char></note> he was afraid, and having begun to sink, he cried out, saying, “Lord, save me!” <verse eid="MAT 14:30"/></para>

<para style="p"><verse number="31" style="v" sid="MAT 14:31"/>And immediately Jesus, having stretched out the hand, took hold of him and says to him, <char style="wj">“O little of faith, why did you waver?”</char> <verse eid="MAT 14:31"/></para>

<para style="p"><verse number="32" style="v" sid="MAT 14:32"/>And they having gone up into the boat, the wind abated. <verse eid="MAT 14:32"/></para>

<para style="p"><verse number="33" style="v" sid="MAT 14:33"/>And those in the boat worshiped<note caller="+" style="f"><char style="fr" closed="false">14.33 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">came and worshiped</char></note> Him, saying, “Truly You are God's Son!” <verse eid="MAT 14:33"/></para>

<para style="s">Jesus Heals at GennesaretMark 6:53–56</para>

<para style="p"><verse number="34" style="v" sid="MAT 14:34"/>And having crossed over, they came to the land of Gennesaret. <verse eid="MAT 14:34"/></para>

<para style="p"><verse number="35" style="v" sid="MAT 14:35"/>And having recognized Him, the men of that place sent to all that surrounding region, and they brought to Him all those being ill, <verse eid="MAT 14:35"/></para>

<para style="p"><verse number="36" style="v" sid="MAT 14:36"/>and they were imploring Him that they might only touch the fringe of His garment. And as many as touched were saved. <verse eid="MAT 14:36"/></para>

<chapter eid="MAT 14"/>

<chapter number="15" style="c" sid="MAT 15"/>

<para style="s">The Tradition of the Elders</para>

<para style="p"><verse number="1" style="v" sid="MAT 15:1"/><note caller="-" style="x"><char style="xt" closed="false">Mark 7:1–13</char></note>Then Pharisees and scribes<note caller="+" style="f"><char style="fr" closed="false">15.1 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">scribes and Pharisees</char></note> come to Jesus from Jerusalem, saying, <verse eid="MAT 15:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 15:2"/>“Why do Your disciples transgress the tradition of the elders? For they do not wash their hands when they shall eat bread.” <verse eid="MAT 15:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 15:3"/>And answering, He said to them, <char style="wj">“Why also do you⁺ transgress the commandment of God because of your⁺ tradition? </char><verse eid="MAT 15:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 15:4"/><char style="wj">For God said, ‘Honor your father and mother’</char><note caller="+" style="f"><char style="fr" closed="false">15.4 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">For God commanded, saying</char></note><char style="wj"> and ‘The one speaking evil of father or mother, in death let him end.’</char><note caller="+" style="f"><char style="fr" closed="false">15.4 </char><char style="ft" closed="false"> Exodus 20:12; Deuteronomy 5:16</char></note><char style="wj"> </char><note caller="+" style="f"><char style="fr" closed="false">15.4 </char><char style="ft" closed="false"> Exodus 21:17; Leviticus 20:9</char></note><verse eid="MAT 15:4"/></para>

<para style="p"><verse number="5" style="v" sid="MAT 15:5"/><char style="wj">But you⁺ say, ‘Whoever might say to father or mother: Whatever you might be profited by me is a gift,’ </char><verse eid="MAT 15:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 15:6"/><char style="wj">he shall not honor</char><note caller="+" style="f"><char style="fr" closed="false">15.6 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">then he shall not honor</char></note><char style="wj"> his father or his mother.</char><note caller="+" style="f"><char style="fr" closed="false">15.6 </char><char style="ft" closed="false"> NE and TR (see also Mark 7:12); or </char><char style="fq" closed="false">he need not honor his father or his mother with it</char><char style="ft" closed="false">; SBL, NA, WH, and BYZ do not include </char><char style="fq" closed="false">or his mother</char><char style="ft" closed="false">.</char></note><char style="wj"> And you⁺ made void the word</char><note caller="+" style="f"><char style="fr" closed="false">15.6 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">the commandment</char></note><char style="wj"> of God because of your⁺ tradition. </char><verse eid="MAT 15:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 15:7"/><char style="wj">Hypocrites! Isaiah prophesied correctly about you⁺, saying: </char><verse eid="MAT 15:7"/></para>

<para style="q1"><verse number="8" style="v" sid="MAT 15:8"/>‘This people honors Me with the lips, </para>

<para style="q2" vid="MAT 15:8">but their heart is kept far away from Me; <note caller="+" style="f"><char style="fr" closed="false">15.8 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">This people draws near to Me with their mouth and honors</char></note><verse eid="MAT 15:8"/></para>

<para style="q1"><verse number="9" style="v" sid="MAT 15:9"/>and in vain they worship Me, </para>

<para style="q2" vid="MAT 15:9">teaching <char style="add">as</char> teachings the precepts of men.’<note caller="+" style="f"><char style="fr" closed="false">15.9 </char><char style="ft" closed="false"> Isaiah 29:13 (see also LXX)</char></note>” <verse eid="MAT 15:9"/></para>

<para style="s">What Defiles a ManMark 7:14–23</para>

<para style="p"><verse number="10" style="v" sid="MAT 15:10"/>And having summoned the crowd, He said to them, <char style="wj">“Hear and understand. </char><verse eid="MAT 15:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 15:11"/><char style="wj">Not what is entering into the mouth defiles the man; but what is proceeding out of the mouth, this defiles the man.”</char> <verse eid="MAT 15:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 15:12"/>Then the disciples,<note caller="+" style="f"><char style="fr" closed="false">15.12 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">His disciples</char><char style="ft" closed="false">; similarly in verses 33 and 36</char></note> having come, said to Him, “Do You know that the Pharisees, having heard the saying, were offended?” <verse eid="MAT 15:12"/></para>

<para style="p"><verse number="13" style="v" sid="MAT 15:13"/>And answering, He said, <char style="wj">“Every plant that My heavenly Father did not plant will be uprooted. </char><verse eid="MAT 15:13"/></para>

<para style="p"><verse number="14" style="v" sid="MAT 15:14"/><char style="wj">Leave them! They are blind guides of the blind.</char><note caller="+" style="f"><char style="fr" closed="false">15.14 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">blind guides</char></note><char style="wj"> And if the blind may guide the blind, both will fall into a pit.”</char> <verse eid="MAT 15:14"/></para>

<para style="p"><verse number="15" style="v" sid="MAT 15:15"/>And answering, Peter said to Him, “Explain to us this<note caller="+" style="f"><char style="fr" closed="false">15.15 </char><char style="ft" closed="false"> TH and WH </char><char style="fq" closed="false">the</char></note> parable.” <verse eid="MAT 15:15"/></para>

<para style="p"><verse number="16" style="v" sid="MAT 15:16"/>And He said, <char style="wj">“Are you⁺ also still without understanding? </char><verse eid="MAT 15:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 15:17"/><char style="wj">Do you⁺ not perceive</char><note caller="+" style="f"><char style="fr" closed="false">15.17 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">Do you not yet perceive</char></note><char style="wj"> that everything entering into the mouth goes into the belly and is cast out into the sewer? </char><verse eid="MAT 15:17"/></para>

<para style="p"><verse number="18" style="v" sid="MAT 15:18"/><char style="wj">But the things proceeding out of the mouth come forth out of the heart, and these defile the man. </char><verse eid="MAT 15:18"/></para>

<para style="p"><verse number="19" style="v" sid="MAT 15:19"/><char style="wj">For out of the heart come forth evil thoughts, murders, adulteries, sexual immorality, thefts, false testimonies, slanders. </char><verse eid="MAT 15:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 15:20"/><char style="wj">These are the things defiling the man, but to eat with unwashed hands does not defile the man.”</char> <verse eid="MAT 15:20"/></para>

<para style="s">The Faith of the Canaanite WomanMark 7:24–30</para>

<para style="p"><verse number="21" style="v" sid="MAT 15:21"/>And having gone out from there, Jesus withdrew to the parts of Tyre and Sidon. <verse eid="MAT 15:21"/></para>

<para style="p"><verse number="22" style="v" sid="MAT 15:22"/>And behold, a Canaanite woman from those borders, having come out, was crying out,<note caller="+" style="f"><char style="fr" closed="false">15.22 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">to Him</char><char style="ft" closed="false">.</char></note> saying, “Have mercy on me, Lord, Son of David! My daughter is miserably possessed by a demon.” <verse eid="MAT 15:22"/></para>

<para style="p"><verse number="23" style="v" sid="MAT 15:23"/>But He did not answer her a word. And having come, His disciples were imploring Him, saying, “Dismiss her, because she cries out after us.” <verse eid="MAT 15:23"/></para>

<para style="p"><verse number="24" style="v" sid="MAT 15:24"/>And answering, He said, <char style="wj">“I was not sent, except to the lost sheep of the house of Israel.”</char> <verse eid="MAT 15:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 15:25"/>And having come, she was worshiping Him, saying, “Lord, help me!” <verse eid="MAT 15:25"/></para>

<para style="p"><verse number="26" style="v" sid="MAT 15:26"/>And answering, He said, <char style="wj">“It is not good to take the bread of the children and to cast it to the dogs.</char><note caller="+" style="f"><char style="fr" closed="false">15.26 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">puppies</char><char style="ft" closed="false">; also in verse 27</char></note><char style="wj">”</char> <verse eid="MAT 15:26"/></para>

<para style="p"><verse number="27" style="v" sid="MAT 15:27"/>And she said, “Yes, Lord, for even the dogs eat from the crumbs falling from the table of their masters.” <verse eid="MAT 15:27"/></para>

<para style="p"><verse number="28" style="v" sid="MAT 15:28"/>“Then answering, Jesus said to her, <char style="wj">“O woman, great is your faith! Let it be to you as you desire.”</char> And her daughter was healed from that hour. <verse eid="MAT 15:28"/></para>

<para style="s">The Feeding of the Four Thousand2 Kings 4:42–44</para>

<para style="p"><verse number="29" style="v" sid="MAT 15:29"/><note caller="-" style="x"><char style="xt" closed="false">Mark 8:1–10</char></note>And having departed from there, Jesus went along the Sea of Galilee. And having gone up on the mountain, He was sitting there. <verse eid="MAT 15:29"/></para>

<para style="p"><verse number="30" style="v" sid="MAT 15:30"/>And many crowds came to Him, having with them the lame, the crippled, the blind, the mute,<note caller="+" style="f"><char style="fr" closed="false">15.30 </char><char style="ft" closed="false"> NA </char><char style="fq" closed="false">the lame, the blind, the crippled, the mute</char><char style="ft" closed="false">; other CT vary in order.</char></note> and many others. And they cast them at His feet,<note caller="+" style="f"><char style="fr" closed="false">15.30 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">at Jesus’ feet</char></note> and He healed them, <verse eid="MAT 15:30"/></para>

<para style="p"><verse number="31" style="v" sid="MAT 15:31"/>so that the crowd<note caller="+" style="f"><char style="fr" closed="false">15.31 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">crowds</char></note> marveled, seeing the mute speaking, the crippled restored, and the lame walking, and the blind seeing. And they glorified the God of Israel. <verse eid="MAT 15:31"/></para>

<para style="p"><verse number="32" style="v" sid="MAT 15:32"/>And Jesus, having summoned His disciples, said, <char style="wj">“I have compassion toward the crowd, because already three days they continue with Me, and they have nothing that they might eat. And I do not want to dismiss them hungry, lest they faint on the way.”</char> <verse eid="MAT 15:32"/></para>

<para style="p"><verse number="33" style="v" sid="MAT 15:33"/>And the disciples say to Him, “From where unto us in a secluded place <char style="add">are</char> so many loaves so as to satisfy so great a crowd?” <verse eid="MAT 15:33"/></para>

<para style="p"><verse number="34" style="v" sid="MAT 15:34"/>And Jesus says to them, <char style="wj">“How many loaves do you⁺ have?”</char> </para>

<para style="p" vid="MAT 15:34">And they said, “Seven, and a few small fish.” <verse eid="MAT 15:34"/></para>

<para style="p"><verse number="35" style="v" sid="MAT 15:35"/>And having commanded the crowd to sit down on the ground, <verse eid="MAT 15:35"/></para>

<para style="p"><verse number="36" style="v" sid="MAT 15:36"/>He took the seven loaves and the fish, and having given thanks, He broke <char style="add">them</char> and was giving <char style="add">them</char> to the disciples, and the disciples to the crowds. <verse eid="MAT 15:36"/></para>

<para style="p"><verse number="37" style="v" sid="MAT 15:37"/>And they all ate and were satisfied, and they took up the superabounding of the fragments, seven baskets full. <verse eid="MAT 15:37"/></para>

<para style="p"><verse number="38" style="v" sid="MAT 15:38"/>And those eating were four thousand men, apart from women and children. <verse eid="MAT 15:38"/></para>

<para style="p"><verse number="39" style="v" sid="MAT 15:39"/>And having dismissed the crowds, He entered into the boat and went to the borders of Magadan. <note caller="+" style="f"><char style="fr" closed="false">15.39 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">Magdala</char></note><verse eid="MAT 15:39"/></para>

<chapter eid="MAT 15"/>

<chapter number="16" style="c" sid="MAT 16"/>

<para style="s">The Demand for a Sign</para>

<para style="p"><verse number="1" style="v" sid="MAT 16:1"/><note caller="-" style="x"><char style="xt" closed="false">Luke 12:54–56</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 8:11–13</char></note>And having come, the Pharisees and Sadducees, testing <char style="add">Him</char>, asked Him to show them a sign out of heaven. <verse eid="MAT 16:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 16:2"/>And answering, He said to them, <char style="wj">“Evening having come, you⁺ say, ‘Fair weather, for the sky is red,’ </char><verse eid="MAT 16:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 16:3"/><char style="wj">and in the morning, ‘Today a storm, for the sky is red, being overcast.’ Indeed, you⁺ know</char><note caller="+" style="f"><char style="fr" closed="false">16.3 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">You hypocrites know</char></note><char style="wj"> to discern the face of the sky, but the signs of the times you⁺ are not able.</char><note caller="+" style="f"><char style="fr" closed="false">16.3 </char><char style="ft" closed="false"> Several manuscripts do not include </char><char style="fq" closed="false">Evening having come... you are not able.</char><char style="ft" closed="false"> from verses 2 and 3.</char></note><char style="wj"> </char><verse eid="MAT 16:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 16:4"/><char style="wj">An evil and adulterous generation seeks after a sign, and a sign will not be given to it except the sign of Jonah.</char><note caller="+" style="f"><char style="fr" closed="false">16.4 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">Jonah the prophet</char></note><char style="wj">”</char> And having left them, He went away. <verse eid="MAT 16:4"/></para>

<para style="s">The Leaven of the Pharisees and SadduceesMark 8:14–21</para>

<para style="p"><verse number="5" style="v" sid="MAT 16:5"/><note caller="-" style="x"><char style="xt" closed="false">Luke 12:1–3</char></note>And the disciples,<note caller="+" style="f"><char style="fr" closed="false">16.5 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">His disciples</char><char style="ft" closed="false">; similarly in verse 20</char></note> having come to the other side, forgot to take loaves. <verse eid="MAT 16:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 16:6"/>And Jesus said to them, <char style="wj">“Watch out and beware of the leaven of the Pharisees and Sadducees.”</char> <verse eid="MAT 16:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 16:7"/>And they were reasoning among themselves, saying, “Because we took no loaves.” <verse eid="MAT 16:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 16:8"/>But having known <char style="add">this</char>, Jesus said,<note caller="+" style="f"><char style="fr" closed="false">16.8 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">said to them</char></note> <char style="wj">“Why do you⁺ reason among yourselves, O little of faith, that you⁺ have no loaves?</char><note caller="+" style="f"><char style="fr" closed="false">16.8 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">that you brought no loaves</char></note><char style="wj"> </char><verse eid="MAT 16:8"/></para>

<para style="p"><verse number="9" style="v" sid="MAT 16:9"/><char style="wj">Do you⁺ not yet perceive? Nor do you⁺ remember the five loaves for the five thousand and how many hand-baskets you⁺ took up, </char><verse eid="MAT 16:9"/></para>

<para style="p"><verse number="10" style="v" sid="MAT 16:10"/><char style="wj">nor the seven loaves for the four thousand and how many baskets you⁺ took up? </char><verse eid="MAT 16:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 16:11"/><char style="wj">How do you⁺ not perceive that I did not speak to you⁺ about loaves? But beware of the leaven of the Pharisees and Sadducees.</char><note caller="+" style="f"><char style="fr" closed="false">16.11 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">about loaves, but to beware of the leaven of the Pharisees and Sadducees?</char></note><char style="wj">”</char> <verse eid="MAT 16:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 16:12"/>Then they understood that He did not say to beware of the leaven of the loaves, but of the teaching of the Pharisees and Sadducees. <verse eid="MAT 16:12"/></para>

<para style="s">Peter’s Confession of ChristMark 8:27–30</para>

<para style="p"><verse number="13" style="v" sid="MAT 16:13"/><note caller="-" style="x"><char style="xt" closed="false">John 6:67–71</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 9:18–20</char></note>And Jesus, having come into the parts of Caesarea Philippi, was questioning His disciples, saying, <char style="wj">“Who do men say the Son of Man is?</char><note caller="+" style="f"><char style="fr" closed="false">16.13 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">Who do men pronounce Me to be—the Son of Man?</char></note><char style="wj">”</char> <verse eid="MAT 16:13"/></para>

<para style="p"><verse number="14" style="v" sid="MAT 16:14"/>And they said, “Some indeed, John the Baptist; and others, Elijah; and others, Jeremiah or one of the prophets.” <verse eid="MAT 16:14"/></para>

<para style="p"><verse number="15" style="v" sid="MAT 16:15"/>He says to them, <char style="wj">“But you⁺, who do you⁺ say I am?”</char> <verse eid="MAT 16:15"/></para>

<para style="p"><verse number="16" style="v" sid="MAT 16:16"/>And answering, Simon Peter said, “You are the Christ, the Son of the living God.” <verse eid="MAT 16:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 16:17"/>And answering, Jesus said to him, <char style="wj">“Blessed are you, Simon Bar-Jonah!</char><note caller="+" style="f"><char style="fr" closed="false">16.17 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">Simon son of Jonah</char></note><char style="wj"> For flesh and blood did not reveal it to you, but My Father who is in the heavens. </char><verse eid="MAT 16:17"/></para>

<para style="p"><verse number="18" style="v" sid="MAT 16:18"/><char style="wj">And I also say to you that you are Peter, and on this rock I will build My church, and the gates of Hades will not prevail against it. </char><verse eid="MAT 16:18"/></para>

<para style="p"><verse number="19" style="v" sid="MAT 16:19"/><char style="wj">I will give to you the keys of the kingdom of the heavens. And whatever you might bind on the earth will be bound in the heavens, and whatever you might loose on the earth will be loosed in the heavens.”</char> <verse eid="MAT 16:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 16:20"/>Then He instructed<note caller="+" style="f"><char style="fr" closed="false">16.20 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">commanded</char></note> the disciples that they should tell no one that He is the Christ.<note caller="+" style="f"><char style="fr" closed="false">16.20 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">that He is Jesus the Christ</char></note> <verse eid="MAT 16:20"/></para>

<para style="s">Christ’s Passion ForetoldMark 8:31–33</para>

<para style="p"><verse number="21" style="v" sid="MAT 16:21"/><note caller="-" style="x"><char style="xt" closed="false">Luke 9:21–22</char></note>From that time Jesus<note caller="+" style="f"><char style="fr" closed="false">16.21 </char><char style="ft" closed="false"> NE and WH </char><char style="fq" closed="false">Jesus Christ</char></note> began to show to His disciples that it is necessary for Him to go away to Jerusalem, and to suffer many things from the elders and chief priests and scribes, and to be killed, and on the third day to be raised. <verse eid="MAT 16:21"/></para>

<para style="p"><verse number="22" style="v" sid="MAT 16:22"/>And having taken Him aside, Peter began to rebuke Him, saying, “Far be it from You, Lord! This never will be unto You!” <verse eid="MAT 16:22"/></para>

<para style="p"><verse number="23" style="v" sid="MAT 16:23"/>But having turned, He said to Peter, <char style="wj">“Get behind Me, Satan! You are a stumbling block to Me. For you do not have in mind the things of God, but the things of men.”</char> <verse eid="MAT 16:23"/></para>

<para style="s">Take Up Your CrossMark 8:34–38</para>

<para style="p"><verse number="24" style="v" sid="MAT 16:24"/><note caller="-" style="x"><char style="xt" closed="false">Luke 9:23–27</char></note>Then Jesus said to His disciples, <char style="wj">“If anyone wants to come after Me, let him deny himself and take up his cross and follow Me. </char><verse eid="MAT 16:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 16:25"/><char style="wj">For whoever may want to save his life will lose it, but whoever may lose his life on account of Me will find it. </char><verse eid="MAT 16:25"/></para>

<para style="p"><verse number="26" style="v" sid="MAT 16:26"/><char style="wj">For what will it profit</char><note caller="+" style="f"><char style="fr" closed="false">16.26 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">does it profit</char></note><char style="wj"> a man if he should gain the whole world, but lose his soul? Or what will a man give as an exchange for his soul? </char><verse eid="MAT 16:26"/></para>

<para style="p"><verse number="27" style="v" sid="MAT 16:27"/><char style="wj">For the Son of Man is about to come in the glory of His Father with His angels, and then He will repay each one according to his deeds. </char><verse eid="MAT 16:27"/></para>

<para style="p"><verse number="28" style="v" sid="MAT 16:28"/>Truly I say to you⁺ that there are some of those standing here who shall not taste of death until they shall see the Son of Man coming in His kingdom.” <verse eid="MAT 16:28"/></para>

<chapter eid="MAT 16"/>

<chapter number="17" style="c" sid="MAT 17"/>

<para style="s">The Transfiguration</para>

<para style="p"><verse number="1" style="v" sid="MAT 17:1"/><note caller="-" style="x"><char style="xt" closed="false">2 Peter 1:16–21</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 9:28–36</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 9:1–13</char></note>And after six days, Jesus takes along Peter and James and John his brother, and He brings them up onto a high mountain by themselves. <verse eid="MAT 17:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 17:2"/>And He was transfigured before them, and His face shone like the sun, and His garments became white as the light. <verse eid="MAT 17:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 17:3"/>And behold, there appeared to them Moses and Elijah, talking with Him. <verse eid="MAT 17:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 17:4"/>And answering, Peter said to Jesus, “Lord, it is good for us to be here. If You wish, I will make<note caller="+" style="f"><char style="fr" closed="false">17.4 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">let us make</char></note> here three tabernacles<note caller="+" style="f"><char style="fr" closed="false">17.4 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">three shelters</char></note>—one for You, and one for Moses, and one for Elijah.” <verse eid="MAT 17:4"/></para>

<para style="p"><verse number="5" style="v" sid="MAT 17:5"/><char style="add">In</char> his still speaking, behold, a bright cloud overshadowed them, and behold, a voice out of the cloud, saying, “This is My Son, the Beloved, in whom I am well pleased. Listen to Him!” <note caller="+" style="f"><char style="fr" closed="false">17.5 </char><char style="ft" closed="false"> Cited in 2 Peter 1:17</char></note><verse eid="MAT 17:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 17:6"/>And having heard <char style="add">it</char>, the disciples fell upon their face, and they were exceedingly terrified. <verse eid="MAT 17:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 17:7"/>And Jesus, having come near and having touched them, said, <char style="wj">“Rise up, and do not be afraid.”</char> <verse eid="MAT 17:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 17:8"/>And having lifted up their eyes, they saw no one except Jesus Himself alone. <verse eid="MAT 17:8"/></para>

<para style="p"><verse number="9" style="v" sid="MAT 17:9"/>And <char style="add">in</char> their coming down from the mountain, Jesus commanded them, saying, <char style="wj">“Tell no one the vision until the Son of Man should be raised</char><note caller="+" style="f"><char style="fr" closed="false">17.9 </char><char style="ft" closed="false"> NA, SBL, WH </char><char style="fq" closed="false">has been raised</char></note><char style="wj"> out from the dead.”</char> <verse eid="MAT 17:9"/></para>

<para style="p"><verse number="10" style="v" sid="MAT 17:10"/>And the disciples<note caller="+" style="f"><char style="fr" closed="false">17.10 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">His disciples</char></note> questioned Him, saying, “Why then do the scribes say that it is necessary for Elijah to come first?” <verse eid="MAT 17:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 17:11"/>And answering, He said, <char style="wj">“Elijah indeed comes</char><note caller="+" style="f"><char style="fr" closed="false">17.11 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">comes first</char></note><char style="wj"> and will restore all things. </char><verse eid="MAT 17:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 17:12"/><char style="wj">But I say to you⁺ that Elijah did already come, and they did not know him, but they did to him whatever they wanted. Thus also the Son of Man is about to suffer under them.”</char> <verse eid="MAT 17:12"/></para>

<para style="p"><verse number="13" style="v" sid="MAT 17:13"/>Then the disciples understood that He spoke to them about John the Baptist. <verse eid="MAT 17:13"/></para>

<para style="s">The Boy with a DemonMark 9:14–29</para>

<para style="p"><verse number="14" style="v" sid="MAT 17:14"/><note caller="-" style="x"><char style="xt" closed="false">Luke 9:37–42</char></note>And <char style="add">on</char> their having come to the crowd, a man came to Him, kneeling down to Him <verse eid="MAT 17:14"/></para>

<para style="p"><verse number="15" style="v" sid="MAT 17:15"/>and saying, “Lord, have mercy on my son, for he is epileptic and suffers miserably;<note caller="+" style="f"><char style="fr" closed="false">17.15 </char><char style="ft" closed="false"> TH and WH </char><char style="fq" closed="false">and is sick</char></note> for often he falls into the fire, and often into the water. <verse eid="MAT 17:15"/></para>

<para style="p"><verse number="16" style="v" sid="MAT 17:16"/>And I brought him to Your disciples, and they were not able to heal him.” <verse eid="MAT 17:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 17:17"/>And answering, Jesus said, <char style="wj">“O unbelieving and perverse generation, until when will I be with you⁺? Until when will I bear with you⁺? Bring him here to Me.”</char> <verse eid="MAT 17:17"/></para>

<para style="p"><verse number="18" style="v" sid="MAT 17:18"/>And Jesus rebuked him, and the demon came out from him, and the boy was healed from that hour. <verse eid="MAT 17:18"/></para>

<para style="s">The Power of FaithLuke 17:5–10</para>

<para style="p"><verse number="19" style="v" sid="MAT 17:19"/>Then the disciples, having come to Jesus in private, said, “Why were we not able to cast it out?” <verse eid="MAT 17:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 17:20"/>And He said to them,<note caller="+" style="f"><char style="fr" closed="false">17.20 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">Jesus said to them</char></note> <char style="wj">“Because of your⁺ little faith.</char><note caller="+" style="f"><char style="fr" closed="false">17.20 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">Because of your unbelief</char></note><char style="wj"> For truly I say to you⁺, if you⁺ have faith as a grain of mustard, you⁺ will say to this mountain, ‘Move from here to there,’ and it will move. And nothing will be impossible for you⁺.</char><note caller="+" style="f"><char style="fr" closed="false">17.20 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">21</char><char style="fq" closed="false">But this kind does not come out except by prayer and fasting</char><char style="ft" closed="false">; see Mark 9:29.</char></note><char style="wj">”</char> <verse eid="MAT 17:20"/></para>

<para style="s">The Second Prediction of the PassionMark 9:30–32</para>

<para style="p"><verse number="22" style="v" sid="MAT 17:22"/><note caller="-" style="x"><char style="xt" closed="false">Luke 9:43–45</char></note>And <char style="add">in</char> their gathering together<note caller="+" style="f"><char style="fr" closed="false">17.22 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">staying together</char></note> in Galilee, Jesus said to them, <char style="wj">“The Son of Man is about to be betrayed into the hands of men, </char><verse eid="MAT 17:22"/></para>

<para style="p"><verse number="23" style="v" sid="MAT 17:23"/><char style="wj">and they will kill Him, and on the third day He will be raised up.”</char> And they were deeply grieved. <verse eid="MAT 17:23"/></para>

<para style="s">The Temple Tax</para>

<para style="p"><verse number="24" style="v" sid="MAT 17:24"/>And <char style="add">on</char> their having come to Capernaum, those receiving the didrachmas<note caller="+" style="f"><char style="fr" closed="false">17.24 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the two-drachma tax</char></note> came to Peter and said, “Does your⁺ Teacher pay the didrachmas?<note caller="+" style="f"><char style="fr" closed="false">17.24 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the two drachmas</char></note>” <verse eid="MAT 17:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 17:25"/>He says, “Yes.” </para>

<para style="p" vid="MAT 17:25">And <char style="add">on</char> his having come<note caller="+" style="f"><char style="fr" closed="false">17.25 </char><char style="ft" closed="false"> F35 </char><char style="fq" closed="false">their having come</char></note> into the house, Jesus anticipated him, saying, <char style="wj">“What do you think, Simon? From whom do the kings of the earth receive custom or tribute: From their sons, or from the strangers?”</char> <verse eid="MAT 17:25"/></para>

<para style="p"><verse number="26" style="v" sid="MAT 17:26"/>And <char style="add">on</char> his having said, “From the strangers,” Jesus said to him, <char style="wj">“Then the sons are free. </char><verse eid="MAT 17:26"/></para>

<para style="p"><verse number="27" style="v" sid="MAT 17:27"/><char style="wj">But so that we might not offend them, having gone to the sea, cast a hook, and take the first fish having come up. And having opened its mouth, you will find a stater.</char><note caller="+" style="f"><char style="fr" closed="false">17.27 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">A stater</char><char style="ft" closed="false"> was a silver coin worth approximately one shekel</char></note><char style="wj"> Having taken that, give it to them for Me and you.”</char> <verse eid="MAT 17:27"/></para>

<chapter eid="MAT 17"/>

<chapter number="18" style="c" sid="MAT 18"/>

<para style="s">The Greatest in the Kingdom</para>

<para style="p"><verse number="1" style="v" sid="MAT 18:1"/><note caller="-" style="x"><char style="xt" closed="false">Luke 9:46–50</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 9:33–41</char></note>In that hour the disciples came to Jesus, saying, “Who then is greater in the kingdom of the heavens?” <verse eid="MAT 18:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 18:2"/>And having summoned a little child, He set him in their midst <verse eid="MAT 18:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 18:3"/>and said, <char style="wj">“Truly I say to you⁺, if you⁺ shall not be turned and become as the little children, you⁺ shall never enter into the kingdom of the heavens. </char><verse eid="MAT 18:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 18:4"/><char style="wj">Therefore whoever will humble himself like this little child, he is the greatest in the kingdom of the heavens. </char><verse eid="MAT 18:4"/></para>

<para style="p"><verse number="5" style="v" sid="MAT 18:5"/><char style="wj">And whoever shall receive one such little child in My name, he receives Me. </char><verse eid="MAT 18:5"/></para>

<para style="s">Temptations and Trespasses</para>

<para style="p"><verse number="6" style="v" sid="MAT 18:6"/><note caller="-" style="x"><char style="xt" closed="false">Luke 17:1–4</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 9:42–48</char></note>And whoever might cause to stumble one of these little ones believing in Me, it is better for him that a heavy millstone should be hung around his neck and he should be sunk in the depth of the sea. <verse eid="MAT 18:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 18:7"/>Woe to the world because of the stumbling blocks. For <char style="add">it is</char> a necessity that the stumbling blocks come, but woe to the man through whom the stumbling block comes! <note caller="+" style="f"><char style="fr" closed="false">18.7 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">to that man</char></note><verse eid="MAT 18:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 18:8"/>Now if your hand or your foot causes you to stumble, cut it off and cast <char style="add">it</char> from you; it is better for you to enter into life crippled or lame<note caller="+" style="f"><char style="fr" closed="false">18.8 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">lame or crippled</char></note> than, having two hands or two feet, to be cast into the eternal fire. <verse eid="MAT 18:8"/></para>

<para style="p"><verse number="9" style="v" sid="MAT 18:9"/>And if your eye causes you to stumble, pluck it out and cast <char style="add">it</char> from you. It is better for you to enter into life one-eyed than, having two eyes, to be cast into the Gehenna of fire.<note caller="+" style="f"><char style="fr" closed="false">18.9 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the fire of hell</char></note> <verse eid="MAT 18:9"/></para>

<para style="s">The Parable of the Lost SheepLuke 15:1–7</para>

<para style="p"><verse number="10" style="v" sid="MAT 18:10"/>See that you⁺ do not despise one of these little ones. For I say to you⁺ that their angels in the heavens always see the face of My Father who <char style="add">is</char> in the heavens.<note caller="+" style="f"><char style="fr" closed="false">18.10 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">11</char><char style="fq" closed="false">For the Son of Man came to save the lost</char><char style="ft" closed="false">; see Luke 19:10.</char></note> <verse eid="MAT 18:10"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 18:12"/>What do you⁺ think? If unto any man there should be a hundred sheep, and one of them should go astray, will he not leave<note caller="+" style="f"><char style="fr" closed="false">18.12 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">does he not leave</char></note> the ninety-nine on the mountains and, having gone, seek the one going astray? <verse eid="MAT 18:12"/></para>

<para style="p"><verse number="13" style="v" sid="MAT 18:13"/>And if it should come to pass <char style="add">that</char> he finds it, truly I say to you⁺ that he rejoices over it more than over the ninety-nine not having gone astray. <verse eid="MAT 18:13"/></para>

<para style="p"><verse number="14" style="v" sid="MAT 18:14"/>Thus it is not the will of your⁺<note caller="+" style="f"><char style="fr" closed="false">18.14 </char><char style="ft" closed="false"> WH </char><char style="fq" closed="false">My</char></note> Father who <char style="add">is</char> in the heavens that one of these little ones should be lost. <verse eid="MAT 18:14"/></para>

<para style="s">A Brother Who SinsDeuteronomy 19:15–21</para>

<para style="p"><verse number="15" style="v" sid="MAT 18:15"/>And if your brother may sin against you,<note caller="+" style="f"><char style="fr" closed="false">18.15 </char><char style="ft" closed="false"> NE and WH do not include </char><char style="fq" closed="false">against you</char><char style="ft" closed="false">.</char></note> go reprove him between you and him alone. If he may hear you, you have gained your brother. <verse eid="MAT 18:15"/></para>

<para style="p"><verse number="16" style="v" sid="MAT 18:16"/>But if he may not hear, take with you one or two more, so that ‘every word may be stood upon the testimony of two or three witnesses.’ <note caller="+" style="f"><char style="fr" closed="false">18.16 </char><char style="ft" closed="false"> Deuteronomy 19:15</char></note><verse eid="MAT 18:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 18:17"/>And if he may fail to hear them, say <char style="add">it</char> to the church. And if he may fail to hear even the church, let him be unto you as the Gentile and the tax collector. <verse eid="MAT 18:17"/></para>

<para style="p"><verse number="18" style="v" sid="MAT 18:18"/>Truly I say to you⁺, whatever you⁺ shall bind on the earth will be bound in heaven, and whatever you⁺ shall loose on the earth will be loosed in heaven. <verse eid="MAT 18:18"/></para>

<para style="s">Ask in My NameJohn 16:23–33</para>

<para style="p"><verse number="19" style="v" sid="MAT 18:19"/>Again, truly<note caller="+" style="f"><char style="fr" closed="false">18.19 </char><char style="ft" closed="false"> TR does not include </char><char style="fq" closed="false">truly</char><char style="ft" closed="false">.</char></note> I say to you⁺ that if two of you⁺ on the earth shall agree about any matter that they shall ask, it will be done for them by My Father who <char style="add">is</char> in the heavens. <verse eid="MAT 18:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 18:20"/>For where two or three are gathered together unto My name, there am I in their midst.” <verse eid="MAT 18:20"/></para>

<para style="s">The Unforgiving ServantRomans 12:14–21</para>

<para style="p"><verse number="21" style="v" sid="MAT 18:21"/>Then, having come, Peter said to Him, “Lord, how often will my brother sin against me, and I will forgive him? Up to seven times?” <verse eid="MAT 18:21"/></para>

<para style="p"><verse number="22" style="v" sid="MAT 18:22"/>Jesus says to him, <char style="wj">“I do not say to you, up to seven times, but up to seventy-seven times! </char><note caller="+" style="f"><char style="fr" closed="false">18.22 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">seventy times seven</char><char style="ft" closed="false">; see Genesis 4:24 LXX</char></note><verse eid="MAT 18:22"/></para>

<para style="p"><verse number="23" style="v" sid="MAT 18:23"/>Because of this, the kingdom of the heavens was likened to to a man, a king, who wanted to settle accounts with his servants. <verse eid="MAT 18:23"/></para>

<para style="p"><verse number="24" style="v" sid="MAT 18:24"/>And <char style="add">on</char> his having begun to settle, one was brought to him, a debtor of ten thousand talents.<note caller="+" style="f"><char style="fr" closed="false">18.24 </char><char style="ft" closed="false"> A talent was worth about twenty years’ wages for a laborer.</char></note> <verse eid="MAT 18:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 18:25"/>And <char style="add">on</char> his having nothing to repay, the master commanded him to be sold—and the wife and the children and all of whatever he had—and repayment to be made. <verse eid="MAT 18:25"/></para>

<para style="p"><verse number="26" style="v" sid="MAT 18:26"/>Therefore the servant, having fallen down, was bowing on his knees to him, saying, ‘Have patience<note caller="+" style="f"><char style="fr" closed="false">18.26 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">Master, have patience</char></note> with me, and I will repay all to you.’ <verse eid="MAT 18:26"/></para>

<para style="p"><verse number="27" style="v" sid="MAT 18:27"/>And having been moved with compassion, the master of that servant released him and forgave him the debt. <verse eid="MAT 18:27"/></para>

<para style="p"><verse number="28" style="v" sid="MAT 18:28"/>But having gone out, that servant found one of his fellow servants who was owing him a hundred denarii.<note caller="+" style="f"><char style="fr" closed="false">18.28 </char><char style="ft" closed="false"> A denarius was customarily a day’s wage for a laborer; see Matthew 20:2.</char></note> And having seized him, he was choking <char style="add">him</char>, saying, ‘Repay<note caller="+" style="f"><char style="fr" closed="false">18.28 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">Repay me</char></note> what you owe!’ <verse eid="MAT 18:28"/></para>

<para style="p"><verse number="29" style="v" sid="MAT 18:29"/>Therefore, having fallen down,<note caller="+" style="f"><char style="fr" closed="false">18.29 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">at his feet</char><char style="ft" closed="false">.</char></note> his fellow servant was calling on him, saying, ‘Have patience with me, and I will repay you.<note caller="+" style="f"><char style="fr" closed="false">18.29 </char><char style="ft" closed="false"> TR </char><char style="fq" closed="false">and I will pay you everything</char></note>’ <verse eid="MAT 18:29"/></para>

<para style="p"><verse number="30" style="v" sid="MAT 18:30"/>But he was not willing. Rather, having gone, he cast him into prison until he should repay what was owed. <verse eid="MAT 18:30"/></para>

<para style="p"><verse number="31" style="v" sid="MAT 18:31"/>Therefore his fellow servants, having seen the things having happened, were deeply grieved, and having gone, they made clear to their master all the things having happened. <verse eid="MAT 18:31"/></para>

<para style="p"><verse number="32" style="v" sid="MAT 18:32"/>Then, having summoned him, his master says to him, ‘Evil servant! I forgave you all that debt because you called on me. <verse eid="MAT 18:32"/></para>

<para style="p"><verse number="33" style="v" sid="MAT 18:33"/>Was it not necessary for you also to have had mercy on your fellow servant, as I also had mercy on you?’ <verse eid="MAT 18:33"/></para>

<para style="p"><verse number="34" style="v" sid="MAT 18:34"/>And having become angry, his master delivered him to the tormenters until he should repay everything being owed to him.<note caller="+" style="f"><char style="fr" closed="false">18.34 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">all that was owed to him</char></note> <verse eid="MAT 18:34"/></para>

<para style="p"><verse number="35" style="v" sid="MAT 18:35"/>Thus also My heavenly Father will do to you⁺ unless each of you⁺ should forgive his brother<note caller="+" style="f"><char style="fr" closed="false">18.35 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">his trespasses</char><char style="ft" closed="false">.</char></note> from your⁺ hearts.” <verse eid="MAT 18:35"/></para>

<chapter eid="MAT 18"/>

<chapter number="19" style="c" sid="MAT 19"/>

<para style="s">Teachings about Divorce</para>

<para style="p"><verse number="1" style="v" sid="MAT 19:1"/><note caller="-" style="x"><char style="xt" closed="false">Mark 10:1–12</char></note>And it came to pass when Jesus finished these words <char style="add">that</char> He withdrew from Galilee and came into the borders of Judea beyond the Jordan. <verse eid="MAT 19:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 19:2"/>And many crowds followed Him, and He healed them there. <verse eid="MAT 19:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 19:3"/>And Pharisees<note caller="+" style="f"><char style="fr" closed="false">19.3 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">the Pharisees</char></note> came to Him, testing Him and saying, “Is it lawful for a man to send away his wife for any cause?” <verse eid="MAT 19:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 19:4"/>And answering, He said, <char style="wj">“Did you⁺ not read that the One having created from the beginning ‘made them male and female,’ </char><note caller="+" style="f"><char style="fr" closed="false">19.4 </char><char style="ft" closed="false"> Genesis 1:27; Genesis 5:2</char></note><verse eid="MAT 19:4"/></para>

<para style="p"><verse number="5" style="v" sid="MAT 19:5"/><char style="wj">and He said, ‘On account of this a man will leave the father and the mother and be joined with his wife, and the two will be for one flesh’? </char><note caller="+" style="f"><char style="fr" closed="false">19.5 </char><char style="ft" closed="false"> Genesis 2:24 (see also LXX)</char></note><verse eid="MAT 19:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 19:6"/><char style="wj">So they are no longer two, but one flesh. Therefore what God yoked together, let man not separate.”</char> <verse eid="MAT 19:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 19:7"/>They say to Him, “Why then did Moses command to give <char style="add">her</char> a roll of divorce and to send her away?<note caller="+" style="f"><char style="fr" closed="false">19.7 </char><char style="ft" closed="false"> See Deuteronomy 24:1.</char></note>” <verse eid="MAT 19:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 19:8"/>He says to them, <char style="wj">“Moses, for your⁺ hardness of heart, allowed you⁺ to divorce your⁺ wives; but it has not been this way from the beginning. </char><verse eid="MAT 19:8"/></para>

<para style="p"><verse number="9" style="v" sid="MAT 19:9"/><char style="wj">And I say to you⁺ that whoever shall send away his wife, except for sexual immorality, and shall marry another, he commits adultery.</char><note caller="+" style="f"><char style="fr" closed="false">19.9 </char><char style="ft" closed="false"> SBL and BYZ include </char><char style="fq" closed="false">And he who marries a divorced woman commits adultery</char><char style="ft" closed="false">; see Matthew 5:32.</char></note><char style="wj">”</char> <verse eid="MAT 19:9"/></para>

<para style="p"><verse number="10" style="v" sid="MAT 19:10"/>His disciples<note caller="+" style="f"><char style="fr" closed="false">19.10 </char><char style="ft" closed="false"> SBL and WH </char><char style="fq" closed="false">The disciples</char></note> say to Him, “If this is the case of the man with the wife, it is better not to marry.” <verse eid="MAT 19:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 19:11"/>And He said to them, <char style="wj">“Not all receive this word, but those to whom it has been given. </char><verse eid="MAT 19:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 19:12"/><char style="wj">For there are eunuchs who were born thus from the womb of their mother, and there are eunuchs who were made eunuchs by men, and there are eunuchs who made themselves eunuchs for the sake of the kingdom of the heavens. The one being able to receive it, let him receive it.”</char> <verse eid="MAT 19:12"/></para>

<para style="s">Jesus Blesses the ChildrenMark 10:13–16</para>

<para style="p"><verse number="13" style="v" sid="MAT 19:13"/><note caller="-" style="x"><char style="xt" closed="false">Luke 18:15–17</char></note>Then little children were brought to Him so that He might lay the hands on them and He might pray, but the disciples rebuked them. <verse eid="MAT 19:13"/></para>

<para style="p"><verse number="14" style="v" sid="MAT 19:14"/>But Jesus said, <char style="wj">“Permit the little children, and do not forbid them to come to Me! For unto such is the kingdom of the heavens.”</char> <verse eid="MAT 19:14"/></para>

<para style="p"><verse number="15" style="v" sid="MAT 19:15"/>And having laid the hands on them, He went from there. <verse eid="MAT 19:15"/></para>

<para style="s">The Rich Young ManMark 10:17–31</para>

<para style="p"><verse number="16" style="v" sid="MAT 19:16"/><note caller="-" style="x"><char style="xt" closed="false">Luke 18:18–30</char></note>And behold, one having come to Him said, “Teacher, what good shall I do so that I shall have eternal life?” <verse eid="MAT 19:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 19:17"/>And He said to him, “Why do you ask Me about the good?<note caller="+" style="f"><char style="fr" closed="false">19.17 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">16</char><char style="fq" closed="false">...“Good Teacher, what good shall I do so that I might have eternal life?” </char><char style="fq" closed="false">17</char><char style="fq" closed="false">“Why do you call Me good?”</char><char style="ft" closed="false"> See Mark 10:17–18 and Luke 18:18–19.</char></note> One is good. But if you want to enter into life, keep the commandments.” <verse eid="MAT 19:17"/></para>

<para style="p"><verse number="18" style="v" sid="MAT 19:18"/>He says to Him, “Which?” And Jesus said, <char style="wj">“‘You will not murder, you will not commit adultery, you will not steal, you will not bear false witness, </char><verse eid="MAT 19:18"/></para>

<para style="p"><verse number="19" style="v" sid="MAT 19:19"/><char style="wj">honor the father and the mother, and you will love your neighbor as yourself.’”</char> <note caller="+" style="f"><char style="fr" closed="false">19.19 </char><char style="ft" closed="false"> Exodus 20:12–16; Leviticus 19:18; Deuteronomy 5:16–20</char></note><verse eid="MAT 19:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 19:20"/>The young man says to Him, “All these I kept.<note caller="+" style="f"><char style="fr" closed="false">19.20 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">from my youth</char><char style="ft" closed="false">.</char></note> What do I still lack?” <verse eid="MAT 19:20"/></para>

<para style="p"><verse number="21" style="v" sid="MAT 19:21"/>Jesus was saying to him, <char style="wj">“If you want to be perfect, go, sell what you are possessing and give to the poor, and you will have treasure in the heavens. And come, follow Me.”</char> <verse eid="MAT 19:21"/></para>

<para style="p"><verse number="22" style="v" sid="MAT 19:22"/>And having heard this word, the young man went away grieving, for he was one having many possessions. <verse eid="MAT 19:22"/></para>

<para style="p"><verse number="23" style="v" sid="MAT 19:23"/>And Jesus said to His disciples, <char style="wj">“Truly I say to you⁺ that with difficulty a rich man will enter into the kingdom of the heavens. </char><verse eid="MAT 19:23"/></para>

<para style="p"><verse number="24" style="v" sid="MAT 19:24"/><char style="wj">And again I say to you⁺, it is easier for a camel to enter through the eye of a needle than for a rich man to enter into the kingdom of God.”</char> <verse eid="MAT 19:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 19:25"/>And having heard, the disciples<note caller="+" style="f"><char style="fr" closed="false">19.25 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">His disciples</char></note> were exceedingly astonished, saying, “Who then is able to be saved?” <verse eid="MAT 19:25"/></para>

<para style="p"><verse number="26" style="v" sid="MAT 19:26"/>And having looked on <char style="add">them</char>, Jesus said to them, <char style="wj">“With men this is impossible, but with God all things are possible.”</char> <verse eid="MAT 19:26"/></para>

<para style="p"><verse number="27" style="v" sid="MAT 19:27"/>Then answering, Peter said to Him, “Behold, we have left all and followed You. What then will be unto us?” <verse eid="MAT 19:27"/></para>

<para style="p"><verse number="28" style="v" sid="MAT 19:28"/>And Jesus said to them, <char style="wj">“Truly I say to you⁺ that you⁺, the ones having followed Me, in the regeneration,</char><note caller="+" style="f"><char style="fr" closed="false">19.28 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">in the renewal of all things</char></note><char style="wj"> when the Son of Man shall sit down upon His throne of glory, you⁺ also will sit on twelve thrones, judging the twelve tribes of Israel. </char><verse eid="MAT 19:28"/></para>

<para style="p"><verse number="29" style="v" sid="MAT 19:29"/><char style="wj">And everyone who has left houses or brothers or sisters or father or mother or wife</char><note caller="+" style="f"><char style="fr" closed="false">19.29 </char><char style="ft" closed="false"> NE, WH, and NA do not include </char><char style="fq" closed="false">or wife</char><char style="ft" closed="false">.</char></note><char style="wj"> or children or fields for the sake of My name will receive a hundredfold and will inherit eternal life. </char><verse eid="MAT 19:29"/></para>

<para style="p"><verse number="30" style="v" sid="MAT 19:30"/><char style="wj">But many who are first will be last, and last, first.</char> <verse eid="MAT 19:30"/></para>

<chapter eid="MAT 19"/>

<chapter number="20" style="c" sid="MAT 20"/>

<para style="s">The Parable of the Workers</para>

<para style="p"><verse number="1" style="v" sid="MAT 20:1"/>“For the kingdom of the heavens is like a man, a master of a house, who went out in the morning to hire workmen for his vineyard. <verse eid="MAT 20:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 20:2"/>And having agreed with the workmen for a denarius a day, he sent them into his vineyard. <note caller="+" style="f"><char style="fr" closed="false">20.2 </char><char style="ft" closed="false"> A denarius was customarily a day’s wage for a laborer; similarly in verses 9, 10, and 13.</char></note><verse eid="MAT 20:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 20:3"/>And having gone out about the third hour,<note caller="+" style="f"><char style="fr" closed="false">20.3 </char><char style="ft" closed="false"> That is, about nine in the morning</char></note> he saw others standing in the marketplace idle. <verse eid="MAT 20:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 20:4"/>And to those ones he said, ‘You⁺ also go into the vineyard, and I will give you⁺ whatever may be right.’ <verse eid="MAT 20:4"/></para>

<para style="p"><verse number="5" style="v" sid="MAT 20:5"/>And they went away. </para>

<para style="p" vid="MAT 20:5">And having gone out again about the sixth and ninth hour,<note caller="+" style="f"><char style="fr" closed="false">20.5 </char><char style="ft" closed="false"> That is, about noon and again about three in the afternoon</char></note> he did likewise. <verse eid="MAT 20:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 20:6"/>And about the eleventh,<note caller="+" style="f"><char style="fr" closed="false">20.6 </char><char style="ft" closed="false"> That is, about five in the afternoon; also in verse 9</char></note> having gone out, he found others standing,<note caller="+" style="f"><char style="fr" closed="false">20.6 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">standing idle</char></note> and he says to them, ‘Why do you⁺ stand here all the day idle?’ <verse eid="MAT 20:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 20:7"/>They say to him, ‘Because no one hired us.’ </para>

<para style="p" vid="MAT 20:7">He says to them, ‘You⁺ also go into the vineyard.’<note caller="+" style="f"><char style="fr" closed="false">20.7 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">and whatever is right, you shall receive.</char></note> <verse eid="MAT 20:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 20:8"/>And evening having come, the master of the vineyard says to his foreman, ‘Call the workmen and pay them the wages, having begun from the last, up to the first.’ <verse eid="MAT 20:8"/></para>

<para style="p"><verse number="9" style="v" sid="MAT 20:9"/>And having come, the ones of about the eleventh hour each received a denarius. <verse eid="MAT 20:9"/></para>

<para style="p"><verse number="10" style="v" sid="MAT 20:10"/>And having come, the first thought that they will receive more. But they themselves also received each a denarius. <verse eid="MAT 20:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 20:11"/>And having received <char style="add">it</char>, they were grumbling against the master of the house, <verse eid="MAT 20:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 20:12"/>saying, ‘These, the last, worked one hour, and you made them equal to us, the ones having borne the burden of the day and the scorching heat.’ <verse eid="MAT 20:12"/></para>

<para style="p"><verse number="13" style="v" sid="MAT 20:13"/>And answering one of them, he said, ‘Friend, I am doing you no wrong. Did you not agree with me on a denarius? <verse eid="MAT 20:13"/></para>

<para style="p"><verse number="14" style="v" sid="MAT 20:14"/>Take what <char style="add">is</char> yours and go. But I want to give to this last one as to you also. <verse eid="MAT 20:14"/></para>

<para style="p"><verse number="15" style="v" sid="MAT 20:15"/>Or is it not lawful for me to do what I want with what <char style="add">is</char> mine? Or is your eye evil<note caller="+" style="f"><char style="fr" closed="false">20.15 </char><char style="ft" closed="false"> That is, </char><char style="fq" closed="false">Or are you envious</char></note> because I am good?’ <verse eid="MAT 20:15"/></para>

<para style="p"><verse number="16" style="v" sid="MAT 20:16"/>Thus the last will be first, and the first, last.”<note caller="+" style="f"><char style="fr" closed="false">20.16 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">For many are called, but few are chosen.</char></note> <verse eid="MAT 20:16"/></para>

<para style="s">The Third Prediction of the PassionMark 10:32–34</para>

<para style="p"><verse number="17" style="v" sid="MAT 20:17"/><note caller="-" style="x"><char style="xt" closed="false">Luke 18:31–34</char></note>And Jesus, going up to Jerusalem, took aside the twelve disciples by themselves, and on the way He said to them, <verse eid="MAT 20:17"/></para>

<para style="p"><verse number="18" style="v" sid="MAT 20:18"/><char style="wj">“Behold, we are going up to Jerusalem, and the Son of Man will be betrayed to the chief priests and scribes, and they will condemn Him to death. </char><verse eid="MAT 20:18"/></para>

<para style="p"><verse number="19" style="v" sid="MAT 20:19"/><char style="wj">And they will betray Him to the Gentiles to mock and to flog and to crucify, and on the third day He will be raised up.</char><note caller="+" style="f"><char style="fr" closed="false">20.19 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">He will rise again</char></note><char style="wj">”</char> <verse eid="MAT 20:19"/></para>

<para style="s">A Mother’s RequestMark 10:35–45</para>

<para style="p"><verse number="20" style="v" sid="MAT 20:20"/>Then the mother of the sons of Zebedee came to Him with her sons, kneeling down and asking something from Him. <verse eid="MAT 20:20"/></para>

<para style="p"><verse number="21" style="v" sid="MAT 20:21"/>And He said to her, <char style="wj">“What do you want?”</char> </para>

<para style="p" vid="MAT 20:21">She says to Him, “Say that these two sons of mine shall sit, one at Your right hand and one at Your left hand, in Your kingdom.” <verse eid="MAT 20:21"/></para>

<para style="p"><verse number="22" style="v" sid="MAT 20:22"/>And answering, Jesus said, <char style="wj">“You⁺ do not know what you⁺ are asking. Are you⁺ able to drink the cup that I am about to drink?”</char><note caller="+" style="f"><char style="fr" closed="false">20.22 </char><char style="ft" closed="false"> BYZ includes </char><char style="fq" closed="false">or be baptized with the baptism with which I am baptized.</char><char style="ft" closed="false"> TR is similar.</char></note> </para>

<para style="p" vid="MAT 20:22">They say to Him, “We are able.” <verse eid="MAT 20:22"/></para>

<para style="p"><verse number="23" style="v" sid="MAT 20:23"/><char style="wj">He says to them, “Indeed you⁺ will drink My cup,</char><note caller="+" style="f"><char style="fr" closed="false">20.23 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">and be baptized with the baptism with which I am baptized</char><char style="ft" closed="false">.</char></note><char style="wj"> but to sit at My right hand and at My left, this is not Mine to give, but to those for whom it has been prepared by My Father.” </char><verse eid="MAT 20:23"/></para>

<para style="p"><verse number="24" style="v" sid="MAT 20:24"/>And having heard, the ten were indignant about the two brothers. <verse eid="MAT 20:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 20:25"/>But Jesus, having summoned them, said, <char style="wj">“You⁺ know that the rulers of the Gentiles exercise lordship over them, and the great ones exercise authority over them. </char><verse eid="MAT 20:25"/></para>

<para style="p"><verse number="26" style="v" sid="MAT 20:26"/><char style="wj">It will not be</char><note caller="+" style="f"><char style="fr" closed="false">20.26 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">But it will not be</char></note><char style="wj"> this way among you⁺. But whoever may want to become great among you⁺, he will be your⁺ servant; </char><verse eid="MAT 20:26"/></para>

<para style="p"><verse number="27" style="v" sid="MAT 20:27"/><char style="wj">and whoever may want to be first among you⁺, he will be your⁺ slave— </char><verse eid="MAT 20:27"/></para>

<para style="p"><verse number="28" style="v" sid="MAT 20:28"/><char style="wj">even as the Son of Man did not come to be served, but to serve, and to give His life as a ransom for many.”</char> <verse eid="MAT 20:28"/></para>

<para style="s">The Blind Men by the RoadMark 10:46–52</para>

<para style="p"><verse number="29" style="v" sid="MAT 20:29"/><note caller="-" style="x"><char style="xt" closed="false">Luke 18:35–43</char></note>And <char style="add">in</char> their going out from Jericho, a great crowd followed Him. <verse eid="MAT 20:29"/></para>

<para style="p"><verse number="30" style="v" sid="MAT 20:30"/>And behold, two blind <char style="add">men</char> sitting beside the road, having heard that Jesus is passing by, cried out, saying, “Lord, have mercy on us, Son of David!” <verse eid="MAT 20:30"/></para>

<para style="p"><verse number="31" style="v" sid="MAT 20:31"/>And the crowd rebuked them, that they should be silent. But they cried out all the more, saying, “Lord, have mercy on us, Son of David!” <verse eid="MAT 20:31"/></para>

<para style="p"><verse number="32" style="v" sid="MAT 20:32"/>And having stood, Jesus called them and said, <char style="wj">“What do you⁺ want that I may do for you⁺?”</char> <verse eid="MAT 20:32"/></para>

<para style="p"><verse number="33" style="v" sid="MAT 20:33"/>They say to Him, “Lord, that our eyes may be opened.” <verse eid="MAT 20:33"/></para>

<para style="p"><verse number="34" style="v" sid="MAT 20:34"/>And having been moved with compassion, Jesus touched their eyes, and immediately they received their sight,<note caller="+" style="f"><char style="fr" closed="false">20.34 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">their eyes received sight</char></note> and they followed Him. <verse eid="MAT 20:34"/></para>

<chapter eid="MAT 20"/>

<chapter number="21" style="c" sid="MAT 21"/>

<para style="s">The Triumphal Entry</para>

<para style="p"><verse number="1" style="v" sid="MAT 21:1"/><note caller="-" style="x"><char style="xt" closed="false">John 12:12–19</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 19:28–40</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 11:1–11</char></note><note caller="-" style="x"><char style="xt" closed="false">Zechariah 9:9–13</char></note>And when they drew near to Jerusalem and came to Bethphage<note caller="+" style="f"><char style="fr" closed="false">21.1 </char><char style="ft" closed="false"> MT </char><char style="fq" closed="false">Bethsphage</char></note> on the Mount of Olives, then Jesus sent two disciples, <verse eid="MAT 21:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 21:2"/>saying to them, <char style="wj">“Go into the village ahead of you⁺,</char><note caller="+" style="f"><char style="fr" closed="false">21.2 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">opposite you</char></note><char style="wj"> and immediately you⁺ will find a donkey tied, and a colt with her. Having loosed them, bring them to Me. </char><verse eid="MAT 21:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 21:3"/><char style="wj">And if anyone should say anything to you⁺, you⁺ will say that the Lord has need of them, and immediately he will send them.”</char> <verse eid="MAT 21:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 21:4"/>And this<note caller="+" style="f"><char style="fr" closed="false">21.4 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">And all this</char></note> came to pass so that it might be fulfilled, that having been spoken through the prophet, saying, <verse eid="MAT 21:4"/></para>

<para style="q1"><verse number="5" style="v" sid="MAT 21:5"/>“Say to the daughter of Zion, </para>

<para style="q2" vid="MAT 21:5">‘Behold, your King comes to you, </para>

<para style="q1" vid="MAT 21:5">gentle and mounted on a donkey, </para>

<para style="q2" vid="MAT 21:5">and on a colt, the foal of a beast of burden.’” <note caller="+" style="f"><char style="fr" closed="false">21.5 </char><char style="ft" closed="false"> Zechariah 9:9</char></note><verse eid="MAT 21:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 21:6"/>And the disciples, having gone and having done as Jesus directed them, <verse eid="MAT 21:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 21:7"/>led the donkey and the colt and put their garments on them, and He sat<note caller="+" style="f"><char style="fr" closed="false">21.7 </char><char style="ft" closed="false"> Scrivener TR </char><char style="fq" closed="false">and they set Jesus</char></note> on them. <verse eid="MAT 21:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 21:8"/>And the very large crowd spread their garments in the road, and others were cutting branches from the trees and were spreading <char style="add">them</char> in the road. <verse eid="MAT 21:8"/></para>

<para style="p"><verse number="9" style="v" sid="MAT 21:9"/>And the crowds going before Him and those following were crying out, saying: </para>

<para style="q1" vid="MAT 21:9">“Hosanna to the Son of David!” </para>

<para style="q1" vid="MAT 21:9">“Blessed is the One coming in the name of the Lord!”<note caller="+" style="f"><char style="fr" closed="false">21.9 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Hosanna</char><char style="ft" closed="false"> is a transliteration of the Hebrew </char><char style="fq" closed="false">Hosia-na</char><char style="ft" closed="false">, meaning </char><char style="fq" closed="false">Save, we pray</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">Save now</char><char style="ft" closed="false">, which became a shout of praise; see Psalm 118:25; also in verse 15.</char></note> </para>

<para style="q1" vid="MAT 21:9">“Hosanna in the highest!”<note caller="+" style="f"><char style="fr" closed="false">21.9 </char><char style="ft" closed="false"> Psalm 118:26</char></note> <note caller="+" style="f"><char style="fr" closed="false">21.9 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">“Hosanna in the highest heaven!”</char><char style="ft" closed="false"> See Psalm 118:25 and Psalm 148:1.</char></note><verse eid="MAT 21:9"/></para>

<para style="p"><verse number="10" style="v" sid="MAT 21:10"/>And <char style="add">on</char> His having entered into Jerusalem, all the city was shaken, saying, “Who is this?” <verse eid="MAT 21:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 21:11"/>And the crowds were saying, “This is the prophet, Jesus, the One from Nazareth of Galilee.” <verse eid="MAT 21:11"/></para>

<para style="s">Jesus Cleanses the TempleMark 11:15–19</para>

<para style="p"><verse number="12" style="v" sid="MAT 21:12"/><note caller="-" style="x"><char style="xt" closed="false">John 2:12–25</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 19:45–48</char></note>And Jesus entered into the temple<note caller="+" style="f"><char style="fr" closed="false">21.12 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the temple courts</char><char style="ft" closed="false">; also in verses 15 and 23; BYZ and TR </char><char style="fq" closed="false">the temple of God</char></note> and cast out all those selling and buying in the temple. And He overturned the tables of the money changers and the seats of those selling the doves. <verse eid="MAT 21:12"/></para>

<para style="p"><verse number="13" style="v" sid="MAT 21:13"/>And He says to them, <char style="wj">“It has been written: ‘My house will be called a house of prayer.’ But you⁺ are making</char><note caller="+" style="f"><char style="fr" closed="false">21.13 </char><char style="ft" closed="false"> Isaiah 56:7</char></note><char style="wj"> it ‘a den of robbers.’</char><note caller="+" style="f"><char style="fr" closed="false">21.13 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">you have made</char></note><char style="wj">”</char> <note caller="+" style="f"><char style="fr" closed="false">21.13 </char><char style="ft" closed="false"> Jeremiah 7:11</char></note><verse eid="MAT 21:13"/></para>

<para style="p"><verse number="14" style="v" sid="MAT 21:14"/>And the blind and the lame<note caller="+" style="f"><char style="fr" closed="false">21.14 </char><char style="ft" closed="false"> BYZ </char><char style="fq" closed="false">lame ones and blind ones</char></note> came to Him in the temple, and He healed them. <verse eid="MAT 21:14"/></para>

<para style="p"><verse number="15" style="v" sid="MAT 21:15"/>But the chief priests and the scribes, having seen the wonders that He did and the children crying out in the temple and saying, “Hosanna to the Son of David,” were indignant. <verse eid="MAT 21:15"/></para>

<para style="p"><verse number="16" style="v" sid="MAT 21:16"/>And they said to Him, “Do You hear what these say?” </para>

<para style="p" vid="MAT 21:16">And Jesus says to them, <char style="wj">“Yes. Did you⁺ never read: </char></para>

<para style="q1" vid="MAT 21:16">‘Out of the mouth of babes and sucklings </para>

<para style="q2" vid="MAT 21:16">You prepared praise’?” <note caller="+" style="f"><char style="fr" closed="false">21.16 </char><char style="ft" closed="false"> Psalm 8:2 (see also LXX)</char></note><verse eid="MAT 21:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 21:17"/>And having left them, He went out of the city to Bethany, and He lodged there. <verse eid="MAT 21:17"/></para>

<para style="s">The Barren Fig TreeMark 11:12–14</para>

<para style="p"><verse number="18" style="v" sid="MAT 21:18"/><note caller="-" style="x"><char style="xt" closed="false">Mark 11:20–25</char></note>And in the morning, having come back into the city, He was hungry. <verse eid="MAT 21:18"/></para>

<para style="p"><verse number="19" style="v" sid="MAT 21:19"/>And having seen one fig tree on the way, He went to it and found nothing on it except leaves. And He says to it, <char style="wj">“Never let there be anymore fruit out of you, to the age!”</char> And the fig tree withered immediately. <verse eid="MAT 21:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 21:20"/>And having seen <char style="add">it</char>, the disciples marveled, saying, “How did the fig tree wither immediately?” <verse eid="MAT 21:20"/></para>

<para style="p"><verse number="21" style="v" sid="MAT 21:21"/>And answering, Jesus said to them, <char style="wj">“Truly I say to you⁺, if you⁺ shall have faith and not doubt, you⁺ will do not only this of the fig tree, but even if you⁺ should say to this mountain, ‘Be taken away and be cast into the sea,’ it will come to pass. </char><verse eid="MAT 21:21"/></para>

<para style="p"><verse number="22" style="v" sid="MAT 21:22"/><char style="wj">And all things, as many as you⁺ might ask in prayer, believing, you⁺ will receive.”</char> <verse eid="MAT 21:22"/></para>

<para style="s">Jesus’ Authority ChallengedMark 11:27–33</para>

<para style="p"><verse number="23" style="v" sid="MAT 21:23"/><note caller="-" style="x"><char style="xt" closed="false">Luke 20:1–8</char></note>And <char style="add">on</char> His having come into the temple teaching, the chief priests and the elders of the people came to Him, saying, “By what authority do You do these things?” And who gave You this authority? <verse eid="MAT 21:23"/></para>

<para style="p"><verse number="24" style="v" sid="MAT 21:24"/>And answering, Jesus said to them, <char style="wj">“I will also ask you⁺ one word, which if you⁺ tell Me, I will also tell you⁺ by what authority I do these things. </char><verse eid="MAT 21:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 21:25"/><char style="wj">From where was the baptism of John? From heaven or from men?”</char> And they were reasoning among themselves, saying, “If we should say, ‘From heaven,’ He will say to us, ‘Why then did you⁺ not believe him?’ <verse eid="MAT 21:25"/></para>

<para style="p"><verse number="26" style="v" sid="MAT 21:26"/>But if we should say, ‘From men,’ we fear the crowd, for all hold John as a prophet.” <verse eid="MAT 21:26"/></para>

<para style="p"><verse number="27" style="v" sid="MAT 21:27"/>And answering Jesus, they said, “We do not know.” </para>

<para style="p" vid="MAT 21:27">And He said to them, <char style="wj">“Neither do I tell you⁺ by what authority I do these things. </char><verse eid="MAT 21:27"/></para>

<para style="s">The Parable of the Two Sons</para>

<para style="p"><verse number="28" style="v" sid="MAT 21:28"/>But what do you⁺ think? A man had two sons, and having come to the first he said, ‘Son, go today, work in the vineyard.<note caller="+" style="f"><char style="fr" closed="false">21.28 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">in my vineyard</char></note>’ <verse eid="MAT 21:28"/></para>

<para style="p"><verse number="29" style="v" sid="MAT 21:29"/>And answering, he said, ‘I will not.’ But afterward, having repented, he went.<note caller="+" style="f"><char style="fr" closed="false">21.29 </char><char style="ft" closed="false"> NE and WH </char><char style="fq" closed="false">But he went.</char></note> <verse eid="MAT 21:29"/></para>

<para style="p"><verse number="30" style="v" sid="MAT 21:30"/>And having come to the second,<note caller="+" style="f"><char style="fr" closed="false">21.30 </char><char style="ft" closed="false"> ALT, HF, NA, and F35 </char><char style="fq" closed="false">other</char><char style="ft" closed="false"> </char></note> he said likewise. </para>

<para style="p" vid="MAT 21:30">And answering, he said, ‘I <char style="add">will</char> sir,’ and he did not go. <verse eid="MAT 21:30"/></para>

<para style="p"><verse number="31" style="v" sid="MAT 21:31"/>Which of the two did the will of the father?” </para>

<para style="p" vid="MAT 21:31">They say, “The<note caller="+" style="f"><char style="fr" closed="false">21.31 </char><char style="ft" closed="false"> NE and WH </char><char style="fq" closed="false">The latter</char></note> first.” Jesus says to them, <char style="wj">“Truly I say to you⁺ that the tax collectors and the prostitutes go before you⁺ into the kingdom of God. </char><verse eid="MAT 21:31"/></para>

<para style="p"><verse number="32" style="v" sid="MAT 21:32"/><char style="wj">For John came to you⁺ in the way of righteousness, and you⁺ did not believe him, but the tax collectors and the prostitutes believed him. And you⁺, having seen, did not even repent afterward to believe him. </char><verse eid="MAT 21:32"/></para>

<para style="s">The Parable of the Wicked TenantsMark 12:1–12</para>

<para style="p"><verse number="33" style="v" sid="MAT 21:33"/><note caller="-" style="x"><char style="xt" closed="false">Luke 20:9–18</char></note>Hear another parable: There was a man, a master of a house, who planted a vineyard, and placed around it a fence, and dug a winepress in it, and built a tower. And he rented it out to farmers and traveled abroad. <verse eid="MAT 21:33"/></para>

<para style="p"><verse number="34" style="v" sid="MAT 21:34"/>And when the season of the fruits drew near, he sent his servants to the farmers to receive his fruits. <verse eid="MAT 21:34"/></para>

<para style="p"><verse number="35" style="v" sid="MAT 21:35"/>And the farmers, having taken his servants, one they beat, and one they killed, and one they stoned. <verse eid="MAT 21:35"/></para>

<para style="p"><verse number="36" style="v" sid="MAT 21:36"/>Again he sent other servants, more than the first, and they did likewise to them. <verse eid="MAT 21:36"/></para>

<para style="p"><verse number="37" style="v" sid="MAT 21:37"/>And afterward he sent his son to them, saying, ‘They will respect my son.’ <verse eid="MAT 21:37"/></para>

<para style="p"><verse number="38" style="v" sid="MAT 21:38"/>But the farmers, having seen the son, said among themselves, ‘This is the heir. Come, let us kill him and gain possession of his inheritance.’ <verse eid="MAT 21:38"/></para>

<para style="p"><verse number="39" style="v" sid="MAT 21:39"/>And having taken him, they cast <char style="add">him</char> out of the vineyard and killed <char style="add">him</char>. <verse eid="MAT 21:39"/></para>

<para style="p"><verse number="40" style="v" sid="MAT 21:40"/>Therefore, when the lord of the vineyard shall come, what will he do to those farmers?” <verse eid="MAT 21:40"/></para>

<para style="p"><verse number="41" style="v" sid="MAT 21:41"/>They say to Him, “He will destroy those evil ones grievously, and he will give out the vineyard to other farmers who will give back to him the fruits in their seasons.” <verse eid="MAT 21:41"/></para>

<para style="p"><verse number="42" style="v" sid="MAT 21:42"/>Jesus says to them, <char style="wj">“Did you⁺ never read in the Scriptures: </char></para>

<para style="q1" vid="MAT 21:42">‘The stone that those building rejected, </para>

<para style="q2" vid="MAT 21:42">this became the head of the corner. </para>

<para style="q1" vid="MAT 21:42">This was from the Lord, </para>

<para style="q2" vid="MAT 21:42">and it is marvelous in our eyes’? <note caller="+" style="f"><char style="fr" closed="false">21.42 </char><char style="ft" closed="false"> Psalm 118:22–23</char></note><verse eid="MAT 21:42"/></para>

<para style="p"><verse number="43" style="v" sid="MAT 21:43"/>Because of this I say to you⁺ that the kingdom of God will be taken away from you⁺, and it will be given to a people producing its fruits. <verse eid="MAT 21:43"/></para>

<para style="p"><verse number="44" style="v" sid="MAT 21:44"/>And the one having fallen on this stone will be broken; but on whomever it might fall, it will grind him to powder.<note caller="+" style="f"><char style="fr" closed="false">21.44 </char><char style="ft" closed="false"> Tischendorf and some early manuscripts do not include verse 44; see also Luke 20:18.</char></note>” <verse eid="MAT 21:44"/></para>

<para style="p"><verse number="45" style="v" sid="MAT 21:45"/>And the chief priests and the Pharisees, having heard His parables, knew that He speaks about them. <verse eid="MAT 21:45"/></para>

<para style="p"><verse number="46" style="v" sid="MAT 21:46"/>And seeking to lay hold of Him, they feared the crowds, because they were holding Him as a prophet. <verse eid="MAT 21:46"/></para>

<chapter eid="MAT 21"/>

<chapter number="22" style="c" sid="MAT 22"/>

<para style="s">The Parable of the Banquet</para>

<para style="p"><verse number="1" style="v" sid="MAT 22:1"/><note caller="-" style="x"><char style="xt" closed="false">Luke 14:15–24</char></note>And answering, Jesus again spoke to them in parables, saying: <verse eid="MAT 22:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 22:2"/><char style="wj">“The kingdom of the heavens was likened to a man, a king, who made a wedding feast for his son. </char><verse eid="MAT 22:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 22:3"/><char style="wj">And he sent his servants to call those having been called to the wedding feast, and they were not willing to come. </char><verse eid="MAT 22:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 22:4"/>Again he sent other servants, saying, ‘Say to those having been called: Behold, I have prepared my dinner. My oxen and fatlings have been killed, and all things <char style="add">are</char> ready; come to the wedding feast.’ <verse eid="MAT 22:4"/></para>

<para style="p"><verse number="5" style="v" sid="MAT 22:5"/>And having disregarded <char style="add">it</char>, they went away, one to <char style="add">his</char> own field, and one to his business. <verse eid="MAT 22:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 22:6"/>And the rest, having laid hold of his servants, mistreated and killed <char style="add">them</char>. <verse eid="MAT 22:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 22:7"/>And<note caller="+" style="f"><char style="fr" closed="false">22.7 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">when he heard this</char><char style="ft" closed="false">.</char></note> the king was enraged, and having sent his armies, he destroyed those murderers and set on fire their city. <verse eid="MAT 22:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 22:8"/>Then he says to his servants, ‘Indeed, the wedding feast is ready, but those having been called were not worthy. <verse eid="MAT 22:8"/></para>

<para style="p"><verse number="9" style="v" sid="MAT 22:9"/>Therefore go on the thoroughfares of the roads and call to the wedding feast as many as you⁺ may find.’ <verse eid="MAT 22:9"/></para>

<para style="p"><verse number="10" style="v" sid="MAT 22:10"/>And those servants, having gone out into the roads, gathered together all whom they found, both evil and good, and the wedding feast was filled with those reclining. <verse eid="MAT 22:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 22:11"/>And the king, having entered to view those reclining, saw a man there not dressed in clothing of a wedding feast. <verse eid="MAT 22:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 22:12"/>And he says to him, ‘Friend, how did you enter here not having clothing of a wedding feast?’ </para>

<para style="p" vid="MAT 22:12">And he was speechless. <verse eid="MAT 22:12"/></para>

<para style="p"><verse number="13" style="v" sid="MAT 22:13"/>Then the king said to the servants, ‘Having bound his feet and hands, cast him out<note caller="+" style="f"><char style="fr" closed="false">22.13 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">take him away and cast him out</char></note> into the outer darkness—there will be weeping and gnashing of the teeth.’ <verse eid="MAT 22:13"/></para>

<para style="p"><verse number="14" style="v" sid="MAT 22:14"/>For many are called, but few chosen.” <verse eid="MAT 22:14"/></para>

<para style="s">Paying Taxes to CaesarMark 12:13–17</para>

<para style="p"><verse number="15" style="v" sid="MAT 22:15"/><note caller="-" style="x"><char style="xt" closed="false">Luke 20:19–26</char></note>Then having gone, the Pharisees took counsel <char style="add">as to</char> how they might trap Him in a word. <verse eid="MAT 22:15"/></para>

<para style="p"><verse number="16" style="v" sid="MAT 22:16"/>And they send to Him their disciples with the Herodians, saying, “Teacher, we know that You are true, and You teach the way of God in truth. And to You there is care about no one, for You do not look to the appearance of men. <verse eid="MAT 22:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 22:17"/>Therefore tell us, what do You think? Is it lawful to give tribute to Caesar or not?” <verse eid="MAT 22:17"/></para>

<para style="p"><verse number="18" style="v" sid="MAT 22:18"/>But having known their malice, Jesus said, <char style="wj">“Why do you⁺ test Me, hypocrites? </char><verse eid="MAT 22:18"/></para>

<para style="p"><verse number="19" style="v" sid="MAT 22:19"/><char style="wj">Show Me the coin of the tribute.”</char> </para>

<para style="p" vid="MAT 22:19">And they presented to Him a denarius.<note caller="+" style="f"><char style="fr" closed="false">22.19 </char><char style="ft" closed="false"> A denarius was customarily a day’s wage for a laborer; see Matthew 20:2.</char></note> <verse eid="MAT 22:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 22:20"/>And He says to them, <char style="wj">“Whose is this image, and the inscription?”</char> <verse eid="MAT 22:20"/></para>

<para style="p"><verse number="21" style="v" sid="MAT 22:21"/>They say to Him, “Caesar’s.” </para>

<para style="p" vid="MAT 22:21">Then He says to them, <char style="wj">“Therefore give back the things of Caesar to Caesar, and the things of God to God.”</char> <verse eid="MAT 22:21"/></para>

<para style="p"><verse number="22" style="v" sid="MAT 22:22"/>And having heard, they marveled. And having left Him, they went away. <verse eid="MAT 22:22"/></para>

<para style="s">The Sadducees and the ResurrectionMark 12:18–27</para>

<para style="p"><verse number="23" style="v" sid="MAT 22:23"/><note caller="-" style="x"><char style="xt" closed="false">Luke 20:27–40</char></note>On that day Sadducees, saying there is not a resurrection, came to Him, and they questioned Him, <verse eid="MAT 22:23"/></para>

<para style="p"><verse number="24" style="v" sid="MAT 22:24"/>saying, “Teacher, Moses said <char style="add">that</char> if anyone should die not having children, his brother will marry his wife and will raise up seed for his brother. <note caller="+" style="f"><char style="fr" closed="false">22.24 </char><char style="ft" closed="false"> Deuteronomy 25:5</char></note><verse eid="MAT 22:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 22:25"/>Now there were seven brothers with us. And the first, having married, died; and not having seed, he left his wife to his brother. <verse eid="MAT 22:25"/></para>

<para style="p"><verse number="26" style="v" sid="MAT 22:26"/>Likewise also the second, and the third, to the seventh. <verse eid="MAT 22:26"/></para>

<para style="p"><verse number="27" style="v" sid="MAT 22:27"/>And last of all, the woman died.<note caller="+" style="f"><char style="fr" closed="false">22.27 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">also died</char></note> <verse eid="MAT 22:27"/></para>

<para style="p"><verse number="28" style="v" sid="MAT 22:28"/>In the resurrection, therefore, of which of the seven will she be wife? For all had her.” <verse eid="MAT 22:28"/></para>

<para style="p"><verse number="29" style="v" sid="MAT 22:29"/>And answering, Jesus said to them, <char style="wj">“You⁺ go astray, not knowing the Scriptures, nor the power of God. </char><verse eid="MAT 22:29"/></para>

<para style="p"><verse number="30" style="v" sid="MAT 22:30"/><char style="wj">For in the resurrection, they neither marry nor are they given in marriage, but they are like angels</char><note caller="+" style="f"><char style="fr" closed="false">22.30 </char><char style="ft" closed="false"> SBL, BYZ, and TR </char><char style="fq" closed="false">angels of God</char></note><char style="wj"> in heaven. </char><verse eid="MAT 22:30"/></para>

<para style="p"><verse number="31" style="v" sid="MAT 22:31"/><char style="wj">But concerning the resurrection of the dead, did you⁺ not read what has been spoken to you⁺ by God, saying, </char><verse eid="MAT 22:31"/></para>

<para style="p"><verse number="32" style="v" sid="MAT 22:32"/><char style="wj">‘I am the God of Abraham and the God of Isaac and the God of Jacob’? He is not the God of the dead, but of the living.”</char> <note caller="+" style="f"><char style="fr" closed="false">22.32 </char><char style="ft" closed="false"> Exodus 3:6</char></note><verse eid="MAT 22:32"/></para>

<para style="p"><verse number="33" style="v" sid="MAT 22:33"/>And having heard, the crowds were astonished at His teaching. <verse eid="MAT 22:33"/></para>

<para style="s">The Greatest CommandmentDeuteronomy 6:1–19</para>

<para style="p"><verse number="34" style="v" sid="MAT 22:34"/><note caller="-" style="x"><char style="xt" closed="false">Mark 12:28–34</char></note>And the Pharisees, having heard that He silenced the Sadducees, were gathered at the same <char style="add">place</char>. <verse eid="MAT 22:34"/></para>

<para style="p"><verse number="35" style="v" sid="MAT 22:35"/>And one of them, a lawyer, questioned, testing Him, <verse eid="MAT 22:35"/></para>

<para style="p"><verse number="36" style="v" sid="MAT 22:36"/>“Teacher, which <char style="add">is</char> the great commandment in the Law?” <verse eid="MAT 22:36"/></para>

<para style="p"><verse number="37" style="v" sid="MAT 22:37"/>And He said to him, <char style="wj">“‘You shall love the Lord your God with all your heart and with all your soul and with all your mind.’ </char><note caller="+" style="f"><char style="fr" closed="false">22.37 </char><char style="ft" closed="false"> Deuteronomy 6:5</char></note><verse eid="MAT 22:37"/></para>

<para style="p"><verse number="38" style="v" sid="MAT 22:38"/><char style="wj">This is the great and first</char><note caller="+" style="f"><char style="fr" closed="false">22.38 </char><char style="ft" closed="false"> RP and TR </char><char style="fq" closed="false">first and great</char><char style="ft" closed="false">; many modern translations hold to the familiar </char><char style="fq" closed="false">first and greatest</char><char style="ft" closed="false">.</char></note><char style="wj"> commandment. </char><verse eid="MAT 22:38"/></para>

<para style="p"><verse number="39" style="v" sid="MAT 22:39"/><char style="wj">And the second is like it: ‘You shall love your neighbor as yourself.’ </char><note caller="+" style="f"><char style="fr" closed="false">22.39 </char><char style="ft" closed="false"> Leviticus 19:18</char></note><verse eid="MAT 22:39"/></para>

<para style="p"><verse number="40" style="v" sid="MAT 22:40"/><char style="wj">On these two commandments hang all the Law and the Prophets.”</char> <verse eid="MAT 22:40"/></para>

<para style="s">Whose Son Is the Christ?Mark 12:35–37</para>

<para style="p"><verse number="41" style="v" sid="MAT 22:41"/><note caller="-" style="x"><char style="xt" closed="false">Luke 20:41–44</char></note>And the Pharisees having been assembled together, Jesus questioned them, <verse eid="MAT 22:41"/></para>

<para style="p"><verse number="42" style="v" sid="MAT 22:42"/>saying, <char style="wj">“What do you⁺ think about the Christ? Of whom is He son?”</char> </para>

<para style="p" vid="MAT 22:42">They say to Him, “Of David.” <verse eid="MAT 22:42"/></para>

<para style="p"><verse number="43" style="v" sid="MAT 22:43"/>He says to them, <char style="wj">“How then does David in the Spirit call Him ‘Lord,’ saying: </char><verse eid="MAT 22:43"/></para>

<para style="q1"><verse number="44" style="v" sid="MAT 22:44"/>‘The Lord said to my Lord, </para>

<para style="q2" vid="MAT 22:44">“Sit at My right hand </para>

<para style="q1" vid="MAT 22:44">until I place Your enemies </para>

<para style="q2" vid="MAT 22:44"><char style="add">as</char> a footstool for Your feet”’? <note caller="+" style="f"><char style="fr" closed="false">22.44 </char><char style="ft" closed="false"> Psalm 110:1</char></note><verse eid="MAT 22:44"/></para>

<para style="p"><verse number="45" style="v" sid="MAT 22:45"/>If, therefore, David calls Him ‘Lord,’ how is He his son?” <verse eid="MAT 22:45"/></para>

<para style="p"><verse number="46" style="v" sid="MAT 22:46"/>And no one was able to answer Him a word, nor did anyone dare from that day to question Him <char style="add">any</char> longer. <verse eid="MAT 22:46"/></para>

<chapter eid="MAT 22"/>

<chapter number="23" style="c" sid="MAT 23"/>

<para style="s">Woes to Scribes and Pharisees</para>

<para style="p"><verse number="1" style="v" sid="MAT 23:1"/><note caller="-" style="x"><char style="xt" closed="false">Luke 11:37–54</char></note>Then Jesus spoke to the crowds and to His disciples, <verse eid="MAT 23:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 23:2"/>saying, <char style="wj">“The scribes and the Pharisees sat down on Moses’ seat. </char><verse eid="MAT 23:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 23:3"/><char style="wj">Therefore do and observe all things, whatsoever they might tell you⁺.</char><note caller="+" style="f"><char style="fr" closed="false">23.3 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">tell you to observe</char></note><char style="wj"> But do not do according to their works, for they speak and do not do. </char><verse eid="MAT 23:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 23:4"/><char style="wj">And they tie up burdens heavy and hard to bear,</char><note caller="+" style="f"><char style="fr" closed="false">23.4 </char><char style="ft" closed="false"> SBL, NE, and WH </char><char style="fq" closed="false">They tie up heavy burdens</char></note><char style="wj"> and they lay them on the shoulders of men; but they themselves are not willing to move them with their finger. </char><verse eid="MAT 23:4"/></para>

<para style="p"><verse number="5" style="v" sid="MAT 23:5"/>And they do all their works in order to be seen by men. For they broaden their phylacteries and lengthen their tassels.<note caller="+" style="f"><char style="fr" closed="false">23.5 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">the tassels of their garments</char></note> <verse eid="MAT 23:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 23:6"/>And they love the chief place at the suppers, and the first seats in the synagogues, <verse eid="MAT 23:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 23:7"/>and the greetings in the marketplaces, and to be called ‘Rabbi’<note caller="+" style="f"><char style="fr" closed="false">23.7 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">‘Rabbi, Rabbi’</char></note> by men. <verse eid="MAT 23:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 23:8"/>But you⁺ shall not be called ‘Rabbi,’ for your⁺ Teacher<note caller="+" style="f"><char style="fr" closed="false">23.8 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">your Teacher the Christ</char></note> is One, and you⁺ are all brothers. <verse eid="MAT 23:8"/></para>

<para style="p"><verse number="9" style="v" sid="MAT 23:9"/>And you⁺ shall call no one your⁺ father on the earth, for One is your⁺ Father who <char style="add">is</char> in heaven. <verse eid="MAT 23:9"/></para>

<para style="p"><verse number="10" style="v" sid="MAT 23:10"/>Neither shall you⁺ be called instructors, because One is your⁺ Instructor, the Christ. <verse eid="MAT 23:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 23:11"/>But the greatest among you⁺ will be your⁺ servant. <verse eid="MAT 23:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 23:12"/>And whoever will exalt himself will be humbled, and whoever will humble himself will be exalted. <verse eid="MAT 23:12"/></para>

<para style="p"><verse number="13" style="v" sid="MAT 23:13"/>But woe to you⁺, scribes and Pharisees, hypocrites! For you⁺ shut up the kingdom of the heavens before men. For you⁺ do not enter, nor even do you⁺ allow those who are entering to enter.<note caller="+" style="f"><char style="fr" closed="false">23.13 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">14</char><char style="fq" closed="false">Woe to you, scribes and Pharisees, hypocrites! For you defraud widows of their houses, and pray at great length as a pretext; because of this you will receive greater condemnation.</char><char style="ft" closed="false"> See Mark 12:40 and Luke 20:47.</char></note> <verse eid="MAT 23:13"/></para>

<para style="p"><verse number="15" style="v" sid="MAT 23:15"/>Woe to you⁺, scribes and Pharisees, hypocrites! For you⁺ traverse the sea and the dry land to make one convert, and when he might become one, you⁺ make him twofold more a son of Gehenna<note caller="+" style="f"><char style="fr" closed="false">23.15 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">hell</char><char style="ft" closed="false">; also in verse 33</char></note> than yourselves. <verse eid="MAT 23:15"/></para>

<para style="p"><verse number="16" style="v" sid="MAT 23:16"/>Woe to you⁺, blind guides, those saying, ‘Whoever shall swear by the temple, it is nothing; but whoever shall swear by the gold of the temple is bound by his oath.’ <verse eid="MAT 23:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 23:17"/>Foolish and blind ones! For which is greater: the gold, or the temple having sanctified the gold? <verse eid="MAT 23:17"/></para>

<para style="p"><verse number="18" style="v" sid="MAT 23:18"/>And <char style="add">you say</char>, ‘Whoever shall swear by the altar, it is nothing; but whoever shall swear by the gift that <char style="add">is</char> upon it is bound by his oath.’ <verse eid="MAT 23:18"/></para>

<para style="p"><verse number="19" style="v" sid="MAT 23:19"/>Blind ones!<note caller="+" style="f"><char style="fr" closed="false">23.19 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">Foolish and blind ones</char></note> For which <char style="add">is</char> greater: the gift, or the altar sanctifying the gift? <verse eid="MAT 23:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 23:20"/>Therefore the one having sworn by the altar swears by it and by all things that <char style="add">are</char> upon it. <verse eid="MAT 23:20"/></para>

<para style="p"><verse number="21" style="v" sid="MAT 23:21"/>And the one having sworn by the temple swears by it and by the One dwelling in it. <verse eid="MAT 23:21"/></para>

<para style="p"><verse number="22" style="v" sid="MAT 23:22"/>And the one having sworn by heaven swears by the throne of God and by the One sitting upon it. <verse eid="MAT 23:22"/></para>

<para style="p"><verse number="23" style="v" sid="MAT 23:23"/>Woe to you⁺, scribes and Pharisees, hypocrites! For you⁺ pay tithes of mint and dill and cumin, and you⁺ left aside the weightier <char style="add">things</char> of the law: justice and mercy and faithfulness. And it was necessary to do these, and those not to leave aside. <verse eid="MAT 23:23"/></para>

<para style="p"><verse number="24" style="v" sid="MAT 23:24"/>Blind guides—those straining out the gnat and swallowing up the camel!<note caller="+" style="f"><char style="fr" closed="false">23.24 </char><char style="ft" closed="false"> See Leviticus 11:4 and Leviticus 11:23, where camels and gnats are both forbidden as food.</char></note> <verse eid="MAT 23:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 23:25"/>Woe to you⁺, scribes and Pharisees, hypocrites! For you⁺ cleanse the outside of the cup and of the dish, but inside they are full of plundering and self-indulgence.<note caller="+" style="f"><char style="fr" closed="false">23.25 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">plundering and excess</char></note> <verse eid="MAT 23:25"/></para>

<para style="p"><verse number="26" style="v" sid="MAT 23:26"/>Blind Pharisee! First cleanse the inside of the cup and of the dish,<note caller="+" style="f"><char style="fr" closed="false">23.26 </char><char style="ft" closed="false"> NA does not include </char><char style="fq" closed="false">and of the dish</char><char style="ft" closed="false">.</char></note> so that its outside might become clean also. <verse eid="MAT 23:26"/></para>

<para style="p"><verse number="27" style="v" sid="MAT 23:27"/>Woe to you⁺, scribes and Pharisees, hypocrites, because you⁺ are like whitewashed tombs, which indeed on the outside appear beautiful, but on the inside they are full of bones of the dead and of all uncleanness. <verse eid="MAT 23:27"/></para>

<para style="p"><verse number="28" style="v" sid="MAT 23:28"/>Thus also on the outside you⁺ indeed appear righteous to men, but on the inside you⁺ are full of hypocrisy and lawlessness. <verse eid="MAT 23:28"/></para>

<para style="p"><verse number="29" style="v" sid="MAT 23:29"/>Woe to you⁺, scribes and Pharisees, hypocrites! For you⁺ build the tombs of the prophets and adorn the monuments of the righteous. <verse eid="MAT 23:29"/></para>

<para style="p"><verse number="30" style="v" sid="MAT 23:30"/>And you⁺ say, ‘If we had been in the days of our fathers, we would not have been partakers with them in the blood of the prophets.’ <verse eid="MAT 23:30"/></para>

<para style="p"><verse number="31" style="v" sid="MAT 23:31"/>Thus you⁺ bear witness to yourselves that you⁺ are sons of those having murdered the prophets. <verse eid="MAT 23:31"/></para>

<para style="p"><verse number="32" style="v" sid="MAT 23:32"/>And you⁺, fill up the measure of your⁺ fathers. <verse eid="MAT 23:32"/></para>

<para style="p"><verse number="33" style="v" sid="MAT 23:33"/>Serpents! Offspring of vipers! How shall you⁺ escape from the judgment of Gehenna? <verse eid="MAT 23:33"/></para>

<para style="p"><verse number="34" style="v" sid="MAT 23:34"/>Because of this, behold, I send to you⁺ prophets and wise <char style="add">men</char> and scribes. Some of them you⁺ will kill and crucify, and some of them you⁺ will flog in your⁺ synagogues and will persecute from city to city, <verse eid="MAT 23:34"/></para>

<para style="p"><verse number="35" style="v" sid="MAT 23:35"/>so that upon you⁺ shall come all the righteous blood being poured out upon the earth, from the blood of the righteous Abel to the blood of Zechariah son of Berechiah,<note caller="+" style="f"><char style="fr" closed="false">23.35 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">Barachiah</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">Berachiah</char></note> whom you⁺ murdered between the temple and the altar. <verse eid="MAT 23:35"/></para>

<para style="p"><verse number="36" style="v" sid="MAT 23:36"/>Truly I say to you⁺, all these things will come upon this generation. <verse eid="MAT 23:36"/></para>

<para style="s">Lament over JerusalemLuke 13:31–35</para>

<para style="p"><verse number="37" style="v" sid="MAT 23:37"/>O Jerusalem, Jerusalem, killing the prophets and stoning those sent to her! How often I willed to gather together your children, the way that a hen gathers together her chicks under the wings, and you⁺ were not willing! <verse eid="MAT 23:37"/></para>

<para style="p"><verse number="38" style="v" sid="MAT 23:38"/>Behold, your⁺ house is left to you⁺ desolate!<note caller="+" style="f"><char style="fr" closed="false">23.38 </char><char style="ft" closed="false"> NE and WH do not include </char><char style="fq" closed="false">desolate</char><char style="ft" closed="false">.</char></note> <verse eid="MAT 23:38"/></para>

<para style="p"><verse number="39" style="v" sid="MAT 23:39"/>For I say to you⁺, you⁺ shall not see Me from now until you⁺ say, ‘Blessed <char style="add">is</char> the One coming in the name of the Lord.’” <note caller="+" style="f"><char style="fr" closed="false">23.39 </char><char style="ft" closed="false"> Psalm 118:26</char></note><verse eid="MAT 23:39"/></para>

<chapter eid="MAT 23"/>

<chapter number="24" style="c" sid="MAT 24"/>

<para style="s">Temple Destruction and Other Signs</para>

<para style="p"><verse number="1" style="v" sid="MAT 24:1"/><note caller="-" style="x"><char style="xt" closed="false">Luke 21:5–9</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 13:1–8</char></note>And having gone out from the temple, Jesus was going, and His disciples came near to point out to Him the buildings of the temple. <verse eid="MAT 24:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 24:2"/>And answering, He said to them,<note caller="+" style="f"><char style="fr" closed="false">24.2 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">Jesus said to them</char></note> <char style="wj">“Do you⁺ not see all these things? Truly I say to you⁺, not one stone here shall be left upon a stone, which will not be thrown down.”</char> <verse eid="MAT 24:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 24:3"/>And He sitting upon the Mount of Olives, the disciples came to Him by Himself, saying, “Tell us when these things will be. And what <char style="add">is</char> the sign of Your coming and the consummation of the age?” <verse eid="MAT 24:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 24:4"/>And answering, Jesus said to them, <char style="wj">“Take heed, lest anyone may lead you⁺ astray. </char><verse eid="MAT 24:4"/></para>

<para style="p"><verse number="5" style="v" sid="MAT 24:5"/><char style="wj">For many will come in My name, saying, ‘I am the Christ,’ and they will lead many astray. </char><verse eid="MAT 24:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 24:6"/><char style="wj">And you⁺ will begin</char><note caller="+" style="f"><char style="fr" closed="false">24.6 </char><char style="ft" closed="false"> F35 </char><char style="fq" closed="false">you will be concerned</char></note><char style="wj"> to hear of wars and rumors of wars. Behold, do not be alarmed; for it is necessary</char><note caller="+" style="f"><char style="fr" closed="false">24.6 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">For all is necessary</char></note><char style="wj"> to happen, but the end is not yet. </char><verse eid="MAT 24:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 24:7"/><char style="wj">For nation will rise up against nation, and kingdom against kingdom, and there will be famines</char><note caller="+" style="f"><char style="fr" closed="false">24.7 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">and pestilences</char><char style="ft" closed="false">.</char></note><char style="wj"> and earthquakes in various places. </char><verse eid="MAT 24:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 24:8"/><char style="wj">And all these are the beginning of birth pains. </char><verse eid="MAT 24:8"/></para>

<para style="s">Witnessing to All NationsMark 13:9–13</para>

<para style="p"><verse number="9" style="v" sid="MAT 24:9"/><note caller="-" style="x"><char style="xt" closed="false">Luke 21:10–19</char></note>Then they will deliver you⁺ up to tribulation, and they will kill you⁺, and you⁺ will be hated by all the nations because of My name. <verse eid="MAT 24:9"/></para>

<para style="p"><verse number="10" style="v" sid="MAT 24:10"/>And then many will be caused to stumble, and they will deliver up one another and will hate one another; <verse eid="MAT 24:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 24:11"/>and many false prophets will arise and will lead many astray. <verse eid="MAT 24:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 24:12"/>And because lawlessness is to be multiplied, the love of many will grow cold. <verse eid="MAT 24:12"/></para>

<para style="p"><verse number="13" style="v" sid="MAT 24:13"/>But the one having endured to the end, he will be saved. <verse eid="MAT 24:13"/></para>

<para style="p"><verse number="14" style="v" sid="MAT 24:14"/>And this gospel of the kingdom will be proclaimed in the whole world for a testimony to all the nations, and then the end will come. <verse eid="MAT 24:14"/></para>

<para style="s">The Abomination of DesolationMark 13:14–23</para>

<para style="p"><verse number="15" style="v" sid="MAT 24:15"/><note caller="-" style="x"><char style="xt" closed="false">Luke 21:20–24</char></note>Therefore, when you⁺ shall see the ‘abomination of the desolation,’ having been spoken of by the<note caller="+" style="f"><char style="fr" closed="false">24.15 </char><char style="ft" closed="false"> See Daniel 9:27, Daniel 11:31, and Daniel 12:11.</char></note> prophet Daniel, standing in the holy place (the one reading, let him understand), <verse eid="MAT 24:15"/></para>

<para style="p"><verse number="16" style="v" sid="MAT 24:16"/>then those in Judea, let them flee to the mountains; <verse eid="MAT 24:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 24:17"/>the one on the housetop, let him not come down to take away the <char style="add">things</char> out of his house; <verse eid="MAT 24:17"/></para>

<para style="p"><verse number="18" style="v" sid="MAT 24:18"/>and the one in the field, let him not return back to take away his garment.<note caller="+" style="f"><char style="fr" closed="false">24.18 </char><char style="ft" closed="false"> RP and TR </char><char style="fq" closed="false">garments</char></note> <verse eid="MAT 24:18"/></para>

<para style="p"><verse number="19" style="v" sid="MAT 24:19"/>And woe to those having in womb and to those nursing in those days! <verse eid="MAT 24:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 24:20"/>But pray that your⁺ flight may not be in winter, nor on a Sabbath. <verse eid="MAT 24:20"/></para>

<para style="p"><verse number="21" style="v" sid="MAT 24:21"/>For then there will be great tribulation, such as has not been from the beginning of the world until now, nor ever shall be. <verse eid="MAT 24:21"/></para>

<para style="p"><verse number="22" style="v" sid="MAT 24:22"/>And if those days were not shortened, not any flesh would have been saved; but because of the chosen, those days will be shortened. <verse eid="MAT 24:22"/></para>

<para style="p"><verse number="23" style="v" sid="MAT 24:23"/>At that time if anyone should say to you⁺, ‘Behold, here <char style="add">is</char> the Christ,’ or ‘Here,’ do not believe <char style="add">it</char>. <verse eid="MAT 24:23"/></para>

<para style="p"><verse number="24" style="v" sid="MAT 24:24"/>For false Christs and false prophets will arise and will give great signs and wonders so as to lead astray, if possible, even the chosen. <verse eid="MAT 24:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 24:25"/>Behold, I have told you⁺ beforehand. <verse eid="MAT 24:25"/></para>

<para style="s">The Return of the Son of ManMark 13:24–27</para>

<para style="p"><verse number="26" style="v" sid="MAT 24:26"/><note caller="-" style="x"><char style="xt" closed="false">Luke 21:25–28</char></note>Therefore if they may say to you⁺, ‘Behold, He is in the wilderness,<note caller="+" style="f"><char style="fr" closed="false">24.26 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">desert</char></note>’ do not go out; <char style="add">or</char> ‘Behold, in the inner rooms,’ do not believe <char style="add">it</char>. <verse eid="MAT 24:26"/></para>

<para style="p"><verse number="27" style="v" sid="MAT 24:27"/>For just as the lightning goes out from the east and shines as far as the west, so will be the coming of the Son of Man. <verse eid="MAT 24:27"/></para>

<para style="p"><verse number="28" style="v" sid="MAT 24:28"/>Wherever<note caller="+" style="f"><char style="fr" closed="false">24.28 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">For where</char></note> the carcass may be, there the vultures will be gathered. <verse eid="MAT 24:28"/></para>

<para style="p"><verse number="29" style="v" sid="MAT 24:29"/>And immediately after the tribulation of those days: </para>

<para style="q1" vid="MAT 24:29">‘The sun will be darkened, </para>

<para style="q2" vid="MAT 24:29">and the moon will not give her light; </para>

<para style="q1" vid="MAT 24:29">and the stars will fall from the sky, </para>

<para style="q2" vid="MAT 24:29">and the powers of the heavens will be shaken.”<note caller="+" style="f"><char style="fr" closed="false">24.29 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">and the celestial bodies will be shaken</char><char style="ft" closed="false">; see Isaiah 13:10, Isaiah 34:4, and Joel 2:10.</char></note>’ <verse eid="MAT 24:29"/></para>

<para style="p"><verse number="30" style="v" sid="MAT 24:30"/>And then the sign of the Son of Man will appear in heaven, and then all the tribes of the earth will mourn. And they will see the Son of Man coming on the clouds of heaven, with power and great glory.<note caller="+" style="f"><char style="fr" closed="false">24.30 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the sky</char><char style="ft" closed="false">; twice in this verse</char></note> <note caller="+" style="f"><char style="fr" closed="false">24.30 </char><char style="ft" closed="false"> See Daniel 7:13–14.</char></note><verse eid="MAT 24:30"/></para>

<para style="p"><verse number="31" style="v" sid="MAT 24:31"/>And He will send His angels with a great trumpet call, and they will gather together His chosen from the four winds, from the ends of the heavens to the ends of them. <verse eid="MAT 24:31"/></para>

<para style="s">The Lesson of the Fig TreeMark 13:28–31</para>

<para style="p"><verse number="32" style="v" sid="MAT 24:32"/><note caller="-" style="x"><char style="xt" closed="false">Luke 21:29–33</char></note>Now learn the parable<note caller="+" style="f"><char style="fr" closed="false">24.32 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">this lesson</char></note> from the fig tree: When its branch already shall have become tender and it may put forth leaves, you⁺ know that the summer <char style="add">is</char> near. <verse eid="MAT 24:32"/></para>

<para style="p"><verse number="33" style="v" sid="MAT 24:33"/>So also you⁺, when you⁺ see all these things, know that He is near,<note caller="+" style="f"><char style="fr" closed="false">24.33 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">it is near</char></note> at the doors. <verse eid="MAT 24:33"/></para>

<para style="p"><verse number="34" style="v" sid="MAT 24:34"/>Truly I say to you⁺ that this generation shall not have passed away until all these things shall have come to pass. <verse eid="MAT 24:34"/></para>

<para style="p"><verse number="35" style="v" sid="MAT 24:35"/>The heaven and the earth will pass away, but My words shall never pass away. <verse eid="MAT 24:35"/></para>

<para style="s">Readiness at Any HourGenesis 6:1–7</para>

<para style="p"><verse number="36" style="v" sid="MAT 24:36"/><note caller="-" style="x"><char style="xt" closed="false">Luke 12:35–48</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 13:32–37</char></note>But concerning that day and hour no one knows, not even the angels of the heavens, nor the Son,<note caller="+" style="f"><char style="fr" closed="false">24.36 </char><char style="ft" closed="false"> BYZ and TR do not include </char><char style="fq" closed="false">nor the Son</char><char style="ft" closed="false">.</char></note> except the Father only.<note caller="+" style="f"><char style="fr" closed="false">24.36 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">My Father only</char></note> <verse eid="MAT 24:36"/></para>

<para style="p"><verse number="37" style="v" sid="MAT 24:37"/>For as <char style="add">were</char> the days of Noah, so will be the coming of the Son of Man. <verse eid="MAT 24:37"/></para>

<para style="p"><verse number="38" style="v" sid="MAT 24:38"/>For as in those days<note caller="+" style="f"><char style="fr" closed="false">24.38 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">in the days</char></note> before the flood, they were eating and drinking, marrying and giving in marriage, until that day Noah entered into the ark. <verse eid="MAT 24:38"/></para>

<para style="p"><verse number="39" style="v" sid="MAT 24:39"/>And they did not know until the flood came and took away all. So also will be the coming of the Son of Man. <verse eid="MAT 24:39"/></para>

<para style="p"><verse number="40" style="v" sid="MAT 24:40"/>Then two will be in the field: one is taken, and one is left. <verse eid="MAT 24:40"/></para>

<para style="p"><verse number="41" style="v" sid="MAT 24:41"/>Two <char style="add">women</char> will be grinding at the mill: one is taken, and one is left. <verse eid="MAT 24:41"/></para>

<para style="p"><verse number="42" style="v" sid="MAT 24:42"/>Therefore watch, because you⁺ do not know on what day your⁺ Lord comes. <note caller="+" style="f"><char style="fr" closed="false">24.42 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">in what hour</char></note><verse eid="MAT 24:42"/></para>

<para style="p"><verse number="43" style="v" sid="MAT 24:43"/>But know this, that if the master of the house had known in which watch the thief comes, he would have watched and would not have allowed his house to be broken into. <verse eid="MAT 24:43"/></para>

<para style="p"><verse number="44" style="v" sid="MAT 24:44"/>Because of this also, you⁺ be ready, because in the hour that you⁺ do not think, the Son of Man comes. <verse eid="MAT 24:44"/></para>

<para style="p"><verse number="45" style="v" sid="MAT 24:45"/>Who then is the faithful and wise servant, whom the master<note caller="+" style="f"><char style="fr" closed="false">24.45 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">his lord</char></note> set over his household, to give them the food in season? <verse eid="MAT 24:45"/></para>

<para style="p"><verse number="46" style="v" sid="MAT 24:46"/>Blessed <char style="add">is</char> that servant whom his master, having come, will find so doing. <verse eid="MAT 24:46"/></para>

<para style="p"><verse number="47" style="v" sid="MAT 24:47"/>Truly I say to you⁺ that he will set him over all of his possessions. <verse eid="MAT 24:47"/></para>

<para style="p"><verse number="48" style="v" sid="MAT 24:48"/>But if that evil servant should say in his heart, ‘My master delays,<note caller="+" style="f"><char style="fr" closed="false">24.48 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">delays to come</char><char style="ft" closed="false">;</char></note>’ <verse eid="MAT 24:48"/></para>

<para style="p"><verse number="49" style="v" sid="MAT 24:49"/>and he should begin to beat his fellow servants, and he should eat and drink with those being drunk, <verse eid="MAT 24:49"/></para>

<para style="p"><verse number="50" style="v" sid="MAT 24:50"/>the master of that servant will come in a day that he does not expect and in an hour that he does not know, <verse eid="MAT 24:50"/></para>

<para style="p"><verse number="51" style="v" sid="MAT 24:51"/>and he will cut him in two and will appoint his portion with the hypocrites—there will be weeping and gnashing of the teeth. <verse eid="MAT 24:51"/></para>

<chapter eid="MAT 24"/>

<chapter number="25" style="c" sid="MAT 25"/>

<para style="s">The Parable of the Ten Virgins</para>

<para style="p"><verse number="1" style="v" sid="MAT 25:1"/><char style="add">“</char> Then the kingdom of the heavens will be likened to ten virgins, who, having taken their lamps, went out to meet the bridegroom, <verse eid="MAT 25:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 25:2"/>and five of them were foolish, and five wise.<note caller="+" style="f"><char style="fr" closed="false">25.2 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">five of them were wise, and five foolish</char></note> <verse eid="MAT 25:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 25:3"/>For the foolish,<note caller="+" style="f"><char style="fr" closed="false">25.3 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">Those who were foolish</char></note> having taken their lamps, did not take oil with them; <verse eid="MAT 25:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 25:4"/>but the wise took oil in the vessels with their lamps. <verse eid="MAT 25:4"/></para>

<para style="p"><verse number="5" style="v" sid="MAT 25:5"/>And <char style="add">in</char> the tarrying of the bridegroom, they all became drowsy and were sleeping. <verse eid="MAT 25:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 25:6"/>And in the middle of the night there was a cry: ‘Behold, the bridegroom!<note caller="+" style="f"><char style="fr" closed="false">25.6 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">is coming</char><char style="ft" closed="false">.</char></note> Come out to meet him!’ <verse eid="MAT 25:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 25:7"/>Then all those virgins arose and trimmed their lamps. <verse eid="MAT 25:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 25:8"/>And the foolish said to the wise, ‘Give us some of your⁺ oil, because our lamps are going out.’ <verse eid="MAT 25:8"/></para>

<para style="p"><verse number="9" style="v" sid="MAT 25:9"/>And the wise answered, saying, ‘No, lest it might not be sufficient for us and you⁺. Go rather to those selling, and buy for yourselves.’ <verse eid="MAT 25:9"/></para>

<para style="p"><verse number="10" style="v" sid="MAT 25:10"/>And <char style="add">in</char> their going away to buy, the bridegroom came, and those ready went in with him to the wedding feast, and the door was shut. <verse eid="MAT 25:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 25:11"/>And afterward, the other virgins come also, saying, ‘Lord, lord, open to us!’ <verse eid="MAT 25:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 25:12"/>And answering, he said, ‘Truly I say to you⁺, I have not known you⁺.’ <verse eid="MAT 25:12"/></para>

<para style="p"><verse number="13" style="v" sid="MAT 25:13"/>Therefore watch, for you⁺ do not know the day nor the hour.<note caller="+" style="f"><char style="fr" closed="false">25.13 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">when the Son of Man comes</char><char style="ft" closed="false">.</char></note> <verse eid="MAT 25:13"/></para>

<para style="s">The Parable of the TalentsLuke 19:11–27</para>

<para style="p"><verse number="14" style="v" sid="MAT 25:14"/>For <char style="add">it is</char> like a man going on a journey <char style="add">who</char> called his own servants and delivered his possessions to them. <verse eid="MAT 25:14"/></para>

<para style="p"><verse number="15" style="v" sid="MAT 25:15"/>And indeed, to one he gave five talents;<note caller="+" style="f"><char style="fr" closed="false">25.15 </char><char style="ft" closed="false"> A talent was worth about twenty years’ wages for a laborer.</char></note> and to one, two; and to one, one—to each according to his own ability. And he left the region. <verse eid="MAT 25:15"/></para>

<para style="p"><verse number="16" style="v" sid="MAT 25:16"/>Immediately the one having received the five talents, having gone, traded<note caller="+" style="f"><char style="fr" closed="false">25.16 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">15</char><char style="fq" closed="false">... And he left the region immediately. </char><char style="fq" closed="false">16</char><char style="fq" closed="false">... having gone, traded with them</char><char style="ft" closed="false">. Translators vary as to the placement of the Greek adverb </char><char style="fq" closed="false">eutheōs</char><char style="ft" closed="false"> (at once) at the end of verse 15 or at the beginning of verse 16.</char></note> with them and gained five others.<note caller="+" style="f"><char style="fr" closed="false">25.16 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">made five more talents</char></note> <verse eid="MAT 25:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 25:17"/>Likewise, the one with the two gained<note caller="+" style="f"><char style="fr" closed="false">25.17 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">gained, also he,</char></note> two others. <verse eid="MAT 25:17"/></para>

<para style="p"><verse number="18" style="v" sid="MAT 25:18"/>But the one having received the one, having gone away, dug in the earth and hid his master's money. <verse eid="MAT 25:18"/></para>

<para style="p"><verse number="19" style="v" sid="MAT 25:19"/>And after much time, the master of those servants comes and settles the account with them. <verse eid="MAT 25:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 25:20"/>And the one having received the five talents, having come, brought to <char style="add">him</char> five other talents, saying, ‘Master, you delivered to me five talents. Behold, I gained five other talents.<note caller="+" style="f"><char style="fr" closed="false">25.20 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">besides them</char><char style="ft" closed="false">; also in verse 22.</char></note>’ <verse eid="MAT 25:20"/></para>

<para style="p"><verse number="21" style="v" sid="MAT 25:21"/>His master said to him, ‘Well done, good and faithful servant! You were faithful over a few things; I will set you over many things. Enter into the joy of your master!’ <verse eid="MAT 25:21"/></para>

<para style="p"><verse number="22" style="v" sid="MAT 25:22"/>And the one with the two talents, also having come, said, ‘Lord, you delivered to me two talents. Behold, I gained two other talents.’ <verse eid="MAT 25:22"/></para>

<para style="p"><verse number="23" style="v" sid="MAT 25:23"/>His master said to him, ‘Well done, good and faithful servant! You were faithful over a few things; I will set you over many things. Enter into the joy of your master!’ <verse eid="MAT 25:23"/></para>

<para style="p"><verse number="24" style="v" sid="MAT 25:24"/>And the one having received the one talent, having come, also said, ‘Lord, I knew you, that you are a hard man, reaping where you did not sow, and gathering from where you did not scatter. <verse eid="MAT 25:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 25:25"/>And having been afraid, having gone away, I hid your talent in the ground. Behold, you have what <char style="add">is</char> yours.’ <verse eid="MAT 25:25"/></para>

<para style="p"><verse number="26" style="v" sid="MAT 25:26"/>And answering, his master said to him, ‘Wicked and slothful servant! You knew that I reap where I did not sow and gather from where I did not scatter. <verse eid="MAT 25:26"/></para>

<para style="p"><verse number="27" style="v" sid="MAT 25:27"/>Therefore it was necessary for you to cast my money to the bankers, and having come, I would have received my own with interest. <verse eid="MAT 25:27"/></para>

<para style="p"><verse number="28" style="v" sid="MAT 25:28"/>Therefore take away the talent from him and give <char style="add">it</char> to the one having the ten talents. <verse eid="MAT 25:28"/></para>

<para style="p"><verse number="29" style="v" sid="MAT 25:29"/>For everyone having will be given, and he will have in abundance. But the one not having, even that which he has<note caller="+" style="f"><char style="fr" closed="false">25.29 </char><char style="ft" closed="false"> F35 </char><char style="fq" closed="false">he thinks he has</char></note> will be taken away from him. <verse eid="MAT 25:29"/></para>

<para style="p"><verse number="30" style="v" sid="MAT 25:30"/>And cast out the worthless servant into the outer darkness—there will be weeping and gnashing of the teeth.’ <verse eid="MAT 25:30"/></para>

<para style="s">The Sheep and the Goats</para>

<para style="p"><verse number="31" style="v" sid="MAT 25:31"/>And when the Son of Man comes in His glory, and all the angels<note caller="+" style="f"><char style="fr" closed="false">25.31 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">holy angels</char></note> with Him, then He will sit upon the throne of His glory. <verse eid="MAT 25:31"/></para>

<para style="p"><verse number="32" style="v" sid="MAT 25:32"/>And all the nations will be gathered before Him, and He will separate them from one another, as the shepherd separates the sheep from the goats. <verse eid="MAT 25:32"/></para>

<para style="p"><verse number="33" style="v" sid="MAT 25:33"/>And indeed, He will set the sheep on His right hand and the goats on <char style="add">His</char> left. <verse eid="MAT 25:33"/></para>

<para style="p"><verse number="34" style="v" sid="MAT 25:34"/>Then the King will say to those on His right hand, ‘Come, the blessed of My Father, inherit the kingdom prepared for you⁺ from the foundation of the world. <verse eid="MAT 25:34"/></para>

<para style="p"><verse number="35" style="v" sid="MAT 25:35"/>For I hungered, and you⁺ gave Me <char style="add">something</char> to eat; I thirsted, and you⁺ gave Me <char style="add">something</char> to drink; I was a stranger, and you⁺ took Me in; <verse eid="MAT 25:35"/></para>

<para style="p"><verse number="36" style="v" sid="MAT 25:36"/><char style="add">I was</char> naked, and you⁺ clothed Me; I was ailing, and you⁺ visited Me; I was in prison, and you⁺ came to Me.’ <verse eid="MAT 25:36"/></para>

<para style="p"><verse number="37" style="v" sid="MAT 25:37"/>Then the righteous will answer Him, saying, ‘Lord, when did we see You hungering, and fed <char style="add">You</char>? Or thirsting, and gave <char style="add">You</char> to drink? <verse eid="MAT 25:37"/></para>

<para style="p"><verse number="38" style="v" sid="MAT 25:38"/>And when did we see You a stranger, and took <char style="add">You</char> in? Or naked, and clothed <char style="add">You</char>? <verse eid="MAT 25:38"/></para>

<para style="p"><verse number="39" style="v" sid="MAT 25:39"/>And when did we see You ailing or in prison, and came to You?’ <verse eid="MAT 25:39"/></para>

<para style="p"><verse number="40" style="v" sid="MAT 25:40"/>And answering, the King will say to them, ‘Truly I say to you⁺, inasmuch as you⁺ did <char style="add">it</char> to one of the least of these brothers of Mine, you⁺ did <char style="add">it</char> to Me.’ <verse eid="MAT 25:40"/></para>

<para style="p"><verse number="41" style="v" sid="MAT 25:41"/>Then also He will say to those on <char style="add">His</char> left, ‘Depart from Me, the cursed, into the eternal fire prepared for the devil and his angels. <verse eid="MAT 25:41"/></para>

<para style="p"><verse number="42" style="v" sid="MAT 25:42"/>For I hungered, and you⁺ did not give to Me to eat; and I thirsted, and you⁺ did not give Me to drink; <verse eid="MAT 25:42"/></para>

<para style="p"><verse number="43" style="v" sid="MAT 25:43"/>I was a stranger, and you⁺ did not take Me in; naked, and you⁺ did not clothe Me; ailing and in prison, and you⁺ did not visit Me.’ <verse eid="MAT 25:43"/></para>

<para style="p"><verse number="44" style="v" sid="MAT 25:44"/>Then they also will answer, saying, ‘Lord, when did we see You hungering, or thirsting, or a stranger, or naked, or ailing, or in prison, and we did not minister to You?’ <verse eid="MAT 25:44"/></para>

<para style="p"><verse number="45" style="v" sid="MAT 25:45"/>Then He will answer them, saying, ‘Truly I say to you⁺, inasmuch as you⁺ did not do <char style="add">it</char> to one of the least of these, you⁺ did not do <char style="add">it</char> to Me.’ <verse eid="MAT 25:45"/></para>

<para style="p"><verse number="46" style="v" sid="MAT 25:46"/>And these will go away into eternal punishment, but the righteous into eternal life.” <verse eid="MAT 25:46"/></para>

<chapter eid="MAT 25"/>

<chapter number="26" style="c" sid="MAT 26"/>

<para style="s">The Plot to Kill Jesus</para>

<para style="p"><verse number="1" style="v" sid="MAT 26:1"/><note caller="-" style="x"><char style="xt" closed="false">John 11:45–57</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 22:1–2</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 14:1–2</char></note>And it came to pass, when Jesus finished all<note caller="+" style="f"><char style="fr" closed="false">26.1 </char><char style="ft" closed="false"> F35 does not include </char><char style="fq" closed="false">all</char><char style="ft" closed="false">.</char></note> these words, <char style="add">that</char> He said to His disciples, <verse eid="MAT 26:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 26:2"/><char style="wj">“You⁺ know that after two days the Passover takes place, and the Son of Man is delivered over to be crucified.”</char> <verse eid="MAT 26:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 26:3"/>Then the chief priests were gathered together—<note caller="+" style="f"><char style="fr" closed="false">26.3 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">and the scribes</char><char style="ft" closed="false">.</char></note> and the elders of the people—in the courtyard of the high priest, who is called Caiaphas, <verse eid="MAT 26:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 26:4"/>and they plotted together in order that they might seize Jesus by guile and kill <char style="add">Him</char>. <verse eid="MAT 26:4"/></para>

<para style="p"><verse number="5" style="v" sid="MAT 26:5"/>But they were saying, “Not during the feast, lest a riot might take place among the people.” <verse eid="MAT 26:5"/></para>

<para style="s">Jesus Anointed at BethanyMark 14:3–9</para>

<para style="p"><verse number="6" style="v" sid="MAT 26:6"/><note caller="-" style="x"><char style="xt" closed="false">John 12:1–8</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 7:36–50</char></note>And Jesus having been in Bethany in the house of Simon the Leper,<note caller="+" style="f"><char style="fr" closed="false">26.6 </char><char style="ft" closed="false"> Aramaic </char><char style="fq" closed="false">Simon the Potter</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">Simon the Jar Maker</char></note> <verse eid="MAT 26:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 26:7"/>a woman came to Him, having an alabaster flask of very costly fragrant oil, and she poured <char style="add">it</char> on His head <char style="add">as</char> He is reclining. <verse eid="MAT 26:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 26:8"/>And the disciples,<note caller="+" style="f"><char style="fr" closed="false">26.8 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">His disciples</char><char style="ft" closed="false">; also in verse 45</char></note> having seen, became indignant, saying, “For what <char style="add">is</char> this waste? <verse eid="MAT 26:8"/></para>

<para style="p"><verse number="9" style="v" sid="MAT 26:9"/>For this could have been sold for much and given to the poor.” <verse eid="MAT 26:9"/></para>

<para style="p"><verse number="10" style="v" sid="MAT 26:10"/>And Jesus, having known, said to them, <char style="wj">“Why do you⁺ cause trouble to the woman? For she did a beautiful work to Me. </char><verse eid="MAT 26:10"/></para>

<para style="p"><verse number="11" style="v" sid="MAT 26:11"/><char style="wj">For the poor you⁺ always have with you,</char><note caller="+" style="f"><char style="fr" closed="false">26.11 </char><char style="ft" closed="false"> See Deuteronomy 15:11.</char></note><char style="wj"> but not always do you⁺ have Me. </char><verse eid="MAT 26:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 26:12"/><char style="wj">For she, in pouring this fragrant oil on My body, did it for My burial. </char><verse eid="MAT 26:12"/></para>

<para style="p"><verse number="13" style="v" sid="MAT 26:13"/><char style="wj">Truly I say to you⁺, wherever this gospel shall be proclaimed in the whole world, that which she did will also be spoken of, for a memorial of her.”</char> <verse eid="MAT 26:13"/></para>

<para style="s">Judas Agrees to Betray JesusMark 14:10–11</para>

<para style="p"><verse number="14" style="v" sid="MAT 26:14"/><note caller="-" style="x"><char style="xt" closed="false">Luke 22:3–6</char></note>Then one of the Twelve, the one being called Judas Iscariot, having gone to the chief priests, <verse eid="MAT 26:14"/></para>

<para style="p"><verse number="15" style="v" sid="MAT 26:15"/>said, “What are you⁺ willing to give me, and I will betray Him to you⁺?” And they appointed to him thirty pieces of silver. <verse eid="MAT 26:15"/></para>

<para style="p"><verse number="16" style="v" sid="MAT 26:16"/>And from that time, he was seeking an opportunity, that he might betray Him. <verse eid="MAT 26:16"/></para>

<para style="s">Preparing the PassoverMark 14:12–16</para>

<para style="p"><verse number="17" style="v" sid="MAT 26:17"/><note caller="-" style="x"><char style="xt" closed="false">Luke 22:7–13</char></note>And on the first of the Unleavened,<note caller="+" style="f"><char style="fr" closed="false">26.17 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">On the first day of the Feast of Unleavened Bread</char><char style="ft" closed="false">; see Exodus 12:14–20.</char></note> the disciples came to Jesus, saying, “Where do You desire <char style="add">that</char> we should prepare for You to eat the Passover?” <verse eid="MAT 26:17"/></para>

<para style="p"><verse number="18" style="v" sid="MAT 26:18"/>And He said, <char style="wj">“Go into the city to a certain man and tell him, ‘The Teacher says, “My time is near; at your house I will keep the Passover with My disciples.”’”</char> <verse eid="MAT 26:18"/></para>

<para style="p"><verse number="19" style="v" sid="MAT 26:19"/>And the disciples did as Jesus directed them and prepared the Passover. <verse eid="MAT 26:19"/></para>

<para style="s">The Last SupperMark 14:17–26</para>

<para style="p"><verse number="20" style="v" sid="MAT 26:20"/><note caller="-" style="x"><char style="xt" closed="false">1 Corinthians 11:17–34</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 22:14–23</char></note>And evening having come, He was reclining with the twelve disciples.<note caller="+" style="f"><char style="fr" closed="false">26.20 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">the Twelve</char></note> <verse eid="MAT 26:20"/></para>

<para style="p"><verse number="21" style="v" sid="MAT 26:21"/>And <char style="add">while</char> they are eating, He said to them, <char style="wj">“Truly I say to you⁺ that one of you⁺ will betray Me.”</char> <verse eid="MAT 26:21"/></para>

<para style="p"><verse number="22" style="v" sid="MAT 26:22"/>And being grieved exceedingly, they began, each one, to say to Him, “Is it I, Lord?” <verse eid="MAT 26:22"/></para>

<para style="p"><verse number="23" style="v" sid="MAT 26:23"/>And answering, He said, <char style="wj">“The one having dipped the hand in the bowl with Me, he will betray Me. </char><verse eid="MAT 26:23"/></para>

<para style="p"><verse number="24" style="v" sid="MAT 26:24"/><char style="wj">Indeed the Son of Man goes as it has been written about Him; but woe to that man by whom the Son of Man is betrayed. It would be better for him if he had not been born—that man.”</char> <verse eid="MAT 26:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 26:25"/>And Judas, who was betraying Him, answering, said, “Is it I, Rabbi?” </para>

<para style="p" vid="MAT 26:25">He says to him, <char style="wj">“You have said.”</char> <verse eid="MAT 26:25"/></para>

<para style="p"><verse number="26" style="v" sid="MAT 26:26"/>Now <char style="add">while</char> they are eating, Jesus, having taken bread and having blessed <char style="add">it</char>,<note caller="+" style="f"><char style="fr" closed="false">26.26 </char><char style="ft" closed="false"> RP </char><char style="fq" closed="false">having given thanks</char></note> broke <char style="add">it</char>, and having given <char style="add">it</char> to the disciples, He said, <char style="wj">“Take, eat; this is My body.”</char> <verse eid="MAT 26:26"/></para>

<para style="p"><verse number="27" style="v" sid="MAT 26:27"/>And having taken a cup<note caller="+" style="f"><char style="fr" closed="false">26.27 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">the cup</char></note> and having given thanks, He gave <char style="add">it</char> to them, saying, <char style="wj">“Drink of it, all of you. </char><verse eid="MAT 26:27"/></para>

<para style="p"><verse number="28" style="v" sid="MAT 26:28"/><char style="wj">For this is My blood of the covenant,</char><note caller="+" style="f"><char style="fr" closed="false">26.28 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">the new covenant</char></note><char style="wj"> being poured out for many for forgiveness of sins. </char><verse eid="MAT 26:28"/></para>

<para style="p"><verse number="29" style="v" sid="MAT 26:29"/><char style="wj">And I say to you⁺ that I shall not drink of this fruit of the vine from now until that day when I drink it anew with you⁺ in the kingdom of My Father.”</char> <verse eid="MAT 26:29"/></para>

<para style="p"><verse number="30" style="v" sid="MAT 26:30"/>And having sung a hymn, they went out to the Mount of Olives. <verse eid="MAT 26:30"/></para>

<para style="s">Jesus Predicts Peter’s DenialZechariah 13:7–9</para>

<para style="p"><verse number="31" style="v" sid="MAT 26:31"/><note caller="-" style="x"><char style="xt" closed="false">John 13:36–38</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 22:31–38</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 14:27–31</char></note>Then Jesus says to them, <char style="wj">“All of you⁺ will fall away because of Me during this night. For it has been written: </char></para>

<para style="q1" vid="MAT 26:31">‘I will strike the shepherd, </para>

<para style="q2" vid="MAT 26:31">and the sheep of the flock will be scattered.’<note caller="+" style="f"><char style="fr" closed="false">26.31 </char><char style="ft" closed="false"> Zechariah 13:7</char></note> <verse eid="MAT 26:31"/></para>

<para style="p"><verse number="32" style="v" sid="MAT 26:32"/>But I, after being raised, will go before you⁺ into Galilee.” <verse eid="MAT 26:32"/></para>

<para style="p"><verse number="33" style="v" sid="MAT 26:33"/>And answering, Peter said to Him, “Even if all will fall away because of You, I never will fall away.” <verse eid="MAT 26:33"/></para>

<para style="p"><verse number="34" style="v" sid="MAT 26:34"/>Jesus said to him, <char style="wj">“Truly I say to you that during this night, before the rooster crows, you will deny Me three times.”</char> <verse eid="MAT 26:34"/></para>

<para style="p"><verse number="35" style="v" sid="MAT 26:35"/>Peter says to Him, “Even if it were necessary for me to die with You, I will never deny You.” And all the disciples said likewise. <verse eid="MAT 26:35"/></para>

<para style="s">Jesus Prays at GethsemaneMark 14:32–42</para>

<para style="p"><verse number="36" style="v" sid="MAT 26:36"/><note caller="-" style="x"><char style="xt" closed="false">Luke 22:39–46</char></note>Then Jesus comes with them to a place called Gethsemane, and He says to the disciples, <char style="wj">“Sit here until, having gone away over there, I shall pray.”</char> <verse eid="MAT 26:36"/></para>

<para style="p"><verse number="37" style="v" sid="MAT 26:37"/>And having taken with <char style="add">Him</char> Peter and the two sons of Zebedee, He began to be sorrowful and deeply distressed. <verse eid="MAT 26:37"/></para>

<para style="p"><verse number="38" style="v" sid="MAT 26:38"/>Then He says to them,<note caller="+" style="f"><char style="fr" closed="false">26.38 </char><char style="ft" closed="false"> BYZ </char><char style="fq" closed="false">Then Jesus said to them</char></note> <char style="wj">“My soul is very sorrowful, even to death. Remain here and watch with Me.”</char> <verse eid="MAT 26:38"/></para>

<para style="p"><verse number="39" style="v" sid="MAT 26:39"/>And having gone forward a little, He fell upon His face, praying and saying, <char style="wj">“My Father, if it is possible, let this cup pass from Me. Nevertheless, not as I will, but as You.”</char> <verse eid="MAT 26:39"/></para>

<para style="p"><verse number="40" style="v" sid="MAT 26:40"/>And He comes to the disciples and finds them sleeping. And He says to Peter, <char style="wj">“So, were you⁺ not able to watch with Me one hour? </char><verse eid="MAT 26:40"/></para>

<para style="p"><verse number="41" style="v" sid="MAT 26:41"/><char style="wj">Watch and pray so that you⁺ might not enter into temptation. the spirit indeed is willing, but the flesh weak.”</char> <verse eid="MAT 26:41"/></para>

<para style="p"><verse number="42" style="v" sid="MAT 26:42"/>Again, for a second time, having gone away, He prayed, saying, <char style="wj">“My Father, if this is not possible to pass</char><note caller="+" style="f"><char style="fr" closed="false">26.42 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">if this cup cannot pass from Me</char></note><char style="wj"> unless I drink it, Your will be done.”</char> <verse eid="MAT 26:42"/></para>

<para style="p"><verse number="43" style="v" sid="MAT 26:43"/>And having come again, He found them sleeping,<note caller="+" style="f"><char style="fr" closed="false">26.43 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">and having come, He found them again sleeping</char></note> for their eyes were heavy. <verse eid="MAT 26:43"/></para>

<para style="p"><verse number="44" style="v" sid="MAT 26:44"/>And having left them again, having gone away, He prayed for the third time, having said the same thing again.<note caller="+" style="f"><char style="fr" closed="false">26.44 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">the same thing</char></note> <verse eid="MAT 26:44"/></para>

<para style="p"><verse number="45" style="v" sid="MAT 26:45"/>Then He comes to the disciples and says to them, <char style="wj">“Sleep and take your⁺ rest later on. Behold, the hour has drawn near, and the Son of Man is betrayed into the hands of sinners. </char><verse eid="MAT 26:45"/></para>

<para style="p"><verse number="46" style="v" sid="MAT 26:46"/><char style="wj">Rise up, let us go! Behold, he who is betraying Me has drawn near!</char><note caller="+" style="f"><char style="fr" closed="false">26.46 </char><char style="ft" closed="false"> F35 </char><char style="fq" closed="false">is here</char></note><char style="wj">”</char> <verse eid="MAT 26:46"/></para>

<para style="s">The Betrayal of JesusMark 14:43–52</para>

<para style="p"><verse number="47" style="v" sid="MAT 26:47"/><note caller="-" style="x"><char style="xt" closed="false">John 18:1–14</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 22:47–53</char></note>And <char style="add">in</char> His still speaking, behold, Judas, one of the Twelve, came, and with him a great crowd with swords and clubs, from the chief priests and elders of the people. <verse eid="MAT 26:47"/></para>

<para style="p"><verse number="48" style="v" sid="MAT 26:48"/>And the one betraying Him gave them a sign, saying, “Whomever I shall kiss, it is He; seize Him.” <verse eid="MAT 26:48"/></para>

<para style="p"><verse number="49" style="v" sid="MAT 26:49"/>And having come up to Jesus immediately, he said, “Greetings, Rabbi!” and kissed Him. <verse eid="MAT 26:49"/></para>

<para style="p"><verse number="50" style="v" sid="MAT 26:50"/>And Jesus said to him, <char style="wj">“Friend, for what are you come?”</char><note caller="+" style="f"><char style="fr" closed="false">26.50 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">“Friend, do what you came for.”</char></note> Then, having come, they laid hands on Jesus and seized Him. <verse eid="MAT 26:50"/></para>

<para style="p"><verse number="51" style="v" sid="MAT 26:51"/>And behold, one of those with Jesus, having stretched out the hand, drew his sword, and having struck the servant of the high priest, he cut off his ear. <verse eid="MAT 26:51"/></para>

<para style="p"><verse number="52" style="v" sid="MAT 26:52"/>Then Jesus says to him, <char style="wj">“Return your sword into its place; for all those having taken the sword will perish</char><note caller="+" style="f"><char style="fr" closed="false">26.52 </char><char style="ft" closed="false"> BYZ </char><char style="fq" closed="false">will die</char></note><char style="wj"> by the sword. </char><verse eid="MAT 26:52"/></para>

<para style="p"><verse number="53" style="v" sid="MAT 26:53"/><char style="wj">Or do you think that I am not able</char><note caller="+" style="f"><char style="fr" closed="false">26.53 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">right now</char><char style="ft" closed="false">.</char></note><char style="wj"> to call upon My Father, and He will furnish to Me presently more than twelve legions of angels? </char><verse eid="MAT 26:53"/></para>

<para style="p"><verse number="54" style="v" sid="MAT 26:54"/><char style="wj">How then would the Scriptures be fulfilled that it must be so?”</char> <verse eid="MAT 26:54"/></para>

<para style="p"><verse number="55" style="v" sid="MAT 26:55"/>In that hour, Jesus said to the crowds, <char style="wj">“Did you⁺ come out with swords and clubs, as against a robber, to capture Me? Every day</char><note caller="+" style="f"><char style="fr" closed="false">26.55 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">with you</char><char style="ft" closed="false">.</char></note><char style="wj"> in the temple</char><note caller="+" style="f"><char style="fr" closed="false">26.55 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the temple courts</char></note><char style="wj"> I was sitting teaching, and you⁺ did not seize Me. </char><verse eid="MAT 26:55"/></para>

<para style="p"><verse number="56" style="v" sid="MAT 26:56"/><char style="wj">And all this has come to pass so that the Scriptures of the prophets might be fulfilled.”</char> </para>

<para style="p" vid="MAT 26:56">Then the disciples, all having forsaken Him, fled. <verse eid="MAT 26:56"/></para>

<para style="s">Jesus before the SanhedrinMark 14:53–65</para>

<para style="p"><verse number="57" style="v" sid="MAT 26:57"/><note caller="-" style="x"><char style="xt" closed="false">John 18:19–24</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 22:66–71</char></note>And those having seized Jesus led <char style="add">Him</char> away to Caiaphas the high priest, where the scribes and the elders were assembled. <verse eid="MAT 26:57"/></para>

<para style="p"><verse number="58" style="v" sid="MAT 26:58"/>And Peter was following Him from afar, even to the court of the high priest. And having entered within, he was sitting with the guards to see the outcome. <verse eid="MAT 26:58"/></para>

<para style="p"><verse number="59" style="v" sid="MAT 26:59"/>And the chief priests<note caller="+" style="f"><char style="fr" closed="false">26.59 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">and the elders</char><char style="ft" closed="false">.</char></note> and the whole Council<note caller="+" style="f"><char style="fr" closed="false">26.59 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the whole Sanhedrin</char></note> were seeking false testimony against Jesus, so that they might put Him to death. <verse eid="MAT 26:59"/></para>

<para style="p"><verse number="60" style="v" sid="MAT 26:60"/>But they did not find <char style="add">any</char>, of many false witnesses having come forward. And at last, two<note caller="+" style="f"><char style="fr" closed="false">26.60 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">two false witnesses</char></note> having come forward,<note caller="+" style="f"><char style="fr" closed="false">26.60 </char><char style="ft" closed="false"> Some sources include </char><char style="fq" closed="false">And at last, two having come forward</char><char style="ft" closed="false"> with verse 61.</char></note> <verse eid="MAT 26:60"/></para>

<para style="p"><verse number="61" style="v" sid="MAT 26:61"/>they said, “This <char style="add">man</char> has been saying, ‘I am able to demolish the temple of God and rebuild it in three days.’” <verse eid="MAT 26:61"/></para>

<para style="p"><verse number="62" style="v" sid="MAT 26:62"/>And the high priest, having risen up, said to Him, “Do You answer nothing? What do these witness against You?” <verse eid="MAT 26:62"/></para>

<para style="p"><verse number="63" style="v" sid="MAT 26:63"/>But Jesus was silent. </para>

<para style="p" vid="MAT 26:63">And the high priest said to Him, “I adjure you by the living God that You tell us if You are the Christ, the Son of God.” <verse eid="MAT 26:63"/></para>

<para style="p"><verse number="64" style="v" sid="MAT 26:64"/>Jesus says to him, <char style="wj">“You said it. But I say to you⁺, from now you⁺ will see the Son of Man sitting at the right hand of Power and coming upon the clouds of heaven.”</char><note caller="+" style="f"><char style="fr" closed="false">26.64 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the right hand of the Mighty One</char></note> <note caller="+" style="f"><char style="fr" closed="false">26.64 </char><char style="ft" closed="false"> See Psalm 110:1 and Daniel 7:13.</char></note><verse eid="MAT 26:64"/></para>

<para style="p"><verse number="65" style="v" sid="MAT 26:65"/>Then the high priest tears his garments, saying, “He blasphemed! Why do we have any more need of witnesses? Behold, now you⁺ heard the blasphemy.<note caller="+" style="f"><char style="fr" closed="false">26.65 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">His blasphemy</char></note> <verse eid="MAT 26:65"/></para>

<para style="p"><verse number="66" style="v" sid="MAT 26:66"/>What do you⁺ think?” </para>

<para style="p" vid="MAT 26:66">And answering, they said, “He is deserving of death.” <verse eid="MAT 26:66"/></para>

<para style="p"><verse number="67" style="v" sid="MAT 26:67"/>Then they spat in His face and struck Him. And others slapped <char style="add">Him</char>, <verse eid="MAT 26:67"/></para>

<para style="p"><verse number="68" style="v" sid="MAT 26:68"/>saying, “Prophesy to us, Christ. Who is the one having struck You?” <verse eid="MAT 26:68"/></para>

<para style="s">Peter Denies JesusMark 14:66–72</para>

<para style="p"><verse number="69" style="v" sid="MAT 26:69"/><note caller="-" style="x"><char style="xt" closed="false">John 18:15–18</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 22:54–62</char></note>And Peter was sitting outside in the court, and one servant girl came to him, saying, “You also were with Jesus the Galilean.” <verse eid="MAT 26:69"/></para>

<para style="p"><verse number="70" style="v" sid="MAT 26:70"/>And he denied <char style="add">it</char> before all, saying, “I do not know what you say.” <verse eid="MAT 26:70"/></para>

<para style="p"><verse number="71" style="v" sid="MAT 26:71"/>And having gone out to the gateway, another saw him and says to those there, “This <char style="add">man</char> was with Jesus of Nazareth.” <note caller="+" style="f"><char style="fr" closed="false">26.71 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">also</char><char style="ft" closed="false">.</char></note><verse eid="MAT 26:71"/></para>

<para style="p"><verse number="72" style="v" sid="MAT 26:72"/>And again he denied <char style="add">it</char> with an oath: “I do not know the man.” <verse eid="MAT 26:72"/></para>

<para style="p"><verse number="73" style="v" sid="MAT 26:73"/>And after a little while, those standing by, having come, said to Peter, “Truly you are of them also, for even your speech makes you evident.” <verse eid="MAT 26:73"/></para>

<para style="p"><verse number="74" style="v" sid="MAT 26:74"/>Then he began to curse and to swear, “I do not know the man!” </para>

<para style="p" vid="MAT 26:74">And immediately a rooster crowed. <verse eid="MAT 26:74"/></para>

<para style="p"><verse number="75" style="v" sid="MAT 26:75"/>And Peter remembered the word of Jesus, <char style="add">He</char> having said,<note caller="+" style="f"><char style="fr" closed="false">26.75 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">to him</char><char style="ft" closed="false">.</char></note> <char style="wj">“Before the rooster crows, you will deny Me three times.”</char> And having gone out, he wept bitterly. <verse eid="MAT 26:75"/></para>

<chapter eid="MAT 26"/>

<chapter number="27" style="c" sid="MAT 27"/>

<para style="s">Jesus Delivered to Pilate</para>

<para style="p"><verse number="1" style="v" sid="MAT 27:1"/><note caller="-" style="x"><char style="xt" closed="false">Mark 15:1–5</char></note>And morning having come, all the chief priests and the elders of the people<note caller="+" style="f"><char style="fr" closed="false">27.1 </char><char style="ft" closed="false"> F35 does not include </char><char style="fq" closed="false">of the people</char><char style="ft" closed="false">.</char></note> took counsel against Jesus, so that they might put Him to death. <verse eid="MAT 27:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 27:2"/>And having bound Him, they led <char style="add">Him</char> away and delivered <char style="add">Him</char> to Pilate<note caller="+" style="f"><char style="fr" closed="false">27.2 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">to Pontius Pilate</char></note> the governor. <verse eid="MAT 27:2"/></para>

<para style="s">Judas Hangs HimselfZechariah 11:10–17</para>

<para style="p"><verse number="3" style="v" sid="MAT 27:3"/>Then Judas, the one having delivered Him up, having seen that He was condemned, having regretted <char style="add">it</char>, returned the thirty pieces of silver to the chief priests and elders, <verse eid="MAT 27:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 27:4"/>saying, “I sinned, having betrayed innocent<note caller="+" style="f"><char style="fr" closed="false">27.4 </char><char style="ft" closed="false"> WH </char><char style="fq" closed="false">righteous</char></note> blood.” </para>

<para style="p" vid="MAT 27:4">But they said, “What <char style="add">is it</char> to us? You will see.” <verse eid="MAT 27:4"/></para>

<para style="p"><verse number="5" style="v" sid="MAT 27:5"/>And having cast down the pieces of silver into the temple, he withdrew. And having gone away, he hanged himself. <verse eid="MAT 27:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 27:6"/>And the chief priests, having taken the pieces of silver, said, “It is not lawful to put them into the treasury, since it is the price of blood.” <verse eid="MAT 27:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 27:7"/>And having taken counsel, they bought with them the potter’s field for a burial place for foreigners. <verse eid="MAT 27:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 27:8"/>Therefore that field was called Field of Blood until this day. <verse eid="MAT 27:8"/></para>

<para style="p"><verse number="9" style="v" sid="MAT 27:9"/>Then was fulfilled that having been spoken by the prophet Jeremiah, saying, </para>

<para style="q1" vid="MAT 27:9">“And they took the thirty pieces of silver, </para>

<para style="q2" vid="MAT 27:9">the price of the One having been priced, </para>

<para style="q2" vid="MAT 27:9">on whom a price was set by the sons of Israel, <verse eid="MAT 27:9"/></para>

<para style="q1"><verse number="10" style="v" sid="MAT 27:10"/>and they gave them for the potter’s field, </para>

<para style="q2" vid="MAT 27:10">as the Lord directed me.”<note caller="+" style="f"><char style="fr" closed="false">27.10 </char><char style="ft" closed="false"> See Jeremiah 19:1–15, Jeremiah 32:6–9, and Zechariah 11:12–13.</char></note> <verse eid="MAT 27:10"/></para>

<para style="s">Jesus before PilateLuke 23:1–5</para>

<para style="p"><verse number="11" style="v" sid="MAT 27:11"/><note caller="-" style="x"><char style="xt" closed="false">John 18:28–40</char></note>Now Jesus stood before the governor, and the governor questioned Him, saying, “Are You the King of the Jews?” </para>

<para style="p" vid="MAT 27:11">And Jesus said, <char style="wj">“You say it.”</char> <verse eid="MAT 27:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 27:12"/>And in His being accused by the chief priests and elders, He answered nothing. <verse eid="MAT 27:12"/></para>

<para style="p"><verse number="13" style="v" sid="MAT 27:13"/>Then Pilate says to Him, “Do You not hear how many things they witness against You?” <verse eid="MAT 27:13"/></para>

<para style="p"><verse number="14" style="v" sid="MAT 27:14"/>And He did not answer him, not even to one word, so as to amaze the governor exceedingly. <verse eid="MAT 27:14"/></para>

<para style="s">The Crowd Chooses BarabbasMark 15:6–11</para>

<para style="p"><verse number="15" style="v" sid="MAT 27:15"/><note caller="-" style="x"><char style="xt" closed="false">Luke 23:13–25</char></note>And at the feast, the governor had been accustomed to release one prisoner to the multitude, whom they willed. <verse eid="MAT 27:15"/></para>

<para style="p"><verse number="16" style="v" sid="MAT 27:16"/>And at that time they were holding a notable prisoner called Barabbas.<note caller="+" style="f"><char style="fr" closed="false">27.16 </char><char style="ft" closed="false"> SBL and NA </char><char style="fq" closed="false">Jesus Barabbas</char><char style="ft" closed="false">; also in verse 17, but universally called </char><char style="fq" closed="false">Barabbas</char><char style="ft" closed="false"> in verses 20, 21, and 26</char></note> <verse eid="MAT 27:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 27:17"/>Therefore, <char style="add">in</char> their being gathered together, Pilate said to them, “Whom do you⁺ desire <char style="add">that</char> I shall release to you⁺? Barabbas, or Jesus who is called Christ?” <verse eid="MAT 27:17"/></para>

<para style="p"><verse number="18" style="v" sid="MAT 27:18"/>For he had known that they delivered Him up because of envy. <verse eid="MAT 27:18"/></para>

<para style="p"><verse number="19" style="v" sid="MAT 27:19"/>And <char style="add">in</char> his sitting on the judgment seat, his wife sent to him, saying, “Nothing with you and that righteous <char style="add">man</char>, for I suffered many things in a dream today because of Him.” <verse eid="MAT 27:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 27:20"/>But the chief priests and the elders persuaded the crowds that they should ask for Barabbas, and should destroy Jesus. <verse eid="MAT 27:20"/></para>

<para style="p"><verse number="21" style="v" sid="MAT 27:21"/>And answering, the governor said to them, “Which of the two do you⁺ desire <char style="add">that</char> I shall release to you⁺?” </para>

<para style="p" vid="MAT 27:21">And they said, “Barabbas.” <verse eid="MAT 27:21"/></para>

<para style="p"><verse number="22" style="v" sid="MAT 27:22"/>Pilate says to them, “What then should I do with Jesus who is called Christ?” </para>

<para style="p" vid="MAT 27:22">They all say, “Let <char style="add">Him</char> be crucified!” <verse eid="MAT 27:22"/></para>

<para style="p"><verse number="23" style="v" sid="MAT 27:23"/>And he said,<note caller="+" style="f"><char style="fr" closed="false">27.23 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">And the governor said</char></note> “For what evil did He commit?” </para>

<para style="p" vid="MAT 27:23">And they kept crying out all the more, saying, “Let <char style="add">Him</char> be crucified!” <verse eid="MAT 27:23"/></para>

<para style="s">Pilate Washes His HandsMark 15:12–15</para>

<para style="p"><verse number="24" style="v" sid="MAT 27:24"/>And Pilate, having seen that it availed nothing, but rather a riot is arising, having taken water, he washed the hands before the crowd, saying, “I am guiltless of the blood of this <char style="add">man</char>.<note caller="+" style="f"><char style="fr" closed="false">27.24 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">of this blood</char><char style="ft" closed="false">; BYZ and TR </char><char style="fq" closed="false">of this righteous blood</char></note> For yourselves you⁺ will see.” <verse eid="MAT 27:24"/></para>

<para style="p"><verse number="25" style="v" sid="MAT 27:25"/>And answering, all the people, said, “His blood <char style="add">be</char> on us and on our children!” <verse eid="MAT 27:25"/></para>

<para style="p"><verse number="26" style="v" sid="MAT 27:26"/>Then he released Barabbas to them. And having flogged Jesus, He delivered <char style="add">Him</char> up so that He might be crucified. <verse eid="MAT 27:26"/></para>

<para style="s">The Soldiers Mock JesusIsaiah 50:4–11</para>

<para style="p"><verse number="27" style="v" sid="MAT 27:27"/><note caller="-" style="x"><char style="xt" closed="false">John 19:1–15</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 22:63–65</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 15:16–20</char></note>Then the soldiers of the governor, having taken with <char style="add">them</char> Jesus into the Praetorium, gathered the whole cohort before Him. <verse eid="MAT 27:27"/></para>

<para style="p"><verse number="28" style="v" sid="MAT 27:28"/>And having stripped Him, they put a scarlet robe around Him. <verse eid="MAT 27:28"/></para>

<para style="p"><verse number="29" style="v" sid="MAT 27:29"/>And having twisted together a crown of thorns, they put <char style="add">it</char> on His head, and a reed in His right hand; and having bowed the knees before Him, they mocked Him, saying, “Hail, King of the Jews!” <verse eid="MAT 27:29"/></para>

<para style="p"><verse number="30" style="v" sid="MAT 27:30"/>And having spit upon Him, they took the reed and kept striking <char style="add">Him</char> on His head. <verse eid="MAT 27:30"/></para>

<para style="p"><verse number="31" style="v" sid="MAT 27:31"/>And when they had mocked Him, they took the robe off Him, and they put His garments on Him and led Him away to crucify <char style="add">Him</char>. <verse eid="MAT 27:31"/></para>

<para style="s">The CrucifixionPsalm 22:1–31</para>

<para style="p"><verse number="32" style="v" sid="MAT 27:32"/><note caller="-" style="x"><char style="xt" closed="false">John 19:16–27</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 23:26–43</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 15:21–32</char></note>And going out, they found a man of Cyrene named Simon. They compelled him that he might carry His cross. <verse eid="MAT 27:32"/></para>

<para style="p"><verse number="33" style="v" sid="MAT 27:33"/>And having come to a place called Golgotha, which is called Place of a Skull, <verse eid="MAT 27:33"/></para>

<para style="p"><verse number="34" style="v" sid="MAT 27:34"/>they gave Him wine<note caller="+" style="f"><char style="fr" closed="false">27.34 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">sour wine</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">vinegar</char></note> to drink, mixed with gall; and having tasted <char style="add">it</char>, He was not willing to drink <char style="add">it</char>. <verse eid="MAT 27:34"/></para>

<para style="p"><verse number="35" style="v" sid="MAT 27:35"/>And having crucified Him, they divided His garments, casting a lot. <note caller="+" style="f"><char style="fr" closed="false">27.35 </char><char style="ft" closed="false"> See Psalm 22:18; TR includes </char><char style="fq" closed="false">to fulfill what was said through the prophet: “They divided My garments among them, and for My clothing they cast a lot.”</char></note><verse eid="MAT 27:35"/></para>

<para style="p"><verse number="36" style="v" sid="MAT 27:36"/>And sitting down, they were guarding Him there. <verse eid="MAT 27:36"/></para>

<para style="p"><verse number="37" style="v" sid="MAT 27:37"/>And they put up over His head the written accusation against Him: </para>

<para style="p" vid="MAT 27:37">THIS IS JESUS, THE KING OF THE JEWS.<verse eid="MAT 27:37"/></para>

<para style="p"><verse number="38" style="v" sid="MAT 27:38"/>At that time two robbers<note caller="+" style="f"><char style="fr" closed="false">27.38 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">insurrectionists</char><char style="ft" closed="false">; also in verse 44</char></note> are crucified with Him, one at the right hand and one at the left. <verse eid="MAT 27:38"/></para>

<para style="p"><verse number="39" style="v" sid="MAT 27:39"/>And those passing by kept railing at Him, wagging their heads <verse eid="MAT 27:39"/></para>

<para style="p"><verse number="40" style="v" sid="MAT 27:40"/>and saying, “The One demolishing the temple and building <char style="add">it</char> in three days, save Yourself! If You are the Son of God, also come down from the cross!” <verse eid="MAT 27:40"/></para>

<para style="p"><verse number="41" style="v" sid="MAT 27:41"/>Likewise also the chief priests, mocking, with the scribes and elders, were saying, <verse eid="MAT 27:41"/></para>

<para style="p"><verse number="42" style="v" sid="MAT 27:42"/>“He saved others. He is not able to save Himself. He is King of Israel! Let Him come down<note caller="+" style="f"><char style="fr" closed="false">27.42 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">If He is King of Israel, let him descend</char></note> now from the cross, and we will believe in Him.<note caller="+" style="f"><char style="fr" closed="false">27.42 </char><char style="ft" closed="false"> TR </char><char style="fq" closed="false">we will believe Him</char></note> <verse eid="MAT 27:42"/></para>

<para style="p"><verse number="43" style="v" sid="MAT 27:43"/>He has trusted on God. Let Him deliver <char style="add">Him</char> now if He wants Him, for He said, <char style="wj">‘I am the Son of God.’</char>” <note caller="+" style="f"><char style="fr" closed="false">27.43 </char><char style="ft" closed="false"> Psalm 22:8</char></note><verse eid="MAT 27:43"/></para>

<para style="p"><verse number="44" style="v" sid="MAT 27:44"/>And likewise even the robbers, those having been crucified with Him, were upbraiding Him. <verse eid="MAT 27:44"/></para>

<para style="s">The Death of JesusPsalm 22:1–31</para>

<para style="p"><verse number="45" style="v" sid="MAT 27:45"/><note caller="-" style="x"><char style="xt" closed="false">John 19:28–30</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 23:44–49</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 15:33–41</char></note>And from the sixth hour<note caller="+" style="f"><char style="fr" closed="false">27.45 </char><char style="ft" closed="false"> That is, noon</char></note> darkness was over all the land until the ninth hour.<note caller="+" style="f"><char style="fr" closed="false">27.45 </char><char style="ft" closed="false"> That is, three in the afternoon</char></note> <verse eid="MAT 27:45"/></para>

<para style="p"><verse number="46" style="v" sid="MAT 27:46"/>And about the ninth hour, Jesus cried out in a loud voice, saying, <char style="wj">“Eli, Eli, lema</char><note caller="+" style="f"><char style="fr" closed="false">27.46 </char><char style="ft" closed="false"> NE and WH </char><char style="fq" closed="false">Eloi, Eloi</char></note><char style="wj"> sabachthani?”</char> That is, <char style="wj">“My God, My God, why did You forsake Me?”</char><note caller="+" style="f"><char style="fr" closed="false">27.46 </char><char style="ft" closed="false"> BYZ </char><char style="fq" closed="false">lima</char><char style="ft" closed="false">; TR </char><char style="fq" closed="false">lama</char></note> <note caller="+" style="f"><char style="fr" closed="false">27.46 </char><char style="ft" closed="false"> Psalm 22:1</char></note><verse eid="MAT 27:46"/></para>

<para style="p"><verse number="47" style="v" sid="MAT 27:47"/>And some of those standing there, having heard, were saying, “This <char style="add">man</char> calls Elijah.” <verse eid="MAT 27:47"/></para>

<para style="p"><verse number="48" style="v" sid="MAT 27:48"/>And immediately one of them, having run and having taken a sponge, and having filled <char style="add">it</char> with vinegar<note caller="+" style="f"><char style="fr" closed="false">27.48 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">filled it with sour wine</char></note> and having put <char style="add">it</char> on a reed, gave Him to drink.<note caller="+" style="f"><char style="fr" closed="false">27.48 </char><char style="ft" closed="false"> See Psalm 69:21.</char></note> <verse eid="MAT 27:48"/></para>

<para style="p"><verse number="49" style="v" sid="MAT 27:49"/>And the rest were saying, “Let <char style="add">it</char> be. Let us see whether Elijah comes to save Him.”<note caller="+" style="f"><char style="fr" closed="false">27.49 </char><char style="ft" closed="false"> WH includes </char><char style="fq" closed="false">And another, having taken a spear, pierced His side, and water and blood came out</char><char style="ft" closed="false">; see John 19:34.</char></note> <verse eid="MAT 27:49"/></para>

<para style="p"><verse number="50" style="v" sid="MAT 27:50"/>And Jesus, having cried again in a loud voice, yielded up <char style="add">His</char> spirit. <verse eid="MAT 27:50"/></para>

<para style="p"><verse number="51" style="v" sid="MAT 27:51"/>And behold, the veil of the temple was torn into two from top to bottom. And the earth was shaken, and the rocks were split. <verse eid="MAT 27:51"/></para>

<para style="p"><verse number="52" style="v" sid="MAT 27:52"/>And the tombs were opened, and many bodies of the saints having fallen asleep were raised. <verse eid="MAT 27:52"/></para>

<para style="p"><verse number="53" style="v" sid="MAT 27:53"/>And having gone forth out of the tombs after His resurrection, they entered into the holy city and appeared to many. <verse eid="MAT 27:53"/></para>

<para style="p"><verse number="54" style="v" sid="MAT 27:54"/>And the centurion and those with him guarding Jesus, having seen the earthquake and the things taking place, feared greatly, saying, “Truly this was God’s Son.” <verse eid="MAT 27:54"/></para>

<para style="p"><verse number="55" style="v" sid="MAT 27:55"/>And many women were<note caller="+" style="f"><char style="fr" closed="false">27.55 </char><char style="ft" closed="false"> F35 and GOC </char><char style="fq" closed="false">were also</char></note> there, looking on from afar off, who followed Jesus from Galilee, ministering to Him— <verse eid="MAT 27:55"/></para>

<para style="p"><verse number="56" style="v" sid="MAT 27:56"/>among whom was Mary Magdalene—also Mary the mother of James and Joseph, and the mother of the sons of Zebedee. <note caller="+" style="f"><char style="fr" closed="false">27.56 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">Joses</char></note><verse eid="MAT 27:56"/></para>

<para style="s">The Burial of JesusIsaiah 53:9–12</para>

<para style="p"><verse number="57" style="v" sid="MAT 27:57"/><note caller="-" style="x"><char style="xt" closed="false">John 19:38–42</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 23:50–56</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 15:42–47</char></note>And evening having come, a rich man from Arimathea named Joseph came, who himself also was discipled to Jesus. <verse eid="MAT 27:57"/></para>

<para style="p"><verse number="58" style="v" sid="MAT 27:58"/>Having gone to Pilate, he asked for the body of Jesus. Then Pilate commanded it to be given up.<note caller="+" style="f"><char style="fr" closed="false">27.58 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">commanded that the body be given up to him</char></note> <verse eid="MAT 27:58"/></para>

<para style="p"><verse number="59" style="v" sid="MAT 27:59"/>And Joseph, having taken the body, wrapped it in a clean linen cloth <verse eid="MAT 27:59"/></para>

<para style="p"><verse number="60" style="v" sid="MAT 27:60"/>and placed it in his new tomb, which he had cut in the rock. And having rolled a great stone to the door of the tomb, he went away. <verse eid="MAT 27:60"/></para>

<para style="p"><verse number="61" style="v" sid="MAT 27:61"/>And Mary Magdalene was there, and the other Mary, sitting opposite the tomb. <verse eid="MAT 27:61"/></para>

<para style="s">The Guards at the Tomb</para>

<para style="p"><verse number="62" style="v" sid="MAT 27:62"/>And the next day, which is after the Preparation, the chief priests and the Pharisees were gathered together before Pilate, <verse eid="MAT 27:62"/></para>

<para style="p"><verse number="63" style="v" sid="MAT 27:63"/>saying, “Sir, we have remembered how that deceiver, while living, said, <char style="wj">‘After three days I arise.’</char> <verse eid="MAT 27:63"/></para>

<para style="p"><verse number="64" style="v" sid="MAT 27:64"/>Therefore command the tomb to be secured until the third day, lest ever His disciples, having come,<note caller="+" style="f"><char style="fr" closed="false">27.64 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">by night</char><char style="ft" closed="false">.</char></note> steal Him away and say to the people, ‘He is risen from the dead.’ And the last deception will be worse than the first.” <verse eid="MAT 27:64"/></para>

<para style="p"><verse number="65" style="v" sid="MAT 27:65"/>Pilate said to them, “You⁺ have a guard. Go, make <char style="add">it as</char> secure as you⁺ have known.” <verse eid="MAT 27:65"/></para>

<para style="p"><verse number="66" style="v" sid="MAT 27:66"/>And having gone with the guard, they made the tomb secure, having sealed the stone. <verse eid="MAT 27:66"/></para>

<chapter eid="MAT 27"/>

<chapter number="28" style="c" sid="MAT 28"/>

<para style="s">The Resurrection</para>

<para style="p"><verse number="1" style="v" sid="MAT 28:1"/><note caller="-" style="x"><char style="xt" closed="false">John 20:1–9</char></note><note caller="-" style="x"><char style="xt" closed="false">Luke 24:1–12</char></note><note caller="-" style="x"><char style="xt" closed="false">Mark 16:1–8</char></note>Now after the Sabbaths, it being dawn toward the first of the Sabbaths,<note caller="+" style="f"><char style="fr" closed="false">28.1 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">After the Sabbath, at dawn on the first day of the week</char></note> Mary Magdalene and the other Mary came to see the tomb. <verse eid="MAT 28:1"/></para>

<para style="p"><verse number="2" style="v" sid="MAT 28:2"/>And behold, there was a great earthquake; for an angel of the Lord, having descended out of heaven and having come, rolled away the stone<note caller="+" style="f"><char style="fr" closed="false">28.2 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">from the entrance</char><char style="ft" closed="false">.</char></note> and was sitting upon it. <verse eid="MAT 28:2"/></para>

<para style="p"><verse number="3" style="v" sid="MAT 28:3"/>And his appearance was like lightning, and his clothing white as snow. <verse eid="MAT 28:3"/></para>

<para style="p"><verse number="4" style="v" sid="MAT 28:4"/>And those keeping guard trembled from fear of him, and they became like dead <char style="add">men</char>. <verse eid="MAT 28:4"/></para>

<para style="p"><verse number="5" style="v" sid="MAT 28:5"/>And answering, the angel said to the women, “Do not be afraid, for I know that you⁺ seek Jesus, the One having been crucified. <verse eid="MAT 28:5"/></para>

<para style="p"><verse number="6" style="v" sid="MAT 28:6"/>He is not here, for He is risen, as He said! Come, see the place where He was lying.<note caller="+" style="f"><char style="fr" closed="false">28.6 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">where the Lord was lying</char></note> <verse eid="MAT 28:6"/></para>

<para style="p"><verse number="7" style="v" sid="MAT 28:7"/>And having gone quickly, say to His disciples, ‘He is risen from the dead, and behold, He goes before you⁺ into Galilee; there you⁺ will see Him.’ Behold, I have told you⁺.” <verse eid="MAT 28:7"/></para>

<para style="p"><verse number="8" style="v" sid="MAT 28:8"/>And having gone out quickly from the tomb with fear and great joy, they ran to tell His disciples. <verse eid="MAT 28:8"/></para>

<para style="p"><verse number="9" style="v" sid="MAT 28:9"/>And behold,<note caller="+" style="f"><char style="fr" closed="false">28.9 </char><char style="ft" closed="false"> BYZ and TR </char><char style="fq" closed="false">Now as they were going to report it to His disciples, behold,</char></note> Jesus met them, saying, <char style="wj">“Greetings!”</char> And having come, they took hold of His feet and worshiped Him. <verse eid="MAT 28:9"/></para>

<para style="p"><verse number="10" style="v" sid="MAT 28:10"/>Then Jesus says to them, <char style="wj">“Do not be afraid. Go, tell My brothers, so that they should go into Galilee. And there they will see Me.”</char> <verse eid="MAT 28:10"/></para>

<para style="s">The Report of the Guards</para>

<para style="p"><verse number="11" style="v" sid="MAT 28:11"/>And <char style="add">in</char> their going, behold, some of the guard, having gone into the city, reported to the chief priests all the things having come to pass. <verse eid="MAT 28:11"/></para>

<para style="p"><verse number="12" style="v" sid="MAT 28:12"/>And having been gathered together with the elders and having taken counsel, they gave many pieces of silver to the soldiers, <verse eid="MAT 28:12"/></para>

<para style="p"><verse number="13" style="v" sid="MAT 28:13"/>saying, “Say, ‘His disciples, having come by night, stole Him—we being asleep.’ <verse eid="MAT 28:13"/></para>

<para style="p"><verse number="14" style="v" sid="MAT 28:14"/>And if this is heard by the governor, we will persuade him, and we will keep you⁺ out of trouble.” <verse eid="MAT 28:14"/></para>

<para style="p"><verse number="15" style="v" sid="MAT 28:15"/>And having taken the pieces of silver, they did as they were instructed. And this report was spread abroad among the Jews until the present day. <verse eid="MAT 28:15"/></para>

<para style="s">The Great CommissionMark 16:14–18</para>

<para style="p"><verse number="16" style="v" sid="MAT 28:16"/>And the eleven disciples went into Galilee, to the mountain where Jesus assigned them. <verse eid="MAT 28:16"/></para>

<para style="p"><verse number="17" style="v" sid="MAT 28:17"/>And having seen Him, they worshiped; but some doubted. <verse eid="MAT 28:17"/></para>

<para style="p"><verse number="18" style="v" sid="MAT 28:18"/>And having come near, Jesus spoke to them, saying, <char style="wj">“All authority in heaven and on the earth was given to Me. </char><verse eid="MAT 28:18"/></para>

<para style="p"><verse number="19" style="v" sid="MAT 28:19"/><char style="wj">Therefore, having gone, disciple</char><note caller="+" style="f"><char style="fr" closed="false">28.19 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">Therefore go and make disciples of</char></note><char style="wj"> all the nations, baptizing them in the name of the Father, and of the Son, and of the Holy Spirit, </char><verse eid="MAT 28:19"/></para>

<para style="p"><verse number="20" style="v" sid="MAT 28:20"/><char style="wj">teaching them to observe all things, as much as I commanded you⁺. And behold, I am with you⁺ all the days, until the consummation of the age.</char><note caller="+" style="f"><char style="fr" closed="false">28.20 </char><char style="ft" closed="false"> BYZ and TR include </char><char style="fq" closed="false">Amen</char><char style="ft" closed="false">.</char></note><char style="wj">”</char> <verse eid="MAT 28:20"/></para>

<chapter eid="MAT 28"/>

</usx>
