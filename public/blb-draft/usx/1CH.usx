<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.1">
<book code="1CH" style="id">BLB-Draft</book>

<para style="h">1 Chronicles</para>

<para style="toc1">1 Chronicles</para>

<para style="rem">sourceUrl=https://literalbible.com/blb.docx fetchedAtUtc=2026-09-01T15:43:00Z status=draft id=BLB-Draft spec=USFM-USX 3.1.1 char:add=docx-italic note:f=docx-footnotes note:x=docx-heading-crossrefs</para>

<chapter number="1" style="c" sid="1CH 1"/>

<para style="s">From Adam to Abraham</para>

<para style="p"><verse number="1" style="v" sid="1CH 1:1"/><note caller="-" style="x"><char style="xt" closed="false">Genesis 11:10–26</char></note><note caller="-" style="x"><char style="xt" closed="false">Genesis 10:1–32</char></note><note caller="-" style="x"><char style="xt" closed="false">Genesis 5:1–32</char></note>Adam, Seth, Enosh, <verse eid="1CH 1:1"/></para>

<para style="p"><verse number="2" style="v" sid="1CH 1:2"/>Kenan, Mahalalel, Jared, <verse eid="1CH 1:2"/></para>

<para style="p"><verse number="3" style="v" sid="1CH 1:3"/>Enoch, Methuselah, Lamech, <verse eid="1CH 1:3"/></para>

<para style="p"><verse number="4" style="v" sid="1CH 1:4"/><char style="add">The sons of</char> Noah: </para>

<para style="q1" vid="1CH 1:4">Shem, Ham, and Japheth. <note caller="+" style="f"><char style="fr" closed="false">1.4 </char><char style="ft" closed="false"> LXX; Hebrew does not include </char><char style="fq" closed="false">The sons of</char><char style="ft" closed="false">; see Genesis 5:32.</char></note><verse eid="1CH 1:4"/></para>

<para style="q1"><verse number="5" style="v" sid="1CH 1:5"/>The sons of Japheth: </para>

<para style="q2" vid="1CH 1:5">Gomer, and Magog, and Madai, and Javan, and Tubal, and Meshech, and Tiras. <verse eid="1CH 1:5"/></para>

<para style="q2"><verse number="6" style="v" sid="1CH 1:6"/>And The sons of Gomer: Ashkenaz, and Riphath,<note caller="+" style="f"><char style="fr" closed="false">1.6 </char><char style="ft" closed="false"> Many Hebrew manuscripts and Vulgate (see also LXX and Genesis 10:3); most Hebrew manuscripts </char><char style="fq" closed="false">Diphath</char></note> and Togarmah. <verse eid="1CH 1:6"/></para>

<para style="q2"><verse number="7" style="v" sid="1CH 1:7"/>And the sons of Javan: Elishah, and Tarshish, Kittim, and Rodanim. <verse eid="1CH 1:7"/></para>

<para style="q1"><verse number="8" style="v" sid="1CH 1:8"/>The sons of Ham: </para>

<para style="q2" vid="1CH 1:8">Cush, and Mizraim, Put, and Canaan. <verse eid="1CH 1:8"/></para>

<para style="q2"><verse number="9" style="v" sid="1CH 1:9"/>And the sons of Cush: Seba, and Havilah, and Sabta, and Raamah, and Sabteca. </para>

<para style="q2" vid="1CH 1:9">And the sons of Raamah: Sheba and Dedan. <note caller="+" style="f"><char style="fr" closed="false">1.9 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Sabta</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Sabtah</char><char style="ft" closed="false">; see Genesis 10:7.</char></note><verse eid="1CH 1:9"/></para>

<para style="q2"><verse number="10" style="v" sid="1CH 1:10"/>And Cush begat Nimrod; he began to be a mighty one<note caller="+" style="f"><char style="fr" closed="false">1.10 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">he established himself as a mighty warrior</char></note> on the earth. <verse eid="1CH 1:10"/></para>

<para style="q2"><verse number="11" style="v" sid="1CH 1:11"/>And Mizraim begat Ludim, and Anamim, and Lehabim, and Naphtuhim, <verse eid="1CH 1:11"/></para>

<para style="q2"><verse number="12" style="v" sid="1CH 1:12"/>and the Pathrusites, and the Casluhites (from whom came out the Philistines), and the Caphtorites.<note caller="+" style="f"><char style="fr" closed="false">1.12 </char><char style="ft" closed="false"> Some translators adjust the Hebrew word order to </char><char style="fq" closed="false">the Casluhites, and the Caphtorites (from whom the Philistines came)</char><char style="ft" closed="false">; see also Jeremiah 47:4 and Amos 9:7.</char></note> <verse eid="1CH 1:12"/></para>

<para style="q2"><verse number="13" style="v" sid="1CH 1:13"/>And Canaan begat Sidon his firstborn, and Heth, <verse eid="1CH 1:13"/></para>

<para style="q2"><verse number="14" style="v" sid="1CH 1:14"/>and the Jebusite, and the Amorite, and the Girgashite, <verse eid="1CH 1:14"/></para>

<para style="q2"><verse number="15" style="v" sid="1CH 1:15"/>and the Hivite, and the Arkite, and the Sinite, <verse eid="1CH 1:15"/></para>

<para style="q2"><verse number="16" style="v" sid="1CH 1:16"/>and the Arvadite, and the Zemarite, and the Hamathite. <verse eid="1CH 1:16"/></para>

<para style="q1"><verse number="17" style="v" sid="1CH 1:17"/>The sons of Shem: </para>

<para style="q2" vid="1CH 1:17">Elam, and Asshur, and Arphaxad, and Lud, and Aram. </para>

<para style="q2" vid="1CH 1:17"><char style="add">The sons of Aram:</char>, Uz, and Hul, and Gether, and Meshech.<note caller="+" style="f"><char style="fr" closed="false">1.17 </char><char style="ft" closed="false"> One Hebrew manuscript and some LXX manuscripts (see also Genesis 10:23); most Hebrew manuscripts do not include </char><char style="fq" closed="false">The sons of Aram:</char></note> <note caller="+" style="f"><char style="fr" closed="false">1.17 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Meshech</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Mash</char><char style="ft" closed="false">; see Genesis 10:23.</char></note><verse eid="1CH 1:17"/></para>

<para style="q2"><verse number="18" style="v" sid="1CH 1:18"/>And Arphaxad begat Shelah, and Shelah begat Eber. <verse eid="1CH 1:18"/></para>

<para style="q2"><verse number="19" style="v" sid="1CH 1:19"/>And to Eber were born two sons. The name of one <char style="add">was</char> Peleg,<note caller="+" style="f"><char style="fr" closed="false">1.19 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Peleg</char><char style="ft" closed="false"> means </char><char style="fq" closed="false">division</char><char style="ft" closed="false">.</char></note> for in his days the earth was divided, and the name of his brother <char style="add">was</char> Joktan. <verse eid="1CH 1:19"/></para>

<para style="q2"><verse number="20" style="v" sid="1CH 1:20"/>And Joktan begat Almodad, and Sheleph, and Hazarmaveth, and Jerah, <verse eid="1CH 1:20"/></para>

<para style="q2"><verse number="21" style="v" sid="1CH 1:21"/>and Hadoram, and Uzal, and Diklah, <verse eid="1CH 1:21"/></para>

<para style="q2"><verse number="22" style="v" sid="1CH 1:22"/>and Obal,<note caller="+" style="f"><char style="fr" closed="false">1.22 </char><char style="ft" closed="false"> LXX and Syriac (see also Genesis 10:28); Hebrew </char><char style="fq" closed="false">Ebal</char></note> and Abimael, and Sheba, <verse eid="1CH 1:22"/></para>

<para style="q2"><verse number="23" style="v" sid="1CH 1:23"/>and Ophir, and Havilah, and Jobab. All these <char style="add">were</char> the sons of Joktan. <verse eid="1CH 1:23"/></para>

<para style="q2"><verse number="24" style="v" sid="1CH 1:24"/>Shem, Arphaxad, Shelah,<note caller="+" style="f"><char style="fr" closed="false">1.24 </char><char style="ft" closed="false"> Some LXX manuscripts </char><char style="fq" closed="false">Shem, Arphaxad, Cainan, Shelah</char><char style="ft" closed="false">; see also Genesis 10:24 LXX and Luke 3:35–36.</char></note> <verse eid="1CH 1:24"/></para>

<para style="q2"><verse number="25" style="v" sid="1CH 1:25"/>Eber, Peleg, Reu, <verse eid="1CH 1:25"/></para>

<para style="q2"><verse number="26" style="v" sid="1CH 1:26"/>Serug, Nahor, Terah, <verse eid="1CH 1:26"/></para>

<para style="q2"><verse number="27" style="v" sid="1CH 1:27"/>and Abram (that <char style="add">is</char>, Abraham). <verse eid="1CH 1:27"/></para>

<para style="s">The Descendants of AbrahamGenesis 25:12–18</para>

<para style="p"><verse number="28" style="v" sid="1CH 1:28"/>The sons of Abraham: Isaac and Ishmael. <verse eid="1CH 1:28"/></para>

<para style="p"><verse number="29" style="v" sid="1CH 1:29"/>These <char style="add">are</char> their genealogies: The firstborn of Ishmael Nebaioth, and Kedar, and Adbeel, and Mibsam, <verse eid="1CH 1:29"/></para>

<para style="q1"><verse number="30" style="v" sid="1CH 1:30"/>Mishma, and Dumah, Massa, Hadad, and Tema, <verse eid="1CH 1:30"/></para>

<para style="q1"><verse number="31" style="v" sid="1CH 1:31"/>Jetur, Naphish, and Kedemah. These were the sons of Ishmael. <verse eid="1CH 1:31"/></para>

<para style="q1"><verse number="32" style="v" sid="1CH 1:32"/>And the sons born to Keturah concubine of Abraham: </para>

<para style="q2" vid="1CH 1:32">Zimran, and Jokshan, and Medan, and Midian, and Ishbak, and Shuah. </para>

<para style="q1" vid="1CH 1:32">And the sons of Jokshan: </para>

<para style="q2" vid="1CH 1:32">Sheba and Dedan. <verse eid="1CH 1:32"/></para>

<para style="q1"><verse number="33" style="v" sid="1CH 1:33"/>And the sons of Midian: </para>

<para style="q2" vid="1CH 1:33">Ephah, and Epher, and Hanoch, and Abidah, and Eldaah. </para>

<para style="q2" vid="1CH 1:33">All these <char style="add">were</char> the sons of Keturah. <verse eid="1CH 1:33"/></para>

<para style="q1"><verse number="34" style="v" sid="1CH 1:34"/>And Abraham begat Isaac. The sons of Isaac: </para>

<para style="q2" vid="1CH 1:34">Esau and Israel. <verse eid="1CH 1:34"/></para>

<para style="s">The Descendants of EsauGenesis 36:1–19</para>

<para style="q1"><verse number="35" style="v" sid="1CH 1:35"/>The sons of Esau: </para>

<para style="q2" vid="1CH 1:35">Eliphaz, Reuel, and Jeush, and Jaalam, and Korah. <verse eid="1CH 1:35"/></para>

<para style="q2"><verse number="36" style="v" sid="1CH 1:36"/>And the sons of Eliphaz: Teman, and Omar, Zepho, and Gatam, <char style="add">and</char> Kenaz; and <char style="add">by</char> Timna, Amalek. <note caller="+" style="f"><char style="fr" closed="false">1.36 </char><char style="ft" closed="false"> Many Hebrew manuscripts, some LXX manuscripts, and Syriac (see also Genesis 36:11); most Hebrew manuscripts </char><char style="fq" closed="false">Zephi</char></note><verse eid="1CH 1:36"/></para>

<para style="q2"><verse number="37" style="v" sid="1CH 1:37"/>The sons of Reuel: Nahath, Zerah, Shammah, and Mizzah. <verse eid="1CH 1:37"/></para>

<para style="s">The Descendants of SeirGenesis 36:20–30</para>

<para style="q1"><verse number="38" style="v" sid="1CH 1:38"/>And the sons of Seir: </para>

<para style="q2" vid="1CH 1:38">Lotan, and Shobal, and Zibeon, and Anah, and Dishon, and Ezer, and Dishan. <verse eid="1CH 1:38"/></para>

<para style="q2"><verse number="39" style="v" sid="1CH 1:39"/>And the sons of Lotan: Hori and Homam, and the sister of Lotan <char style="add">was</char> Timna. <note caller="+" style="f"><char style="fr" closed="false">1.39 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Homam</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Hemam</char><char style="ft" closed="false">; see Genesis 36:22.</char></note><verse eid="1CH 1:39"/></para>

<para style="q2"><verse number="40" style="v" sid="1CH 1:40"/>The sons of Shobal: Alvan,<note caller="+" style="f"><char style="fr" closed="false">1.40 </char><char style="ft" closed="false"> LXX (see also Genesis 36:23); Hebrew </char><char style="fq" closed="false">Alian</char><char style="ft" closed="false"> </char></note> and Manahath, and Ebal, Shepho,<note caller="+" style="f"><char style="fr" closed="false">1.40 </char><char style="ft" closed="false"> LXX (see also Genesis 36:23); Hebrew </char><char style="fq" closed="false">Shephi</char></note> and Onam. </para>

<para style="q2" vid="1CH 1:40">And the sons of Zibeon: Aiah and Anah. <verse eid="1CH 1:40"/></para>

<para style="q2"><verse number="41" style="v" sid="1CH 1:41"/>The sons of Anah: Dishon. </para>

<para style="q2" vid="1CH 1:41">And the sons of Dishon: Hemdan,<note caller="+" style="f"><char style="fr" closed="false">1.41 </char><char style="ft" closed="false"> LXX (see also Genesis 36:26); Hebrew </char><char style="fq" closed="false">Hamran</char></note> and Eshban, and Ithran, and Cheran. <verse eid="1CH 1:41"/></para>

<para style="q2"><verse number="42" style="v" sid="1CH 1:42"/>The sons of Ezer: Bilhan, and Zaavan, <char style="add">and</char> Akan.<note caller="+" style="f"><char style="fr" closed="false">1.42 </char><char style="ft" closed="false"> LXX (see also Genesis 36:27); Hebrew </char><char style="fq" closed="false">Jaakan</char></note> </para>

<para style="q2" vid="1CH 1:42">The sons of Dishan: Uz and Aran. <verse eid="1CH 1:42"/></para>

<para style="s">The Kings of EdomGenesis 36:31–43</para>

<para style="p"><verse number="43" style="v" sid="1CH 1:43"/>And these <char style="add">were</char> the kings who reigned in the land of Edom before the face of the reigning of a king over the sons of Israel: </para>

<para style="q1" vid="1CH 1:43">Bela son of Beor, and the name of his city <char style="add">was</char> Dinhabah. <verse eid="1CH 1:43"/></para>

<para style="q1"><verse number="44" style="v" sid="1CH 1:44"/>And Bela died, and Jobab son of Zerah of Bozrah reigned in his place. <verse eid="1CH 1:44"/></para>

<para style="q1"><verse number="45" style="v" sid="1CH 1:45"/>And Jobab died, and Husham of the land of the Temanite reigned in his place. <verse eid="1CH 1:45"/></para>

<para style="q1"><verse number="46" style="v" sid="1CH 1:46"/>And Husham died, and Hadad son of Bedad reigned in his place, who struck down Midian in the field of Moab. And the name of his city <char style="add">was</char> Avith. <verse eid="1CH 1:46"/></para>

<para style="q1"><verse number="47" style="v" sid="1CH 1:47"/>And Hadad died, and Samlah of Masrekah reigned in his place. <verse eid="1CH 1:47"/></para>

<para style="q1"><verse number="48" style="v" sid="1CH 1:48"/>And Samlah died, and Saul from Rehoboth of the River<note caller="+" style="f"><char style="fr" closed="false">1.48 </char><char style="ft" closed="false"> That is, </char><char style="fq" closed="false">the Euphrates</char></note> reigned in his place. <verse eid="1CH 1:48"/></para>

<para style="q1"><verse number="49" style="v" sid="1CH 1:49"/>And Saul died, and Baal-hanan son of Achbor reigned in his place. <verse eid="1CH 1:49"/></para>

<para style="q1"><verse number="50" style="v" sid="1CH 1:50"/><char style="add">And</char> Baal-hanan died, and Hadad reigned in his place. And the name of his city <char style="add">was</char> Pau, and the name of His wife <char style="add">was</char> Mehetabel daughter of Matred, daughter of Me-zahab. <note caller="+" style="f"><char style="fr" closed="false">1.50 </char><char style="ft" closed="false"> Many MT manuscripts, some LXX manuscripts, Vulgate, and Syriac (see also Genesis 36:39); most MT manuscripts </char><char style="fq" closed="false">Pai</char></note><verse eid="1CH 1:50"/></para>

<para style="q1"><verse number="51" style="v" sid="1CH 1:51"/>And Hadad died. And the chiefs of Edom were: Chief Timna, Chief Alvah, Chief Jetheth, <verse eid="1CH 1:51"/></para>

<para style="p"><verse number="52" style="v" sid="1CH 1:52"/>Chief Oholibamah, Chief Elah, Chief Pinon, <verse eid="1CH 1:52"/></para>

<para style="p"><verse number="53" style="v" sid="1CH 1:53"/>Chief Kenaz, Chief Teman, Chief Mibzar, <verse eid="1CH 1:53"/></para>

<para style="p"><verse number="54" style="v" sid="1CH 1:54"/>Chief Magdiel, <char style="add">and</char> Chief Iram. These <char style="add">were</char> the chiefs of Edom. <verse eid="1CH 1:54"/></para>

<chapter eid="1CH 1"/>

<chapter number="2" style="c" sid="1CH 2"/>

<para style="s">The Sons of Israel</para>

<para style="p"><verse number="1" style="v" sid="1CH 2:1"/><note caller="-" style="x"><char style="xt" closed="false">Genesis 38:1–30</char></note><note caller="-" style="x"><char style="xt" closed="false">Genesis 35:21–26</char></note>These <char style="add">were</char> the sons of Israel: Reuben, Simeon, Levi, and Judah, Issachar, and Zebulun, <verse eid="1CH 2:1"/></para>

<para style="q1"><verse number="2" style="v" sid="1CH 2:2"/>Dan, Joseph, and Benjamin, Naphtali, Gad, and Asher. <verse eid="1CH 2:2"/></para>

<para style="q1"><verse number="3" style="v" sid="1CH 2:3"/>The sons of Judah: </para>

<para style="q2" vid="1CH 2:3">Er, and Onan, and Shelah; <char style="add">these</char> three were born to him of a daughter of Shua the Canaanitess. And Er the firstborn of Judah was wicked in the eyes of YHWH, and He put him to death. <verse eid="1CH 2:3"/></para>

<para style="q2"><verse number="4" style="v" sid="1CH 2:4"/>And Tamar his daughter-in-law bore to him Perez and Zerah. All the sons of Judah <char style="add">were</char> five. <verse eid="1CH 2:4"/></para>

<para style="q1"><verse number="5" style="v" sid="1CH 2:5"/>The sons of Perez: </para>

<para style="q2" vid="1CH 2:5">Hezron and Hamul. <verse eid="1CH 2:5"/></para>

<para style="q1"><verse number="6" style="v" sid="1CH 2:6"/>And the sons of Zerah: </para>

<para style="q2" vid="1CH 2:6">Zimri, and Ethan, and Heman, and Calcol, and Dara;<note caller="+" style="f"><char style="fr" closed="false">2.6 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Zimri</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Zabdi</char><char style="ft" closed="false">; see Joshua 7:1.</char></note> five of them in all. <note caller="+" style="f"><char style="fr" closed="false">2.6 </char><char style="ft" closed="false"> Most Hebrew manuscripts; many Hebrew manuscripts, some LXX manuscripts, and Syriac (see also 1 Kings 4:31) </char><char style="fq" closed="false">Darda</char></note><verse eid="1CH 2:6"/></para>

<para style="q1"><verse number="7" style="v" sid="1CH 2:7"/>And the son of Carmi: </para>

<para style="q2" vid="1CH 2:7">Achar<note caller="+" style="f"><char style="fr" closed="false">2.7 </char><char style="ft" closed="false"> Hebrew </char><char style="fq" closed="false">sons</char></note> troubler of Israel, who transgressed regarding the devoted thing. <note caller="+" style="f"><char style="fr" closed="false">2.7 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Achar</char><char style="ft" closed="false"> means </char><char style="fq" closed="false">troubler</char><char style="ft" closed="false">; also called </char><char style="fq" closed="false">Achan</char><char style="ft" closed="false"> in Joshua 7 and Joshua 22.</char></note><verse eid="1CH 2:7"/></para>

<para style="q1"><verse number="8" style="v" sid="1CH 2:8"/>And the sons of Ethan: </para>

<para style="q2" vid="1CH 2:8">Azariah. <verse eid="1CH 2:8"/></para>

<para style="q1"><verse number="9" style="v" sid="1CH 2:9"/>And the sons of Hezron who were born to him: </para>

<para style="q2" vid="1CH 2:9">Jerahmeel, and Ram, and Chelubai. <note caller="+" style="f"><char style="fr" closed="false">2.9 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Chelubai</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Caleb</char><char style="ft" closed="false">; see verse 18.</char></note><verse eid="1CH 2:9"/></para>

<para style="q1"><verse number="10" style="v" sid="1CH 2:10"/>And Ram begat Amminadab, and Amminadab begat Nahshon, a leader of the sons of Judah. <verse eid="1CH 2:10"/></para>

<para style="q1"><verse number="11" style="v" sid="1CH 2:11"/>And Nahshon begat Salmon, and Salmon begat Boaz, <note caller="+" style="f"><char style="fr" closed="false">2.11 </char><char style="ft" closed="false"> LXX (see also Ruth 4:20–21); Hebrew </char><char style="fq" closed="false">Salma</char><char style="ft" closed="false">; twice in this verse</char></note><verse eid="1CH 2:11"/></para>

<para style="q1"><verse number="12" style="v" sid="1CH 2:12"/>and Boaz begat Obed, and Obed begat Jesse, <verse eid="1CH 2:12"/></para>

<para style="q1"><verse number="13" style="v" sid="1CH 2:13"/>and Jesse begat his firstborn Eliab, and Abinadab the second, and Shimea the third, <note caller="+" style="f"><char style="fr" closed="false">2.13 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Shimea</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Shammah</char><char style="ft" closed="false">, </char><char style="fq" closed="false">Shimeah</char><char style="ft" closed="false">, and </char><char style="fq" closed="false">Shimei</char><char style="ft" closed="false">; see 1 Samuel 16:9, 2 Samuel 13:3, and 2 Samuel 21:21.</char></note><verse eid="1CH 2:13"/></para>

<para style="q1"><verse number="14" style="v" sid="1CH 2:14"/>Nethanel the fourth, Raddai the fifth, <verse eid="1CH 2:14"/></para>

<para style="q1"><verse number="15" style="v" sid="1CH 2:15"/>Ozem the sixth, <char style="add">and</char> David the seventh. <verse eid="1CH 2:15"/></para>

<para style="q1"><verse number="16" style="v" sid="1CH 2:16"/>And their sisters <char style="add">were</char> Zeruiah and Abigail. And the sons of Zeruiah: Abishai, and Joab, and Asahel—three. <verse eid="1CH 2:16"/></para>

<para style="q1"><verse number="17" style="v" sid="1CH 2:17"/>And Abigail bore Amasa, and the father of Amasa <char style="add">was</char> Jether the Ishmaelite. <note caller="+" style="f"><char style="fr" closed="false">2.17 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Jether</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Ithra</char><char style="ft" closed="false">; see 2 Samuel 17:25.</char></note><verse eid="1CH 2:17"/></para>

<para style="q1"><verse number="18" style="v" sid="1CH 2:18"/>And Caleb son of Hezron had children by Azubah <char style="add">his</char> wife and by Jerioth. And these <char style="add">were</char> her sons: Jesher, and Shobab, and Ardon. <verse eid="1CH 2:18"/></para>

<para style="q1"><verse number="19" style="v" sid="1CH 2:19"/>And Azubah died, and Caleb took as his wife Ephrath,<note caller="+" style="f"><char style="fr" closed="false">2.19 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Ephrath</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Ephrathah</char><char style="ft" closed="false">; see verse 50.</char></note> and she bore to him Hur. <verse eid="1CH 2:19"/></para>

<para style="q1"><verse number="20" style="v" sid="1CH 2:20"/>And Hur begat Uri, and Uri begat Bezalel. <verse eid="1CH 2:20"/></para>

<para style="q1"><verse number="21" style="v" sid="1CH 2:21"/>And afterward Hezron went in to the daughter of Machir father of Gilead, and he married her. And he <char style="add">was</char> a son of sixty years, and she bore to him Segub. <verse eid="1CH 2:21"/></para>

<para style="q1"><verse number="22" style="v" sid="1CH 2:22"/>And Segub begat Jair, and he had unto him twenty-three cities in the land of Gilead. <verse eid="1CH 2:22"/></para>

<para style="q1"><verse number="23" style="v" sid="1CH 2:23"/>And Geshur and Aram took Havvoth-jair,<note caller="+" style="f"><char style="fr" closed="false">2.23 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the villages of Jair</char></note> with Kenath and its daughters—sixty towns. All these <char style="add">were</char> the sons of Machir the father of Gilead. <verse eid="1CH 2:23"/></para>

<para style="q1"><verse number="24" style="v" sid="1CH 2:24"/>And after the death of Hezron in Caleb-ephrathah, the wife of Hezron, Abijah, bore<note caller="+" style="f"><char style="fr" closed="false">2.24 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">After Hezron died, Caleb had relations with Ephrathah, the wife of Hezron his father, and she bore</char><char style="ft" closed="false">; see also LXX.</char></note> to him Ashhur father<note caller="+" style="f"><char style="fr" closed="false">2.24 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the founder</char><char style="ft" closed="false">; also in verses 42, 45, 49, and possibly elsewhere</char></note> of Tekoa. <verse eid="1CH 2:24"/></para>

<para style="q1"><verse number="25" style="v" sid="1CH 2:25"/>And the sons of Jerahmeel the firstborn of Hezron: The firstborn Ram, and Bunah, and Oren, and Ozem, <char style="add">and</char> Ahijah. <verse eid="1CH 2:25"/></para>

<para style="q2"><verse number="26" style="v" sid="1CH 2:26"/>And to Jerahmeel was another wife, and her name <char style="add">was</char> Atarah. She <char style="add">was</char> the mother of Onam. <verse eid="1CH 2:26"/></para>

<para style="q1"><verse number="27" style="v" sid="1CH 2:27"/>And the sons of Ram the firstborn of Jerahmeel were: </para>

<para style="q2" vid="1CH 2:27">Maaz, and Jamin, and Eker. <verse eid="1CH 2:27"/></para>

<para style="q1"><verse number="28" style="v" sid="1CH 2:28"/>And the sons of Onam were: </para>

<para style="q2" vid="1CH 2:28">Shammai and Jada. </para>

<para style="q1" vid="1CH 2:28">And the sons of Shammai: Nadab and Abishur. <verse eid="1CH 2:28"/></para>

<para style="q2"><verse number="29" style="v" sid="1CH 2:29"/>And the name of the wife of Abishur <char style="add">was</char> Abihail, and she bore to him Ahban and Molid. <verse eid="1CH 2:29"/></para>

<para style="q1"><verse number="30" style="v" sid="1CH 2:30"/>And the sons of Nadab: </para>

<para style="q2" vid="1CH 2:30">Seled and Appaim. And Seled died without sons. <verse eid="1CH 2:30"/></para>

<para style="q1"><verse number="31" style="v" sid="1CH 2:31"/>And the sons of Appaim: </para>

<para style="q2" vid="1CH 2:31">Ishi. </para>

<para style="q1" vid="1CH 2:31">And the sons of Ishi: </para>

<para style="q2" vid="1CH 2:31">Sheshan. </para>

<para style="q1" vid="1CH 2:31">And the sons of Sheshan: </para>

<para style="q2" vid="1CH 2:31">Ahlai. <verse eid="1CH 2:31"/></para>

<para style="q1"><verse number="32" style="v" sid="1CH 2:32"/>And the sons of Jada the brother of Shammai: </para>

<para style="q2" vid="1CH 2:32">Jether and Jonathan. And Jether died without sons. <verse eid="1CH 2:32"/></para>

<para style="q1"><verse number="33" style="v" sid="1CH 2:33"/>And the sons of Jonathan: </para>

<para style="q2" vid="1CH 2:33">Peleth and Zaza. </para>

<para style="q1" vid="1CH 2:33">These were the sons of Jerahmeel. <verse eid="1CH 2:33"/></para>

<para style="q1"><verse number="34" style="v" sid="1CH 2:34"/>Unto Sheshan there were no sons, but only daughters. And unto Sheshan <char style="add">was</char> a servant, an Egyptian, and his name <char style="add">was</char> Jarha. <verse eid="1CH 2:34"/></para>

<para style="q1"><verse number="35" style="v" sid="1CH 2:35"/>And Sheshan gave his daughter to Jarha his servant for a wife, and she bore to him Attai. <verse eid="1CH 2:35"/></para>

<para style="q1"><verse number="36" style="v" sid="1CH 2:36"/>And Attai begat Nathan, and Nathan begat Zabad, <verse eid="1CH 2:36"/></para>

<para style="q1"><verse number="37" style="v" sid="1CH 2:37"/>and Zabad begat Ephlal, and Ephlal begat Obed, <verse eid="1CH 2:37"/></para>

<para style="q1"><verse number="38" style="v" sid="1CH 2:38"/>and Obed begat Jehu, and Jehu begat Azariah, <verse eid="1CH 2:38"/></para>

<para style="q1"><verse number="39" style="v" sid="1CH 2:39"/>and Azariah begat Helez, and Helez begat Eleasah, <verse eid="1CH 2:39"/></para>

<para style="q1"><verse number="40" style="v" sid="1CH 2:40"/>and Eleasah begat Sismai, and Sismai begat Shallum, <verse eid="1CH 2:40"/></para>

<para style="q1"><verse number="41" style="v" sid="1CH 2:41"/>and Shallum begat Jekamiah, and Jekamiah begat Elishama. <verse eid="1CH 2:41"/></para>

<para style="q1"><verse number="42" style="v" sid="1CH 2:42"/>And the sons of Caleb the brother of Jerahmeel: </para>

<para style="q2" vid="1CH 2:42">Mesha<note caller="+" style="f"><char style="fr" closed="false">2.42 </char><char style="ft" closed="false"> Hebrew; LXX </char><char style="fq" closed="false">Mareshah</char></note> his firstborn (he <char style="add">was</char> the father of Ziph), and his son Mareshah, the father of Hebron. <verse eid="1CH 2:42"/></para>

<para style="q1"><verse number="43" style="v" sid="1CH 2:43"/>And the sons of Hebron: Korah, and Tappuah, and Rekem, and Shema. <verse eid="1CH 2:43"/></para>

<para style="q2"><verse number="44" style="v" sid="1CH 2:44"/>And Shema begat Raham the father of Jorkoam, and Rekem begat Shammai. <verse eid="1CH 2:44"/></para>

<para style="q2"><verse number="45" style="v" sid="1CH 2:45"/>And a son of Shammai <char style="add">was</char> Maon, and Maon <char style="add">was</char> the father of Beth-zur. <verse eid="1CH 2:45"/></para>

<para style="q1"><verse number="46" style="v" sid="1CH 2:46"/>And Ephah, concubine of Caleb, bore Haran, and Moza, and Gazez. And Haran begat Gazez. <verse eid="1CH 2:46"/></para>

<para style="q1"><verse number="47" style="v" sid="1CH 2:47"/>And the sons of Jahdai: </para>

<para style="q2" vid="1CH 2:47">Regem, and Jotham, and Geshan, and Pelet, and Ephah, and Shaaph. <verse eid="1CH 2:47"/></para>

<para style="q1"><verse number="48" style="v" sid="1CH 2:48"/>The concubine of Caleb, Maacah, bore Sheber and Tirhanah. <verse eid="1CH 2:48"/></para>

<para style="q1"><verse number="49" style="v" sid="1CH 2:49"/>And she gave birth to Shaaph the father of Madmannah <char style="add">and to</char> Sheva the father of Machbenah and the father of Gibea. And the daughter of Caleb <char style="add">was</char> Acsah. <verse eid="1CH 2:49"/></para>

<para style="q1"><verse number="50" style="v" sid="1CH 2:50"/>These were the sons of Caleb. </para>

<para style="q1" vid="1CH 2:50">The sons<note caller="+" style="f"><char style="fr" closed="false">2.50 </char><char style="ft" closed="false"> LXX and Vulgate; Hebrew </char><char style="fq" closed="false">son</char></note> of Hur the firstborn of Ephrathah:<note caller="+" style="f"><char style="fr" closed="false">2.50 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Ephrathah</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Ephrath</char><char style="ft" closed="false">; see verse 19.</char></note> Shobal the father of Kiriath-jearim, <verse eid="1CH 2:50"/></para>

<para style="q2"><verse number="51" style="v" sid="1CH 2:51"/>Salma the father of Bethlehem, <char style="add">and</char> Hareph the father of Beth-gader. <verse eid="1CH 2:51"/></para>

<para style="q1"><verse number="52" style="v" sid="1CH 2:52"/>And the sons Shobal the father of Kiriath-jearim were: Haroeh, half the Manahathites, <verse eid="1CH 2:52"/></para>

<para style="q2"><verse number="53" style="v" sid="1CH 2:53"/>and the clans of Kiriath-jearim—the Ithrite, and the Puthite, and the Shumathite, and the Mishraite. From these came the Zorathite and the Eshtaolite. <verse eid="1CH 2:53"/></para>

<para style="q1"><verse number="54" style="v" sid="1CH 2:54"/>The sons of Salma: Bethlehem, and the Netophathite, Atroth-beth-joab, and half the Manahathite, the Zorite, <verse eid="1CH 2:54"/></para>

<para style="q2"><verse number="55" style="v" sid="1CH 2:55"/>and the clans of the scribes<note caller="+" style="f"><char style="fr" closed="false">2.55 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">of the Sopherim</char><char style="ft" closed="false"> </char></note> who dwelt at Jabez—the Tirathites, the Shimeathites, <char style="add">and</char> the Suchathites. These <char style="add">are</char> the Kenites who came from Hammath, the father of the house of Rechab.<note caller="+" style="f"><char style="fr" closed="false">2.55 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the father of Beth-rekab</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">the founder of the house of Rechab</char></note> <verse eid="1CH 2:55"/></para>

<chapter eid="1CH 2"/>

<chapter number="3" style="c" sid="1CH 3"/>

<para style="s">The Descendants of David</para>

<para style="p"><verse number="1" style="v" sid="1CH 3:1"/><note caller="-" style="x"><char style="xt" closed="false">2 Samuel 3:1–5</char></note>And these were the sons of David who were born to him in Hebron: </para>

<para style="q1" vid="1CH 3:1">The firstborn Amnon by Ahinoam the Jezreelitess; </para>

<para style="q1" vid="1CH 3:1">the second Daniel by Abigail the Carmelitess; <verse eid="1CH 3:1"/></para>

<para style="q1"><verse number="2" style="v" sid="1CH 3:2"/>the third Absalom son of Maacah the daughter of Talmai king of Geshur; </para>

<para style="q1" vid="1CH 3:2">the fourth Adonijah son of Haggith; <verse eid="1CH 3:2"/></para>

<para style="q1"><verse number="3" style="v" sid="1CH 3:3"/>the fifth Shephatiah by Abital; </para>

<para style="q1" vid="1CH 3:3">the sixth Ithream by Eglah his wife. <verse eid="1CH 3:3"/></para>

<para style="q1"><verse number="4" style="v" sid="1CH 3:4"/>Six were born to him in Hebron, and he reigned there seven years and six months. And thirty-three years he reigned in Jerusalem. <verse eid="1CH 3:4"/></para>

<para style="p"><verse number="5" style="v" sid="1CH 3:5"/>And these were born to him in Jerusalem: </para>

<para style="q1" vid="1CH 3:5">Shimea, and Shobab, and Nathan, and Solomon—four by Bathsheba<note caller="+" style="f"><char style="fr" closed="false">3.5 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Shimea</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Shammua</char><char style="ft" closed="false">; see 2 Samuel 5:14 and 1 Chronicles 14:4.</char></note> daughter of Ammiel;<note caller="+" style="f"><char style="fr" closed="false">3.5 </char><char style="ft" closed="false"> One Hebrew manuscript and Vulgate (see also LXX and 2 Samuel 11:3); most Hebrew manuscripts </char><char style="fq" closed="false">Bath-shua</char></note> <note caller="+" style="f"><char style="fr" closed="false">3.5 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Ammiel</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Eliam</char><char style="ft" closed="false">; see 2 Samuel 11:3.</char></note><verse eid="1CH 3:5"/></para>

<para style="q1"><verse number="6" style="v" sid="1CH 3:6"/>and Ibhar, and Elishua,<note caller="+" style="f"><char style="fr" closed="false">3.6 </char><char style="ft" closed="false"> Two Hebrew manuscripts (see also 2 Samuel 5:15 and 1 Chronicles 14:5); most Hebrew manuscripts </char><char style="fq" closed="false">Elishama</char></note> and Eliphelet, <verse eid="1CH 3:6"/></para>

<para style="q1"><verse number="7" style="v" sid="1CH 3:7"/>and Nogah, and Nepheg, and Japhia, <verse eid="1CH 3:7"/></para>

<para style="q1"><verse number="8" style="v" sid="1CH 3:8"/>and Elishama, and Eliada, and Eliphelet—nine. <verse eid="1CH 3:8"/></para>

<para style="q1"><verse number="9" style="v" sid="1CH 3:9"/>All <char style="add">were</char> the sons of David, besides the sons of the concubines, and Tamar their sister. <verse eid="1CH 3:9"/></para>

<para style="s">The Descendants of Solomon</para>

<para style="q1"><verse number="10" style="v" sid="1CH 3:10"/>And the son of Solomon <char style="add">was</char> Rehoboam, Abijah his son, Asa his son, Jehoshaphat his son, <verse eid="1CH 3:10"/></para>

<para style="q2"><verse number="11" style="v" sid="1CH 3:11"/>Joram his son, Ahaziah his son, Joash his son, <note caller="+" style="f"><char style="fr" closed="false">3.11 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Joram</char><char style="ft" closed="false"> is a variant spelling of </char><char style="fq" closed="false">Jehoram</char><char style="ft" closed="false">.</char></note><verse eid="1CH 3:11"/></para>

<para style="q2"><verse number="12" style="v" sid="1CH 3:12"/>Amaziah his son, Azariah<note caller="+" style="f"><char style="fr" closed="false">3.12 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Azariah</char><char style="ft" closed="false"> is also called </char><char style="fq" closed="false">Uzziah</char><char style="ft" closed="false">; see 2 Chronicles 26:1.</char></note> his son, Jotham his son, <verse eid="1CH 3:12"/></para>

<para style="q2"><verse number="13" style="v" sid="1CH 3:13"/>Ahaz his son, Hezekiah his son, Manasseh his son, <verse eid="1CH 3:13"/></para>

<para style="q2"><verse number="14" style="v" sid="1CH 3:14"/>Amon his son, <char style="add">and</char> Josiah his son. <verse eid="1CH 3:14"/></para>

<para style="q1"><verse number="15" style="v" sid="1CH 3:15"/>And the sons of Josiah: </para>

<para style="q2" vid="1CH 3:15">The firstborn Johanan, the second Jehoiakim, the third Zedekiah, the fourth Shallum. <note caller="+" style="f"><char style="fr" closed="false">3.15 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Shallum</char><char style="ft" closed="false"> is another name for </char><char style="fq" closed="false">Jehoahaz</char><char style="ft" closed="false">.</char></note><verse eid="1CH 3:15"/></para>

<para style="q1"><verse number="16" style="v" sid="1CH 3:16"/>And the sons of Jehoiakim: </para>

<para style="q2" vid="1CH 3:16">Jeconiah<note caller="+" style="f"><char style="fr" closed="false">3.16 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Jeconiah</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Jehoiachin</char><char style="ft" closed="false">; also in verse 17; see 2 Kings 24:6.</char></note> his son, <char style="add">and</char> Zedekiah his son. <verse eid="1CH 3:16"/></para>

<para style="s">The Royal Line After the Exile</para>

<para style="q1"><verse number="17" style="v" sid="1CH 3:17"/>And the sons of Jeconiah the captive: Shealtiel his son, <verse eid="1CH 3:17"/></para>

<para style="q2"><verse number="18" style="v" sid="1CH 3:18"/>and Malchiram, and Pedaiah, and Shenazzar, Jekamiah, Hoshama, and Nedabiah. <verse eid="1CH 3:18"/></para>

<para style="q1"><verse number="19" style="v" sid="1CH 3:19"/>And the sons of Pedaiah: </para>

<para style="q2" vid="1CH 3:19">Zerubbabel and Shimei. </para>

<para style="q1" vid="1CH 3:19">And the sons of Zerubbabel: Meshullam, and Hananiah, and Shelomith their sister, <verse eid="1CH 3:19"/></para>

<para style="q2"><verse number="20" style="v" sid="1CH 3:20"/>and Hashubah, and Ohel, and Berechiah, and Hasadiah, <char style="add">and</char> Jushab-hesed—five. <verse eid="1CH 3:20"/></para>

<para style="q1"><verse number="21" style="v" sid="1CH 3:21"/>And the sons of Hananiah: </para>

<para style="q2" vid="1CH 3:21">Pelatiah, and Jeshaiah, the sons of Rephaiah, the sons of Arnan, the sons of Obadiah, <char style="add">and</char> the sons of Shechaniah. <verse eid="1CH 3:21"/></para>

<para style="q1"><verse number="22" style="v" sid="1CH 3:22"/>And the sons of Shechaniah: Shemaiah. And the sons of Shemaiah: </para>

<para style="q2" vid="1CH 3:22">Hattush, and Igal, and Bariah, and Neariah, and Shaphat—six. <verse eid="1CH 3:22"/></para>

<para style="q1"><verse number="23" style="v" sid="1CH 3:23"/>And the sons of Neariah: </para>

<para style="q2" vid="1CH 3:23">Elioenai, and Hezekiah, and Azrikam—three. <verse eid="1CH 3:23"/></para>

<para style="q1"><verse number="24" style="v" sid="1CH 3:24"/>And the sons of Elioenai: </para>

<para style="q2" vid="1CH 3:24">Hodaviah, and Eliashib, and Pelaiah, and Akkub, and Johanan, and Delaiah, and Anani—seven. <verse eid="1CH 3:24"/></para>

<chapter eid="1CH 3"/>

<chapter number="4" style="c" sid="1CH 4"/>

<para style="s">The Descendants of Judah</para>

<para style="p"><verse number="1" style="v" sid="1CH 4:1"/>The sons of Judah: </para>

<para style="q1" vid="1CH 4:1">Perez, Hezron, and Carmi, and Hur, and Shobal. <verse eid="1CH 4:1"/></para>

<para style="q1"><verse number="2" style="v" sid="1CH 4:2"/>And Reaiah son of Shobal begat Jahath, and Jahath begat Ahumai and Lahad. These <char style="add">were</char> the clans of the Zorathite. <verse eid="1CH 4:2"/></para>

<para style="q1"><verse number="3" style="v" sid="1CH 4:3"/>And these <char style="add">were</char> the sons<note caller="+" style="f"><char style="fr" closed="false">4.3 </char><char style="ft" closed="false"> LXX (see also Vulgate); Hebrew </char><char style="fq" closed="false">These were of the father</char></note> of Etam: Jezreel, and Ishma, and Idbash. And the name of their sister <char style="add">was</char> Hazelelponi. <verse eid="1CH 4:3"/></para>

<para style="q1"><verse number="4" style="v" sid="1CH 4:4"/>And Penuel <char style="add">was</char> the father<note caller="+" style="f"><char style="fr" closed="false">4.4 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the founder</char><char style="ft" closed="false">; also in verses 5, 12, 14, 17, 18, and possibly elsewhere</char></note> of Gedor, and Ezer <char style="add">was</char> the father of Hushah. </para>

<para style="q1" vid="1CH 4:4">These <char style="add">were</char> the sons of Hur the firstborn of Ephrathah the father of Bethlehem. <verse eid="1CH 4:4"/></para>

<para style="q1"><verse number="5" style="v" sid="1CH 4:5"/>And Ashhur the father of Tekoa had two wives, Helah and Naarah. <verse eid="1CH 4:5"/></para>

<para style="q2"><verse number="6" style="v" sid="1CH 4:6"/>And Naarah bore to him Ahuzzam, and Hepher, and Temeni, and Haahashtari. These <char style="add">were</char> the sons of Naarah. <verse eid="1CH 4:6"/></para>

<para style="q2"><verse number="7" style="v" sid="1CH 4:7"/>And the sons of Helah: Zereth, and Zohar,<note caller="+" style="f"><char style="fr" closed="false">4.7 </char><char style="ft" closed="false"> Alternate MT reading; the other alternate (see also Vulgate) reads </char><char style="fq" closed="false">Izhar</char><char style="ft" closed="false">.</char></note> and Ethnan. <verse eid="1CH 4:7"/></para>

<para style="q2"><verse number="8" style="v" sid="1CH 4:8"/>And Koz begat Anub, and Zobebah, and the clans of Aharhel son of Harum. <verse eid="1CH 4:8"/></para>

<para style="s">The Prayer of Jabez</para>

<para style="q1"><verse number="9" style="v" sid="1CH 4:9"/>And Jabez was more honorable than his brothers, and his mother called his name Jabez,<note caller="+" style="f"><char style="fr" closed="false">4.9 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Jabez</char><char style="ft" closed="false"> sounds like the Hebrew for </char><char style="fq" closed="false">pain</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">distress</char><char style="ft" closed="false">.</char></note> saying, “Because I have brought forth in pain.” <verse eid="1CH 4:9"/></para>

<para style="q1"><verse number="10" style="v" sid="1CH 4:10"/>And Jabez called out to the God of Israel, saying, “If only You would greatly bless me and enlarge my territory! And may Your hand be with me, that You would keep <char style="add">me</char> from evil, not to grieve me.” </para>

<para style="q1" vid="1CH 4:10">And God brought in for him that which he asked. <verse eid="1CH 4:10"/></para>

<para style="s">More Descendants of Judah</para>

<para style="q1"><verse number="11" style="v" sid="1CH 4:11"/>And Chelub the brother of Shuhah begat Mehir; he <char style="add">was</char> the father of Eshton. <verse eid="1CH 4:11"/></para>

<para style="q1"><verse number="12" style="v" sid="1CH 4:12"/>And Eshton begat Beth-rapha, and Paseah, and Tehinnah father of Ir-nahash. These <char style="add">were</char> the men of Rechah. <verse eid="1CH 4:12"/></para>

<para style="q1"><verse number="13" style="v" sid="1CH 4:13"/>And the sons of Kenaz: </para>

<para style="q2" vid="1CH 4:13">Othniel and Seraiah. </para>

<para style="q1" vid="1CH 4:13">And the sons of Othniel: </para>

<para style="q2" vid="1CH 4:13">Hathath and Meonothai.<note caller="+" style="f"><char style="fr" closed="false">4.13 </char><char style="ft" closed="false"> Vulgate and some LXX; Hebrew does not include </char><char style="fq" closed="false">and Meonothai</char><char style="ft" closed="false">.</char></note> <verse eid="1CH 4:13"/></para>

<para style="q1"><verse number="14" style="v" sid="1CH 4:14"/>And Meonothai begat Ophrah, and Seraiah begat Joab, the father of Ge-harashim,<note caller="+" style="f"><char style="fr" closed="false">4.14 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Ge-harashim</char><char style="ft" closed="false"> means </char><char style="fq" closed="false">valley of craftsmen</char><char style="ft" closed="false">.</char></note> for they were craftsmen. <verse eid="1CH 4:14"/></para>

<para style="q1"><verse number="15" style="v" sid="1CH 4:15"/>And the sons of Caleb son of Jephunneh: </para>

<para style="q2" vid="1CH 4:15">Iru, Elah, and Naam. </para>

<para style="q1" vid="1CH 4:15">And the sons of Elah and Kenaz.<note caller="+" style="f"><char style="fr" closed="false">4.15 </char><char style="ft" closed="false"> That is </char><char style="fq" closed="false">And the son of Elah: Kenaz</char><char style="ft" closed="false"> </char></note> <verse eid="1CH 4:15"/></para>

<para style="q1"><verse number="16" style="v" sid="1CH 4:16"/>And the sons of Jehallelel: </para>

<para style="q2" vid="1CH 4:16">Ziph, and Ziphah, Tiria, and Asarel. <verse eid="1CH 4:16"/></para>

<para style="q1"><verse number="17" style="v" sid="1CH 4:17"/>And the sons of Ezrah: </para>

<para style="q2" vid="1CH 4:17">Jether, and Mered, and Epher, and Jalon. And she bore<note caller="+" style="f"><char style="fr" closed="false">4.17 </char><char style="ft" closed="false"> That is </char><char style="fq" closed="false">Mered’s wife Bithiah bore</char></note> Miriam, and Shammai, and Ishbah father of Eshtemoa. <verse eid="1CH 4:17"/></para>

<para style="q2"><verse number="18" style="v" sid="1CH 4:18"/>And His wife, a Judean,<note caller="+" style="f"><char style="fr" closed="false">4.18 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">a Judahite</char></note> bore Jared the father of Gedor. And Heber the father of Sochoh, and Jekuthiel the father of Zanoah. And these <char style="add">were</char> the sons of Bithiah the daughter of Pharaoh, whom Mered took. <verse eid="1CH 4:18"/></para>

<para style="q1"><verse number="19" style="v" sid="1CH 4:19"/>And the sons of the wife of Hodiah the sister of Naham: </para>

<para style="q2" vid="1CH 4:19">The father of Keilah the Garmite and of Eshtemoa the Maachathite.<note caller="+" style="f"><char style="fr" closed="false">4.19 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">The father of Keilah the Garmite, and Eshtemoa the Maacathite</char></note> <verse eid="1CH 4:19"/></para>

<para style="q1"><verse number="20" style="v" sid="1CH 4:20"/>And the sons of Shimon: </para>

<para style="q2" vid="1CH 4:20">Amnon, and Rinnah, Ben-hanan, and Tilon. </para>

<para style="q1" vid="1CH 4:20">And the sons of Ishi: </para>

<para style="q2" vid="1CH 4:20">Zoheth and Ben-zoheth. <verse eid="1CH 4:20"/></para>

<para style="q1"><verse number="21" style="v" sid="1CH 4:21"/>The sons of Shelah son of Judah: Er the father of Lecah, and Laadah the father of Mareshah, and the clans of the house of the workers of the linen of the house of Ashbea, <verse eid="1CH 4:21"/></para>

<para style="q2"><verse number="22" style="v" sid="1CH 4:22"/>and Jokim, and the men of Cozeba, and Joash, and Saraph, who ruled in Moab, and Jashubi-lehem. (And the records are ancient.) <verse eid="1CH 4:22"/></para>

<para style="q2"><verse number="23" style="v" sid="1CH 4:23"/>They <char style="add">were</char> the potters and those who dwelt at Netaim and Gederah. They dwelt there with the king for his work. <verse eid="1CH 4:23"/></para>

<para style="s">The Descendants of Simeon</para>

<para style="p"><verse number="24" style="v" sid="1CH 4:24"/>The sons of Simeon: </para>

<para style="q1" vid="1CH 4:24">Nemuel, and Jamin, Jarib, Zerah, <char style="add">and</char> Shaul. <note caller="+" style="f"><char style="fr" closed="false">4.24 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Zerah</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Zohar</char><char style="ft" closed="false">; see Genesis 46:10 and Exodus 6:15.</char></note><verse eid="1CH 4:24"/></para>

<para style="q1"><verse number="25" style="v" sid="1CH 4:25"/>Shallum his son, Mibsam his son, and Mishma his son. <verse eid="1CH 4:25"/></para>

<para style="q1"><verse number="26" style="v" sid="1CH 4:26"/>And the sons of Mishma: </para>

<para style="q2" vid="1CH 4:26">Hamuel his son, Zaccur his son, and Shimei his son. <verse eid="1CH 4:26"/></para>

<para style="q1"><verse number="27" style="v" sid="1CH 4:27"/>And Shimei had sixteen sons and six daughters, and his brothers did not have many sons and did not multiply any of their clans as much as the sons of Judah. <verse eid="1CH 4:27"/></para>

<para style="q1"><verse number="28" style="v" sid="1CH 4:28"/>And they dwelt at Beersheba, and Moladah, and Hazar-shual, <verse eid="1CH 4:28"/></para>

<para style="q1"><verse number="29" style="v" sid="1CH 4:29"/>and Bilhah, and Ezem, and Tolad, <verse eid="1CH 4:29"/></para>

<para style="q1"><verse number="30" style="v" sid="1CH 4:30"/>and Bethuel, and Hormah, and Ziklag, <verse eid="1CH 4:30"/></para>

<para style="q1"><verse number="31" style="v" sid="1CH 4:31"/>and Beth-marcaboth, and Hazar-susim, and Beth-biri, and in Shaaraim. These <char style="add">were</char> their cities until the reign of David. <verse eid="1CH 4:31"/></para>

<para style="q1"><verse number="32" style="v" sid="1CH 4:32"/>And their villages <char style="add">were</char> Etam, and Ain, Rimmon, and Tochen, and Ashan—five cities— <verse eid="1CH 4:32"/></para>

<para style="q1"><verse number="33" style="v" sid="1CH 4:33"/>and all the villages that <char style="add">were</char> around these cities, as far as Baal.<note caller="+" style="f"><char style="fr" closed="false">4.33 </char><char style="ft" closed="false"> Hebrew; some LXX manuscripts (see also Joshua 19:8) </char><char style="fq" closed="false">Baalath</char></note> These <char style="add">were</char> their dwelling places, and they kept a genealogy to them: <verse eid="1CH 4:33"/></para>

<para style="q2"><verse number="34" style="v" sid="1CH 4:34"/>Even Meshobab, and Jamlech, and Joshah son of Amaziah, <verse eid="1CH 4:34"/></para>

<para style="q2"><verse number="35" style="v" sid="1CH 4:35"/>and Joel, and Jehu son of Joshibiah (son of Seraiah, son of Asiel), <verse eid="1CH 4:35"/></para>

<para style="q2"><verse number="36" style="v" sid="1CH 4:36"/>and Elioenai, and Jaakobah, and Jeshohaiah, and Asaiah, and Adiel, and Jesimiel, and Benaiah, <verse eid="1CH 4:36"/></para>

<para style="q2"><verse number="37" style="v" sid="1CH 4:37"/>and Ziza son of Shiphi (son of Allon, son of Jedaiah, son of Shimri, son of Shemaiah). <verse eid="1CH 4:37"/></para>

<para style="q1"><verse number="38" style="v" sid="1CH 4:38"/>These coming in by name <char style="add">were</char> leaders in their clans, and the house of their father increased greatly. <verse eid="1CH 4:38"/></para>

<para style="q1"><verse number="39" style="v" sid="1CH 4:39"/>And they went to the entrance of Gedor, as far as the east side of the valley, to seek pasture for their flocks. <verse eid="1CH 4:39"/></para>

<para style="q1"><verse number="40" style="v" sid="1CH 4:40"/>And they found pasture rich and good, and the land broad of sides, and quiet, and peaceful. For some Hamites had lived there formerly. <verse eid="1CH 4:40"/></para>

<para style="q1"><verse number="41" style="v" sid="1CH 4:41"/>And these written by name came in the days of Hezekiah king of Judah, and they struck their tents and the Meunites who were found there, and they devoted them to destruction<note caller="+" style="f"><char style="fr" closed="false">4.41 </char><char style="ft" closed="false"> Forms of the Hebrew </char><char style="fq" closed="false">cherem</char><char style="ft" closed="false"> refer to the giving over of things or persons to YHWH, either by destroying them or by giving them as an offering.</char></note> to this day. And they dwelt in their place, because <char style="add">there was</char> pasture for their flocks there. <verse eid="1CH 4:41"/></para>

<para style="q1"><verse number="42" style="v" sid="1CH 4:42"/>And some of the sons of Simeon went to Mount Seir, five hundred men, and Pelatiah, and Neariah, and Rephaiah, and Uzziel, the sons of Ishi, at their head. <verse eid="1CH 4:42"/></para>

<para style="q1"><verse number="43" style="v" sid="1CH 4:43"/>And they defeated the remnant who had escaped of Amalek, and they have dwelt there to this day. <verse eid="1CH 4:43"/></para>

<chapter eid="1CH 4"/>

<chapter number="5" style="c" sid="1CH 5"/>

<para style="s">The Descendants of Reuben</para>

<para style="p"><verse number="1" style="v" sid="1CH 5:1"/>And the sons of Reuben the firstborn of Israel—for he <char style="add">was</char> the firstborn, and because he defiled the bed of his father, his birthright was given to the sons of Joseph son of Israel, and he is not reckoned according to birthright. <verse eid="1CH 5:1"/></para>

<para style="p"><verse number="2" style="v" sid="1CH 5:2"/>Yet Judah prevailed over his brother, and a leader was from him, and the birthright <char style="add">was</char> to Joseph. <verse eid="1CH 5:2"/></para>

<para style="p"><verse number="3" style="v" sid="1CH 5:3"/>The sons of Reuben, the firstborn of Israel: </para>

<para style="q1" vid="1CH 5:3">Hanoch, and Pallu, Hezron, and Carmi. <verse eid="1CH 5:3"/></para>

<para style="q1"><verse number="4" style="v" sid="1CH 5:4"/>The sons of Joel: Shemaiah his son, Gog his son, Shimei his son, <verse eid="1CH 5:4"/></para>

<para style="q2"><verse number="5" style="v" sid="1CH 5:5"/>Micah his son, Reaiah his son, Baal his son, <verse eid="1CH 5:5"/></para>

<para style="q2"><verse number="6" style="v" sid="1CH 5:6"/>and Beerah his son, whom Tiglath-pilneser<note caller="+" style="f"><char style="fr" closed="false">5.6 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Tilgath-pilneser</char><char style="ft" closed="false"> is a variant spelling of </char><char style="fq" closed="false">Tiglath-pileser</char><char style="ft" closed="false">; also in verse 26</char></note> king of Assyria removed; He <char style="add">was</char> leader of the Reubenite. <verse eid="1CH 5:6"/></para>

<para style="q1"><verse number="7" style="v" sid="1CH 5:7"/>And his brothers by their clans reckoned to their generations: The chief Jeiel, and Zechariah, <verse eid="1CH 5:7"/></para>

<para style="q2"><verse number="8" style="v" sid="1CH 5:8"/>and Bela son of Azaz, son of Shema, son of Joel. He dwelt in Aroer and as far as Nebo and Baal-meon. <verse eid="1CH 5:8"/></para>

<para style="q2"><verse number="9" style="v" sid="1CH 5:9"/>And they settled in the east as far as the entering in of the wilderness, even from the River Euphrates, because their livestock had multiplied in the land of Gilead. <verse eid="1CH 5:9"/></para>

<para style="q2"><verse number="10" style="v" sid="1CH 5:10"/>And in the days of Saul they made war with the Hagrites, and they fell by their hands, and they dwelt in their tents over all the face of the east of Gilead. <verse eid="1CH 5:10"/></para>

<para style="s">The Descendants of Gad</para>

<para style="p"><verse number="11" style="v" sid="1CH 5:11"/>And the sons of Gad dwelt next to them in the land of Bashan as far as Salcah. <verse eid="1CH 5:11"/></para>

<para style="q1"><verse number="12" style="v" sid="1CH 5:12"/>Joel <char style="add">was</char> the chief, and Shapham the next, and Jaanai, and Shaphat in Bashan. <verse eid="1CH 5:12"/></para>

<para style="q1"><verse number="13" style="v" sid="1CH 5:13"/>And their brothers of the house of their fathers <char style="add">were</char> Michael, and Meshullam, and Sheba, and Jorai, and Jachan, and Zia, and Eber—seven. <verse eid="1CH 5:13"/></para>

<para style="q1"><verse number="14" style="v" sid="1CH 5:14"/>These <char style="add">were</char> the sons of Abihail son of Huri, son of Jaroah, son of Gilead, son of Michael, son of Jeshishai, son of Jahdo, son of Buz. <verse eid="1CH 5:14"/></para>

<para style="q1"><verse number="15" style="v" sid="1CH 5:15"/>Ahi son of Abdiel, son of Guni, <char style="add">was</char> chief of the house of their fathers. <verse eid="1CH 5:15"/></para>

<para style="q1"><verse number="16" style="v" sid="1CH 5:16"/>And they dwelt in Gilead, in Bashan, and in its villages, and in all the pasturelands of Sharon on their outskirts. <verse eid="1CH 5:16"/></para>

<para style="q1"><verse number="17" style="v" sid="1CH 5:17"/>All of them were reckoned in the days of Jotham king of Judah and in the days of Jeroboam king of Israel. <verse eid="1CH 5:17"/></para>

<para style="q1"><verse number="18" style="v" sid="1CH 5:18"/>The sons of Reuben, and the Gadite, and the half-tribe of Manasseh, of sons of valor, men bearing shield and sword, and drawing with the bow, and skillful in war—forty-four thousand and seven hundred and sixty going out to the host. <verse eid="1CH 5:18"/></para>

<para style="q1"><verse number="19" style="v" sid="1CH 5:19"/>And they made war with the Hagrites, and Jetur, and Naphish, and Nodab. <verse eid="1CH 5:19"/></para>

<para style="q1"><verse number="20" style="v" sid="1CH 5:20"/>And they were helped against them, and the Hagrites were delivered into their hands, and all who <char style="add">were</char> with them, for they cried out to God in the battle, and He heeded the prayer of them because they put their trust in Him. <verse eid="1CH 5:20"/></para>

<para style="q1"><verse number="21" style="v" sid="1CH 5:21"/>And they took captive their livestock, of their camels fifty thousand, and of their sheep two hundred and fifty thousand, and of their donkeys two thousand, and also of their men a hundred thousand. <verse eid="1CH 5:21"/></para>

<para style="q1"><verse number="22" style="v" sid="1CH 5:22"/>For many fell slain, because the battle <char style="add">was</char> of God. And they dwelt in their place until the exile. <verse eid="1CH 5:22"/></para>

<para style="s">The Half-Tribe of Manasseh</para>

<para style="p"><verse number="23" style="v" sid="1CH 5:23"/>And the sons of the half-tribe of Manasseh dwelt in the land. From Bashan as far as Baal-hermon and Senir and Mount Hermon<note caller="+" style="f"><char style="fr" closed="false">5.23 </char><char style="ft" closed="false"> That is </char><char style="fq" closed="false">from Bashan as far as Baal-hermon (that is Senir, also known as Mount Hermon)</char></note> they multiplied. <verse eid="1CH 5:23"/></para>

<para style="p"><verse number="24" style="v" sid="1CH 5:24"/>And these <char style="add">were</char> the heads of the house of their fathers: </para>

<para style="q1" vid="1CH 5:24">Epher, and Ishi, and Eliel, and Azriel, and Jeremiah, and Hodaviah, and Jahdiel. <char style="add">They were</char> men mighty in valor, men of renown, <char style="add">and</char> heads to the house of their fathers. <verse eid="1CH 5:24"/></para>

<para style="q1"><verse number="25" style="v" sid="1CH 5:25"/>And they were unfaithful to the God of their fathers and played the prostitute after the gods of the peoples of the land, whom God had destroyed before them. <verse eid="1CH 5:25"/></para>

<para style="q1"><verse number="26" style="v" sid="1CH 5:26"/>And the God of Israel stirred up the spirit of Pul king of Assyria (that is, the spirit of Tiglath-pilneser king of Assyria), and he removed them—the Reubenite, and the Gadite, and the half-tribe of Manasseh—and He took them to Halah, and Habor, and Hara, and the river of Gozan, to this day. <verse eid="1CH 5:26"/></para>

<chapter eid="1CH 5"/>

<chapter number="6" style="c" sid="1CH 6"/>

<para style="s">The Descendants of Levi</para>

<para style="p"><verse number="1" style="v" sid="1CH 6:1"/>The sons of Levi: </para>

<para style="q1" vid="1CH 6:1">Gershon, Kohath, and Merari. <verse eid="1CH 6:1"/></para>

<para style="q1"><verse number="2" style="v" sid="1CH 6:2"/>And the sons of Kohath: </para>

<para style="q2" vid="1CH 6:2">Amram, Izhar, and Hebron, and Uzziel. <verse eid="1CH 6:2"/></para>

<para style="q1"><verse number="3" style="v" sid="1CH 6:3"/>And the sons of Amram: </para>

<para style="q2" vid="1CH 6:3">Aaron, and Moses, and Miriam. </para>

<para style="q1" vid="1CH 6:3">And the sons of Aaron: </para>

<para style="q2" vid="1CH 6:3">Nadab, and Abihu, Eleazar, and Ithamar. <verse eid="1CH 6:3"/></para>

<para style="q2"><verse number="4" style="v" sid="1CH 6:4"/>Eleazar begat Phinehas, </para>

<para style="q2" vid="1CH 6:4">Phinehas begat Abishua, <verse eid="1CH 6:4"/></para>

<para style="q2"><verse number="5" style="v" sid="1CH 6:5"/>and Abishua begat Bukki, </para>

<para style="q2" vid="1CH 6:5">and Bukki begat Uzzi, <verse eid="1CH 6:5"/></para>

<para style="q2"><verse number="6" style="v" sid="1CH 6:6"/>and Uzzi begat Zerahiah, </para>

<para style="q2" vid="1CH 6:6">and Zerahiah begat Meraioth, <verse eid="1CH 6:6"/></para>

<para style="q2"><verse number="7" style="v" sid="1CH 6:7"/>Meraioth begat Amariah, </para>

<para style="q2" vid="1CH 6:7">and Amariah begat Ahitub, <verse eid="1CH 6:7"/></para>

<para style="q2"><verse number="8" style="v" sid="1CH 6:8"/>and Ahitub begat Zadok, </para>

<para style="q2" vid="1CH 6:8">and Zadok begat Ahimaaz, <verse eid="1CH 6:8"/></para>

<para style="q2"><verse number="9" style="v" sid="1CH 6:9"/>and Ahimaaz begat Azariah, </para>

<para style="q2" vid="1CH 6:9">and Azariah begat Johanan, <verse eid="1CH 6:9"/></para>

<para style="q2"><verse number="10" style="v" sid="1CH 6:10"/>and Johanan begat Azariah, he who ministered as priest in the temple that Solomon built in Jerusalem. <verse eid="1CH 6:10"/></para>

<para style="q2"><verse number="11" style="v" sid="1CH 6:11"/>And Azariah begat Amariah, </para>

<para style="q2" vid="1CH 6:11">and Amariah begat Ahitub, <verse eid="1CH 6:11"/></para>

<para style="q2"><verse number="12" style="v" sid="1CH 6:12"/>and Ahitub begat Zadok, </para>

<para style="q2" vid="1CH 6:12">and Zadok begat Shallum, <verse eid="1CH 6:12"/></para>

<para style="q2"><verse number="13" style="v" sid="1CH 6:13"/>and Shallum begat Hilkiah, </para>

<para style="q2" vid="1CH 6:13">and Hilkiah begat Azariah, <verse eid="1CH 6:13"/></para>

<para style="q2"><verse number="14" style="v" sid="1CH 6:14"/>and Azariah begat Seraiah, </para>

<para style="q2" vid="1CH 6:14">and Seraiah begat Jehozadak. <note caller="+" style="f"><char style="fr" closed="false">6.14 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Jehozadak</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Jozadak</char><char style="ft" closed="false">; also in verse 15; see Ezra 3:2.</char></note><verse eid="1CH 6:14"/></para>

<para style="q1"><verse number="15" style="v" sid="1CH 6:15"/>And Jehozadak went in the removing <char style="add">by</char> YHWH of Judah and Jerusalem by the hand of Nebuchadnezzar. <verse eid="1CH 6:15"/></para>

<para style="p"><verse number="16" style="v" sid="1CH 6:16"/>The sons of Levi: </para>

<para style="q1" vid="1CH 6:16">Gershom,<note caller="+" style="f"><char style="fr" closed="false">6.16 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Gershom</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Gershon</char><char style="ft" closed="false">; similarly in verses 17, 20, 43, 62, and 71; see verse 1.</char></note> Kohath, and Merari. <verse eid="1CH 6:16"/></para>

<para style="q1"><verse number="17" style="v" sid="1CH 6:17"/>And these <char style="add">are</char> the names of the sons of Gershom: </para>

<para style="q2" vid="1CH 6:17">Libni and Shimei. <verse eid="1CH 6:17"/></para>

<para style="q1"><verse number="18" style="v" sid="1CH 6:18"/>And the sons of Kohath: </para>

<para style="q2" vid="1CH 6:18">Amram, and Izhar, and Hebron, and Uzziel. <verse eid="1CH 6:18"/></para>

<para style="q1"><verse number="19" style="v" sid="1CH 6:19"/>The sons of Merari: </para>

<para style="q2" vid="1CH 6:19">Mahli and Mushi. </para>

<para style="p" vid="1CH 6:19">And these <char style="add">are</char> the clans of the Levites according to their fathers: <verse eid="1CH 6:19"/></para>

<para style="q1"><verse number="20" style="v" sid="1CH 6:20"/>Of Gershom: Libni his son, Jahath his son, Zimmah his son, <verse eid="1CH 6:20"/></para>

<para style="q2"><verse number="21" style="v" sid="1CH 6:21"/>Joah his son, Iddo his son, Zerah his son, Jeatherai his son. <verse eid="1CH 6:21"/></para>

<para style="q1"><verse number="22" style="v" sid="1CH 6:22"/>The sons of Kohath: Amminadab his son, Korah his son, Assir his son, <verse eid="1CH 6:22"/></para>

<para style="q2"><verse number="23" style="v" sid="1CH 6:23"/>Elkanah his son, and Ebiasaph his son, and Assir his son, <note caller="+" style="f"><char style="fr" closed="false">6.23 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Ebiasaph</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Abiasaph</char><char style="ft" closed="false">; also in verse 37; see Exodus 6:24.</char></note><verse eid="1CH 6:23"/></para>

<para style="q2"><verse number="24" style="v" sid="1CH 6:24"/>Tahath his son, Uriel his son, Uzziah his son, and Shaul his son. <verse eid="1CH 6:24"/></para>

<para style="q1"><verse number="25" style="v" sid="1CH 6:25"/>And the sons of Elkanah: Amasai and Ahimoth. <verse eid="1CH 6:25"/></para>

<para style="q2"><verse number="26" style="v" sid="1CH 6:26"/>Elkanah his son, Zophai his son, and Nahath his son, <note caller="+" style="f"><char style="fr" closed="false">6.26 </char><char style="ft" closed="false"> Some Hebrew manuscripts, LXX, and Syriac; most Hebrew manuscripts </char><char style="fq" closed="false">Elkanah. The sons of Elkanah:</char></note><verse eid="1CH 6:26"/></para>

<para style="q2"><verse number="27" style="v" sid="1CH 6:27"/>Eliab his son, Jeroham his son, Elkanah his son.<note caller="+" style="f"><char style="fr" closed="false">6.27 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Eliab</char><char style="ft" closed="false"> is also called </char><char style="fq" closed="false">Eliel</char><char style="ft" closed="false">; see verse 34. Both of these are other names for Elihu; see 1 Samuel 1:1.</char></note> <note caller="+" style="f"><char style="fr" closed="false">6.27 </char><char style="ft" closed="false"> Hebrew; some LXX manuscripts include </char><char style="fq" closed="false">and Samuel his son</char><char style="ft" closed="false">; see verses 33–34 and 1 Samuel 1:19–20.</char></note><verse eid="1CH 6:27"/></para>

<para style="q1"><verse number="28" style="v" sid="1CH 6:28"/>And the sons of Samuel: </para>

<para style="q2" vid="1CH 6:28"><char style="add">Joel</char> his firstborn, and his second son Abijah.<note caller="+" style="f"><char style="fr" closed="false">6.28 </char><char style="ft" closed="false"> See Syriac and some LXX manuscripts (also verse 33 and 1 Samuel 8:2); Hebrew </char><char style="fq" closed="false">The sons of Samuel: the firstborn Vashni, and Abiah</char><char style="ft" closed="false">.</char></note> <verse eid="1CH 6:28"/></para>

<para style="q1"><verse number="29" style="v" sid="1CH 6:29"/>The sons of Merari: Mahli, Libni his son, Shimei his son, Uzzah his son, <verse eid="1CH 6:29"/></para>

<para style="q2"><verse number="30" style="v" sid="1CH 6:30"/>Shimea his son, Haggiah his son, Asaiah his son. <verse eid="1CH 6:30"/></para>

<para style="s">The Temple Musicians</para>

<para style="p"><verse number="31" style="v" sid="1CH 6:31"/>And these <char style="add">are</char> they whom David stationed over the service of song in the house of YHWH, from the resting of the ark. <verse eid="1CH 6:31"/></para>

<para style="p"><verse number="32" style="v" sid="1CH 6:32"/>And they were ministering before the face of the dwelling place of the Tent of Meeting with song, until Solomon had built the house of YHWH in Jerusalem. And they stood according to their judgments over their service. <verse eid="1CH 6:32"/></para>

<para style="p"><verse number="33" style="v" sid="1CH 6:33"/>And these <char style="add">are</char> those standing and their sons. </para>

<para style="q1" vid="1CH 6:33">Of the sons of the Kohathite: Heman the singer, son of Joel, son of Samuel, <verse eid="1CH 6:33"/></para>

<para style="q2"><verse number="34" style="v" sid="1CH 6:34"/>son of Elkanah, son of Jeroham, son of Eliel,<note caller="+" style="f"><char style="fr" closed="false">6.34 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Eliel</char><char style="ft" closed="false"> is also called </char><char style="fq" closed="false">Eliab</char><char style="ft" closed="false">; see verse 27. Both of these are other names for Elihu; see 1 Samuel 1:1.</char></note> son of Toah, <verse eid="1CH 6:34"/></para>

<para style="q2"><verse number="35" style="v" sid="1CH 6:35"/>son of Zuph, son of Elkanah, son of Mahath, son of Amasai, <verse eid="1CH 6:35"/></para>

<para style="q2"><verse number="36" style="v" sid="1CH 6:36"/>son of Elkanah, son of Joel, son of Azariah, son of Zephaniah, <verse eid="1CH 6:36"/></para>

<para style="q2"><verse number="37" style="v" sid="1CH 6:37"/>son of Tahath, son of Assir, son of Ebiasaph, son of Korah, <verse eid="1CH 6:37"/></para>

<para style="q2"><verse number="38" style="v" sid="1CH 6:38"/>son of Izhar, son of Kohath, son of Levi, son of Israel. <verse eid="1CH 6:38"/></para>

<para style="q1"><verse number="39" style="v" sid="1CH 6:39"/>And his brother Asaph, who stood at his right hand: Asaph son of Berechiah, son of Shimea, <verse eid="1CH 6:39"/></para>

<para style="q2"><verse number="40" style="v" sid="1CH 6:40"/>son of Michael, son of Baaseiah,<note caller="+" style="f"><char style="fr" closed="false">6.40 </char><char style="ft" closed="false"> Most Hebrew manuscripts; some Hebrew manuscripts, one LXX manuscript, and Syriac </char><char style="fq" closed="false">Maaseiah</char></note> son of Malchijah, <verse eid="1CH 6:40"/></para>

<para style="q2"><verse number="41" style="v" sid="1CH 6:41"/>son of Ethni, son of Zerah, son of Adaiah, <verse eid="1CH 6:41"/></para>

<para style="q2"><verse number="42" style="v" sid="1CH 6:42"/>son of Ethan, son of Zimmah, son of Shimei, <verse eid="1CH 6:42"/></para>

<para style="q2"><verse number="43" style="v" sid="1CH 6:43"/>son of Jahath, son of Gershom, son of Levi. <verse eid="1CH 6:43"/></para>

<para style="q1"><verse number="44" style="v" sid="1CH 6:44"/>The sons of Merari and their brothers on the left hand: Ethan son of Kishi, son of Abdi, son of Malluch, <verse eid="1CH 6:44"/></para>

<para style="q2"><verse number="45" style="v" sid="1CH 6:45"/>son of Hashabiah, son of Amaziah, son of Hilkiah, <verse eid="1CH 6:45"/></para>

<para style="q2"><verse number="46" style="v" sid="1CH 6:46"/>son of Amzi, son of Bani, son of Shemer, <verse eid="1CH 6:46"/></para>

<para style="q2"><verse number="47" style="v" sid="1CH 6:47"/>son of Mahli, son of Mushi, son of Merari, son of Levi. <verse eid="1CH 6:47"/></para>

<para style="s">The Descendants of Aaron</para>

<para style="p"><verse number="48" style="v" sid="1CH 6:48"/>And their brothers the Levites were appointed to all the service of the tabernacle of the house of God. <verse eid="1CH 6:48"/></para>

<para style="p"><verse number="49" style="v" sid="1CH 6:49"/>And Aaron and his sons offered sacrifices on the altar of the burnt offering and on the altar of incense for all the work of the holy of Holies,<note caller="+" style="f"><char style="fr" closed="false">6.49 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the Most Holy Place</char></note> and to make atonement upon Israel according to all that Moses the servant of God had commanded. <verse eid="1CH 6:49"/></para>

<para style="q1"><verse number="50" style="v" sid="1CH 6:50"/>And these <char style="add">are</char> the sons of Aaron: Eleazar his son, Phinehas his son, Abishua his son, <verse eid="1CH 6:50"/></para>

<para style="q2"><verse number="51" style="v" sid="1CH 6:51"/>Bukki his son, Uzzi his son, Zerahiah his son, <verse eid="1CH 6:51"/></para>

<para style="q2"><verse number="52" style="v" sid="1CH 6:52"/>Meraioth his son, Amariah his son, Ahitub his son, <verse eid="1CH 6:52"/></para>

<para style="q2"><verse number="53" style="v" sid="1CH 6:53"/>Zadok his son, Ahimaaz his son. <verse eid="1CH 6:53"/></para>

<para style="s">Territories for the LevitesNumbers 35:1–8</para>

<para style="p"><verse number="54" style="v" sid="1CH 6:54"/><note caller="-" style="x"><char style="xt" closed="false">Joshua 21:1–45</char></note>And these <char style="add">were</char> their dwelling places throughout their settlements in their territory to the sons of Aaron of the family of the Kohathites, for they were by the lot: <verse eid="1CH 6:54"/></para>

<para style="q1"><verse number="55" style="v" sid="1CH 6:55"/>And they gave to them Hebron in the land of Judah, and its surrounding pasturelands. <verse eid="1CH 6:55"/></para>

<para style="q1"><verse number="56" style="v" sid="1CH 6:56"/>And the fields of the city and its villages they gave to Caleb son of Jephunneh. <verse eid="1CH 6:56"/></para>

<para style="q1"><verse number="57" style="v" sid="1CH 6:57"/>And to the sons of Aaron they gave the cities of refuge, Hebron,<note caller="+" style="f"><char style="fr" closed="false">6.57 </char><char style="ft" closed="false"> See the parallel text at Joshua 21:13: </char><char style="fq" closed="false">a city of refuge, Hebron</char></note> and also Libnah and its pasturelands, and Jattir, and Eshtemoa and its pasturelands, <verse eid="1CH 6:57"/></para>

<para style="q1"><verse number="58" style="v" sid="1CH 6:58"/>and Hilen<note caller="+" style="f"><char style="fr" closed="false">6.58 </char><char style="ft" closed="false"> Some Hebrew manuscripts; MT </char><char style="fq" closed="false">Hilez</char><char style="ft" closed="false">; parallel text at Joshua 21:15 </char><char style="fq" closed="false">Holon</char></note> and its pasturelands, Debir and its pasturelands, <verse eid="1CH 6:58"/></para>

<para style="q1"><verse number="59" style="v" sid="1CH 6:59"/>and Ashan,<note caller="+" style="f"><char style="fr" closed="false">6.59 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Ashan</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Ain</char><char style="ft" closed="false">; see Joshua 21:16.</char></note> and Juttah,<note caller="+" style="f"><char style="fr" closed="false">6.59 </char><char style="ft" closed="false"> Syriac and the parallel text at Joshua 21:16; MT </char><char style="fq" closed="false">Ashan and its pasturelands</char></note> and Beth-shemesh and its pasturelands. <verse eid="1CH 6:59"/></para>

<para style="q1"><verse number="60" style="v" sid="1CH 6:60"/>And from the tribe of Benjamin: Gibeon,<note caller="+" style="f"><char style="fr" closed="false">6.60 </char><char style="ft" closed="false"> LXX, Syriac and parallel text at Joshua 21:17; MT does not include </char><char style="fq" closed="false">Gibeon,</char></note> Geba and its pasturelands, and Alemeth and its pasturelands, and Anathoth and its pasturelands—all their cities <char style="add">were</char> thirteen cities among their families. <verse eid="1CH 6:60"/></para>

<para style="q1"><verse number="61" style="v" sid="1CH 6:61"/>And to the Kohathite, the rest of the family of the tribe, from the half-tribe, the half of Manasseh, <char style="add">they gave</char> by lot ten cities. <verse eid="1CH 6:61"/></para>

<para style="p"><verse number="62" style="v" sid="1CH 6:62"/>And to the sons of Gershom<note caller="+" style="f"><char style="fr" closed="false">6.62 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Gershom</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Gershon</char><char style="ft" closed="false">; also in verse 71; see 1 Chronicles 23:7.</char></note> according to their clans, from the tribe of Issachar, and from the tribe of Asher, and from the tribe of Naphtali, and from the tribe of Manasseh in Bashan, <char style="add">they gave</char> thirteen cities. <verse eid="1CH 6:62"/></para>

<para style="p"><verse number="63" style="v" sid="1CH 6:63"/>To the sons of Merari throughout their clans, from the tribe of Reuben, from the tribe of Gad, and from the tribe of Zebulun, there were allotted twelve cities. <verse eid="1CH 6:63"/></para>

<para style="p"><verse number="64" style="v" sid="1CH 6:64"/>And the sons of Israel gave to the Levites the cities and their pasturelands. <verse eid="1CH 6:64"/></para>

<para style="p"><verse number="65" style="v" sid="1CH 6:65"/>And they gave by lot from the tribe of the sons of Judah, and from the tribe of the sons of Simeon, and from the tribe of the sons of Benjamin, these cities that are called by the names. <verse eid="1CH 6:65"/></para>

<para style="p"><verse number="66" style="v" sid="1CH 6:66"/>And some of the clans of the sons of Kohath were cities as their territory from the tribe of Ephraim. <verse eid="1CH 6:66"/></para>

<para style="q1"><verse number="67" style="v" sid="1CH 6:67"/>And they gave to them the cities of refuge, Shechem,<note caller="+" style="f"><char style="fr" closed="false">6.67 </char><char style="ft" closed="false"> See the parallel text at Joshua 21:21: </char><char style="fq" closed="false">a city of refuge, Shechem</char></note> and its pasturelands, in the hill country of Ephraim, and also Gezer and its pasturelands, <verse eid="1CH 6:67"/></para>

<para style="q1"><verse number="68" style="v" sid="1CH 6:68"/>and Jokmeam and its pasturelands, and Beth-horon and its pasturelands, <verse eid="1CH 6:68"/></para>

<para style="q1"><verse number="69" style="v" sid="1CH 6:69"/>and Aijalon and its pasturelands, and Gath-rimmon and its pasturelands. <verse eid="1CH 6:69"/></para>

<para style="q1"><verse number="70" style="v" sid="1CH 6:70"/>And from the half-tribe of Manasseh, Aner and its pasturelands, and Bileam and its pasturelands, for the clan of the sons of Kohath remaining. <verse eid="1CH 6:70"/></para>

<para style="p"><verse number="71" style="v" sid="1CH 6:71"/>The sons of Gershom: </para>

<para style="q1" vid="1CH 6:71">From the clan of the half-tribe of Manasseh, Golan in Bashan and its pasturelands, and Ashtaroth and its pasturelands. <verse eid="1CH 6:71"/></para>

<para style="q1"><verse number="72" style="v" sid="1CH 6:72"/>And from the tribe of Issachar, Kedesh and its pasturelands, Daberath and its pasturelands, <verse eid="1CH 6:72"/></para>

<para style="q1"><verse number="73" style="v" sid="1CH 6:73"/>and Ramoth and its pasturelands, and Anem and its pasturelands. <verse eid="1CH 6:73"/></para>

<para style="q1"><verse number="74" style="v" sid="1CH 6:74"/>And from the tribe of Asher, Mashal and its pasturelands, and Abdon and its pasturelands, <verse eid="1CH 6:74"/></para>

<para style="q1"><verse number="75" style="v" sid="1CH 6:75"/>and Hukok and its pasturelands, and Rehob and its pasturelands. <verse eid="1CH 6:75"/></para>

<para style="q1"><verse number="76" style="v" sid="1CH 6:76"/>And from the tribe of Naphtali, Kedesh in Galilee and its pasturelands, and Hammon and its pasturelands, and Kiriathaim and its pasturelands. <verse eid="1CH 6:76"/></para>

<para style="p"><verse number="77" style="v" sid="1CH 6:77"/>The sons of Merari (the remaining): </para>

<para style="q1" vid="1CH 6:77">From the tribe of Zebulun, Rimmono and its pasturelands, <char style="add">and</char> Tabor<note caller="+" style="f"><char style="fr" closed="false">6.77 </char><char style="ft" closed="false"> LXX </char><char style="fq" closed="false">(they were given) Jokneam, Kartah, Rimmono, and Tabor</char><char style="ft" closed="false">; see Joshua 21:34.</char></note> and its pasturelands. <verse eid="1CH 6:77"/></para>

<para style="q1"><verse number="78" style="v" sid="1CH 6:78"/>And from beyond the Jordan by Jericho, at the east of the Jordan, from the tribe of Reuben, Bezer in the wilderness and its pasturelands, and Jahzah and its pasturelands, <note caller="+" style="f"><char style="fr" closed="false">6.78 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Jahzah</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Jahaz</char><char style="ft" closed="false">; see Numbers 21:23.</char></note><verse eid="1CH 6:78"/></para>

<para style="q1"><verse number="79" style="v" sid="1CH 6:79"/>and Kedemoth and its pasturelands, and Mephaath and its pasturelands. <verse eid="1CH 6:79"/></para>

<para style="q1"><verse number="80" style="v" sid="1CH 6:80"/>And from the tribe of Gad, Ramoth in Gilead and its pasturelands, and Mahanaim and its pasturelands, <verse eid="1CH 6:80"/></para>

<para style="q1"><verse number="81" style="v" sid="1CH 6:81"/>and Heshbon and its pasturelands, and Jazer and its pasturelands. <verse eid="1CH 6:81"/></para>

<chapter eid="1CH 6"/>

<chapter number="7" style="c" sid="1CH 7"/>

<para style="s">The Descendants of Issachar</para>

<para style="p"><verse number="1" style="v" sid="1CH 7:1"/>And the sons of Issachar: </para>

<para style="q1" vid="1CH 7:1">Tola, and Puah,<note caller="+" style="f"><char style="fr" closed="false">7.1 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Puah</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Puvah</char><char style="ft" closed="false">; see Genesis 46:13 and Numbers 26:23.</char></note> Jashub, and Shimron—four. <verse eid="1CH 7:1"/></para>

<para style="q1"><verse number="2" style="v" sid="1CH 7:2"/>And the sons of Tola: </para>

<para style="q2" vid="1CH 7:2">Uzzi, and Rephaiah, and Jeriel, and Jahmai, and Jibsam, and Shemuel, the heads of the house of their fathers, of Tola, mighty men of valor in their generations. In the days of David their number <char style="add">was</char> twenty-two thousand and six hundred. <verse eid="1CH 7:2"/></para>

<para style="q1"><verse number="3" style="v" sid="1CH 7:3"/>And the sons<note caller="+" style="f"><char style="fr" closed="false">7.3 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">son</char><char style="ft" closed="false">; also in verses 10 and 17</char></note> of Uzzi: </para>

<para style="q2" vid="1CH 7:3">Izrahiah. </para>

<para style="q1" vid="1CH 7:3">And the sons of Izrahiah: Michael, and Obadiah, and Joel, and Isshiah—five chiefs, all of them. <verse eid="1CH 7:3"/></para>

<para style="q2"><verse number="4" style="v" sid="1CH 7:4"/>And with them by their generations according to the houses of their fathers <char style="add">were</char> troops of the host of battle, thirty-six thousand. For they had many wives and sons. <verse eid="1CH 7:4"/></para>

<para style="q1"><verse number="5" style="v" sid="1CH 7:5"/>And their brothers among all the clans of Issachar <char style="add">were</char> mighty men, eighty-seven thousand in all reckoned. <verse eid="1CH 7:5"/></para>

<para style="s">The Descendants of Benjamin</para>

<para style="p"><verse number="6" style="v" sid="1CH 7:6"/>Of Benjamin: Bela, </para>

<para style="q1" vid="1CH 7:6">and Becher, and Jediael—three. <verse eid="1CH 7:6"/></para>

<para style="q1"><verse number="7" style="v" sid="1CH 7:7"/>And the sons of Bela: </para>

<para style="q2" vid="1CH 7:7">Ezbon, and Uzzi, and Uzziel, and Jerimoth, and Iri—five heads of a house of fathers, mighty of valor, and reckoned twenty-two thousand and thirty-four. <verse eid="1CH 7:7"/></para>

<para style="q1"><verse number="8" style="v" sid="1CH 7:8"/>And the sons of Becher: Zemirah, and Joash, and Eliezer, and Elioenai, and Omri, and Jerimoth, and Abijah, and Anathoth, and Alemeth. All these <char style="add">were</char> sons of Becher. <verse eid="1CH 7:8"/></para>

<para style="q2"><verse number="9" style="v" sid="1CH 7:9"/>And they were reckoned according to their generations, heads of a house of their fathers, mighty men of valor, twenty thousand and two hundred. <verse eid="1CH 7:9"/></para>

<para style="q1"><verse number="10" style="v" sid="1CH 7:10"/>And the sons of Jediael: </para>

<para style="q2" vid="1CH 7:10">Bilhan. </para>

<para style="q1" vid="1CH 7:10">And the sons of Bilhan: Jeush, and Benjamin, and Ehud, and Chenaanah, and Zethan, and Tarshish, and Ahishahar. <verse eid="1CH 7:10"/></para>

<para style="q2"><verse number="11" style="v" sid="1CH 7:11"/>All these the sons of Jediael, by the heads of the fathers, mighty men of valor, <char style="add">were</char> seventeen thousand and two hundred going out to the host for battle. <verse eid="1CH 7:11"/></para>

<para style="q2"><verse number="12" style="v" sid="1CH 7:12"/>And Shuppim and Huppim <char style="add">were</char> sons of Ir, <char style="add">and</char> Hushim <char style="add">was</char> son of Aher. <verse eid="1CH 7:12"/></para>

<para style="s">The Descendants of Naphtali</para>

<para style="p"><verse number="13" style="v" sid="1CH 7:13"/>The sons of Naphtali: </para>

<para style="q1" vid="1CH 7:13">Jahziel,<note caller="+" style="f"><char style="fr" closed="false">7.13 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Jahziel</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Jahzeel</char><char style="ft" closed="false">; see Genesis 46:24.</char></note> and Guni, and Jezer, and Shallum,<note caller="+" style="f"><char style="fr" closed="false">7.13 </char><char style="ft" closed="false"> Most Hebrew manuscripts; some Hebrew and LXX manuscripts </char><char style="fq" closed="false">Shillem</char><char style="ft" closed="false">; see Genesis 46:24 and Numbers 26:49.</char></note> the sons of Bilhah. <verse eid="1CH 7:13"/></para>

<para style="s">The Descendants of Manasseh</para>

<para style="p"><verse number="14" style="v" sid="1CH 7:14"/>The sons of Manasseh: </para>

<para style="q1" vid="1CH 7:14">Asriel, whom his Aramean concubine bore. She bore Machir the father of Gilead. <verse eid="1CH 7:14"/></para>

<para style="q1"><verse number="15" style="v" sid="1CH 7:15"/>And Machir took a wife of Huppim and of Shuppim, and the name of his sister <char style="add">was</char> Maacah. </para>

<para style="q1" vid="1CH 7:15">And the name of the second <char style="add">was</char> Zelophehad, and Zelophehad begat <char style="add">only</char> daughters. <verse eid="1CH 7:15"/></para>

<para style="q1"><verse number="16" style="v" sid="1CH 7:16"/>And Maacah the wife of Machir bore a son, and she called his name Peresh. And the name of his brother <char style="add">was</char> Sheresh, and his sons <char style="add">were</char> Ulam and Rekem. <verse eid="1CH 7:16"/></para>

<para style="q1"><verse number="17" style="v" sid="1CH 7:17"/>And the sons of Ulam: </para>

<para style="q2" vid="1CH 7:17">Bedan. These <char style="add">were</char> the sons of Gilead, son of Machir, son of Manasseh. <verse eid="1CH 7:17"/></para>

<para style="q1"><verse number="18" style="v" sid="1CH 7:18"/>And His sister Hammoleketh bore Ishhod, and Abiezer, and Mahlah. <verse eid="1CH 7:18"/></para>

<para style="q1"><verse number="19" style="v" sid="1CH 7:19"/>And the sons of Shemida were: </para>

<para style="q2" vid="1CH 7:19">Ahian, and Shechem, and Likhi, and Aniam. <verse eid="1CH 7:19"/></para>

<para style="s">The Descendants of Ephraim</para>

<para style="p"><verse number="20" style="v" sid="1CH 7:20"/>And the sons of Ephraim: Shuthelah, and Bered his son, and Tahath his son, and Eladah his son, and Tahath his son, <verse eid="1CH 7:20"/></para>

<para style="q1"><verse number="21" style="v" sid="1CH 7:21"/>and Zabad his son, and Shuthelah his son. </para>

<para style="q1" vid="1CH 7:21">And Ezer and Elead were killed <char style="add">by</char> the men of Gath who were born in the land, because they came down to take away their livestock. <verse eid="1CH 7:21"/></para>

<para style="q1"><verse number="22" style="v" sid="1CH 7:22"/>And Ephraim their father mourned many days, and his brothers came to comfort him. <verse eid="1CH 7:22"/></para>

<para style="q1"><verse number="23" style="v" sid="1CH 7:23"/>And he went in to his wife, and she conceived and bore a son, and he called his name Beriah, because disaster had come upon his house. <note caller="+" style="f"><char style="fr" closed="false">7.23 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Beriah</char><char style="ft" closed="false"> sounds like the Hebrew for </char><char style="fq" closed="false">tragedy</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">disaster</char><char style="ft" closed="false">.</char></note><verse eid="1CH 7:23"/></para>

<para style="q1"><verse number="24" style="v" sid="1CH 7:24"/>And his daughter <char style="add">was</char> Sheerah, and she built Beth-horon Lower and Upper, and Uzzen-sheerah. <verse eid="1CH 7:24"/></para>

<para style="q1"><verse number="25" style="v" sid="1CH 7:25"/>And Rephah <char style="add">was</char> his son, and Resheph <char style="add">his son</char>,<note caller="+" style="f"><char style="fr" closed="false">7.25 </char><char style="ft" closed="false"> Some LXX manuscripts; Hebrew does not include </char><char style="fq" closed="false">his son</char><char style="ft" closed="false">.</char></note> and Telah his son, and Tahan his son, <verse eid="1CH 7:25"/></para>

<para style="q1"><verse number="26" style="v" sid="1CH 7:26"/>Laadan his son, Ammihud his son, Elishama his son, <verse eid="1CH 7:26"/></para>

<para style="q1"><verse number="27" style="v" sid="1CH 7:27"/>Nun<note caller="+" style="f"><char style="fr" closed="false">7.27 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">Non</char></note> his son, Joshua his son. <verse eid="1CH 7:27"/></para>

<para style="q1"><verse number="28" style="v" sid="1CH 7:28"/>And their possessions and dwelling places <char style="add">were</char> Bethel and its daughters, and to the east Naaran, and to the west Gezer and its daughters, and Shechem and its daughters, as far as Ayyah<note caller="+" style="f"><char style="fr" closed="false">7.28 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Ayyah</char><char style="ft" closed="false"> is another name for Gaza; see also LXX.</char></note> and its daughters. <verse eid="1CH 7:28"/></para>

<para style="q1"><verse number="29" style="v" sid="1CH 7:29"/>And along the borders of the sons of Manasseh <char style="add">were</char> Beth-shean<note caller="+" style="f"><char style="fr" closed="false">7.29 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Beth-shean</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Beth-shan</char><char style="ft" closed="false">; see 1 Samuel 31:10 and 2 Samuel 21:12.</char></note> and its daughters, Taanach and its daughters, Megiddo and its daughters, Dor and its daughters. In these dwelt the sons of Joseph son of Israel. <verse eid="1CH 7:29"/></para>

<para style="s">The Descendants of Asher</para>

<para style="p"><verse number="30" style="v" sid="1CH 7:30"/>The sons of Asher: </para>

<para style="q1" vid="1CH 7:30">Imnah, and Ishvah, and Ishvi, and Beriah, and Serah their sister. <verse eid="1CH 7:30"/></para>

<para style="q1"><verse number="31" style="v" sid="1CH 7:31"/>And the sons of Beriah: </para>

<para style="q2" vid="1CH 7:31">Heber and Malchiel; he <char style="add">was</char> the father of Birzaith. <verse eid="1CH 7:31"/></para>

<para style="q1"><verse number="32" style="v" sid="1CH 7:32"/>And Heber begat Japhlet, and Shomer, and Hotham, and Shua their sister. <verse eid="1CH 7:32"/></para>

<para style="q1"><verse number="33" style="v" sid="1CH 7:33"/>And the sons of Japhlet: </para>

<para style="q2" vid="1CH 7:33">Pasach, and Bimhal, and Ashvath. These <char style="add">were</char> the sons of Japhlet. <verse eid="1CH 7:33"/></para>

<para style="q1"><verse number="34" style="v" sid="1CH 7:34"/>And the sons of Shemer: </para>

<para style="q2" vid="1CH 7:34">Ahi, and Rohgah,<note caller="+" style="f"><char style="fr" closed="false">7.34 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">The sons of his brother Shemer: Rohgah</char><char style="ft" closed="false">; note that </char><char style="fq" closed="false">Shemer</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Shomer</char><char style="ft" closed="false">; see verse 32.</char></note> and Jehubbah, and Aram. <verse eid="1CH 7:34"/></para>

<para style="q1"><verse number="35" style="v" sid="1CH 7:35"/>And the sons of Helem<note caller="+" style="f"><char style="fr" closed="false">7.35 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Helem</char><char style="ft" closed="false"> is possibly another name for </char><char style="fq" closed="false">Hotham</char><char style="ft" closed="false">; see verse 32.</char></note> his brother: </para>

<para style="q2" vid="1CH 7:35">Zophah, and Imna, and Shelesh, and Amal. <verse eid="1CH 7:35"/></para>

<para style="q1"><verse number="36" style="v" sid="1CH 7:36"/>The sons of Zophah: Suah, and Harnepher, and Shual, and Beri, and Imrah, <verse eid="1CH 7:36"/></para>

<para style="q2"><verse number="37" style="v" sid="1CH 7:37"/>Bezer, and Hod, and Shamma, and Shilshah, and Ithran,<note caller="+" style="f"><char style="fr" closed="false">7.37 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Ithran</char><char style="ft" closed="false"> is possibly a variant of </char><char style="fq" closed="false">Jether</char><char style="ft" closed="false">; see verse 38.</char></note> and Beera. <verse eid="1CH 7:37"/></para>

<para style="q1"><verse number="38" style="v" sid="1CH 7:38"/>And the sons of Jether: </para>

<para style="q2" vid="1CH 7:38">Jephunneh, and Pispah, and Ara. <verse eid="1CH 7:38"/></para>

<para style="q1"><verse number="39" style="v" sid="1CH 7:39"/>And the sons of Ulla: </para>

<para style="q2" vid="1CH 7:39">Arah, and Hanniel, and Rizia. <verse eid="1CH 7:39"/></para>

<para style="q1"><verse number="40" style="v" sid="1CH 7:40"/>All these <char style="add">were</char> the sons of Asher, heads of the house of their fathers, choice mighty men of valor, heads of the princes. They were reckoned for the host, for battle, and their number of men <char style="add">was</char> twenty-six thousand. <verse eid="1CH 7:40"/></para>

<chapter eid="1CH 7"/>

<chapter number="8" style="c" sid="1CH 8"/>

<para style="s">Genealogy from Benjamin to Saul</para>

<para style="p"><verse number="1" style="v" sid="1CH 8:1"/>And Benjamin begat Bela his firstborn, Ashbel the second, and Aharah the third, <verse eid="1CH 8:1"/></para>

<para style="p"><verse number="2" style="v" sid="1CH 8:2"/>Nohah the fourth, and Rapha the fifth. <verse eid="1CH 8:2"/></para>

<para style="q1"><verse number="3" style="v" sid="1CH 8:3"/>And the sons of Bela: Addar, and Gera, and Abihud,<note caller="+" style="f"><char style="fr" closed="false">8.3 </char><char style="ft" closed="false"> Possibly </char><char style="fq" closed="false">Gera the father of Ehud</char><char style="ft" closed="false">; see verse 7.</char></note> <verse eid="1CH 8:3"/></para>

<para style="q2"><verse number="4" style="v" sid="1CH 8:4"/>and Abishua, and Naaman, and Ahoah, <verse eid="1CH 8:4"/></para>

<para style="q2"><verse number="5" style="v" sid="1CH 8:5"/>and Gera, and Shephuphan, and Huram. <verse eid="1CH 8:5"/></para>

<para style="q1"><verse number="6" style="v" sid="1CH 8:6"/>And these <char style="add">are</char> the sons of Ehud—these were the heads of fathers of those dwelling in Geba, and they carried them away to Manahath: <verse eid="1CH 8:6"/></para>

<para style="q2"><verse number="7" style="v" sid="1CH 8:7"/>Even Naaman, and Ahijah, and Gera. He carried them away, and he begat Uzza and Ahihud.<note caller="+" style="f"><char style="fr" closed="false">8.7 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">and Gera, that is Heglam, who was the father of Uzza and Ahihud.</char></note> <verse eid="1CH 8:7"/></para>

<para style="q1"><verse number="8" style="v" sid="1CH 8:8"/>And Shaharaim begat in the land of Moab, after he had sent away Hushim and Baara his wives. <verse eid="1CH 8:8"/></para>

<para style="q1"><verse number="9" style="v" sid="1CH 8:9"/>And he begat by Hodesh his wife: Jobab, and Zibia, and Mesha, and Malcam, <verse eid="1CH 8:9"/></para>

<para style="q2"><verse number="10" style="v" sid="1CH 8:10"/>and Jeuz, and Sachiah, and Mirmah. These <char style="add">were</char> his sons, heads of fathers. <verse eid="1CH 8:10"/></para>

<para style="q1"><verse number="11" style="v" sid="1CH 8:11"/>And by Hushim he begat: </para>

<para style="q2" vid="1CH 8:11">Abitub and Elpaal. <verse eid="1CH 8:11"/></para>

<para style="q1"><verse number="12" style="v" sid="1CH 8:12"/>And the sons of Elpaal: Eber, and Misham, and Shemed (he built Ono and Lod and its daughters), <verse eid="1CH 8:12"/></para>

<para style="q2"><verse number="13" style="v" sid="1CH 8:13"/>and Beriah and Shema (they <char style="add">were</char> heads of fathers of those dwelling in Aijalon; they drove out those dwelling in Gath), <verse eid="1CH 8:13"/></para>

<para style="q1"><verse number="14" style="v" sid="1CH 8:14"/>and Ahio, Shashak, and Jeremoth, <verse eid="1CH 8:14"/></para>

<para style="q1"><verse number="15" style="v" sid="1CH 8:15"/>and Zebadiah, and Arad, and Eder, <verse eid="1CH 8:15"/></para>

<para style="q1"><verse number="16" style="v" sid="1CH 8:16"/>and Michael, and Ispah, and Joha—the sons of Beriah, <verse eid="1CH 8:16"/></para>

<para style="q1"><verse number="17" style="v" sid="1CH 8:17"/>and Zebadiah, and Meshullam, and Hizki, and Heber, <verse eid="1CH 8:17"/></para>

<para style="q1"><verse number="18" style="v" sid="1CH 8:18"/>and Ishmerai, and Jizliah, and Jobab—the sons of Elpaal, <verse eid="1CH 8:18"/></para>

<para style="q1"><verse number="19" style="v" sid="1CH 8:19"/>and Jakim, and Zichri, and Zabdi, <verse eid="1CH 8:19"/></para>

<para style="q1"><verse number="20" style="v" sid="1CH 8:20"/>and Elienai, and Zillethai, and Eliel, <verse eid="1CH 8:20"/></para>

<para style="q1"><verse number="21" style="v" sid="1CH 8:21"/>and Adaiah, and Beraiah, and Shimrath—the sons of Shimei, <verse eid="1CH 8:21"/></para>

<para style="q1"><verse number="22" style="v" sid="1CH 8:22"/>and Ishpan, and Eber, and Eliel, <verse eid="1CH 8:22"/></para>

<para style="q1"><verse number="23" style="v" sid="1CH 8:23"/>and Abdon, and Zichri, and Hanan, <verse eid="1CH 8:23"/></para>

<para style="q1"><verse number="24" style="v" sid="1CH 8:24"/>and Hananiah, and Elam, and Antothijah, <verse eid="1CH 8:24"/></para>

<para style="q1"><verse number="25" style="v" sid="1CH 8:25"/>and Iphdeiah, and Penuel—the sons of Shashak, <verse eid="1CH 8:25"/></para>

<para style="q1"><verse number="26" style="v" sid="1CH 8:26"/>and Shamsherai, and Shehariah, and Athaliah, <verse eid="1CH 8:26"/></para>

<para style="q1"><verse number="27" style="v" sid="1CH 8:27"/>and Jaareshiah, and Elijah, and Zichri—the sons of Jeroham. <verse eid="1CH 8:27"/></para>

<para style="q1"><verse number="28" style="v" sid="1CH 8:28"/>These <char style="add">were</char> heads of fathers by their generations; these heads dwelt in Jerusalem. <verse eid="1CH 8:28"/></para>

<para style="q1"><verse number="29" style="v" sid="1CH 8:29"/>And <char style="add">Jeiel</char> the father of Gibeon<note caller="+" style="f"><char style="fr" closed="false">8.29 </char><char style="ft" closed="false"> Some LXX manuscripts (see also 1 Chronicles 9:35); Hebrew </char><char style="fq" closed="false">And the father of Gibeon</char></note> dwelt at Gibeon, and the name of his wife <char style="add">was</char> Maacah; <verse eid="1CH 8:29"/></para>

<para style="q1"><verse number="30" style="v" sid="1CH 8:30"/>and his firstborn son <char style="add">was</char> Abdon, and Zur, and Kish, and Baal,<note caller="+" style="f"><char style="fr" closed="false">8.30 </char><char style="ft" closed="false"> Some LXX manuscripts include </char><char style="fq" closed="false">Ner</char><char style="ft" closed="false">; see 1 Chronicles 9:36.</char></note> and Nadab, <verse eid="1CH 8:30"/></para>

<para style="q1"><verse number="31" style="v" sid="1CH 8:31"/>and Gedor, and Ahio, and Zecher.<note caller="+" style="f"><char style="fr" closed="false">8.31 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Zecher</char><char style="ft" closed="false"> is likely a variant of </char><char style="fq" closed="false">Zechariah</char><char style="ft" closed="false">; see 1 Chronicles 9:37.</char></note> <verse eid="1CH 8:31"/></para>

<para style="q1"><verse number="32" style="v" sid="1CH 8:32"/>And Mikloth begat Shimeah. And they also dwelt alongside their brothers in Jerusalem with their brothers. <note caller="+" style="f"><char style="fr" closed="false">8.32 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Shimeah</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Shimeam</char><char style="ft" closed="false">; see 1 Chronicles 9:38.</char></note><verse eid="1CH 8:32"/></para>

<para style="s">The Family of Saul</para>

<para style="p"><verse number="33" style="v" sid="1CH 8:33"/>And Ner begat Kish, and Kish begat Saul, and Saul begat Jonathan, and Malchishua, and Abinadab, and Esh-baal. <note caller="+" style="f"><char style="fr" closed="false">8.33 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Esh-baal</char><char style="ft" closed="false"> is also called </char><char style="fq" closed="false">Ish-bosheth</char><char style="ft" closed="false">; see 2 Samuel 2:8.</char></note><verse eid="1CH 8:33"/></para>

<para style="q1"><verse number="34" style="v" sid="1CH 8:34"/>And the son of Jonathan: </para>

<para style="q2" vid="1CH 8:34">Merib-baal, and Merib-baal begat Micah.<note caller="+" style="f"><char style="fr" closed="false">8.34 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Merib-baal</char><char style="ft" closed="false"> is also called </char><char style="fq" closed="false">Mephibosheth</char><char style="ft" closed="false">; see 2 Samuel 4:4.</char></note> <note caller="+" style="f"><char style="fr" closed="false">8.34 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Micah</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Mica</char><char style="ft" closed="false">; see 2 Samuel 9:12.</char></note><verse eid="1CH 8:34"/></para>

<para style="q1"><verse number="35" style="v" sid="1CH 8:35"/>And the sons of Micah: </para>

<para style="q2" vid="1CH 8:35">Pithon, and Melech, and Tarea, and Ahaz. <note caller="+" style="f"><char style="fr" closed="false">8.35 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Tarea</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Tahrea</char><char style="ft" closed="false">; see 1 Chronicles 9:41.</char></note><verse eid="1CH 8:35"/></para>

<para style="q1"><verse number="36" style="v" sid="1CH 8:36"/>And Ahaz begat Jehoadah, and Jehoadah begat Alemeth and Azmaveth and Zimri, and Zimri begat Moza, <note caller="+" style="f"><char style="fr" closed="false">8.36 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Jehoaddah</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Jarah</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">Jadah</char><char style="ft" closed="false">; see 1 Chronicles 9:42.</char></note><verse eid="1CH 8:36"/></para>

<para style="q1"><verse number="37" style="v" sid="1CH 8:37"/>and Moza begat Binea, Raphah his son, Eleasah his son, Azel his son. <note caller="+" style="f"><char style="fr" closed="false">8.37 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Raphah</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Rephaiah</char><char style="ft" closed="false">; see 1 Chronicles 9:43.</char></note><verse eid="1CH 8:37"/></para>

<para style="q1"><verse number="38" style="v" sid="1CH 8:38"/>And Azel had six sons, and these <char style="add">were</char> their names: </para>

<para style="q2" vid="1CH 8:38">Azrikam, Bocheru, and Ishmael, and Sheariah, and Obadiah, and Hanan—all these the sons of Azel. <verse eid="1CH 8:38"/></para>

<para style="q1"><verse number="39" style="v" sid="1CH 8:39"/>And the sons of Eshek his brother: Ulam his firstborn, Jeush the second, and Eliphelet the third. <verse eid="1CH 8:39"/></para>

<para style="q2"><verse number="40" style="v" sid="1CH 8:40"/>And the sons of Ulam were mighty men of valor, bending the bow and multiplying sons and grandsons—a hundred and fifty. </para>

<para style="p" vid="1CH 8:40">All these <char style="add">were</char> sons of Benjamin. <verse eid="1CH 8:40"/></para>

<chapter eid="1CH 8"/>

<chapter number="9" style="c" sid="1CH 9"/>

<para style="s">The People of Jerusalem</para>

<para style="p"><verse number="1" style="v" sid="1CH 9:1"/>And all Israel was reckoned, and behold, they are written in the Book of the Kings of Israel. And Judah was removed to Babylon for their trespass. <verse eid="1CH 9:1"/></para>

<para style="p"><verse number="2" style="v" sid="1CH 9:2"/>And the first dwellers who <char style="add">were</char> in their possessions in their cities of Israel <char style="add">were</char> the priests, the Levites, and the Nethinim.<note caller="+" style="f"><char style="fr" closed="false">9.2 </char><char style="ft" closed="false"> That is, </char><char style="fq" closed="false">the temple servants</char></note> <verse eid="1CH 9:2"/></para>

<para style="p"><verse number="3" style="v" sid="1CH 9:3"/>And in Jerusalem dwelt some of the sons of Judah, and some of the sons of Benjamin, and some of the sons of Ephraim and Manasseh: <verse eid="1CH 9:3"/></para>

<para style="q1"><verse number="4" style="v" sid="1CH 9:4"/>Uthai son of Ammihud, son of Omri, son of Imri, son of Bani of Perez son of Judah. <verse eid="1CH 9:4"/></para>

<para style="q1"><verse number="5" style="v" sid="1CH 9:5"/>And of the Shilonite: </para>

<para style="q2" vid="1CH 9:5">Asaiah the firstborn and his sons. <verse eid="1CH 9:5"/></para>

<para style="q1"><verse number="6" style="v" sid="1CH 9:6"/>And of the sons of Zerah: </para>

<para style="q2" vid="1CH 9:6">Jeuel and their brothers, six hundred and ninety. <verse eid="1CH 9:6"/></para>

<para style="q1"><verse number="7" style="v" sid="1CH 9:7"/>And of the sons of Benjamin: </para>

<para style="q2" vid="1CH 9:7">Sallu son of Meshullam, son of Hodaviah, son of Senuah; <verse eid="1CH 9:7"/></para>

<para style="q2"><verse number="8" style="v" sid="1CH 9:8"/>and Ibneiah son of Jeroham; </para>

<para style="q2" vid="1CH 9:8">and Elah son of Uzzi, son of Michri; </para>

<para style="q2" vid="1CH 9:8">and Meshullam son of Shephatiah, son of Reuel, son of Ibnijah; <verse eid="1CH 9:8"/></para>

<para style="q2"><verse number="9" style="v" sid="1CH 9:9"/>and their brothers according to their generations—nine hundred and fifty-six. All these men <char style="add">were</char> heads of fathers according to the house of their fathers. <verse eid="1CH 9:9"/></para>

<para style="q1"><verse number="10" style="v" sid="1CH 9:10"/>And of the priests: </para>

<para style="q2" vid="1CH 9:10">Jedaiah, and Jehoiarib, and Jachin; <verse eid="1CH 9:10"/></para>

<para style="q2"><verse number="11" style="v" sid="1CH 9:11"/>and Azariah son of Hilkiah, son of Meshullam, son of Zadok, son of Meraioth, son of Ahitub, leader in the house of God; <verse eid="1CH 9:11"/></para>

<para style="q2"><verse number="12" style="v" sid="1CH 9:12"/>and Adaiah son of Jeroham, son of Pashhur, son of Malchijah; </para>

<para style="q2" vid="1CH 9:12">and Maasai son of Adiel, son of Jahzerah, son of Meshullam, son of Meshillemoth, son of Immer; <note caller="+" style="f"><char style="fr" closed="false">9.12 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Meshillemith</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Meshillemoth</char><char style="ft" closed="false">; see Nehemiah 11:13.</char></note><verse eid="1CH 9:12"/></para>

<para style="q2"><verse number="13" style="v" sid="1CH 9:13"/>and their brothers, heads of the house of their fathers, a thousand and seven hundred and sixty mighty of valor for the work of the service of the house of God. <verse eid="1CH 9:13"/></para>

<para style="q1"><verse number="14" style="v" sid="1CH 9:14"/>And of the Levites: </para>

<para style="q2" vid="1CH 9:14">Shemaiah son of Hasshub, son of Azrikam, son of Hashabiah, of the sons of Merari; <verse eid="1CH 9:14"/></para>

<para style="q2"><verse number="15" style="v" sid="1CH 9:15"/>and Bakbakkar, Heresh, and Galal, and Mattaniah son of Micha, son of Zichri, son of Asaph; <verse eid="1CH 9:15"/></para>

<para style="q2"><verse number="16" style="v" sid="1CH 9:16"/>and Obadiah son of Shemaiah, son of Galal, son of Jeduthun; </para>

<para style="q2" vid="1CH 9:16">and Berechiah son of Asa, son of Elkanah, who dwelt in the villages of the Netophathite. <verse eid="1CH 9:16"/></para>

<para style="q1"><verse number="17" style="v" sid="1CH 9:17"/>And the gatekeepers: </para>

<para style="q2" vid="1CH 9:17">Shallum, and Akkub, and Talmon, and Ahiman, and their brothers. Shallum <char style="add">was</char> the chief; <verse eid="1CH 9:17"/></para>

<para style="q2"><verse number="18" style="v" sid="1CH 9:18"/>and until then at the Gate of the King on the east they <char style="add">had been</char> the gatekeepers for the camps of the sons of Levi. <verse eid="1CH 9:18"/></para>

<para style="q2"><verse number="19" style="v" sid="1CH 9:19"/>And Shallum son of Kore, son of Ebiasaph, son of Korah, and his brothers from the house of his father, the Korahites, <char style="add">were</char> in charge of the work of the service, keepers of the thresholds of the tabernacle—and their fathers <char style="add">were</char> over the camp of YHWH, keepers of the entrance. <note caller="+" style="f"><char style="fr" closed="false">9.19 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Ebiasaph</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Abiasaph</char><char style="ft" closed="false">; see Exodus 6:24.</char></note><verse eid="1CH 9:19"/></para>

<para style="q2"><verse number="20" style="v" sid="1CH 9:20"/>And Phinehas son of Eleazar had been the officer over them formerly; YHWH <char style="add">was</char> with him. <verse eid="1CH 9:20"/></para>

<para style="q2"><verse number="21" style="v" sid="1CH 9:21"/>Zechariah son of Meshelemiah <char style="add">was</char> keeper of the door of the Tent of Meeting. <verse eid="1CH 9:21"/></para>

<para style="q2"><verse number="22" style="v" sid="1CH 9:22"/>All those chosen for gatekeepers at the thresholds <char style="add">were</char> two hundred and twelve. They in their villages were reckoned—David and Samuel the seer had appointed them to their trusted office. <verse eid="1CH 9:22"/></para>

<para style="p"><verse number="23" style="v" sid="1CH 9:23"/>And they and their children <char style="add">were</char> over the gates of the house of YHWH, even of the house of the tabernacle, by watches. <verse eid="1CH 9:23"/></para>

<para style="p"><verse number="24" style="v" sid="1CH 9:24"/>On the four sides were the gatekeepers: The east, west, north, and south. <verse eid="1CH 9:24"/></para>

<para style="p"><verse number="25" style="v" sid="1CH 9:25"/>And their brothers in their villages were to come in for seven days from time to time with these. <verse eid="1CH 9:25"/></para>

<para style="p"><verse number="26" style="v" sid="1CH 9:26"/>For in office were four chief gatekeepers; they <char style="add">were</char> Levites, and they were over the chambers and over the treasuries of the house of God. <verse eid="1CH 9:26"/></para>

<para style="p"><verse number="27" style="v" sid="1CH 9:27"/>And around the house of God they lodged, because on them <char style="add">was</char> the watch. And they <char style="add">were</char> over the opening morning by morning. <verse eid="1CH 9:27"/></para>

<para style="p"><verse number="28" style="v" sid="1CH 9:28"/>And <char style="add">some</char> of them were in charge of the vessels of service, for by number they brought them in and by number they took them out. <verse eid="1CH 9:28"/></para>

<para style="p"><verse number="29" style="v" sid="1CH 9:29"/>And some of them were appointed over the vessels and over all the vessels of the sanctuary, and over the fine flour, and the wine, and the oil, and the frankincense, and the spices. <verse eid="1CH 9:29"/></para>

<para style="p"><verse number="30" style="v" sid="1CH 9:30"/>And <char style="add">some</char> of the sons of the priests were mixing the ointment of the spices. <verse eid="1CH 9:30"/></para>

<para style="p"><verse number="31" style="v" sid="1CH 9:31"/>And Mattithiah of the Levites (he <char style="add">was</char> the firstborn of Shallum the Korahite) was entrusted over the work of the flat cakes. <verse eid="1CH 9:31"/></para>

<para style="p"><verse number="32" style="v" sid="1CH 9:32"/>And some of the sons of the Kohathites from their brothers <char style="add">were</char> over the bread of the arrangement, to prepare <char style="add">it</char> Sabbath by Sabbath. <verse eid="1CH 9:32"/></para>

<para style="p"><verse number="33" style="v" sid="1CH 9:33"/>And these singers, the heads of fathers of the Levites in the chambers, <char style="add">were</char> free, for by day and by night <char style="add">they were</char> over them in the work. <verse eid="1CH 9:33"/></para>

<para style="p"><verse number="34" style="v" sid="1CH 9:34"/>These the heads of the fathers of the Levites throughout their generations <char style="add">were</char> heads; these dwelt in Jerusalem. <verse eid="1CH 9:34"/></para>

<para style="s">The Descendants of Saul</para>

<para style="q1"><verse number="35" style="v" sid="1CH 9:35"/>And at Gibeon dwelt the father of Gibeon, Jeiel, and the name of his wife <char style="add">was</char> Maacah, <note caller="+" style="f"><char style="fr" closed="false">9.35 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the founder</char></note><verse eid="1CH 9:35"/></para>

<para style="q1"><verse number="36" style="v" sid="1CH 9:36"/>and His firstborn son <char style="add">was</char> Abdon, and Zur, and Kish, and Baal, and Ner, and Nadab, <verse eid="1CH 9:36"/></para>

<para style="q1"><verse number="37" style="v" sid="1CH 9:37"/>and Gedor, and Ahio, and Zechariah, and Mikloth. <verse eid="1CH 9:37"/></para>

<para style="q1"><verse number="38" style="v" sid="1CH 9:38"/>And Mikloth begat Shimeam. And they also dwelt alongside their brothers in Jerusalem with their brothers. <note caller="+" style="f"><char style="fr" closed="false">9.38 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Shimeam</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Shimeah</char><char style="ft" closed="false">; see 1 Chronicles 8:32.</char></note><verse eid="1CH 9:38"/></para>

<para style="q1"><verse number="39" style="v" sid="1CH 9:39"/>And Ner begat Kish; and Kish begat Saul; and Saul begat Jonathan, and Malchishua, and Abinadab, and Esh-baal. <verse eid="1CH 9:39"/></para>

<para style="q1"><verse number="40" style="v" sid="1CH 9:40"/>And a son of Jonathan: </para>

<para style="q2" vid="1CH 9:40">Merib-baal, and Merib-baal begat Micah. <verse eid="1CH 9:40"/></para>

<para style="q1"><verse number="41" style="v" sid="1CH 9:41"/>And the sons of Micah: </para>

<para style="q2" vid="1CH 9:41">Pithon, and Melech, and Tahrea, <char style="add">and Ahaz</char>. <note caller="+" style="f"><char style="fr" closed="false">9.41 </char><char style="ft" closed="false"> Vulgate and Syriac (see also LXX and 1 Chronicles 8:35); Hebrew </char><char style="fq" closed="false">Pithon, Melech, and Tahrea</char><char style="ft" closed="false">; note that </char><char style="fq" closed="false">Tahrea</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Tarea</char><char style="ft" closed="false">.</char></note><verse eid="1CH 9:41"/></para>

<para style="q2"><verse number="42" style="v" sid="1CH 9:42"/>And Ahaz begat Jarah; and Jarah begat Alemeth, and Azmaveth, and Zimri; and Zimri begat Moza; <note caller="+" style="f"><char style="fr" closed="false">9.42 </char><char style="ft" closed="false"> Most Hebrew manuscripts; some Hebrew manuscripts and LXX </char><char style="fq" closed="false">Jadah; and Jadah</char><char style="ft" closed="false">; note that </char><char style="fq" closed="false">Jarah</char><char style="ft" closed="false"> and </char><char style="fq" closed="false">Jadah</char><char style="ft" closed="false"> are variants of </char><char style="fq" closed="false">Jehoaddah</char><char style="ft" closed="false">; see 1 Chronicles 8:36.</char></note><verse eid="1CH 9:42"/></para>

<para style="q2"><verse number="43" style="v" sid="1CH 9:43"/>and Moza begat Binea; and Rephaiah <char style="add">was</char> his son, Eleasah his son, Azel his son. <note caller="+" style="f"><char style="fr" closed="false">9.43 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Rephaiah</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Raphah</char><char style="ft" closed="false">; see 1 Chronicles 8:37.</char></note><verse eid="1CH 9:43"/></para>

<para style="q1"><verse number="44" style="v" sid="1CH 9:44"/>And unto Azel <char style="add">were</char> six sons, and these their names: </para>

<para style="q2" vid="1CH 9:44">Azrikam, Bocheru, and Ishmael, and Sheariah, and Obadiah, and Hanan. These <char style="add">were</char> the sons of Azel. <verse eid="1CH 9:44"/></para>

<chapter eid="1CH 9"/>

<chapter number="10" style="c" sid="1CH 10"/>

<para style="s">Saul’s Overthrow and Death</para>

<para style="p"><verse number="1" style="v" sid="1CH 10:1"/><note caller="-" style="x"><char style="xt" closed="false">2 Samuel 1:1–16</char></note><note caller="-" style="x"><char style="xt" closed="false">1 Samuel 31:1–6</char></note>And the Philistines fought against Israel, and the men of Israel fled from before the Philistines, and they fell slain on Mount Gilboa. <verse eid="1CH 10:1"/></para>

<para style="p"><verse number="2" style="v" sid="1CH 10:2"/>And the Philistines followed hard after Saul and his sons, and the Philistines killed Jonathan and Abinadab and Malchishua, the sons of Saul. <verse eid="1CH 10:2"/></para>

<para style="p"><verse number="3" style="v" sid="1CH 10:3"/>And the battle was heavy against Saul, and those shooting with the bow found him, and he was wounded by those shooting. <verse eid="1CH 10:3"/></para>

<para style="p"><verse number="4" style="v" sid="1CH 10:4"/>And Saul said to the bearer of his armor, “Draw your sword and thrust me through with it, lest these uncircumcised men come and abuse me.” </para>

<para style="p" vid="1CH 10:4">And the bearer of his armor was not willing, for he was exceedingly afraid. And Saul took a sword and fell on it. <verse eid="1CH 10:4"/></para>

<para style="p"><verse number="5" style="v" sid="1CH 10:5"/>And the bearer of his armor saw that Saul was dead, and he fell himself likewise on the sword, and he died. <verse eid="1CH 10:5"/></para>

<para style="p"><verse number="6" style="v" sid="1CH 10:6"/>And Saul died, and his three sons, and all his house—they died together. <verse eid="1CH 10:6"/></para>

<para style="s">The Philistines Possess the Towns1 Samuel 31:7–10</para>

<para style="p"><verse number="7" style="v" sid="1CH 10:7"/>And all the men of Israel who <char style="add">were</char> in the valley saw that they had fled, and that Saul and his sons were dead, and they abandoned their cities and fled. And the Philistines came and dwelt in them. <verse eid="1CH 10:7"/></para>

<para style="p"><verse number="8" style="v" sid="1CH 10:8"/>And it came to pass the next day that the Philistines came to strip the slain, and they found Saul and his sons fallen on Mount Gilboa. <verse eid="1CH 10:8"/></para>

<para style="p"><verse number="9" style="v" sid="1CH 10:9"/>And they stripped him and lifted up his head, and his armor, and they sent into the land of the Philistines round about, to proclaim tidings <char style="add">to</char> their idols and the people. <verse eid="1CH 10:9"/></para>

<para style="p"><verse number="10" style="v" sid="1CH 10:10"/>And they put his armor in the temple of their gods, and his head they fastened in the house of Dagon. <verse eid="1CH 10:10"/></para>

<para style="s">Jabesh-gilead’s Tribute to Saul1 Samuel 31:11–13</para>

<para style="p"><verse number="11" style="v" sid="1CH 10:11"/>And all Jabesh-gilead heard of all that the Philistines had done to Saul, <verse eid="1CH 10:11"/></para>

<para style="p"><verse number="12" style="v" sid="1CH 10:12"/>and all the men of valor arose and lifted up the body of Saul and the bodies of his sons, and they brought them to Jabesh, and they buried their bones under the oak<note caller="+" style="f"><char style="fr" closed="false">10.12 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">terebinth</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">great tree</char></note> in Jabesh, and they fasted seven days. <verse eid="1CH 10:12"/></para>

<para style="p"><verse number="13" style="v" sid="1CH 10:13"/>And Saul died for his unfaithfulness that he trespassed against YHWH, against the word of YHWH, because he did not keep <char style="add">it</char>, and also because he consulted a medium to inquire. <verse eid="1CH 10:13"/></para>

<para style="p"><verse number="14" style="v" sid="1CH 10:14"/><char style="add">He</char> inquired not of YHWH. And He killed him and turned over the kingdom to David son of Jesse. <verse eid="1CH 10:14"/></para>

<chapter eid="1CH 10"/>

<chapter number="11" style="c" sid="1CH 11"/>

<para style="s">David Anointed King of All Israel</para>

<para style="p"><verse number="1" style="v" sid="1CH 11:1"/><note caller="-" style="x"><char style="xt" closed="false">2 Samuel 5:1–5</char></note>And all Israel came together to David at Hebron, saying, “Behold, we <char style="add">are</char> your bone and your flesh. <verse eid="1CH 11:1"/></para>

<para style="p"><verse number="2" style="v" sid="1CH 11:2"/>Even in time past,<note caller="+" style="f"><char style="fr" closed="false">11.2 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">For some time</char></note> even before, even when Saul was king, you <char style="add">were</char> the one who led out and brought in Israel. And YHWH your God said to you, ‘You shall shepherd My people Israel, and you shall be ruler over My people Israel.’” <verse eid="1CH 11:2"/></para>

<para style="p"><verse number="3" style="v" sid="1CH 11:3"/>And all the elders of Israel came to the king at Hebron, and David made a covenant with them at Hebron before the face of YHWH. And they anointed David king over Israel, according to the word of YHWH by Samuel. <verse eid="1CH 11:3"/></para>

<para style="s">David Conquers Jerusalem2 Samuel 5:6–11</para>

<para style="p"><verse number="4" style="v" sid="1CH 11:4"/>And David went, and all Israel, to Jerusalem, that <char style="add">is</char>, Jebus, and there <char style="add">were</char> the Jebusite, those dwelling in the land. <verse eid="1CH 11:4"/></para>

<para style="p"><verse number="5" style="v" sid="1CH 11:5"/>And those dwelling in Jebus said to David, “You shall not come in here.” </para>

<para style="p" vid="1CH 11:5">And David took the stronghold of Zion (that <char style="add">is</char>, the City of David). <verse eid="1CH 11:5"/></para>

<para style="p"><verse number="6" style="v" sid="1CH 11:6"/>And David said, “Whoever strikes the Jebusite first shall be head and chief.” </para>

<para style="p" vid="1CH 11:6">And Joab son of Zeruiah went up first, and he became head. <verse eid="1CH 11:6"/></para>

<para style="p"><verse number="7" style="v" sid="1CH 11:7"/>And David dwelt in the stronghold; upon thus they called it the City of David. <verse eid="1CH 11:7"/></para>

<para style="p"><verse number="8" style="v" sid="1CH 11:8"/>And he built the city around it, from the Millo<note caller="+" style="f"><char style="fr" closed="false">11.8 </char><char style="ft" closed="false"> That is, </char><char style="fq" closed="false">the terrace</char></note> and to the surrounding area, and Joab repaired the rest of the city. <verse eid="1CH 11:8"/></para>

<para style="p"><verse number="9" style="v" sid="1CH 11:9"/>And David went, going on and becoming great, and YHWH of Hosts <char style="add">was</char> with him. <verse eid="1CH 11:9"/></para>

<para style="s">David’s Mighty Men2 Samuel 23:8–39</para>

<para style="p"><verse number="10" style="v" sid="1CH 11:10"/>And these <char style="add">were</char> the heads of the mighty who <char style="add">were</char> unto David, who strengthened themselves with him in his kingdom, with all Israel, to make him king according to the word of YHWH concerning Israel. <verse eid="1CH 11:10"/></para>

<para style="p"><verse number="11" style="v" sid="1CH 11:11"/>And these <char style="add">are</char> the numbers of the mighty men whom David had: </para>

<para style="p" vid="1CH 11:11">Jashobeam son of a Hachmonite, chief of the captains; he lifted up his spear against three hundred, whom he wounded at one time. <note caller="+" style="f"><char style="fr" closed="false">11.11 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">of the Thirty</char><char style="ft" closed="false">; some LXX manuscripts </char><char style="fq" closed="false">of the Three</char><char style="ft" closed="false">; see 2 Samuel 23:8.</char></note><verse eid="1CH 11:11"/></para>

<para style="p"><verse number="12" style="v" sid="1CH 11:12"/>And after him <char style="add">was</char> Eleazar son of Dodo<note caller="+" style="f"><char style="fr" closed="false">11.12 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Dodo</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Dodai</char><char style="ft" closed="false">; see 1 Chronicles 27:4.</char></note> the Ahohite—he <char style="add">was</char> among the three mighty <char style="add">men</char>. <verse eid="1CH 11:12"/></para>

<para style="p"><verse number="13" style="v" sid="1CH 11:13"/>He was with David at Pas-dammim, and the Philistines were gathered there for battle. And a portion of ground there was full of barley, and the people fled from the Philistines. <verse eid="1CH 11:13"/></para>

<para style="p"><verse number="14" style="v" sid="1CH 11:14"/>And they stationed themselves in the midst of the portion, and snatched it up, and struck the Philistines. And YHWH brought about a great victory. <verse eid="1CH 11:14"/></para>

<para style="p"><verse number="15" style="v" sid="1CH 11:15"/>And three of the thirty chief men went down to the rock to David, into the cave of Adullam; and the camp of the Philistines was encamped in the Valley of Rephaim. <verse eid="1CH 11:15"/></para>

<para style="p"><verse number="16" style="v" sid="1CH 11:16"/>And David <char style="add">was</char> then in the stronghold, and the garrison of the Philistines <char style="add">was</char> then in Bethlehem. <verse eid="1CH 11:16"/></para>

<para style="p"><verse number="17" style="v" sid="1CH 11:17"/>And David longed and said, “Who will give me a drink of water from the well of Bethlehem, which <char style="add">is</char> by the gate!” <verse eid="1CH 11:17"/></para>

<para style="p"><verse number="18" style="v" sid="1CH 11:18"/>And the Three broke through the camp of the Philistines, and they drew water from the well of Bethlehem that <char style="add">was</char> by the gate, and they lifted <char style="add">it</char> and brought <char style="add">it</char> to David. And David would not drink it, and he poured it out to YHWH, <verse eid="1CH 11:18"/></para>

<para style="p"><verse number="19" style="v" sid="1CH 11:19"/>and he said, “Far be it from me, my God, that I should do this; shall I drink the blood of these men with their lives? For with their lives they brought it.” And he would not drink it. </para>

<para style="p" vid="1CH 11:19">These things were done by the three mighty men. <verse eid="1CH 11:19"/></para>

<para style="p"><verse number="20" style="v" sid="1CH 11:20"/>And Abishai the brother of Joab, he was chief of the Three, and He wielded his spear against three hundred, killed <char style="add">them</char>, and won a name among the three. <note caller="+" style="f"><char style="fr" closed="false">11.20 </char><char style="ft" closed="false"> Hebrew; Syriac </char><char style="fq" closed="false">the Thirty</char><char style="ft" closed="false">; also in verse 21</char></note><verse eid="1CH 11:20"/></para>

<para style="p"><verse number="21" style="v" sid="1CH 11:21"/>He was doubly honored above the three, and he became captain unto them. And to the Three he did not attain. <verse eid="1CH 11:21"/></para>

<para style="p"><verse number="22" style="v" sid="1CH 11:22"/>Benaiah was the son of Jehoiada, the son of a man of valor, of great deeds, from Kabzeel: He struck down two champions of Moab,<note caller="+" style="f"><char style="fr" closed="false">11.22 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">two sons of Ariel of Moab</char></note> and He went down and killed the lion in the midst of a pit on the day of the snow. <verse eid="1CH 11:22"/></para>

<para style="p"><verse number="23" style="v" sid="1CH 11:23"/>And he killed an Egyptian, a man of measure five by the cubit,<note caller="+" style="f"><char style="fr" closed="false">11.23 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">5 cubits</char><char style="ft" closed="false"> is approximately 7 feet 6 inches or 229 centimeters tall.</char></note> and in the hand of the Egyptian <char style="add">was</char> a spear like a weavers’ beam. And he went down to him with a staff and wrested the spear from the hand of the Egyptian, and he killed him with his own spear. <verse eid="1CH 11:23"/></para>

<para style="p"><verse number="24" style="v" sid="1CH 11:24"/>These <char style="add">things</char> Benaiah son of Jehoiada did, and to him <char style="add">was</char> a name among the three mighty men. <verse eid="1CH 11:24"/></para>

<para style="p"><verse number="25" style="v" sid="1CH 11:25"/>Indeed he was more honored than the thirty, and to the three he did not attain. And David set him over his guard. <verse eid="1CH 11:25"/></para>

<para style="p"><verse number="26" style="v" sid="1CH 11:26"/>And the mighty men of the armies: </para>

<para style="q1" vid="1CH 11:26">Asah-el the brother of Joab, </para>

<para style="q1" vid="1CH 11:26">Elhanan son of Dodo of Bethlehem, <verse eid="1CH 11:26"/></para>

<para style="q1"><verse number="27" style="v" sid="1CH 11:27"/>Shammoth the Harorite, </para>

<para style="q1" vid="1CH 11:27">Helez the Pelonite, <note caller="+" style="f"><char style="fr" closed="false">11.27 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Shammoth the Harorite</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Shammah the Harodite</char><char style="ft" closed="false">; see 2 Samuel 23:25.</char></note><verse eid="1CH 11:27"/></para>

<para style="q1"><verse number="28" style="v" sid="1CH 11:28"/>Ira son of Ikkesh the Tekoite, </para>

<para style="q1" vid="1CH 11:28">Abiezer the Anathothite, <verse eid="1CH 11:28"/></para>

<para style="q1"><verse number="29" style="v" sid="1CH 11:29"/>Sibbechai the Hushathite, </para>

<para style="q1" vid="1CH 11:29">Ilai the Ahohite, <verse eid="1CH 11:29"/></para>

<para style="q1"><verse number="30" style="v" sid="1CH 11:30"/>Maharai the Netophathite, </para>

<para style="q1" vid="1CH 11:30">Heled son of Baanah the Netophathite, <verse eid="1CH 11:30"/></para>

<para style="q1"><verse number="31" style="v" sid="1CH 11:31"/>Ithai son of Ribai of Gibeah of the sons of Benjamin, </para>

<para style="q1" vid="1CH 11:31">Benaiah the Pirathonite, <note caller="+" style="f"><char style="fr" closed="false">11.31 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Ithai</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Ittai</char><char style="ft" closed="false">; see 2 Samuel 23:29.</char></note><verse eid="1CH 11:31"/></para>

<para style="q1"><verse number="32" style="v" sid="1CH 11:32"/>Hurai of the brooks<note caller="+" style="f"><char style="fr" closed="false">11.32 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Hurai</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Hiddai</char><char style="ft" closed="false">; see 2 Samuel 23:30.</char></note> of Gaash, </para>

<para style="q1" vid="1CH 11:32">Abiel<note caller="+" style="f"><char style="fr" closed="false">11.32 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">from the ravines</char></note> the Arbathite, <note caller="+" style="f"><char style="fr" closed="false">11.32 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Abiel</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Abi-albon</char><char style="ft" closed="false">; see 2 Samuel 23:31.</char></note><verse eid="1CH 11:32"/></para>

<para style="q1"><verse number="33" style="v" sid="1CH 11:33"/>Azmaveth the Baharumite,<note caller="+" style="f"><char style="fr" closed="false">11.33 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Baharumite</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Barhumite</char><char style="ft" closed="false">; see 2 Samuel 23:31.</char></note> </para>

<para style="q1" vid="1CH 11:33">Eliahba the Shaalbonite, <verse eid="1CH 11:33"/></para>

<para style="q1"><verse number="34" style="v" sid="1CH 11:34"/>the sons of Hashem the Gizonite, </para>

<para style="q1" vid="1CH 11:34">Jonathan son of Shageh the Hararite, <note caller="+" style="f"><char style="fr" closed="false">11.34 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Hashem</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Jashen</char><char style="ft" closed="false">; see LXX and 2 Samuel 23:32.</char></note><verse eid="1CH 11:34"/></para>

<para style="q1"><verse number="35" style="v" sid="1CH 11:35"/>Ahiam son of Sachar the Hararite, </para>

<para style="q1" vid="1CH 11:35">Eliphal son of Ur, <note caller="+" style="f"><char style="fr" closed="false">11.35 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Sachar</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Sharar</char><char style="ft" closed="false">; see 2 Samuel 23:33.</char></note><verse eid="1CH 11:35"/></para>

<para style="q1"><verse number="36" style="v" sid="1CH 11:36"/>Hepher the Mecherathite, </para>

<para style="q1" vid="1CH 11:36">Ahijah the Pelonite, <verse eid="1CH 11:36"/></para>

<para style="q1"><verse number="37" style="v" sid="1CH 11:37"/>Hezro the Carmelite, </para>

<para style="q1" vid="1CH 11:37">Naarai son of Ezbai, <verse eid="1CH 11:37"/></para>

<para style="q1"><verse number="38" style="v" sid="1CH 11:38"/>Joel the brother of Nathan, </para>

<para style="q1" vid="1CH 11:38">Mibhar son of Hagri, <verse eid="1CH 11:38"/></para>

<para style="q1"><verse number="39" style="v" sid="1CH 11:39"/>Zelek the Ammonite, </para>

<para style="q1" vid="1CH 11:39">Naharai the Beerothite, bearer of the armor of Joab son of Zeruiah, <verse eid="1CH 11:39"/></para>

<para style="q1"><verse number="40" style="v" sid="1CH 11:40"/>Ira the Ithrite, </para>

<para style="q1" vid="1CH 11:40">Gareb the Ithrite, <verse eid="1CH 11:40"/></para>

<para style="q1"><verse number="41" style="v" sid="1CH 11:41"/>Uriah the Hittite, </para>

<para style="q1" vid="1CH 11:41">Zabad son of Ahlai, <verse eid="1CH 11:41"/></para>

<para style="q1"><verse number="42" style="v" sid="1CH 11:42"/>Adina son of Shiza the Reubenite, a chief of the Reubenite, and with him thirty, <verse eid="1CH 11:42"/></para>

<para style="q1"><verse number="43" style="v" sid="1CH 11:43"/>Hanan son of Maacah, </para>

<para style="q1" vid="1CH 11:43">and Joshaphat the Mithnite, <verse eid="1CH 11:43"/></para>

<para style="q1"><verse number="44" style="v" sid="1CH 11:44"/>Uzzia the Ashterathite, </para>

<para style="q1" vid="1CH 11:44">Shama and Jeiel the sons of Hotham the Aroerite, <verse eid="1CH 11:44"/></para>

<para style="q1"><verse number="45" style="v" sid="1CH 11:45"/>Jediael son of Shimri, and Joha his brother, the Tizite, <verse eid="1CH 11:45"/></para>

<para style="q1"><verse number="46" style="v" sid="1CH 11:46"/>Eliel the Mahavite, </para>

<para style="q1" vid="1CH 11:46">and Jeribai and Joshaviah, the sons of Elnaam, </para>

<para style="q1" vid="1CH 11:46">and Ithmah the Moabite, <verse eid="1CH 11:46"/></para>

<para style="q1"><verse number="47" style="v" sid="1CH 11:47"/>Eliel, and Obed, and Jaasiel the Mezobaite. <verse eid="1CH 11:47"/></para>

<chapter eid="1CH 11"/>

<chapter number="12" style="c" sid="1CH 12"/>

<para style="s">The Mighty Men Join David at Ziklag</para>

<para style="p"><verse number="1" style="v" sid="1CH 12:1"/>And these <char style="add">were</char> those coming in to David at Ziklag while he was still a fugitive from Saul son of Kish (and they <char style="add">were</char> among the mighty men, helpers in battle, <verse eid="1CH 12:1"/></para>

<para style="p"><verse number="2" style="v" sid="1CH 12:2"/>armed with bows, using the right hand and the left with stones and with arrows with the bow, brothers of Saul from Benjamin). <verse eid="1CH 12:2"/></para>

<para style="q1"><verse number="3" style="v" sid="1CH 12:3"/>The chief <char style="add">was</char> Ahiezer, and Joash, the sons of Shemaah the Gibeathite; </para>

<para style="q1" vid="1CH 12:3">and Jeziel, and Pelet, the sons of Azmaveth; </para>

<para style="q1" vid="1CH 12:3">and Berachah; </para>

<para style="q1" vid="1CH 12:3">and Jehu the Anathothite; <verse eid="1CH 12:3"/></para>

<para style="q1"><verse number="4" style="v" sid="1CH 12:4"/>and Ishmaiah the Gibeonite, a mighty man among the thirty and over the thirty; </para>

<para style="q1" vid="1CH 12:4">and Jeremiah, and Jahaziel, and Johanan, and Jozabad the Gederathite; <verse eid="1CH 12:4"/></para>

<para style="q1"><verse number="5" style="v" sid="1CH 12:5"/>Eluzai, and Jerimoth, and Bealiah, and Shemariah, and Shephatiah the Haruphite; <verse eid="1CH 12:5"/></para>

<para style="q1"><verse number="6" style="v" sid="1CH 12:6"/>Elkanah, and Jisshiah, and Azarel, and Joezer, and Jashobeam the Korahites; <verse eid="1CH 12:6"/></para>

<para style="q1"><verse number="7" style="v" sid="1CH 12:7"/>and Joelah and Zebadiah the sons of Jeroham of Gedor. <verse eid="1CH 12:7"/></para>

<para style="p"><verse number="8" style="v" sid="1CH 12:8"/>And <char style="add">some</char> of the Gadite separated themselves unto David at the stronghold in the wilderness, mighty men of valor, men trained for battle, setting in array shield and spear, and their faces the face of the lion, and as swift as gazelles on the mountains: <verse eid="1CH 12:8"/></para>

<para style="q1"><verse number="9" style="v" sid="1CH 12:9"/>Ezer the first, Obadiah the second, Eliab the third, <verse eid="1CH 12:9"/></para>

<para style="q1"><verse number="10" style="v" sid="1CH 12:10"/>Mishmannah the fourth, Jeremiah the fifth, <verse eid="1CH 12:10"/></para>

<para style="q1"><verse number="11" style="v" sid="1CH 12:11"/>Attai the sixth, Eliel the seventh, <verse eid="1CH 12:11"/></para>

<para style="q1"><verse number="12" style="v" sid="1CH 12:12"/>Johanan the eighth, Elzabad the ninth, <verse eid="1CH 12:12"/></para>

<para style="q1"><verse number="13" style="v" sid="1CH 12:13"/>Jeremiah the tenth, <char style="add">and</char> Machbanai the eleventh. <verse eid="1CH 12:13"/></para>

<para style="p"><verse number="14" style="v" sid="1CH 12:14"/>These from the sons of Gad <char style="add">were</char> captains of the host, the least one over a hundred, and the greatest over a thousand. <verse eid="1CH 12:14"/></para>

<para style="p"><verse number="15" style="v" sid="1CH 12:15"/>These are the ones who passed over the Jordan in the first month, and it had overflowed on all its banks. And all in the valleys they put to flight, to the east and to the west. <verse eid="1CH 12:15"/></para>

<para style="p"><verse number="16" style="v" sid="1CH 12:16"/>And there came <char style="add">some</char> from the sons of Benjamin and Judah to the stronghold to David. <verse eid="1CH 12:16"/></para>

<para style="p"><verse number="17" style="v" sid="1CH 12:17"/>And David went out to meet them, and he answered and said to them, “If you⁺ have come to me in peace to help me, the heart of me will be united with you⁺; but if to betray me to my enemies—without violence in my hands—the God of our fathers shall see and judge you.” <verse eid="1CH 12:17"/></para>

<para style="p"><verse number="18" style="v" sid="1CH 12:18"/>And the Spirit came upon Amasai chief of the Thirty: </para>

<para style="q1" vid="1CH 12:18">“To you, O David, </para>

<para style="q2" vid="1CH 12:18">and with you, O son of Jesse, </para>

<para style="q1" vid="1CH 12:18">peace, peace to you, </para>

<para style="q2" vid="1CH 12:18">and peace to your helpers. </para>

<para style="q2" vid="1CH 12:18">For your God helps you.” </para>

<para style="p" vid="1CH 12:18">And David received them and made them leaders of the troop. <verse eid="1CH 12:18"/></para>

<para style="p"><verse number="19" style="v" sid="1CH 12:19"/>And <char style="add">some</char> from Manasseh fell to David when he was going with the Philistines against Saul to the battle. (They did not help them, for by counsel the lords of the Philistines sent him away, saying, “With our heads he may fall to his master Saul.”) <verse eid="1CH 12:19"/></para>

<para style="p"><verse number="20" style="v" sid="1CH 12:20"/>When he went to Ziklag, they fell to him from Manasseh: </para>

<para style="q1" vid="1CH 12:20">Adnah, and Jozabad, and Jediael, and Michael, and Jozabad, and Elihu, and Zillethai, the heads of the thousands who <char style="add">were</char> from Manasseh. <verse eid="1CH 12:20"/></para>

<para style="p"><verse number="21" style="v" sid="1CH 12:21"/>And they helped with David against the bands, for all <char style="add">were</char> mighty men of valor, and they were captains in the army. <verse eid="1CH 12:21"/></para>

<para style="p"><verse number="22" style="v" sid="1CH 12:22"/>For at that time day by day they came to David to help him, until <char style="add">it was</char> a great camp, like the camp of God. <verse eid="1CH 12:22"/></para>

<para style="s">David’s Army Grows at Hebron</para>

<para style="p"><verse number="23" style="v" sid="1CH 12:23"/>And these <char style="add">were</char> the numbers of the heads of the armed of the host <char style="add">who</char> came to David at Hebron to turn <char style="add">over</char> the kingdom of Saul to him, according to the word of YHWH. <verse eid="1CH 12:23"/></para>

<para style="p"><verse number="24" style="v" sid="1CH 12:24"/>Of the sons of Judah bearing shield and spear, six thousand and eight hundred armed of the host. <verse eid="1CH 12:24"/></para>

<para style="p"><verse number="25" style="v" sid="1CH 12:25"/>Of the sons of Simeon, mighty men of valor of the host, seven thousand and a hundred. <verse eid="1CH 12:25"/></para>

<para style="p"><verse number="26" style="v" sid="1CH 12:26"/>Of the sons of Levi four thousand and six hundred, <verse eid="1CH 12:26"/></para>

<para style="p"><verse number="27" style="v" sid="1CH 12:27"/>and Jehoiada the leader from Aaron, and with him three thousand and seven hundred; <verse eid="1CH 12:27"/></para>

<para style="p"><verse number="28" style="v" sid="1CH 12:28"/>and Zadok, a young man mighty of valor, and of the house of his father twenty-two captains. <verse eid="1CH 12:28"/></para>

<para style="p"><verse number="29" style="v" sid="1CH 12:29"/>And of the sons of Benjamin, brothers of Saul, three thousand—and until then the greatest part of them were keeping the charge of the house of Saul. <verse eid="1CH 12:29"/></para>

<para style="p"><verse number="30" style="v" sid="1CH 12:30"/>And of the sons of Ephraim twenty thousand and eight hundred mighty men of valor, men of renown according to the house of their fathers. <verse eid="1CH 12:30"/></para>

<para style="p"><verse number="31" style="v" sid="1CH 12:31"/>And of the half-tribe of Manasseh,<note caller="+" style="f"><char style="fr" closed="false">12.31 </char><char style="ft" closed="false"> That is, the half-tribe of Manasseh west of the Jordan</char></note> eighteen thousand who were marked by name, to come and make David king. <verse eid="1CH 12:31"/></para>

<para style="p"><verse number="32" style="v" sid="1CH 12:32"/>And of the sons of Issachar, knowing discernment of the times, knowing what Israel ought to do, their heads—two hundred—and all their brothers at their command. <verse eid="1CH 12:32"/></para>

<para style="p"><verse number="33" style="v" sid="1CH 12:33"/>Of Zebulun, going forth to the host, arranging battle with all weapons of war, fifty thousand, and to help <char style="add">David</char><note caller="+" style="f"><char style="fr" closed="false">12.33 </char><char style="ft" closed="false"> LXX; Hebrew does not include </char><char style="fq" closed="false">David</char><char style="ft" closed="false">.</char></note> without a double heart.<note caller="+" style="f"><char style="fr" closed="false">12.33 </char><char style="ft" closed="false"> That is, </char><char style="fq" closed="false">with one purpose</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">with undivided loyalty</char></note> <verse eid="1CH 12:33"/></para>

<para style="p"><verse number="34" style="v" sid="1CH 12:34"/>And of Naphtali, a thousand captains, and with them, with shield and spear, thirty-seven thousand. <verse eid="1CH 12:34"/></para>

<para style="p"><verse number="35" style="v" sid="1CH 12:35"/>And of the Danite, arranging for battle, twenty-eight thousand and six hundred. <verse eid="1CH 12:35"/></para>

<para style="p"><verse number="36" style="v" sid="1CH 12:36"/>And of Asher, going forth to the host to arrange for battle, forty thousand. <verse eid="1CH 12:36"/></para>

<para style="p"><verse number="37" style="v" sid="1CH 12:37"/>And from the other side of the Jordan, of the Reubenite, and the Gadite, and the half-tribe of Manasseh, with every of weapon of war for battle, a hundred and twenty thousand. <verse eid="1CH 12:37"/></para>

<para style="p"><verse number="38" style="v" sid="1CH 12:38"/>All these men of war, keeping rank with a perfect heart, came to Hebron to make David king over all Israel, and all the rest of Israel <char style="add">were</char> of one mind to make David king. <verse eid="1CH 12:38"/></para>

<para style="p"><verse number="39" style="v" sid="1CH 12:39"/>And they were there with David three days eating and drinking, for their brothers had prepared for them. <verse eid="1CH 12:39"/></para>

<para style="p"><verse number="40" style="v" sid="1CH 12:40"/>And those very near to them as far as Issachar and Zebulun and Naphtali were bringing food on the donkeys, and on the camels, and on the mules, and on the oxen, and provisions of flour, and cakes of figs, and cakes of raisins, and wine, and oil, and oxen, and oxen, and sheep. Indeed, <char style="add">there was</char> joy in Israel. <verse eid="1CH 12:40"/></para>

<chapter eid="1CH 12"/>

<chapter number="13" style="c" sid="1CH 13"/>

<para style="s">David Fetches the Ark</para>

<para style="p"><verse number="1" style="v" sid="1CH 13:1"/><note caller="-" style="x"><char style="xt" closed="false">2 Samuel 6:1–4</char></note>And David counseled with the captains of the thousands and of the hundreds, with every leader. <verse eid="1CH 13:1"/></para>

<para style="p"><verse number="2" style="v" sid="1CH 13:2"/>And David said to all the assembly of Israel, “If <char style="add">it is</char> good to you⁺ breaking forth from YHWH our God, let us send out to our brothers remaining in all the land of Israel, and with them to the priests and the Levites in their cities <char style="add">and</char> their pasturelands, that they may gather together to us. <verse eid="1CH 13:2"/></para>

<para style="p"><verse number="3" style="v" sid="1CH 13:3"/>And let us bring back the ark of our God to us, for we did not seek Him<note caller="+" style="f"><char style="fr" closed="false">13.3 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">did not seek it</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">did not inquire of it</char></note> in the days of Saul.” <verse eid="1CH 13:3"/></para>

<para style="p"><verse number="4" style="v" sid="1CH 13:4"/>And all the assembly said that they would do so, for the thing was right in the eyes of all the people. <verse eid="1CH 13:4"/></para>

<para style="p"><verse number="5" style="v" sid="1CH 13:5"/>And David gathered together all Israel from the Shihor<note caller="+" style="f"><char style="fr" closed="false">13.5 </char><char style="ft" closed="false"> That is </char><char style="fq" closed="false">from the River Shihor</char></note> in Egypt and as far as Lebo-Hamath, to bring the ark of God from Kiriath-jearim. <verse eid="1CH 13:5"/></para>

<para style="p"><verse number="6" style="v" sid="1CH 13:6"/>And David went up, and all Israel, to Baalah (to Kiriath-jearim), which <char style="add">was was unto Judah, to bring up from there the ark of God, YHWH, dwelling between the cherubim, where the Name is proclaimed. </char><note caller="+" style="f"><char style="fr" closed="false">13.6 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the ark of God, which is called by the Name of YHWH who is enthroned between the cherubim</char><char style="ft" closed="false">; or </char><char style="fq" closed="false">the ark of God, YHWH, who is enthroned between the cherubim, where His Name is called</char></note><verse eid="1CH 13:6"/></para>

<para style="p"><verse number="7" style="v" sid="1CH 13:7"/><char style="add">And they carried the ark of God on a new cart from the house of Abinadab. And Uzza and Ahio were driving the cart. </char><verse eid="1CH 13:7"/></para>

<para style="s">Uzzah Touches the Ark2 Samuel 6:5–11</para>

<para style="p"><verse number="8" style="v" sid="1CH 13:8"/><char style="add">And David and all Israel played before the face of God with all the might, with singing, and on harps, and on stringed instruments, and on tambourines, and on cymbals, and with the trumpets. </char><verse eid="1CH 13:8"/></para>

<para style="p"><verse number="9" style="v" sid="1CH 13:9"/><char style="add">And they came to the threshing floor of Chidon, and Uzza put forth his hand to hold the ark, for the oxen had stumbled. </char><note caller="+" style="f"><char style="fr" closed="false">13.9 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Chidon</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Nacon</char><char style="ft" closed="false">; see 2 Samuel 6:6.</char></note><verse eid="1CH 13:9"/></para>

<para style="p"><verse number="10" style="v" sid="1CH 13:10"/><char style="add">And the anger of YHWH was kindled against Uzza, and He struck him upon that he stretched out his hand upon the ark, and he died there before the face of God. </char><verse eid="1CH 13:10"/></para>

<para style="p"><verse number="11" style="v" sid="1CH 13:11"/><char style="add">And it was displeasing to David because YHWH broke forth a breach upon Uzza; and he called that place Perez-uzzah</char><note caller="+" style="f"><char style="fr" closed="false">13.11 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Perez-uzzah</char><char style="ft" closed="false"> means </char><char style="fq" closed="false">outbreak against Uzzah</char><char style="ft" closed="false">.</char></note><char style="add"> to this day. </char><verse eid="1CH 13:11"/></para>

<para style="p"><verse number="12" style="v" sid="1CH 13:12"/><char style="add">And David was afraid of God that day, saying, “How can I bring to myself the ark of God?” </char><verse eid="1CH 13:12"/></para>

<para style="p"><verse number="13" style="v" sid="1CH 13:13"/><char style="add">And David would not move the ark with him into the City of David, and he stretched it aside into the house of Obed-edom the Gittite. </char><verse eid="1CH 13:13"/></para>

<para style="p"><verse number="14" style="v" sid="1CH 13:14"/><char style="add">And the ark of God remained with the house of Obed-edom in his house three months, and YHWH blessed the house of Obed-edom and all that was unto him. </char><verse eid="1CH 13:14"/></para>

<chapter eid="1CH 13"/>

<chapter number="14" style="c" sid="1CH 14"/>

<para style="s">David’s Family Grows</para>

<para style="p"><verse number="1" style="v" sid="1CH 14:1"/><note caller="-" style="x"><char style="xt" closed="false">2 Samuel 5:12–16</char></note>And Huram king of Tyre sent messengers to David, and cedar trees, and craftsmen of walls, and craftsmen of wood, to build for him a house. <verse eid="1CH 14:1"/></para>

<para style="p"><verse number="2" style="v" sid="1CH 14:2"/>And David knew that YHWH had established him as king over Israel, for was exalted highly his kingdom for the sake of His people Israel. <verse eid="1CH 14:2"/></para>

<para style="p"><verse number="3" style="v" sid="1CH 14:3"/>And David took more wives in Jerusalem, and David begat more sons and daughters. <verse eid="1CH 14:3"/></para>

<para style="p"><verse number="4" style="v" sid="1CH 14:4"/>And these <char style="add">are</char> the names of the children who were unto him in Jerusalem: Shammua, and Shobab, Nathan, and Solomon, <note caller="+" style="f"><char style="fr" closed="false">14.4 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Shammua</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Shimea</char><char style="ft" closed="false">; see 1 Chronicles 3:5.</char></note><verse eid="1CH 14:4"/></para>

<para style="p"><verse number="5" style="v" sid="1CH 14:5"/>and Ibhar, and Elishua, and Elpelet, <verse eid="1CH 14:5"/></para>

<para style="p"><verse number="6" style="v" sid="1CH 14:6"/>and Nogah, and Nepheg, and Japhia, <verse eid="1CH 14:6"/></para>

<para style="p"><verse number="7" style="v" sid="1CH 14:7"/>and Elishama, and Beeliada, and Eliphelet. <note caller="+" style="f"><char style="fr" closed="false">14.7 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Beeliada</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Eliada</char><char style="ft" closed="false">; see 2 Samuel 5:16.</char></note><verse eid="1CH 14:7"/></para>

<para style="s">Two Victories over the Philistines2 Samuel 5:17–25</para>

<para style="p"><verse number="8" style="v" sid="1CH 14:8"/>And the Philistines heard that David had been anointed king over all Israel, and all the Philistines went up to search for David. And David heard <char style="add">of it</char> and went out before them. <verse eid="1CH 14:8"/></para>

<para style="p"><verse number="9" style="v" sid="1CH 14:9"/>And the Philistines went and made a raid on the Valley of Rephaim. <verse eid="1CH 14:9"/></para>

<para style="p"><verse number="10" style="v" sid="1CH 14:10"/>And David inquired of God, saying, “Shall I go up against the Philistines, and have You given them into my hand?” </para>

<para style="p" vid="1CH 14:10">And YHWH said to him, “Go up, and I have given into your hand.” <verse eid="1CH 14:10"/></para>

<para style="p"><verse number="11" style="v" sid="1CH 14:11"/>And they went up to Baal-perazim, and David defeated them there. And David said, “God has broken up my enemies by my hand like the breaking up of waters.” Upon thus they called the name of that place Baal-perazim.<note caller="+" style="f"><char style="fr" closed="false">14.11 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Baal-perazim</char><char style="ft" closed="false"> means </char><char style="fq" closed="false">The Lord Bursts Out</char><char style="ft" closed="false">.</char></note> <verse eid="1CH 14:11"/></para>

<para style="p"><verse number="12" style="v" sid="1CH 14:12"/>And they left their gods there, and David gave a commandment, and they were burned with the fire. <verse eid="1CH 14:12"/></para>

<para style="p"><verse number="13" style="v" sid="1CH 14:13"/>And the Philistines added again to make a raid on the valley. <verse eid="1CH 14:13"/></para>

<para style="p"><verse number="14" style="v" sid="1CH 14:14"/>And David inquired again of God, and God said to him, “You shall not go up after them. Circle around them and come upon them in front of the balsam trees.<note caller="+" style="f"><char style="fr" closed="false">14.14 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">aspen trees</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">poplar trees</char><char style="ft" closed="false">; also in verse 15</char></note> <verse eid="1CH 14:14"/></para>

<para style="p"><verse number="15" style="v" sid="1CH 14:15"/>And it shall be, when you hear the sound of a marching in the tops of the balsam trees, then you shall go out to battle, for God has gone out before you to strike the camp of the Philistines.” <verse eid="1CH 14:15"/></para>

<para style="p"><verse number="16" style="v" sid="1CH 14:16"/>And David did as God had commanded him, and they drove back the camp of the Philistines from Gibeon to Gezer. <verse eid="1CH 14:16"/></para>

<para style="p"><verse number="17" style="v" sid="1CH 14:17"/>And the name of David went out into all the lands, and YHWH brought the dread of him upon all the nations. <verse eid="1CH 14:17"/></para>

<chapter eid="1CH 14"/>

<chapter number="15" style="c" sid="1CH 15"/>

<para style="s">Preparing to Move the Ark</para>

<para style="p"><verse number="1" style="v" sid="1CH 15:1"/><note caller="-" style="x"><char style="xt" closed="false">2 Samuel 6:12–15</char></note>And he built for himself houses in the City of David, and he prepared a place for the ark of God and pitched a tent for it. <verse eid="1CH 15:1"/></para>

<para style="p"><verse number="2" style="v" sid="1CH 15:2"/>Then David said, “No one may carry the ark of God but only the Levites. For YHWH has chosen them to carry the ark of YHWH and to minister before Him even to forever.” <verse eid="1CH 15:2"/></para>

<para style="p"><verse number="3" style="v" sid="1CH 15:3"/>And David gathered together all Israel to Jerusalem to bring up the ark of YHWH to its place, which he had prepared for it. <verse eid="1CH 15:3"/></para>

<para style="p"><verse number="4" style="v" sid="1CH 15:4"/>And David gathered together the sons of Aaron and the Levites: <verse eid="1CH 15:4"/></para>

<para style="q1"><verse number="5" style="v" sid="1CH 15:5"/>Of the sons of Kohath: Uriel the chief, and of his brothers a hundred and twenty; <verse eid="1CH 15:5"/></para>

<para style="q1"><verse number="6" style="v" sid="1CH 15:6"/>of the sons of Merari: Asaiah the chief, and of his brothers two hundred and twenty; <verse eid="1CH 15:6"/></para>

<para style="q1"><verse number="7" style="v" sid="1CH 15:7"/>of the sons of Gershom:<note caller="+" style="f"><char style="fr" closed="false">15.7 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Gershom</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Gershon</char><char style="ft" closed="false">; see 1 Chronicles 23:7.</char></note> Joel the chief, and of his brothers a hundred and thirty; <verse eid="1CH 15:7"/></para>

<para style="q1"><verse number="8" style="v" sid="1CH 15:8"/>of the sons of Elizaphan: Shemaiah the chief, and of his brothers two hundred; <verse eid="1CH 15:8"/></para>

<para style="q1"><verse number="9" style="v" sid="1CH 15:9"/>of the sons of Hebron: Eliel the chief, and of his brothers eighty; <verse eid="1CH 15:9"/></para>

<para style="q1"><verse number="10" style="v" sid="1CH 15:10"/>of the sons of Uzziel: Amminadab the chief, and of his brothers a hundred and twelve. <verse eid="1CH 15:10"/></para>

<para style="p"><verse number="11" style="v" sid="1CH 15:11"/>And David called to Zadok and Abiathar the priests, and to the Levites, to Uriel, Asaiah, and Joel, Shemaiah, and Eliel, and Amminadab, <verse eid="1CH 15:11"/></para>

<para style="p"><verse number="12" style="v" sid="1CH 15:12"/>and He said to them, “You⁺ <char style="add">are</char> heads of the fathers of the Levites. Sanctify yourselves, you⁺ and your⁺ brothers, that you⁺ may bring up the ark of YHWH, God of Israel, to <char style="add">where</char> I have prepared for it. <verse eid="1CH 15:12"/></para>

<para style="p"><verse number="13" style="v" sid="1CH 15:13"/>And because at the first <char style="add">it was</char> not you⁺ not, YHWH our God broke out against us because we did not seek Him according to the ordinance.” <verse eid="1CH 15:13"/></para>

<para style="s">The Priests and Levites Carry the Ark</para>

<para style="p"><verse number="14" style="v" sid="1CH 15:14"/>And the priests and the Levites sanctified themselves to bring up the ark of YHWH, God of Israel; <verse eid="1CH 15:14"/></para>

<para style="p"><verse number="15" style="v" sid="1CH 15:15"/>and the sons of the Levites carried the ark of God, as Moses had commanded according to the word of YHWH, on their shoulders with the poles on them. <verse eid="1CH 15:15"/></para>

<para style="p"><verse number="16" style="v" sid="1CH 15:16"/>And David spoke to the heads of the Levites to appoint their brothers as the singers with instruments of song, stringed instruments, and harps, and cymbals, resounding to lift up the voice with joy. <verse eid="1CH 15:16"/></para>

<para style="p"><verse number="17" style="v" sid="1CH 15:17"/>And the Levites appointed Heman son of Joel; and of his brothers, Asaph son of Berechiah; and of the sons of Merari their brothers, Ethan son of Kushaiah; <verse eid="1CH 15:17"/></para>

<para style="p"><verse number="18" style="v" sid="1CH 15:18"/>and with them their brothers of the second <char style="add">rank</char>: Zechariah, and Jaaziel,<note caller="+" style="f"><char style="fr" closed="false">15.18 </char><char style="ft" closed="false"> Several Hebrew manuscripts and most LXX manuscripts (see also verse 20 and 1 Chronicles 16:5); most Hebrew manuscripts </char><char style="fq" closed="false">Zechariah son of Jaaziel</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">Zechariah, Ben, and Jaaziel</char><char style="ft" closed="false"> </char></note> and Shemiramoth, and Jehiel, and Unni, Eliab, and Benaiah, and Maaseiah, and Mattithiah, and Elipheleh, and Mikneiah, and Obed-edom and Jeiel the gatekeepers.<note caller="+" style="f"><char style="fr" closed="false">15.18 </char><char style="ft" closed="false"> Hebrew; some LXX manuscripts </char><char style="fq" closed="false">Obed-edom, Jeiel, and Azaziah</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">Obed-edom, Jeiel, and Ozias</char></note> <verse eid="1CH 15:18"/></para>

<para style="p"><verse number="19" style="v" sid="1CH 15:19"/>And the singers, Heman, Asaph, and Ethan, with cymbals of brass to sound; <verse eid="1CH 15:19"/></para>

<para style="p"><verse number="20" style="v" sid="1CH 15:20"/>and Zechariah, and Aziel, and Shemiramoth, and Jeheil, and Unni, and Eliab, and Maaseiah, and Benaiah, with strings according to Alamoth;<note caller="+" style="f"><char style="fr" closed="false">15.20 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Aziel</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Jaaziel</char><char style="ft" closed="false">; see verse 18.</char></note> <note caller="+" style="f"><char style="fr" closed="false">15.20 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Alamoth</char><char style="ft" closed="false"> is probably a musical or liturgical term; here and in Psalm 46:1.</char></note><verse eid="1CH 15:20"/></para>

<para style="p"><verse number="21" style="v" sid="1CH 15:21"/>and Mattithiah, and Elipheleh, and Mikneiah, and Obed-edom, and Jeiel, and Azaziah, with lyres according to Sheminith, to oversee. <note caller="+" style="f"><char style="fr" closed="false">15.21 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Sheminith</char><char style="ft" closed="false"> is probably a musical term; here and in Psalm 6:1 and Psalm 12:1.</char></note><verse eid="1CH 15:21"/></para>

<para style="p"><verse number="22" style="v" sid="1CH 15:22"/>And Chenaniah head of the Levites <char style="add">was</char> over the lifting up <char style="add">of song</char>; he instructed in the lifting up, because he <char style="add">was</char> skillful. <verse eid="1CH 15:22"/></para>

<para style="p"><verse number="23" style="v" sid="1CH 15:23"/>And Berechiah and Elkanah <char style="add">were</char> gatekeepers<note caller="+" style="f"><char style="fr" closed="false">15.23 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">guardians</char><char style="ft" closed="false">; also in verse 24</char></note> for the ark. <verse eid="1CH 15:23"/></para>

<para style="p"><verse number="24" style="v" sid="1CH 15:24"/>And Shebaniah, and Joshaphat, and Nethanel, and Amasai, and Zechariah, and Benaiah, and Eliezer the priests were to blow the trumpets before the face of the ark of God. And Obed-edom and Jehiah <char style="add">were</char> gatekeepers for the ark. <verse eid="1CH 15:24"/></para>

<para style="s">Moving the Ark to Jerusalem</para>

<para style="p"><verse number="25" style="v" sid="1CH 15:25"/>And it came to pass that David and the elders of Israel and the chiefs of the thousands went to bring up the ark of the covenant of YHWH from the house of Obed-edom with joy. <verse eid="1CH 15:25"/></para>

<para style="p"><verse number="26" style="v" sid="1CH 15:26"/>And it came to pass, in God helping the Levites who bore the ark of the covenant of YHWH, that they offered seven bulls and seven rams. <verse eid="1CH 15:26"/></para>

<para style="p"><verse number="27" style="v" sid="1CH 15:27"/>And David was wrapped in a robe of fine linen, and <char style="add">were</char> all the Levites who bore the ark, and the singers, and Chenaniah head of the lifting up of the singers. And on David <char style="add">was</char> an Ephod of linen. <verse eid="1CH 15:27"/></para>

<para style="p"><verse number="28" style="v" sid="1CH 15:28"/>And all Israel brought up the ark of the covenant of YHWH with shouting, and with the sound of the shofar, and with the trumpets, and with cymbals, making music with stringed instruments and harps. <verse eid="1CH 15:28"/></para>

<para style="s">Michal’s Contempt for David2 Samuel 6:16</para>

<para style="p"><verse number="29" style="v" sid="1CH 15:29"/>And it came to pass, <char style="add">as</char> the ark of the covenant of YHWH came to the City of David, that Michal daughter of Saul looked through the window and saw King David dancing and playing music; and she despised him in her heart. <verse eid="1CH 15:29"/></para>

<chapter eid="1CH 15"/>

<chapter number="16" style="c" sid="1CH 16"/>

<para style="s">A Tent for the Ark</para>

<para style="p"><verse number="1" style="v" sid="1CH 16:1"/><note caller="-" style="x"><char style="xt" closed="false">2 Samuel 6:17–19</char></note>And they brought the ark of God and set it in the midst of the tabernacle that David had erected for it, and they offered burnt offerings and peace offerings before the face of God. <verse eid="1CH 16:1"/></para>

<para style="p"><verse number="2" style="v" sid="1CH 16:2"/>And David had finished offering the burnt offerings and the peace offerings, and he blessed the people in the name of YHWH. <verse eid="1CH 16:2"/></para>

<para style="p"><verse number="3" style="v" sid="1CH 16:3"/>And he distributed to each man of Israel, from man and to woman, to everyone a cake of bread, and a date cake,<note caller="+" style="f"><char style="fr" closed="false">16.3 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">a portion of meat</char></note> and a raisin cake. <verse eid="1CH 16:3"/></para>

<para style="p"><verse number="4" style="v" sid="1CH 16:4"/>And he put before the face of the ark of YHWH some of the Levites to minister, and to commemorate, and to thank, and to praise YHWH, God of Israel: <verse eid="1CH 16:4"/></para>

<para style="p"><verse number="5" style="v" sid="1CH 16:5"/>Asaph <char style="add">was</char> the chief, and next to him Zechariah, Jeiel, and Shemiramoth, and Jehiel, and Mattithiah, and Eliab, and Benaiah, and Obed-edom, and Jeiel, with stringed instruments and harps; and Asaph sounded with cymbals. <verse eid="1CH 16:5"/></para>

<para style="p"><verse number="6" style="v" sid="1CH 16:6"/>And Benaiah and Jahaziel the priests regularly <char style="add">blew</char> the trumpets before the face of the ark of the covenant of God. <verse eid="1CH 16:6"/></para>

<para style="s">David’s Psalm of ThanksgivingPsalm 105:1–15</para>

<para style="p"><verse number="7" style="v" sid="1CH 16:7"/>On that day then David delivered at the beginning to give thanks to YHWH by the hand of Asaph and his brothers: <verse eid="1CH 16:7"/></para>

<para style="q1"><verse number="8" style="v" sid="1CH 16:8"/>“Give thanks to YHWH, Call upon His name, </para>

<para style="q2" vid="1CH 16:8">make known among the peoples His deeds. <verse eid="1CH 16:8"/></para>

<para style="q1"><verse number="9" style="v" sid="1CH 16:9"/>Sing to Him, sing praises to Him, </para>

<para style="q2" vid="1CH 16:9">tell of all His wonders. <verse eid="1CH 16:9"/></para>

<para style="q1"><verse number="10" style="v" sid="1CH 16:10"/>Glory in His holy name; </para>

<para style="q2" vid="1CH 16:10">let rejoice the hearts of those seeking YHWH. <verse eid="1CH 16:10"/></para>

<para style="q1"><verse number="11" style="v" sid="1CH 16:11"/>Seek YHWH and His strength, </para>

<para style="q2" vid="1CH 16:11">Seek His face continually. <verse eid="1CH 16:11"/></para>

<para style="q1"><verse number="12" style="v" sid="1CH 16:12"/>Remember His wonders that He has done, </para>

<para style="q2" vid="1CH 16:12">His wonders and the ordinances of His mouth, <verse eid="1CH 16:12"/></para>

<para style="q1"><verse number="13" style="v" sid="1CH 16:13"/>O seed of Israel His servant, </para>

<para style="q2" vid="1CH 16:13">O sons of Jacob, His chosen ones. <verse eid="1CH 16:13"/></para>

<para style="q1"><verse number="14" style="v" sid="1CH 16:14"/>He <char style="add">is</char> YHWH our God; </para>

<para style="q2" vid="1CH 16:14">in all the earth <char style="add">are</char> His judgments. <verse eid="1CH 16:14"/></para>

<para style="q1"><verse number="15" style="v" sid="1CH 16:15"/>Remember<note caller="+" style="f"><char style="fr" closed="false">16.15 </char><char style="ft" closed="false"> Hebrew; some LXX manuscripts </char><char style="fq" closed="false">He remembers</char><char style="ft" closed="false">; see Psalm 105:8.</char></note> His covenant forever, </para>

<para style="q2" vid="1CH 16:15">the word He commanded to a thousand generations— <verse eid="1CH 16:15"/></para>

<para style="q1"><verse number="16" style="v" sid="1CH 16:16"/>that He made with Abraham, </para>

<para style="q2" vid="1CH 16:16">and His oath to Isaac. <verse eid="1CH 16:16"/></para>

<para style="q1"><verse number="17" style="v" sid="1CH 16:17"/>And He confirmed it to Jacob for a statute, </para>

<para style="q2" vid="1CH 16:17">to Israel <char style="add">as</char> an everlasting covenant, <verse eid="1CH 16:17"/></para>

<para style="q1"><verse number="18" style="v" sid="1CH 16:18"/>saying, ‘To you I will give the land of Canaan </para>

<para style="q2" vid="1CH 16:18">as the portion of your⁺ inheritance.’ <verse eid="1CH 16:18"/></para>

<para style="q1"><verse number="19" style="v" sid="1CH 16:19"/>When you⁺ were few in number, </para>

<para style="q2" vid="1CH 16:19">indeed few, and sojourners in it, <verse eid="1CH 16:19"/></para>

<para style="q1"><verse number="20" style="v" sid="1CH 16:20"/>then they wandered from nation to nation </para>

<para style="q2" vid="1CH 16:20">and from a kingdom to another people. <verse eid="1CH 16:20"/></para>

<para style="q1"><verse number="21" style="v" sid="1CH 16:21"/>He permitted no man to oppress them, </para>

<para style="q2" vid="1CH 16:21">and He rebuked kings on their behalf: <verse eid="1CH 16:21"/></para>

<para style="q1"><verse number="22" style="v" sid="1CH 16:22"/>‘Do not touch My anointed ones, </para>

<para style="q2" vid="1CH 16:22">and My prophets do not harm.’ <verse eid="1CH 16:22"/></para>

<para style="s">Sing to Yahweh, All the EarthPsalm 96:1–13</para>

<para style="q1"><verse number="23" style="v" sid="1CH 16:23"/>Sing to YHWH, all the earth. </para>

<para style="q2" vid="1CH 16:23">Proclaim His salvation day after day. <verse eid="1CH 16:23"/></para>

<para style="q1"><verse number="24" style="v" sid="1CH 16:24"/>Declare among the nations His glory, </para>

<para style="q2" vid="1CH 16:24">among all the peoples His wonders. <verse eid="1CH 16:24"/></para>

<para style="q1"><verse number="25" style="v" sid="1CH 16:25"/>For great is YHWH, and greatly to be praised; </para>

<para style="q2" vid="1CH 16:25">and He <char style="add">is</char> to be feared above all gods. <verse eid="1CH 16:25"/></para>

<para style="q1"><verse number="26" style="v" sid="1CH 16:26"/>For all the gods of the peoples <char style="add">are</char> nothing, </para>

<para style="q2" vid="1CH 16:26">and YHWH made the heavens. <verse eid="1CH 16:26"/></para>

<para style="q1"><verse number="27" style="v" sid="1CH 16:27"/>Honor and majesty <char style="add">are</char> before Him, </para>

<para style="q2" vid="1CH 16:27">strength and joy in His place. <verse eid="1CH 16:27"/></para>

<para style="q1"><verse number="28" style="v" sid="1CH 16:28"/>Give to YHWH, O families of peoples, </para>

<para style="q2" vid="1CH 16:28">Ascribe to YHWH glory and strength. <verse eid="1CH 16:28"/></para>

<para style="q1"><verse number="29" style="v" sid="1CH 16:29"/>Ascribe to YHWH the honor of His name; </para>

<para style="q2" vid="1CH 16:29">bring an offering and come before His face. </para>

<para style="q1" vid="1CH 16:29">Worship YHWH in the beauty of holiness; <verse eid="1CH 16:29"/></para>

<para style="q2"><verse number="30" style="v" sid="1CH 16:30"/>tremble before Him all the earth. </para>

<para style="q1" vid="1CH 16:30">Indeed the world is firmly established; </para>

<para style="q2" vid="1CH 16:30">it shall not be moved. <verse eid="1CH 16:30"/></para>

<para style="q1"><verse number="31" style="v" sid="1CH 16:31"/>Let the heavens rejoice </para>

<para style="q2" vid="1CH 16:31">and let the earth be glad, </para>

<para style="q1" vid="1CH 16:31">and let them say among the nations, </para>

<para style="q2" vid="1CH 16:31">‘YHWH reigns.’ <verse eid="1CH 16:31"/></para>

<para style="q1"><verse number="32" style="v" sid="1CH 16:32"/>Let the sea roar </para>

<para style="q2" vid="1CH 16:32">and all its fullness; </para>

<para style="q1" vid="1CH 16:32">let the field rejoice </para>

<para style="q2" vid="1CH 16:32">and all that <char style="add">is</char> in it. <verse eid="1CH 16:32"/></para>

<para style="q1"><verse number="33" style="v" sid="1CH 16:33"/>Then the trees of the forest shall rejoice before YHWH, </para>

<para style="q2" vid="1CH 16:33">for He is coming to judge the earth. <verse eid="1CH 16:33"/></para>

<para style="q1"><verse number="34" style="v" sid="1CH 16:34"/>Give thanks to YHWH, for <char style="add">He is</char> good; </para>

<para style="q2" vid="1CH 16:34">His loving devotion<note caller="+" style="f"><char style="fr" closed="false">16.34 </char><char style="ft" closed="false"> Forms of the Hebrew </char><char style="fq" closed="false">chesed</char><char style="ft" closed="false"> are translated here and in most cases throughout the Scriptures as </char><char style="fq" closed="false">loving devotion</char><char style="ft" closed="false">; the range of meaning includes </char><char style="fq" closed="false">love</char><char style="ft" closed="false">, </char><char style="fq" closed="false">goodness</char><char style="ft" closed="false">, </char><char style="fq" closed="false">kindness</char><char style="ft" closed="false">, </char><char style="fq" closed="false">faithfulness</char><char style="ft" closed="false">, and </char><char style="fq" closed="false">mercy</char><char style="ft" closed="false">, as well as </char><char style="fq" closed="false">loyalty to a covenant</char><char style="ft" closed="false">.</char></note> <char style="add">is</char> even to forever. <verse eid="1CH 16:34"/></para>

<para style="q1"><verse number="35" style="v" sid="1CH 16:35"/>And say, ‘Save us, O God of our salvation, </para>

<para style="q2" vid="1CH 16:35">and Gather us together, and snatch us up from the Gentiles, </para>

<para style="q1" vid="1CH 16:35">to give thanks to Your holy name, </para>

<para style="q2" vid="1CH 16:35">to glory in Your praise.’ <verse eid="1CH 16:35"/></para>

<para style="q1"><verse number="36" style="v" sid="1CH 16:36"/>Blessed <char style="add">be</char> YHWH, God of Israel, </para>

<para style="q2" vid="1CH 16:36">from everlasting and to everlasting.” </para>

<para style="p" vid="1CH 16:36">And all the people said, “Amen,” and praised YHWH. <verse eid="1CH 16:36"/></para>

<para style="s">Worship before the Ark</para>

<para style="p"><verse number="37" style="v" sid="1CH 16:37"/>And he left there before the face of the ark of the covenant of YHWH Asaph and his brothers, to minister before the face of the ark regularly, according to the matter of a day in its day, <verse eid="1CH 16:37"/></para>

<para style="p"><verse number="38" style="v" sid="1CH 16:38"/>and Obed-edom and their brothers, sixty-eight, and Obed-edom son of Jeduthun and Hosah <char style="add">to be</char> gatekeepers, <verse eid="1CH 16:38"/></para>

<para style="p"><verse number="39" style="v" sid="1CH 16:39"/>and Zadok the priest and his brothers the priests before the tabernacle of YHWH at the high place that <char style="add">was</char> in Gibeon, <verse eid="1CH 16:39"/></para>

<para style="p"><verse number="40" style="v" sid="1CH 16:40"/>to offer burnt offerings to YHWH on the altar of the burnt offering regularly morning and evening, and for all that is written in the Law of YHWH, which He commanded upon Israel, <verse eid="1CH 16:40"/></para>

<para style="p"><verse number="41" style="v" sid="1CH 16:41"/>and with them Heman and Jeduthun and the rest of those chosen, who were designated by name to give thanks to YHWH, because “His loving devotion <char style="add">is</char> forever.” <verse eid="1CH 16:41"/></para>

<para style="p"><verse number="42" style="v" sid="1CH 16:42"/>And with them <char style="add">were</char> Heman and Jeduthun with trumpets and cymbals to sound aloud, and the instruments of the song of God.<note caller="+" style="f"><char style="fr" closed="false">16.42 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">instruments for the sacred music</char></note> And the sons of Jeduthun <char style="add">were</char> the gatekeepers. <verse eid="1CH 16:42"/></para>

<para style="p"><verse number="43" style="v" sid="1CH 16:43"/>And all the people departed, every man to his house, and David returned to bless his house. <verse eid="1CH 16:43"/></para>

<chapter eid="1CH 16"/>

<chapter number="17" style="c" sid="1CH 17"/>

<para style="s">God’s Covenant with David</para>

<para style="p"><verse number="1" style="v" sid="1CH 17:1"/><note caller="-" style="x"><char style="xt" closed="false">2 Samuel 7:1–17</char></note>And it came to pass, as David was dwelling in his house, that David said to Nathan the prophet, “Behold, I dwell in a house of cedars, and the ark of the covenant of YHWH <char style="add">is</char> under curtains.” <verse eid="1CH 17:1"/></para>

<para style="p"><verse number="2" style="v" sid="1CH 17:2"/>And Nathan said to David, “All that <char style="add">is</char> in your heart, do, for God <char style="add">is</char> with you.” <verse eid="1CH 17:2"/></para>

<para style="p"><verse number="3" style="v" sid="1CH 17:3"/>And it came to pass in that night, that the word of God came to Nathan, saying, <verse eid="1CH 17:3"/></para>

<para style="p"><verse number="4" style="v" sid="1CH 17:4"/>“Go and tell unto David My servant, thus says YHWH: You shall not build Me a house to dwell in. <verse eid="1CH 17:4"/></para>

<para style="p"><verse number="5" style="v" sid="1CH 17:5"/>For I have not dwelt in a house since the time that I brought up Israel <char style="add">out of Egypt</char>,<note caller="+" style="f"><char style="fr" closed="false">17.5 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Out of Egypt</char><char style="ft" closed="false"> is implied, but not included in the Hebrew; see 2 Samuel 7:6.</char></note> even to this day, and I have been from tent to tent, and from the Dwelling Place. <verse eid="1CH 17:5"/></para>

<para style="p"><verse number="6" style="v" sid="1CH 17:6"/>In all where I have walked among all Israel, have I ever spoken a word to one of the leaders<note caller="+" style="f"><char style="fr" closed="false">17.6 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">judges</char><char style="ft" closed="false">; see verse 10.</char></note> of Israel whom I commanded to shepherd My people, saying, ‘Why have you⁺ not built for Me a house of cedars?’ <verse eid="1CH 17:6"/></para>

<para style="p"><verse number="7" style="v" sid="1CH 17:7"/>And now, thus shall you say to My servant David: Thus says YHWH of Hosts: I took you from the sheepfold, from after the sheep, to be ruler over My people Israel. <verse eid="1CH 17:7"/></para>

<para style="p"><verse number="8" style="v" sid="1CH 17:8"/>And I have been with you in all to which you have gone, and I have cut off all your enemies from before your face, and I will make for you a name like the name of the great men who <char style="add">are</char> on the earth. <verse eid="1CH 17:8"/></para>

<para style="p"><verse number="9" style="v" sid="1CH 17:9"/>And I will set a place for My people Israel, and I will plant them, and they will settle in their place, and they shall not be disturbed anymore, nor shall the sons of wickedness oppress them anymore as at the beginning <verse eid="1CH 17:9"/></para>

<para style="p"><verse number="10" style="v" sid="1CH 17:10"/>and since the days that I appointed judges over My people Israel. And I will subdue all your enemies. And I declare to you that YHWH will build a house for you. <verse eid="1CH 17:10"/></para>

<para style="p"><verse number="11" style="v" sid="1CH 17:11"/>And it shall come to pass, when your days are fulfilled and you go with your fathers, that I will raise up your seed after you who will be from your sons, and I will establish his kingdom. <verse eid="1CH 17:11"/></para>

<para style="p"><verse number="12" style="v" sid="1CH 17:12"/>He will build for Me a house, and I will establish his throne even to forever. <verse eid="1CH 17:12"/></para>

<para style="p"><verse number="13" style="v" sid="1CH 17:13"/>I will be his Father, and he will be My son. And My loving devotion I will not turn aside from him as I turned it aside from <char style="add">him</char> who was before you. <verse eid="1CH 17:13"/></para>

<para style="p"><verse number="14" style="v" sid="1CH 17:14"/>And I will establish him in My house and in My kingdom even to forever, and his throne will be established even to forever.” <verse eid="1CH 17:14"/></para>

<para style="p"><verse number="15" style="v" sid="1CH 17:15"/>According to all these words and according to all this vision, so spoke Nathan to David. <verse eid="1CH 17:15"/></para>

<para style="s">David’s Prayer of Thanksgiving2 Samuel 7:18–29</para>

<para style="p"><verse number="16" style="v" sid="1CH 17:16"/>And King David went in and sat before the face of YHWH, and he said, “Who <char style="add">am</char> I, O YHWH God, and what <char style="add">is</char> my house, that You have brought me as far as here? <verse eid="1CH 17:16"/></para>

<para style="p"><verse number="17" style="v" sid="1CH 17:17"/>And this was a small thing in your eyes, O God, and You have spoken of the house of Your servant afar off, and have regarded me as a type of the man on high,<note caller="+" style="f"><char style="fr" closed="false">17.17 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">and have shown me future generations</char></note> O YHWH God. <verse eid="1CH 17:17"/></para>

<para style="p"><verse number="18" style="v" sid="1CH 17:18"/>What more can David <char style="add">say</char> to You for the honor of Your servant? For You know Your servant. <verse eid="1CH 17:18"/></para>

<para style="p"><verse number="19" style="v" sid="1CH 17:19"/>O YHWH,<note caller="+" style="f"><char style="fr" closed="false">17.19 </char><char style="ft" closed="false"> See 2 Samuel 7:20; many translators </char><char style="fq" closed="false">18</char><char style="fq" closed="false"> ...For You know Your servant. </char><char style="fq" closed="false">19</char><char style="fq" closed="false"> O LORD,</char></note> For the sake of Your servant and according to Your own heart You have done all this greatness, in making known all these great <char style="add">things</char>. <verse eid="1CH 17:19"/></para>

<para style="p"><verse number="20" style="v" sid="1CH 17:20"/>O YHWH, none <char style="add">is</char> like You, and <char style="add">there is</char> no God besides You, according to all that we have heard with our ears. <verse eid="1CH 17:20"/></para>

<para style="p"><verse number="21" style="v" sid="1CH 17:21"/>And who <char style="add">is</char> like Your people Israel, the one nation on the earth whom God went to redeem for Himself <char style="add">as</char> a people, to make for Yourself a great name and to be feared, to drive out nations from before Your people whom You redeemed from Egypt. <verse eid="1CH 17:21"/></para>

<para style="p"><verse number="22" style="v" sid="1CH 17:22"/>For You have made Your people Israel Your very own people even to forever, and You, O YHWH, have become to them God. <verse eid="1CH 17:22"/></para>

<para style="p"><verse number="23" style="v" sid="1CH 17:23"/>And now, O YHWH, the word that You have spoken concerning Your servant and concerning his house, may it be confirmed even to forever, and do as You have spoken. <verse eid="1CH 17:23"/></para>

<para style="p"><verse number="24" style="v" sid="1CH 17:24"/>And may Your name be confirmed, even magnified, forever, saying, ‘YHWH of Hosts, the God of Israel, <char style="add">is</char> God to Israel.’ And may the house of Your servant David be established before You. <verse eid="1CH 17:24"/></para>

<para style="p"><verse number="25" style="v" sid="1CH 17:25"/>For You, my God, have uncovered the ear to Your servant, that You will build for him a house. Upon thus Your servant has found it to pray before You. <verse eid="1CH 17:25"/></para>

<para style="p"><verse number="26" style="v" sid="1CH 17:26"/>And now, O YHWH, You are God, and You spoke to Your servant this goodness. <verse eid="1CH 17:26"/></para>

<para style="p"><verse number="27" style="v" sid="1CH 17:27"/>And You have been pleased to bless the house of Your servant, that it may be forever before You. For You, O YHWH, have blessed it, and it will be blessed forever.” <verse eid="1CH 17:27"/></para>

<chapter eid="1CH 17"/>

<chapter number="18" style="c" sid="1CH 18"/>

<para style="s">David’s Triumphs</para>

<para style="p"><verse number="1" style="v" sid="1CH 18:1"/><note caller="-" style="x"><char style="xt" closed="false">Psalm 60:1–12</char></note><note caller="-" style="x"><char style="xt" closed="false">2 Samuel 8:1–14</char></note>And it came to pass after this that David struck the Philistines and subdued them, and he took Gath and its daughters from the hand of the Philistines. <verse eid="1CH 18:1"/></para>

<para style="p"><verse number="2" style="v" sid="1CH 18:2"/>And he defeated Moab, and the Moabites became servants of David, bringing tribute. <verse eid="1CH 18:2"/></para>

<para style="p"><verse number="3" style="v" sid="1CH 18:3"/>And David defeated Hadadezer king of Zobah <char style="add">as far as</char> Hamath in his going to establish his hand by the river Euphrates. <verse eid="1CH 18:3"/></para>

<para style="p"><verse number="4" style="v" sid="1CH 18:4"/>And David took from him a thousand chariots, and seven thousand horsemen, and twenty thousand soldiers on foot, and David hamstrung all the chariots and left of them a hundred chariots. <verse eid="1CH 18:4"/></para>

<para style="p"><verse number="5" style="v" sid="1CH 18:5"/>And the Aramaeans of Damascus came to help Hadadezer king of Zobah, and David struck down twenty-two thousand men of Aram. <verse eid="1CH 18:5"/></para>

<para style="p"><verse number="6" style="v" sid="1CH 18:6"/>And David placed <char style="add">garrisons</char> in Aram of Damascus, and Aram became servants of David, bearing tribute, and YHWH preserved David<note caller="+" style="f"><char style="fr" closed="false">18.6 </char><char style="ft" closed="false"> LXX and Vulgate (see also 2 Samuel 8:6 and Syriac); Hebrew does not include </char><char style="fq" closed="false">garrisons</char><char style="ft" closed="false">.</char></note> in all to which he went. <note caller="+" style="f"><char style="fr" closed="false">18.6 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">YHWH saved David</char><char style="ft" closed="false">; also in verse 13</char></note><verse eid="1CH 18:6"/></para>

<para style="p"><verse number="7" style="v" sid="1CH 18:7"/>And David took the shields of gold that were on the servants of Hadadezer, and he brought them to Jerusalem. <verse eid="1CH 18:7"/></para>

<para style="p"><verse number="8" style="v" sid="1CH 18:8"/>And from Tibhath and from Chun, cities of Hadadezer, David brought a large amount of bronze with which Solomon made the bronze Sea, and the pillars, and the articles of bronze. <note caller="+" style="f"><char style="fr" closed="false">18.8 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Tibhath</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Tebah</char><char style="ft" closed="false">; see 2 Samuel 8:8 LXX.</char></note><verse eid="1CH 18:8"/></para>

<para style="p"><verse number="9" style="v" sid="1CH 18:9"/>And Tou king of Hamath heard that David had defeated all the army of Hadadezer king of Zobah, <note caller="+" style="f"><char style="fr" closed="false">18.9 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Tou</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Toi</char><char style="ft" closed="false">; also in verse 10; see 2 Samuel 8:9.</char></note><verse eid="1CH 18:9"/></para>

<para style="p"><verse number="10" style="v" sid="1CH 18:10"/>and he sent Hadoram his son to King David to ask of him peace and to bless him, upon that he had fought against Hadadezer and struck him. For Hadadezer had been a man at war with Tou, and <char style="add">he had</char> all kinds of articles of gold and silver and bronze. <note caller="+" style="f"><char style="fr" closed="false">18.10 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Hadoram</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Joram</char><char style="ft" closed="false">; see 2 Samuel 8:10.</char></note><verse eid="1CH 18:10"/></para>

<para style="p"><verse number="11" style="v" sid="1CH 18:11"/>These also King David dedicated to YHWH, along with the silver and the gold that he had brought from all the nations—from Edom, and from Moab, and from the sons of Ammon, and from the Philistines, and from Amalek. <verse eid="1CH 18:11"/></para>

<para style="p"><verse number="12" style="v" sid="1CH 18:12"/>And Abishai son of Zeruiah struck Edom in the Valley of Salt—eighteen thousand. <verse eid="1CH 18:12"/></para>

<para style="p"><verse number="13" style="v" sid="1CH 18:13"/>And He put in Edom garrisons, and all Edom became servants of David. And YHWH saved David in all to which he went. <verse eid="1CH 18:13"/></para>

<para style="s">David’s Officers2 Samuel 8:15–18</para>

<para style="p"><verse number="14" style="v" sid="1CH 18:14"/>And David reigned over all Israel, and it came to pass <char style="add">that</char> he was doing judgment and justice to all his people. <verse eid="1CH 18:14"/></para>

<para style="q1"><verse number="15" style="v" sid="1CH 18:15"/>And Joab son of Zeruiah <char style="add">was</char> over the army; </para>

<para style="q1" vid="1CH 18:15">and Jehoshaphat son of Ahilud <char style="add">was</char> recorder; <verse eid="1CH 18:15"/></para>

<para style="q1"><verse number="16" style="v" sid="1CH 18:16"/>and Zadok son of Ahitub and Ahimelech son of Abiathar <char style="add">were</char> priests; </para>

<para style="q1" vid="1CH 18:16">and Shavsha<note caller="+" style="f"><char style="fr" closed="false">18.16 </char><char style="ft" closed="false"> Some Hebrew manuscripts, Vulgate, and Syriac (see also 2 Samuel 8:17); most Hebrew manuscripts </char><char style="fq" closed="false">Abimelech</char></note> <char style="add">was</char> scribe; <note caller="+" style="f"><char style="fr" closed="false">18.16 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Shavsha</char><char style="ft" closed="false"> is also called </char><char style="fq" closed="false">Seraiah</char><char style="ft" closed="false">, </char><char style="fq" closed="false">Sheva</char><char style="ft" closed="false">, and </char><char style="fq" closed="false">Shisha</char><char style="ft" closed="false">; see 2 Samuel 8:17, 2 Samuel 20:25, and 1 Kings 4:3.</char></note><verse eid="1CH 18:16"/></para>

<para style="q1"><verse number="17" style="v" sid="1CH 18:17"/>and Benaiah son of Jehoiada <char style="add">was</char> over the Cherethites and the Pelethites; </para>

<para style="q1" vid="1CH 18:17">and the sons of David <char style="add">were</char> the chief ministers at the side of the king. <verse eid="1CH 18:17"/></para>

<chapter eid="1CH 18"/>

<chapter number="19" style="c" sid="1CH 19"/>

<para style="s">David’s Messengers Disgraced</para>

<para style="p"><verse number="1" style="v" sid="1CH 19:1"/><note caller="-" style="x"><char style="xt" closed="false">2 Samuel 10:1–8</char></note>And it came to pass after this, that Nahash the king of the sons of Ammon died, and his son reigned in his place. <verse eid="1CH 19:1"/></para>

<para style="p"><verse number="2" style="v" sid="1CH 19:2"/>And David said, “I will show kindness to Hanun son of Nahash, because his father showed kindness to me.” And David sent messengers to comfort him concerning his father, and the servants of David came to the land of the sons of Ammon to Hanun, to comfort him. <verse eid="1CH 19:2"/></para>

<para style="p"><verse number="3" style="v" sid="1CH 19:3"/>And the princes of the sons of Ammon said to Hanun, “Is David honoring your father in your eyes because he has sent to you comforters? Is <char style="add">it</char> not in order to search out and to overthrow and to spy out the land that his servants have come to you?” <verse eid="1CH 19:3"/></para>

<para style="p"><verse number="4" style="v" sid="1CH 19:4"/>And Hanun took the servants of David and shaved them and cut off their garments in the middle at their buttocks, and he sent them away. <verse eid="1CH 19:4"/></para>

<para style="p"><verse number="5" style="v" sid="1CH 19:5"/>And <char style="add">some</char> went and declared to David concerning the men, and he sent to meet them because the men were greatly ashamed. And the king said, “Dwell at Jericho until that your⁺ beards have grown; and return.” <verse eid="1CH 19:5"/></para>

<para style="p"><verse number="6" style="v" sid="1CH 19:6"/>And the sons of Ammon saw that they were a stench to David, and Hanun and the sons of Ammon sent a thousand talents of silver<note caller="+" style="f"><char style="fr" closed="false">19.6 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">1,000 talents</char><char style="ft" closed="false"> is approximately 37.7 tons or 34.2 metric tons of silver.</char></note> to hire for themselves from Aram-naharaim,<note caller="+" style="f"><char style="fr" closed="false">19.6 </char><char style="ft" closed="false"> That is, Mesopotamia; </char><char style="fq" closed="false">Aram-naharaim</char><char style="ft" closed="false"> means </char><char style="fq" closed="false">Aram of the two rivers</char><char style="ft" closed="false">, likely the region between the Euphrates and Balih Rivers in northwestern Mesopotamia.</char></note> and from Aram-maacah, and from Zobah, chariots and horsemen. <verse eid="1CH 19:6"/></para>

<para style="p"><verse number="7" style="v" sid="1CH 19:7"/>And they hired for themselves two and thirty thousand chariots, and the king of Maacah and his people, and they came in and encamped before the face of Medeba. And the sons of Ammon gathered together from their cities and came in to the battle. <verse eid="1CH 19:7"/></para>

<para style="p"><verse number="8" style="v" sid="1CH 19:8"/>And David heard, and he sent Joab and all the host of the mighty men. <verse eid="1CH 19:8"/></para>

<para style="p"><verse number="9" style="v" sid="1CH 19:9"/>And the sons of Ammon came out for battle and arrayed themselves before the gate of the city, and the kings who had come <char style="add">were</char> by themselves in the field. <verse eid="1CH 19:9"/></para>

<para style="s">David Defeats Ammon and Aram2 Samuel 10:9–19</para>

<para style="p"><verse number="10" style="v" sid="1CH 19:10"/>And Joab saw that the front of the battle was to him before and behind, and he chose some of the choice in Israel, and he arrayed against Aram. <verse eid="1CH 19:10"/></para>

<para style="p"><verse number="11" style="v" sid="1CH 19:11"/>And the rest of the people he put under the command of Abishai his brother, and they arrayed against the sons of Ammon. <verse eid="1CH 19:11"/></para>

<para style="p"><verse number="12" style="v" sid="1CH 19:12"/>And he said, “If Aram is too strong for me, you shall be to me for salvation. And if the sons of Ammon are too strong for you, then I will save you. <verse eid="1CH 19:12"/></para>

<para style="p"><verse number="13" style="v" sid="1CH 19:13"/>Be strong, and let us strengthen ourselves for our people and for the cities of our God. And YHWH shall do good in His sight.” <verse eid="1CH 19:13"/></para>

<para style="p"><verse number="14" style="v" sid="1CH 19:14"/>And Joab drew near, and the people who <char style="add">were</char> with him, against Aram to battle; and they fled from his face. <verse eid="1CH 19:14"/></para>

<para style="p"><verse number="15" style="v" sid="1CH 19:15"/>And the sons of Ammon saw that Aram was fleeing, and fled they also before Abishai his brother and entered the city. And Joab went to Jerusalem. <verse eid="1CH 19:15"/></para>

<para style="p"><verse number="16" style="v" sid="1CH 19:16"/>And Aram saw that they had been struck by Israel, and they sent messengers and brought out Aram which <char style="add">was</char> beyond the River, and Shophach<note caller="+" style="f"><char style="fr" closed="false">19.16 </char><char style="ft" closed="false"> That is, </char><char style="fq" closed="false">the Euphrates</char></note> the commander of the army of Hadadezer before them. <note caller="+" style="f"><char style="fr" closed="false">19.16 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Shophach</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Shobach</char><char style="ft" closed="false">; also in verse 18; see 2 Samuel 10:16.</char></note><verse eid="1CH 19:16"/></para>

<para style="p"><verse number="17" style="v" sid="1CH 19:17"/>And it was declared to David, and he gathered all Israel and passed over the Jordan, and he came toward them and arrayed against them. And David arrayed in battle against Aram, and they fought with him. <verse eid="1CH 19:17"/></para>

<para style="p"><verse number="18" style="v" sid="1CH 19:18"/>And Aram fled before Israel, and David killed of Aram seven thousand charioteers and forty thousand soldiers on foot. And he killed Shophach the commander of the army. <verse eid="1CH 19:18"/></para>

<para style="p"><verse number="19" style="v" sid="1CH 19:19"/>And the servants of Hadadezer saw that they were defeated by Israel, and they made peace with David and became his servants. And Aram was not willing to help the people of Ammon anymore. <verse eid="1CH 19:19"/></para>

<chapter eid="1CH 19"/>

<chapter number="20" style="c" sid="1CH 20"/>

<para style="s">The Capture of Rabbah</para>

<para style="p"><verse number="1" style="v" sid="1CH 20:1"/><note caller="-" style="x"><char style="xt" closed="false">2 Samuel 12:26–31</char></note>And it happened, at the time of the return of the year,<note caller="+" style="f"><char style="fr" closed="false">20.1 </char><char style="ft" closed="false"> That is </char><char style="fq" closed="false">in the spring of the year</char></note> at the time of the going out of the kings, that Joab led out the force of the host and destroyed the land of the sons of Ammon, and he came in and besieged Rabbah. And David stayed at Jerusalem. And Joab defeated Rabbah and overthrew it. <verse eid="1CH 20:1"/></para>

<para style="p"><verse number="2" style="v" sid="1CH 20:2"/>And David took the crown of their king<note caller="+" style="f"><char style="fr" closed="false">20.2 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">of Milcom</char><char style="ft" closed="false">. Milcom, also called Molech, was god of the Ammonites; see Leviticus 18:21 and 1 Kings 11:7.</char></note> from off his head, and he found it to weigh a talent of gold,<note caller="+" style="f"><char style="fr" closed="false">20.2 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">A talent</char><char style="ft" closed="false"> is approximately 75.4 pounds or 34.2 kilograms of gold.</char></note> and in it <char style="add">were</char> precious stones, and it was on the head of David. And the plunder of the city he brought out in great abundance. <verse eid="1CH 20:2"/></para>

<para style="p"><verse number="3" style="v" sid="1CH 20:3"/>And the people who <char style="add">were</char> in it he brought out, and they sawed<note caller="+" style="f"><char style="fr" closed="false">20.3 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">cut them</char></note> with the saws, and with the iron picks, and with the axes. Thus David did to all the cities of the sons of Ammon. And David returned, and all the people, <char style="add">to</char> Jerusalem. <verse eid="1CH 20:3"/></para>

<para style="s">Battles against the Philistines2 Samuel 21:15–22</para>

<para style="p"><verse number="4" style="v" sid="1CH 20:4"/>And it came to pass afterward that war broke out in Gezer with the Philistines. At that time Sibbechai the Hushathite killed Sippai<note caller="+" style="f"><char style="fr" closed="false">20.4 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Sippai</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Saph</char><char style="ft" closed="false">; see 2 Samuel 21:18.</char></note> of the sons of the Rephaim,<note caller="+" style="f"><char style="fr" closed="false">20.4 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">of the giants</char><char style="ft" closed="false">; see also </char><char style="fq" closed="false">descendants of Rapha</char><char style="ft" closed="false"> in verses 6 and 8.</char></note> and they were subdued. <verse eid="1CH 20:4"/></para>

<para style="p"><verse number="5" style="v" sid="1CH 20:5"/>And there was again war with the Philistines, and Elhanan son of Jair killed Lahmi the brother of Goliath the Gittite, and the shaft of his spear <char style="add">was</char> was like a beam of a weaver. <note caller="+" style="f"><char style="fr" closed="false">20.5 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">Elhanan son of Jair the Bethlehemite killed the brother</char><char style="ft" closed="false">; see 2 Samuel 21:19.</char></note><verse eid="1CH 20:5"/></para>

<para style="p"><verse number="6" style="v" sid="1CH 20:6"/>And there was again war in Gath, where there was a man of stature with digits six and six—twenty-four. And he was born also of Rapha. <verse eid="1CH 20:6"/></para>

<para style="p"><verse number="7" style="v" sid="1CH 20:7"/>And he defied Israel, and killed him Jonathan son of Shimea brother of David. <verse eid="1CH 20:7"/></para>

<para style="p"><verse number="8" style="v" sid="1CH 20:8"/>These were born of Rapha in Gath, and they fell by the hand of David and by the hand of his servants. <verse eid="1CH 20:8"/></para>

<chapter eid="1CH 20"/>

<chapter number="21" style="c" sid="1CH 21"/>

<para style="s">David’s Military Census</para>

<para style="p"><verse number="1" style="v" sid="1CH 21:1"/><note caller="-" style="x"><char style="xt" closed="false">2 Samuel 24:1–9</char></note><note caller="-" style="x"><char style="xt" closed="false">Exodus 30:11–16</char></note>And Satan<note caller="+" style="f"><char style="fr" closed="false">21.1 </char><char style="ft" closed="false"> That is, </char><char style="fq" closed="false">the Accuser</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">the Adversary</char></note> stood up against Israel and incited David to number Israel. <verse eid="1CH 21:1"/></para>

<para style="p"><verse number="2" style="v" sid="1CH 21:2"/>And David said to Joab and to the heads of the people, “Go, number Israel from Beersheba and as far as Dan and bring <char style="add">it</char> to me, that I may know their number.” <verse eid="1CH 21:2"/></para>

<para style="p"><verse number="3" style="v" sid="1CH 21:3"/>And Joab answered, “May YHWH add to His people as they <char style="add">are</char> a hundred times. Are <char style="add">they</char> not, my lord O king, all of them for my lord as servants? Why does my lord require this? Why should he be a cause of guilt in Israel?” <verse eid="1CH 21:3"/></para>

<para style="p"><verse number="4" style="v" sid="1CH 21:4"/>And the word of the king was strengthened against Joab, and Joab went out and went throughout all Israel, and he came to Jerusalem. <verse eid="1CH 21:4"/></para>

<para style="p"><verse number="5" style="v" sid="1CH 21:5"/>And Joab gave the account of the number of the people to David. And all Israel <char style="add">had</char> a thousand thousands and a hundred thousand men who drew the sword, and Judah <char style="add">had</char> four hundred and seventy thousand men who drew the sword. <verse eid="1CH 21:5"/></para>

<para style="p"><verse number="6" style="v" sid="1CH 21:6"/>And Levi and Benjamin he did not count in their midst, for the word of the king was abominable to Joab. <verse eid="1CH 21:6"/></para>

<para style="s">Judgment for David’s Sin2 Samuel 24:10–14</para>

<para style="p"><verse number="7" style="v" sid="1CH 21:7"/>And it was evil in the eyes of God concerning this thing, and He struck Israel. <verse eid="1CH 21:7"/></para>

<para style="p"><verse number="8" style="v" sid="1CH 21:8"/>And David said to God, “I have sinned greatly because I have done this thing. And take away, please, the iniquity of Your servant, for I have acted very foolishly.” <verse eid="1CH 21:8"/></para>

<para style="p"><verse number="9" style="v" sid="1CH 21:9"/>And YHWH spoke to Gad, seer of David, saying, <verse eid="1CH 21:9"/></para>

<para style="p"><verse number="10" style="v" sid="1CH 21:10"/>“Go and declare to David, saying, thus says YHWH: ‘Three <char style="add">things</char> I offer to you; choose for yourself one of them, that I may do <char style="add">it</char> to you.’” <verse eid="1CH 21:10"/></para>

<para style="p"><verse number="11" style="v" sid="1CH 21:11"/>And Gad came to David and said to him, “Thus says YHWH: ‘Choose for yourself <verse eid="1CH 21:11"/></para>

<para style="p"><verse number="12" style="v" sid="1CH 21:12"/>either three years of famine, or three months of being swept away before the faces of your foes—and the sword of your enemies overtaking <char style="add">you</char>, or three days of the sword of YHWH and the plague upon the land and the angel of YHWH destroying in all the territory of Israel.’ And consider what word I should take back to Him who sent me.” <note caller="+" style="f"><char style="fr" closed="false">21.12 </char><char style="ft" closed="false"> Hebrew; LXX and Vulgate </char><char style="fq" closed="false">of fleeing</char><char style="ft" closed="false">; see 2 Samuel 24:13.</char></note><verse eid="1CH 21:12"/></para>

<para style="p"><verse number="13" style="v" sid="1CH 21:13"/>And David said to Gad, “There is great distress to me. Let me fall, please, into the hand of YHWH, for very great are His mercies; and into the hand of man do not let me fall.” <verse eid="1CH 21:13"/></para>

<para style="s">A Plague on Israel2 Samuel 24:15–17</para>

<para style="p"><verse number="14" style="v" sid="1CH 21:14"/>And YHWH sent a plague upon Israel, and fell from Israel seventy thousand men. <verse eid="1CH 21:14"/></para>

<para style="p"><verse number="15" style="v" sid="1CH 21:15"/>And God sent an angel to Jerusalem to destroy it, and as he was destroying, YHWH saw and relented of the disaster, and He said to the angel who was destroying, “Enough now! Restrain your hand.” </para>

<para style="p" vid="1CH 21:15">And the angel of YHWH stood by the threshing floor of Ornan the Jebusite. <note caller="+" style="f"><char style="fr" closed="false">21.15 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Ornan</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Araunah</char><char style="ft" closed="false">; also in verses 18–28; see 2 Samuel 24:16.</char></note><verse eid="1CH 21:15"/></para>

<para style="p"><verse number="16" style="v" sid="1CH 21:16"/>And David lifted up his eyes and saw the angel of YHWH standing between the earth and between the heavens, and his sword being drawn in his hand stretched out over Jerusalem. And David fell, and the elders, covered in sackcloth, on their faces. <verse eid="1CH 21:16"/></para>

<para style="p"><verse number="17" style="v" sid="1CH 21:17"/>And David said to God, “Was <char style="add">it</char> not I <char style="add">who</char> said to number the people? And I<note caller="+" style="f"><char style="fr" closed="false">21.17 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">I, the shepherd,</char><char style="ft" closed="false"> see 2 Samuel 24:17 DSS and LXX.</char></note> <char style="add">am</char> he who has sinned and done great evil. And these sheep, what have they done? O YHWH my God, please, let Your hand be upon me and upon the house of my father, and not upon Your people, that they should be plagued.” <verse eid="1CH 21:17"/></para>

<para style="s">David Builds an Altar2 Samuel 24:18–25</para>

<para style="p"><verse number="18" style="v" sid="1CH 21:18"/>And the angel of YHWH spoke to Gad, to say to David that David should go and erect an altar to YHWH on the threshing floor of Ornan the Jebusite. <verse eid="1CH 21:18"/></para>

<para style="p"><verse number="19" style="v" sid="1CH 21:19"/>And David went up at the word of Gad, which he had spoken in the name of YHWH. <verse eid="1CH 21:19"/></para>

<para style="p"><verse number="20" style="v" sid="1CH 21:20"/>And Ornan turned and saw the angel. And his four sons with him hid themselves, and Ornan was threshing wheat. <verse eid="1CH 21:20"/></para>

<para style="p"><verse number="21" style="v" sid="1CH 21:21"/>And David came to Ornan, and Ornan looked and saw David, and he went out from the threshing floor and bowed before David with <char style="add">his</char> face to the ground. <verse eid="1CH 21:21"/></para>

<para style="p"><verse number="22" style="v" sid="1CH 21:22"/>And David said to Ornan, “Grant me the place of the threshing floor, that I may build on it an altar to YHWH. At the full price you shall grant it to me, that the plague may be withdrawn from the people.” <verse eid="1CH 21:22"/></para>

<para style="p"><verse number="23" style="v" sid="1CH 21:23"/>And Ornan said to David, “Take <char style="add">it</char> to yourself, and let my lord the king do good in his eyes. See, I give <char style="add">you</char> the oxen for burnt offerings, and the threshing sledges for wood, and the wheat for the grain offering; all I have given.” <verse eid="1CH 21:23"/></para>

<para style="p"><verse number="24" style="v" sid="1CH 21:24"/>And King David said to Ornan, “No, but I will surely buy <char style="add">it</char> for the full price; for I will not take what is yours for YHWH, so as to offer a burnt offering without cost.” <verse eid="1CH 21:24"/></para>

<para style="p"><verse number="25" style="v" sid="1CH 21:25"/>And David gave to Ornan for the place six hundred shekels of gold by weight.<note caller="+" style="f"><char style="fr" closed="false">21.25 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">600 shekels</char><char style="ft" closed="false"> is approximately 15.1 pounds or 6.8 kilograms of gold.</char></note> <verse eid="1CH 21:25"/></para>

<para style="p"><verse number="26" style="v" sid="1CH 21:26"/>And David built there an altar to YHWH, and he offered burnt offerings and peace offerings, and he called to YHWH. And He answered him by fire from the heavens on the altar of the burnt offering. <verse eid="1CH 21:26"/></para>

<para style="p"><verse number="27" style="v" sid="1CH 21:27"/>And YHWH commanded the angel, and he returned his sword to its sheath. <verse eid="1CH 21:27"/></para>

<para style="p"><verse number="28" style="v" sid="1CH 21:28"/>At that time David saw that YHWH had answered him on the threshing floor of Ornan the Jebusite, and he sacrificed there. <verse eid="1CH 21:28"/></para>

<para style="p"><verse number="29" style="v" sid="1CH 21:29"/>For the tabernacle of YHWH, which Moses had made in the wilderness, and the altar of the burnt offering, <char style="add">were</char> at that time at the high place in Gibeon. <verse eid="1CH 21:29"/></para>

<para style="p"><verse number="30" style="v" sid="1CH 21:30"/>David could not go before it to inquire of God, for he was afraid of the sword of the angel of YHWH. <verse eid="1CH 21:30"/></para>

<chapter eid="1CH 21"/>

<chapter number="22" style="c" sid="1CH 22"/>

<para style="s">Preparations for the Temple</para>

<para style="p"><verse number="1" style="v" sid="1CH 22:1"/>And David said, “This is the house of YHWH God, and this <char style="add">is</char> the altar of burnt offering for Israel.” <verse eid="1CH 22:1"/></para>

<para style="p"><verse number="2" style="v" sid="1CH 22:2"/>And David commanded to gather the sojourners who <char style="add">were</char> in the land of Israel, and he appointed hewers to hew stones cut to build the house of God. <verse eid="1CH 22:2"/></para>

<para style="p"><verse number="3" style="v" sid="1CH 22:3"/>And iron in abundance for the nails of the doors of the gates and for the joints David provided, and bronze in abundance without weight, <verse eid="1CH 22:3"/></para>

<para style="p"><verse number="4" style="v" sid="1CH 22:4"/>and cedar trees in abundance, for the Sidonians and the Tyrians brought cedar trees in abundance to David. <verse eid="1CH 22:4"/></para>

<para style="p"><verse number="5" style="v" sid="1CH 22:5"/>And David said, “Solomon my son <char style="add">is</char> young and inexperienced, and the house to be built for YHWH <char style="add">shall be</char> exceedingly magnificent, famous and glorious throughout all the lands. I will make preparation now for it.” And David made preparations in abundance before the face of his death. <verse eid="1CH 22:5"/></para>

<para style="s">Solomon Anointed to Build the Temple</para>

<para style="p"><verse number="6" style="v" sid="1CH 22:6"/>And he called for Solomon his son, and he commanded him to build a house for YHWH, God of Israel. <verse eid="1CH 22:6"/></para>

<para style="p"><verse number="7" style="v" sid="1CH 22:7"/>And David said to Solomon, “My son, <char style="add">as for</char> me, it was in my mind to build a house for the Name of YHWH my God. <verse eid="1CH 22:7"/></para>

<para style="p"><verse number="8" style="v" sid="1CH 22:8"/>And the word of YHWH came to me, saying, ‘You have shed blood in abundance, and you have made great wars. You shall not build a house for My name, because you have shed much blood on the earth before My face. <verse eid="1CH 22:8"/></para>

<para style="p"><verse number="9" style="v" sid="1CH 22:9"/>Behold, a son shall be born to you. He shall be a man of rest, and I will give rest to him from all his enemies round about. For Solomon<note caller="+" style="f"><char style="fr" closed="false">22.9 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Solomon</char><char style="ft" closed="false"> sounds like and is probably derived from the Hebrew word for </char><char style="fq" closed="false">peace</char><char style="ft" closed="false">.</char></note> shall be His name, and peace and quietness I will give to Israel in his days. <verse eid="1CH 22:9"/></para>

<para style="p"><verse number="10" style="v" sid="1CH 22:10"/>He shall build a house for My Name, and he shall be unto Me son, and I <char style="add">will be</char> unto him Father. And I will establish the throne of his kingdom over Israel even to forever.’ <verse eid="1CH 22:10"/></para>

<para style="p"><verse number="11" style="v" sid="1CH 22:11"/>Now, my son, may YHWH be with you, and may you prosper and build the house of YHWH your God, as He spoke concerning you. <verse eid="1CH 22:11"/></para>

<para style="p"><verse number="12" style="v" sid="1CH 22:12"/>Only may YHWH give to you wisdom and understanding, and give you charge concerning Israel, that you may keep the law of YHWH your God. <verse eid="1CH 22:12"/></para>

<para style="p"><verse number="13" style="v" sid="1CH 22:13"/>Then you will prosper, if you take care to fulfill the statutes and the ordinances with which YHWH commanded Moses concerning Israel. Be strong and be courageous. Do not fear and do not be dismayed. <verse eid="1CH 22:13"/></para>

<para style="p"><verse number="14" style="v" sid="1CH 22:14"/>And behold, in my affliction I have prepared for the house of YHWH a hundred thousand talents of gold,<note caller="+" style="f"><char style="fr" closed="false">22.14 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">100,000 talents</char><char style="ft" closed="false"> is approximately 3,770 tons or 3,420 metric tons of gold.</char></note> and a thousand thousands of talents of silver,<note caller="+" style="f"><char style="fr" closed="false">22.14 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">1,000,000 talents</char><char style="ft" closed="false"> is approximately 37,700 tons or 34,200 metric tons of silver.</char></note> and bronze and iron without weight; for it is so abundant. And timber and stone I have prepared, and to them you may add. <verse eid="1CH 22:14"/></para>

<para style="p"><verse number="15" style="v" sid="1CH 22:15"/>And with you in abundance are those doing work: Hewers and craftsmen of stone and of wood, and all types of skillful men for every kind of work. <verse eid="1CH 22:15"/></para>

<para style="p"><verse number="16" style="v" sid="1CH 22:16"/>To the gold, to the silver, and to the bronze, and to the iron, there is no number. Arise and work, and YHWH be with you.” <verse eid="1CH 22:16"/></para>

<para style="p"><verse number="17" style="v" sid="1CH 22:17"/>And David commanded all the heads of Israel to help Solomon his son: <verse eid="1CH 22:17"/></para>

<para style="p"><verse number="18" style="v" sid="1CH 22:18"/>“Is not YHWH your⁺ God with you⁺, and has given rest to you⁺ on every side? For He has given into my hand those dwelling in the land, and the land is subdued before the face of YHWH and before His people. <verse eid="1CH 22:18"/></para>

<para style="p"><verse number="19" style="v" sid="1CH 22:19"/>Now set your⁺ heart and your⁺ soul to seek YHWH your⁺ God, and arise and build the sanctuary of YHWH God, to bring the ark of the covenant of YHWH and the holy articles of God into the house that is to be built for the name of YHWH.” <verse eid="1CH 22:19"/></para>

<chapter eid="1CH 22"/>

<chapter number="23" style="c" sid="1CH 23"/>

<para style="s">The Divisions of the Levites</para>

<para style="p"><verse number="1" style="v" sid="1CH 23:1"/>And David was old and was full of days, and his son Solomon he made king over Israel. <verse eid="1CH 23:1"/></para>

<para style="p"><verse number="2" style="v" sid="1CH 23:2"/>And he gathered together all the heads of Israel, and the priests, and the Levites. <verse eid="1CH 23:2"/></para>

<para style="p"><verse number="3" style="v" sid="1CH 23:3"/>And the Levites were numbered from a son of thirty years and above, and the number by their heads of mighty men was thirty-eight thousand. <verse eid="1CH 23:3"/></para>

<para style="p"><verse number="4" style="v" sid="1CH 23:4"/>“From these <char style="add">were</char> twenty-four thousand to preside over the work of the house of YHWH, six thousand and officers and judges, <verse eid="1CH 23:4"/></para>

<para style="p"><verse number="5" style="v" sid="1CH 23:5"/>and four thousand gatekeepers, and four thousand giving praise to YHWH with instruments that I have made for giving praise.”<note caller="+" style="f"><char style="fr" closed="false">23.5 </char><char style="ft" closed="false"> It is implied that this is a quote of David.</char></note> <verse eid="1CH 23:5"/></para>

<para style="p"><verse number="6" style="v" sid="1CH 23:6"/>And David separated them into divisions among the sons of Levi: </para>

<para style="q1" vid="1CH 23:6">Gershon, Kohath, and Merari. <verse eid="1CH 23:6"/></para>

<para style="s">The GershonitesNumbers 3:21–26</para>

<para style="q1"><verse number="7" style="v" sid="1CH 23:7"/><note caller="-" style="x"><char style="xt" closed="false">Numbers 4:21–28</char></note>Of the Gershonite: Ladan<note caller="+" style="f"><char style="fr" closed="false">23.7 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Ladan</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Libni</char><char style="ft" closed="false">; also in verses 8 and 9; see 1 Chronicles 6:17.</char></note> and Shimei. <verse eid="1CH 23:7"/></para>

<para style="q1"><verse number="8" style="v" sid="1CH 23:8"/>The sons of Laadan: The first Jehiel, and Zetham, and Joel—three. <note caller="+" style="f"><char style="fr" closed="false">23.8 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Jehiel</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Jehieli</char><char style="ft" closed="false">; see 1 Chronicles 26:21.</char></note><verse eid="1CH 23:8"/></para>

<para style="q1"><verse number="9" style="v" sid="1CH 23:9"/>The sons of Shimei: Shelomith, and Haziel, and Haran—three. These <char style="add">were</char> the heads of the fathers of Laadan. <verse eid="1CH 23:9"/></para>

<para style="q1"><verse number="10" style="v" sid="1CH 23:10"/>And the sons of Shimei:<note caller="+" style="f"><char style="fr" closed="false">23.10 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Shimei</char><char style="ft" closed="false"> was possibly a son or grandson of the </char><char style="fq" closed="false">Shimei</char><char style="ft" closed="false"> listed in verse 9.</char></note> Jahath, Zina,<note caller="+" style="f"><char style="fr" closed="false">23.10 </char><char style="ft" closed="false"> Most Hebrew manuscripts; one Hebrew manuscript, LXX, and Vulgate (see also verse 11) </char><char style="fq" closed="false">Zizah</char></note> and Jeush, and Beriah. These <char style="add">were</char> the sons of Shimei—four. <verse eid="1CH 23:10"/></para>

<para style="q1"><verse number="11" style="v" sid="1CH 23:11"/>And Jahath was the head, and Zizah the second. And Jeush and Beriah did not have many sons, and they were to a house of a father in one assignment. <verse eid="1CH 23:11"/></para>

<para style="s">The KohathitesNumbers 3:27–32</para>

<para style="q1"><verse number="12" style="v" sid="1CH 23:12"/><note caller="-" style="x"><char style="xt" closed="false">Numbers 4:1–20</char></note>The sons of Kohath: Amram, Izhar, Hebron, and Uzziel—four. <verse eid="1CH 23:12"/></para>

<para style="q1"><verse number="13" style="v" sid="1CH 23:13"/>The sons of Amram: Aaron and Moses. And Aaron was set apart for his sanctifying the holy of holies,<note caller="+" style="f"><char style="fr" closed="false">23.13 </char><char style="ft" closed="false"> Of </char><char style="fq" closed="false">the most holy [things]</char></note> he and his sons even to forever, to burn incense before the face of YHWH, to minister for him, and to give the blessing in His name even to forever. <verse eid="1CH 23:13"/></para>

<para style="q1"><verse number="14" style="v" sid="1CH 23:14"/>And Moses the man of God, his sons were reckoned to the tribe of Levi. <verse eid="1CH 23:14"/></para>

<para style="q1"><verse number="15" style="v" sid="1CH 23:15"/>The sons of Moses: Gershom and Eliezer. <verse eid="1CH 23:15"/></para>

<para style="q1"><verse number="16" style="v" sid="1CH 23:16"/>The sons of Gershom: Shebuel <char style="add">was</char> the first. <verse eid="1CH 23:16"/></para>

<para style="q1"><verse number="17" style="v" sid="1CH 23:17"/>And of the sons of Eliezer Rehabiah: Was the first. And Eliezer had no other sons, and the sons of Rehabiah multiplied exceedingly. <verse eid="1CH 23:17"/></para>

<para style="q1"><verse number="18" style="v" sid="1CH 23:18"/>The sons of Izhar: Shelomith the first. <verse eid="1CH 23:18"/></para>

<para style="q1"><verse number="19" style="v" sid="1CH 23:19"/>The sons of Hebron: Jeriah the first, Amariah the second, Jahaziel the third, and Jekameam the fourth. <verse eid="1CH 23:19"/></para>

<para style="q1"><verse number="20" style="v" sid="1CH 23:20"/>The sons of Uzziel: Micah the first, and Isshiah the second. <verse eid="1CH 23:20"/></para>

<para style="s">The MeraritesNumbers 3:33–37</para>

<para style="q1"><verse number="21" style="v" sid="1CH 23:21"/><note caller="-" style="x"><char style="xt" closed="false">Numbers 4:29–33</char></note>The sons of Merari: Mahli and Mushi. The sons of Mahli: Eleazar and Kish. <verse eid="1CH 23:21"/></para>

<para style="q1"><verse number="22" style="v" sid="1CH 23:22"/>And Eleazar died; there were unto him no sons, but only daughters. And the sons of Kish, their brothers, lifted them. <verse eid="1CH 23:22"/></para>

<para style="q1"><verse number="23" style="v" sid="1CH 23:23"/>The sons of Mushi: Mahli, and Eder, and Jeremoth—three. <note caller="+" style="f"><char style="fr" closed="false">23.23 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Jeremoth</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Jerimoth</char><char style="ft" closed="false">; see 1 Chronicles 24:30.</char></note><verse eid="1CH 23:23"/></para>

<para style="s">Levite Duties Revised</para>

<para style="p"><verse number="24" style="v" sid="1CH 23:24"/>These <char style="add">were</char> the sons of Levi by the houses of their fathers, heads of the fathers, by their appointments, in the number of names, by their polls, who did the work for the service of the house of YHWH, from a son of twenty years and above. <verse eid="1CH 23:24"/></para>

<para style="p"><verse number="25" style="v" sid="1CH 23:25"/>For David said, “YHWH, God of Israel, has given rest to His people, that they may dwell in Jerusalem even to forever.” <verse eid="1CH 23:25"/></para>

<para style="p"><verse number="26" style="v" sid="1CH 23:26"/>And also of the Levites, “No longer shall they carry the tabernacle or any of its articles for its service.” <verse eid="1CH 23:26"/></para>

<para style="p"><verse number="27" style="v" sid="1CH 23:27"/>For by the last words of David they were numbering the sons of Levi from a son of twenty years and above. <verse eid="1CH 23:27"/></para>

<para style="p"><verse number="28" style="v" sid="1CH 23:28"/>For their duty <char style="add">was</char> at the hand of the sons of Aaron in the service of the house of YHWH, in the courts, and in the chambers, and in the purifying of every holy thing, and the work of the service of the house of God, <verse eid="1CH 23:28"/></para>

<para style="p"><verse number="29" style="v" sid="1CH 23:29"/>and for the bread of the arrangement, and the fine flour for the present, and for the unleavened cakes, and for the pan, and for what is mixed, and for all kinds of measures and sizes, <verse eid="1CH 23:29"/></para>

<para style="p"><verse number="30" style="v" sid="1CH 23:30"/>and to stand morning by morning to thank and to give praise to YHWH, and likewise at the evening, <verse eid="1CH 23:30"/></para>

<para style="p"><verse number="31" style="v" sid="1CH 23:31"/>and at every presentation of burnt offerings to YHWH on the Sabbaths and on the New Moons and for the appointed seasons, by number, according to the ordinance upon them, regularly before the face of YHWH. <verse eid="1CH 23:31"/></para>

<para style="p"><verse number="32" style="v" sid="1CH 23:32"/>And they were to keep the charge of the Tent of Meeting, and the charge of the sanctuary, and the charge of the sons of Aaron their brothers in the work of the house of YHWH. <verse eid="1CH 23:32"/></para>

<chapter eid="1CH 23"/>

<chapter number="24" style="c" sid="1CH 24"/>

<para style="s">Twenty-Four Divisions of Priests</para>

<para style="p"><verse number="1" style="v" sid="1CH 24:1"/>And the sons of Aaron—<char style="add">these are</char> the divisions of the sons of Aaron: Nadab, and Abihu, Eleazar, and Ithamar. <verse eid="1CH 24:1"/></para>

<para style="p"><verse number="2" style="v" sid="1CH 24:2"/>And Nadab and Abihu died before the face of their father, and there were unto them no children, and Eleazar and Ithamar served as priests. <verse eid="1CH 24:2"/></para>

<para style="p"><verse number="3" style="v" sid="1CH 24:3"/>And David divided them, and Zadok of the sons of Eleazar, and Ahimelech of the sons of Ithamar, according to their office in their service. <verse eid="1CH 24:3"/></para>

<para style="p"><verse number="4" style="v" sid="1CH 24:4"/>And there were found of the sons of Eleazar more for heads of the mighty men than of the sons of Ithamar, and they were divided. Among the sons of Eleazar, heads for a house of fathers, sixteen. And among the sons of Ithamar, for a house of their fathers, eight. <verse eid="1CH 24:4"/></para>

<para style="p"><verse number="5" style="v" sid="1CH 24:5"/>And they were divided by lot, these with these; for there were officials of the sanctuary and officials of God from the sons of Eleazar and from the sons of Ithamar. <verse eid="1CH 24:5"/></para>

<para style="p"><verse number="6" style="v" sid="1CH 24:6"/>And Shemaiah son of Nethanel the scribe of the Levites wrote them down before the face of the king, and the princes, and Zadok the priest, and Ahimelech son of Abiathar, and the heads of fathers of the priests and the Levites—one house of a father taken for Eleazar, and one being taken possession of for Ithamar. <verse eid="1CH 24:6"/></para>

<para style="q1"><verse number="7" style="v" sid="1CH 24:7"/>And the first lot fell to Jehoiarib, </para>

<para style="q1" vid="1CH 24:7">to Jedaiah the second, <verse eid="1CH 24:7"/></para>

<para style="q1"><verse number="8" style="v" sid="1CH 24:8"/>to Harim the third, </para>

<para style="q1" vid="1CH 24:8">to Seorim the fourth, <verse eid="1CH 24:8"/></para>

<para style="q1"><verse number="9" style="v" sid="1CH 24:9"/>to Malchijah the fifth, </para>

<para style="q1" vid="1CH 24:9">to Mijamin the sixth, <verse eid="1CH 24:9"/></para>

<para style="q1"><verse number="10" style="v" sid="1CH 24:10"/>to Koz the seventh, </para>

<para style="q1" vid="1CH 24:10">to Abijah the eighth, <verse eid="1CH 24:10"/></para>

<para style="q1"><verse number="11" style="v" sid="1CH 24:11"/>to Jeshua the ninth, </para>

<para style="q1" vid="1CH 24:11">to Shecaniah the tenth, <verse eid="1CH 24:11"/></para>

<para style="q1"><verse number="12" style="v" sid="1CH 24:12"/>to Eliashib the eleventh, </para>

<para style="q1" vid="1CH 24:12">to Jakim the twelfth, <verse eid="1CH 24:12"/></para>

<para style="q1"><verse number="13" style="v" sid="1CH 24:13"/>to Huppah the thirteenth, </para>

<para style="q1" vid="1CH 24:13">to Jeshebeab the fourteenth, <verse eid="1CH 24:13"/></para>

<para style="q1"><verse number="14" style="v" sid="1CH 24:14"/>to Bilgah the fifteenth, </para>

<para style="q1" vid="1CH 24:14">to Immer the sixteenth, <verse eid="1CH 24:14"/></para>

<para style="q1"><verse number="15" style="v" sid="1CH 24:15"/>to Hezir the seventeenth, </para>

<para style="q1" vid="1CH 24:15">to Happizzez the eighteenth, <verse eid="1CH 24:15"/></para>

<para style="q1"><verse number="16" style="v" sid="1CH 24:16"/>to Pethahiah the nineteenth, </para>

<para style="q1" vid="1CH 24:16">to Ezekiel the twentieth, <verse eid="1CH 24:16"/></para>

<para style="q1"><verse number="17" style="v" sid="1CH 24:17"/>to Jachin the one and twentieth, </para>

<para style="q1" vid="1CH 24:17">to Gamul the two and twentieth, <verse eid="1CH 24:17"/></para>

<para style="q1"><verse number="18" style="v" sid="1CH 24:18"/>to Delaiah the three and twentieth, </para>

<para style="q1" vid="1CH 24:18">to Maaziah the four and twentieth. <verse eid="1CH 24:18"/></para>

<para style="p"><verse number="19" style="v" sid="1CH 24:19"/>These <char style="add">were</char> their appointments for their service for coming into the house of YHWH, according to their ordinance by the hand of Aaron their father, as YHWH, God of Israel, had commanded him. <verse eid="1CH 24:19"/></para>

<para style="s">The Rest of the Levites</para>

<para style="p"><verse number="20" style="v" sid="1CH 24:20"/>And those remaining of the sons of Levi: </para>

<para style="q1" vid="1CH 24:20">Of the sons of Amram: Shubael;<note caller="+" style="f"><char style="fr" closed="false">24.20 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Shubael</char><char style="ft" closed="false"> (twice in this verse) is a variant of </char><char style="fq" closed="false">Shebuel</char><char style="ft" closed="false">; see 1 Chronicles 23:16 and 1 Chronicles 26:24.</char></note> </para>

<para style="q1" vid="1CH 24:20">of the sons of Shubael: Jehdeiah. <verse eid="1CH 24:20"/></para>

<para style="q1"><verse number="21" style="v" sid="1CH 24:21"/>To Rehabiah, of the sons of Rehabiah: The first <char style="add">was</char> Isshiah. <note caller="+" style="f"><char style="fr" closed="false">24.21 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Isshiah</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Jeshaiah</char><char style="ft" closed="false">; see 1 Chronicles 26:25.</char></note><verse eid="1CH 24:21"/></para>

<para style="q1"><verse number="22" style="v" sid="1CH 24:22"/>Of the Izharite: Shelomoth;<note caller="+" style="f"><char style="fr" closed="false">24.22 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Shelomoth</char><char style="ft" closed="false"> (twice in this verse) is a variant of </char><char style="fq" closed="false">Shelomith</char><char style="ft" closed="false">; see 1 Chronicles 23:18.</char></note> </para>

<para style="q1" vid="1CH 24:22">of the sons of Shelomoth: Jahath. <verse eid="1CH 24:22"/></para>

<para style="q1"><verse number="23" style="v" sid="1CH 24:23"/>And of the sons <char style="add">of Hebron</char> Jeriah <char style="add">was the first</char>:<note caller="+" style="f"><char style="fr" closed="false">24.23 </char><char style="ft" closed="false"> Hebrew </char><char style="fq" closed="false">And of the sons of Jeriah</char><char style="ft" closed="false">; see 1 Chronicles 23:19.</char></note> Amariah the second, Jahaziel the third, <char style="add">and</char> Jekameam the fourth. <verse eid="1CH 24:23"/></para>

<para style="q1"><verse number="24" style="v" sid="1CH 24:24"/>The sons of Uzziel: Micah; </para>

<para style="q1" vid="1CH 24:24">of the sons of Micah: Shamir. <verse eid="1CH 24:24"/></para>

<para style="q1"><verse number="25" style="v" sid="1CH 24:25"/>The brother of Micah: Isshiah; </para>

<para style="q1" vid="1CH 24:25">of the sons of Isshiah: Zechariah. <verse eid="1CH 24:25"/></para>

<para style="q1"><verse number="26" style="v" sid="1CH 24:26"/>The sons of Merari: Mahli and Mushi; </para>

<para style="q1" vid="1CH 24:26">the sons of Jaaziah: Beno. <verse eid="1CH 24:26"/></para>

<para style="q1"><verse number="27" style="v" sid="1CH 24:27"/>The sons of Merari by Jaaziah: Beno, and Shoham, and Zaccur, and Ibri. <verse eid="1CH 24:27"/></para>

<para style="q1"><verse number="28" style="v" sid="1CH 24:28"/>Of Mahli: Eleazar, and were to him no sons. <verse eid="1CH 24:28"/></para>

<para style="q1"><verse number="29" style="v" sid="1CH 24:29"/>Of Kish: The son of Kish: Jerahmeel. <verse eid="1CH 24:29"/></para>

<para style="q1"><verse number="30" style="v" sid="1CH 24:30"/>And the sons of Mushi: Mahli, and Eder, and Jerimoth. These <char style="add">were</char> the sons of the Levites according to the house of their fathers. <note caller="+" style="f"><char style="fr" closed="false">24.30 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Jerimoth</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Jeremoth</char><char style="ft" closed="false">; see 1 Chronicles 23:23.</char></note><verse eid="1CH 24:30"/></para>

<para style="p"><verse number="31" style="v" sid="1CH 24:31"/>And they also cast lots as their brothers, the sons of Aaron, before the face of David the king, and Zadok, and Ahimelech, and the heads of the fathers of the priests and Levites—the chief father as his younger brother. <verse eid="1CH 24:31"/></para>

<chapter eid="1CH 24"/>

<chapter number="25" style="c" sid="1CH 25"/>

<para style="s">Twenty-Four Divisions of Musicians</para>

<para style="p"><verse number="1" style="v" sid="1CH 25:1"/>And David and the heads of the host separated for service <char style="add">some</char> of the sons of Asaph, and of Heman, and of Jeduthun, to prophesy with harps, stringed instruments, and cymbals; and the number of the men of work was according to their service: <verse eid="1CH 25:1"/></para>

<para style="q1"><verse number="2" style="v" sid="1CH 25:2"/>Of the sons of Asaph: Zaccur, and Joseph, and Nethaniah, and Asharelah, the sons of Asaph under the direction of Asaph, who prophesied according to the order of the king. <verse eid="1CH 25:2"/></para>

<para style="q1"><verse number="3" style="v" sid="1CH 25:3"/>Of Jeduthun, the sons of Jeduthun: Gedaliah, and Zeri, and Jeshaiah, <char style="add">Shimei,</char><note caller="+" style="f"><char style="fr" closed="false">25.3 </char><char style="ft" closed="false"> One Hebrew manuscript and some LXX manuscripts (see also verse 17); most Hebrew manuscripts do not include </char><char style="fq" closed="false">Shimei</char><char style="ft" closed="false">.</char></note> Hashabiah, and Mattithiah—six—under the hand of their father Jeduthun, prophesying with a harp for giving of thanks and praise to YHWH. <verse eid="1CH 25:3"/></para>

<para style="q1"><verse number="4" style="v" sid="1CH 25:4"/>Of Heman, the sons of Heman: Bukkiah, Mattaniah, Uzziel, Shebuel,<note caller="+" style="f"><char style="fr" closed="false">25.4 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Shebuel</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Shubael</char><char style="ft" closed="false">; see verse 20.</char></note> and Jerimoth,<note caller="+" style="f"><char style="fr" closed="false">25.4 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Jerimoth</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Jeremoth</char><char style="ft" closed="false">; see verse 22.</char></note> Hananiah, Hanani, Eliathah, Giddalti, and Romamti-ezer, Joshbekashah, Mallothi, Hothir, Mahazioth. <verse eid="1CH 25:4"/></para>

<para style="q1"><verse number="5" style="v" sid="1CH 25:5"/>All these <char style="add">were</char> the sons of Heman, seer of the king in the words of God, to lift up a horn. And God gave to Heman fourteen sons and three daughters. <verse eid="1CH 25:5"/></para>

<para style="p"><verse number="6" style="v" sid="1CH 25:6"/>All these <char style="add">were</char> under the hand of their father in the song of the house of YHWH, with cymbals, harps, and lyres, for the service of the house of God. Under the hand of the king <char style="add">were</char> Asaph, and Jeduthun, and Heman. <verse eid="1CH 25:6"/></para>

<para style="p"><verse number="7" style="v" sid="1CH 25:7"/>And the number of them with their brothers, who were instructed in the songs of YHWH, all who were skillful, <char style="add">was</char> two hundred eighty-eight. <verse eid="1CH 25:7"/></para>

<para style="p"><verse number="8" style="v" sid="1CH 25:8"/>And they cast lots for their duty unto the small as well as the great, the teacher with the pupil. <verse eid="1CH 25:8"/></para>

<para style="q1"><verse number="9" style="v" sid="1CH 25:9"/>And the first lot came out for Asaph to Joseph, <char style="add">his sons, and his brothers—twelve</char>;<note caller="+" style="f"><char style="fr" closed="false">25.9 </char><char style="ft" closed="false"> See LXX and the total in verse 7; Hebrew does not include </char><char style="fq" closed="false">his sons, and his brothers—twelve;</char></note> </para>

<para style="q1" vid="1CH 25:9">the second to Gedaliah—him and his brothers and his sons—twelve; <verse eid="1CH 25:9"/></para>

<para style="q1"><verse number="10" style="v" sid="1CH 25:10"/>the third <char style="add">to</char> Zaccur, his sons, and his brothers—twelve; <verse eid="1CH 25:10"/></para>

<para style="q1"><verse number="11" style="v" sid="1CH 25:11"/>the fourth to Izri,<note caller="+" style="f"><char style="fr" closed="false">25.11 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Izri</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Zeri</char><char style="ft" closed="false">; see verse 3.</char></note> his sons, and his brothers—twelve; <verse eid="1CH 25:11"/></para>

<para style="q1"><verse number="12" style="v" sid="1CH 25:12"/>the fifth to Nethaniah, his sons, and his brothers—twelve; <verse eid="1CH 25:12"/></para>

<para style="q1"><verse number="13" style="v" sid="1CH 25:13"/>the sixth to Bukkiah, his sons, and his brothers—twelve; <verse eid="1CH 25:13"/></para>

<para style="q1"><verse number="14" style="v" sid="1CH 25:14"/>the seventh to Jesharelah,<note caller="+" style="f"><char style="fr" closed="false">25.14 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Jesarelah</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Asarelah</char><char style="ft" closed="false">; see verse 2.</char></note> his sons, and his brothers—twelve; <verse eid="1CH 25:14"/></para>

<para style="q1"><verse number="15" style="v" sid="1CH 25:15"/>the eighth to Jeshaiah, his sons, and his brothers—twelve; <verse eid="1CH 25:15"/></para>

<para style="q1"><verse number="16" style="v" sid="1CH 25:16"/>the ninth to Mattaniah, his sons, and his brothers—twelve; <verse eid="1CH 25:16"/></para>

<para style="q1"><verse number="17" style="v" sid="1CH 25:17"/>the tenth to Shimei, his sons, and his brothers—twelve; <verse eid="1CH 25:17"/></para>

<para style="q1"><verse number="18" style="v" sid="1CH 25:18"/>the eleventh to Azarel,<note caller="+" style="f"><char style="fr" closed="false">25.18 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Azarel</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Uzziel</char><char style="ft" closed="false">; see verse 4.</char></note> his sons, and his brothers—twelve; <verse eid="1CH 25:18"/></para>

<para style="q1"><verse number="19" style="v" sid="1CH 25:19"/>the twelfth to Hashabiah, his sons, and his brothers—twelve; <verse eid="1CH 25:19"/></para>

<para style="q1"><verse number="20" style="v" sid="1CH 25:20"/>the thirteenth to Shubael, his sons, and his brothers—twelve; <verse eid="1CH 25:20"/></para>

<para style="q1"><verse number="21" style="v" sid="1CH 25:21"/>the fourteenth to Mattithiah, his sons, and his brothers—twelve; <verse eid="1CH 25:21"/></para>

<para style="q1"><verse number="22" style="v" sid="1CH 25:22"/>the fifteenth to Jeremoth,<note caller="+" style="f"><char style="fr" closed="false">25.22 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Jeremoth</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Jerimoth</char><char style="ft" closed="false">; see verse 4.</char></note> his sons, and his brothers—twelve; <verse eid="1CH 25:22"/></para>

<para style="q1"><verse number="23" style="v" sid="1CH 25:23"/>the sixteenth to Hananiah, his sons, and his brothers—twelve; <verse eid="1CH 25:23"/></para>

<para style="q1"><verse number="24" style="v" sid="1CH 25:24"/>the seventeenth to Joshbekashah, his sons, and his brothers—twelve; <verse eid="1CH 25:24"/></para>

<para style="q1"><verse number="25" style="v" sid="1CH 25:25"/>the eighteenth to Hanani, his sons, and his brothers—twelve; <verse eid="1CH 25:25"/></para>

<para style="q1"><verse number="26" style="v" sid="1CH 25:26"/>the nineteenth to Mallothi, his sons, and his brothers—twelve; <verse eid="1CH 25:26"/></para>

<para style="q1"><verse number="27" style="v" sid="1CH 25:27"/>the twentieth to Eliathah, his sons, and his brothers—twelve; <verse eid="1CH 25:27"/></para>

<para style="q1"><verse number="28" style="v" sid="1CH 25:28"/>the one and twentieth to Hothir, his sons, and his brothers—twelve; <verse eid="1CH 25:28"/></para>

<para style="q1"><verse number="29" style="v" sid="1CH 25:29"/>the two and twentieth to Giddalti, his sons, and his brothers—twelve; <verse eid="1CH 25:29"/></para>

<para style="q1"><verse number="30" style="v" sid="1CH 25:30"/>the three and twentieth to Mahazioth, his sons, and his brothers—twelve; <verse eid="1CH 25:30"/></para>

<para style="q1"><verse number="31" style="v" sid="1CH 25:31"/>the four and twentieth to Romamti-ezer, his sons, and his brothers—twelve; <verse eid="1CH 25:31"/></para>

<chapter eid="1CH 25"/>

<chapter number="26" style="c" sid="1CH 26"/>

<para style="s">The Divisions of the Gatekeepers</para>

<para style="p"><verse number="1" style="v" sid="1CH 26:1"/>for the divisions of the gatekeepers: </para>

<para style="q1" vid="1CH 26:1">Of the Korahites: Meshelemiah son of Kore, of the sons of Asaph. <verse eid="1CH 26:1"/></para>

<para style="q1"><verse number="2" style="v" sid="1CH 26:2"/>And the sons of Meshelemiah: Zechariah the firstborn, Jediael the second, Zebadiah the third, Jathniel the fourth, <verse eid="1CH 26:2"/></para>

<para style="q1"><verse number="3" style="v" sid="1CH 26:3"/>Elam the fifth, Jehohanan the sixth, Eliehoenai the seventh. <verse eid="1CH 26:3"/></para>

<para style="q1"><verse number="4" style="v" sid="1CH 26:4"/>And to Obed-edom <char style="add">were</char> sons: Shemaiah the firstborn, Jehozabad the second, Joah the third, and Sacar the fourth, and Nethanel the fifth, <verse eid="1CH 26:4"/></para>

<para style="q1"><verse number="5" style="v" sid="1CH 26:5"/>Ammiel the sixth, Issachar the seventh, Peulthai the eighth, for God blessed him. <verse eid="1CH 26:5"/></para>

<para style="q1"><verse number="6" style="v" sid="1CH 26:6"/>And to Shemaiah his son were born sons who governed throughout the house of their father, because they <char style="add">were</char> mighty ones of valor. <verse eid="1CH 26:6"/></para>

<para style="q1"><verse number="7" style="v" sid="1CH 26:7"/>The sons of Shemaiah: Othni, and Rephael, and Obed, Elzabad; his brothers <char style="add">were</char> sons of valor, Elihu and Semachiah. <verse eid="1CH 26:7"/></para>

<para style="q1"><verse number="8" style="v" sid="1CH 26:8"/>All these <char style="add">were</char> of the sons of Obed-edom; they and their sons and their brothers, men of valor with power for work—sixty-two of Obed-edom. <verse eid="1CH 26:8"/></para>

<para style="q1"><verse number="9" style="v" sid="1CH 26:9"/>And to Meshelemiah <char style="add">were</char> sons and brothers, sons of valor—eighteen. <verse eid="1CH 26:9"/></para>

<para style="q1"><verse number="10" style="v" sid="1CH 26:10"/>And to Hosah of the sons of Merari <char style="add">were</char> sons: Shimri the first (although he was not the firstborn, his father made him the first), <verse eid="1CH 26:10"/></para>

<para style="q1"><verse number="11" style="v" sid="1CH 26:11"/>Hilkiah the second, Tebaliah the third, Zechariah the fourth—all the sons and brothers of Hosah, thirteen. <verse eid="1CH 26:11"/></para>

<para style="p"><verse number="12" style="v" sid="1CH 26:12"/>Among these <char style="add">were</char> the divisions of the gatekeepers, the heads of the mighty ones <char style="add">having</char> duties just like their brothers, to serve in the house of YHWH. <verse eid="1CH 26:12"/></para>

<para style="p"><verse number="13" style="v" sid="1CH 26:13"/>And they cast lots, the small as well as the great, according to the house of their fathers, for each gate. <verse eid="1CH 26:13"/></para>

<para style="q1"><verse number="14" style="v" sid="1CH 26:14"/>And the lot fell for the East to Shelemiah.<note caller="+" style="f"><char style="fr" closed="false">26.14 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Shelemiah</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Meshelemiah</char><char style="ft" closed="false">; see verse 2.</char></note> </para>

<para style="q1" vid="1CH 26:14">And <char style="add">for</char> Zechariah his son, a wise counselor, they cast lots, and his lot came out for the North. <verse eid="1CH 26:14"/></para>

<para style="q1"><verse number="15" style="v" sid="1CH 26:15"/>To Obed-edom the South, and to his sons the house of the gatherings. <verse eid="1CH 26:15"/></para>

<para style="q1"><verse number="16" style="v" sid="1CH 26:16"/>To Shuppim and Hosah for the West, with the Shallecheth Gate on the ascending highway.<note caller="+" style="f"><char style="fr" closed="false">26.16 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">on the upper road</char></note> A guard <char style="add">was</char> alongside a guard. <verse eid="1CH 26:16"/></para>

<para style="p"><verse number="17" style="v" sid="1CH 26:17"/>To the east the Levites <char style="add">were</char> six, to the north day by day four, to the south day by day four, and at the storehouse two <char style="add">by</char> two. <verse eid="1CH 26:17"/></para>

<para style="p"><verse number="18" style="v" sid="1CH 26:18"/>At Parbar<note caller="+" style="f"><char style="fr" closed="false">26.18 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the court</char><char style="ft" closed="false">; twice in this verse</char></note> on the west, <char style="add">were</char> four at the highway <char style="add">and</char> two at Parbar. <verse eid="1CH 26:18"/></para>

<para style="p"><verse number="19" style="v" sid="1CH 26:19"/>These <char style="add">were</char> the divisions of the gatekeepers among the sons of the Korahite and among the sons of Merari. <verse eid="1CH 26:19"/></para>

<para style="s">The Treasurers, Officers, and Judges</para>

<para style="p"><verse number="20" style="v" sid="1CH 26:20"/>And of the Levites, Ahijah <char style="add">was</char><note caller="+" style="f"><char style="fr" closed="false">26.20 </char><char style="ft" closed="false"> LXX </char><char style="fq" closed="false">And of the Levites, their brethren [were]</char></note> over the treasuries of the house of God and over the treasuries of the holy things. <verse eid="1CH 26:20"/></para>

<para style="p"><verse number="21" style="v" sid="1CH 26:21"/>The sons of Laadan, the sons of the Gershonite, of Ladan, the heads of the fathers of Laadan the Gershonite <char style="add">were</char> Jehieli,<note caller="+" style="f"><char style="fr" closed="false">26.21 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Ladan</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Libni</char><char style="ft" closed="false">; see 1 Chronicles 6:17.</char></note> <note caller="+" style="f"><char style="fr" closed="false">26.21 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Jehieli</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Jehiel</char><char style="ft" closed="false">; also in verse 22; see 1 Chronicles 23:8.</char></note><verse eid="1CH 26:21"/></para>

<para style="p"><verse number="22" style="v" sid="1CH 26:22"/>the sons of Jehieli: Zetham, and Joel his brother, over the treasuries of the house of YHWH. <verse eid="1CH 26:22"/></para>

<para style="p"><verse number="23" style="v" sid="1CH 26:23"/>Of the Amramite, the Izharite, the Hebronite, and the Uzzielite: <verse eid="1CH 26:23"/></para>

<para style="q1"><verse number="24" style="v" sid="1CH 26:24"/>And Shebuel son of Gershom son of Moses <char style="add">was</char> overseer of the treasuries. <verse eid="1CH 26:24"/></para>

<para style="q1"><verse number="25" style="v" sid="1CH 26:25"/>And his brothers through Eliezer: Rehabiah his son, and Jeshaiah his son, and Joram his son, and Zichri his son, and Shelomith his son. <note caller="+" style="f"><char style="fr" closed="false">26.25 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Jeshaiah</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Isshiah</char><char style="ft" closed="false">; see 1 Chronicles 24:21.</char></note><verse eid="1CH 26:25"/></para>

<para style="q1"><verse number="26" style="v" sid="1CH 26:26"/>This Shelomoth and his brothers <char style="add">were</char> over all the treasuries of the holy things that David the king and the heads of the fathers, even heads of thousands and of hundreds, and the captains of the army, had dedicated. <verse eid="1CH 26:26"/></para>

<para style="q1"><verse number="27" style="v" sid="1CH 26:27"/>From the battles and from the plunder they dedicated to strengthen the house of YHWH, <verse eid="1CH 26:27"/></para>

<para style="q1"><verse number="28" style="v" sid="1CH 26:28"/>and all that Samuel the seer, and Saul son of Kish, and Abner son of Ner, and Joab son of Zeruiah, had dedicated—all sanctified under the hand of Shelomith and his brothers. <verse eid="1CH 26:28"/></para>

<para style="q1"><verse number="29" style="v" sid="1CH 26:29"/>Of the Izharite: Chenaniah and his sons unto the outside work<note caller="+" style="f"><char style="fr" closed="false">26.29 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the work outside (the temple)</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">the work outside (Jerusalem)</char></note> <char style="add">were</char> over Israel as officials and judges. <verse eid="1CH 26:29"/></para>

<para style="q1"><verse number="30" style="v" sid="1CH 26:30"/>Of the Hebronite: Hashabiah and his brothers, sons of valor, a thousand and seven hundred, <char style="add">were</char> over the inspection of Israel on the west side of the Jordan for all the business of YHWH, and in the service of the king. <verse eid="1CH 26:30"/></para>

<para style="q1"><verse number="31" style="v" sid="1CH 26:31"/>Of the Hebronite, Jerijah<note caller="+" style="f"><char style="fr" closed="false">26.31 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Jerijah</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Jeriah</char><char style="ft" closed="false">; see 1 Chronicles 23:19.</char></note> <char style="add">was</char> the head of the Hebronite, according to the generations of his fathers. In the fortieth year of the reign of David they were sought, and there were found among them mighty men of valor at Jazer of Gilead. <verse eid="1CH 26:31"/></para>

<para style="q1"><verse number="32" style="v" sid="1CH 26:32"/>And his brothers, sons of valor, two thousand and seven hundred heads of the fathers, king David appointed over the Reubenite, and the Gadite, and the half-tribe of Manasseh, for every matter of God and matter of the king. <verse eid="1CH 26:32"/></para>

<chapter eid="1CH 26"/>

<chapter number="27" style="c" sid="1CH 27"/>

<para style="s">Twelve Captains for Twelve Months</para>

<para style="p"><verse number="1" style="v" sid="1CH 27:1"/>And <char style="add">these are</char> the sons of Israel according to their number of the heads of the fathers and the captains of the thousands and of the hundreds, and their officers who served the king in every matter of the divisions who came in and went out month by month throughout all the months of the year—one division <char style="add">being</char> twenty-four thousand. <verse eid="1CH 27:1"/></para>

<para style="q1"><verse number="2" style="v" sid="1CH 27:2"/>Over the first division for the first month <char style="add">was</char> Jashobeam son of Zabdiel—and in his division twenty-four thousand— <verse eid="1CH 27:2"/></para>

<para style="q1"><verse number="3" style="v" sid="1CH 27:3"/>of the sons of Perez, the chief of all the captains of the army for the first month. <verse eid="1CH 27:3"/></para>

<para style="q1"><verse number="4" style="v" sid="1CH 27:4"/>And over the division of the second month <char style="add">was</char> Dodai the Ahohite, and his division, and Mikloth <char style="add">was</char> the leader, and in his division <char style="add">were</char> twenty-four thousand. <note caller="+" style="f"><char style="fr" closed="false">27.4 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Dodai</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Dodo</char><char style="ft" closed="false">; see 2 Samuel 23:9.</char></note><verse eid="1CH 27:4"/></para>

<para style="q1"><verse number="5" style="v" sid="1CH 27:5"/>The captain of the third army for the third month <char style="add">was</char> Benaiah son of Jehoiada, the chief priest, and in his division <char style="add">were</char> twenty-four thousand. <verse eid="1CH 27:5"/></para>

<para style="q1"><verse number="6" style="v" sid="1CH 27:6"/>This Benaiah was mighty among the Thirty, and over the thirty, and <char style="add">over</char> his division <char style="add">was</char> Ammizabad his son. <verse eid="1CH 27:6"/></para>

<para style="q1"><verse number="7" style="v" sid="1CH 27:7"/>The fourth, for the fourth month, <char style="add">was</char> Asahel the brother of Joab, and Zebadiah his son after him, and in his division <char style="add">were</char> twenty-four thousand. <verse eid="1CH 27:7"/></para>

<para style="q1"><verse number="8" style="v" sid="1CH 27:8"/>The fifth, for the fifth month, <char style="add">was</char> the captain Shamhuth<note caller="+" style="f"><char style="fr" closed="false">27.8 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Shamhuth</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Shammoth</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">Shammah</char><char style="ft" closed="false">; see 1 Chronicles 11:27 and 2 Samuel 23:25.</char></note> the Izrahite, and in his division <char style="add">were</char> twenty-four thousand. <verse eid="1CH 27:8"/></para>

<para style="q1"><verse number="9" style="v" sid="1CH 27:9"/>The sixth, for the sixth month, <char style="add">was</char> Ira son of Ikkesh the Tekoite, and in his division <char style="add">were</char> twenty-four thousand. <verse eid="1CH 27:9"/></para>

<para style="q1"><verse number="10" style="v" sid="1CH 27:10"/>The seventh, for the seventh month, <char style="add">was</char> Helez the Pelonite, of the sons of Ephraim, and in his division <char style="add">were</char> twenty-four thousand. <verse eid="1CH 27:10"/></para>

<para style="q1"><verse number="11" style="v" sid="1CH 27:11"/>The eighth, for the eighth month, <char style="add">was</char> Sibbechai the Hushathite, of the Zerahites, and in his division <char style="add">were</char> twenty-four thousand. <verse eid="1CH 27:11"/></para>

<para style="q1"><verse number="12" style="v" sid="1CH 27:12"/>The ninth, for the ninth month, <char style="add">was</char> Abiezer the Anathothite, of the Benjamite, and in his division <char style="add">were</char> twenty-four thousand. <verse eid="1CH 27:12"/></para>

<para style="q1"><verse number="13" style="v" sid="1CH 27:13"/>The tenth, for the tenth month, <char style="add">was</char> Maharai the Netophathite, of the Zerahite, and in his division <char style="add">were</char> twenty-four thousand. <verse eid="1CH 27:13"/></para>

<para style="q1"><verse number="14" style="v" sid="1CH 27:14"/>The eleventh, for the eleventh month, <char style="add">was</char> Benaiah the Pirathonite, of the sons of Ephraim, and in his division <char style="add">were</char> twenty-four thousand. <verse eid="1CH 27:14"/></para>

<para style="q1"><verse number="15" style="v" sid="1CH 27:15"/>The twelfth, for the twelfth month, <char style="add">was</char> Heldai<note caller="+" style="f"><char style="fr" closed="false">27.15 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Heldai</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Heled</char><char style="ft" closed="false">; see 1 Chronicles 11:30 and 2 Samuel 23:29.</char></note> the Netophathite, of Othniel, and in his division <char style="add">were</char> twenty-four thousand. <verse eid="1CH 27:15"/></para>

<para style="s">The Leaders of the Twelve Tribes</para>

<para style="p"><verse number="16" style="v" sid="1CH 27:16"/>And over the tribes of Israel: </para>

<para style="q1" vid="1CH 27:16">Over the Reubenite, the officer <char style="add">was</char> Eliezer son of Zichri; </para>

<para style="q1" vid="1CH 27:16">over the Simeonite, Shephatiah son of Maacah; <verse eid="1CH 27:16"/></para>

<para style="q1"><verse number="17" style="v" sid="1CH 27:17"/>over Levi <char style="add">was</char> Hashabiah son of Kemuel; </para>

<para style="q1" vid="1CH 27:17">over Aaron, Zadok; <verse eid="1CH 27:17"/></para>

<para style="q1"><verse number="18" style="v" sid="1CH 27:18"/>over Judah <char style="add">was</char> Elihu of the brothers of David; </para>

<para style="q1" vid="1CH 27:18">over Issachar, Omri son of Michael; <verse eid="1CH 27:18"/></para>

<para style="q1"><verse number="19" style="v" sid="1CH 27:19"/>over Zebulun <char style="add">was</char> Ishmaiah son of Obadiah; </para>

<para style="q1" vid="1CH 27:19">over Naphtali, Jerimoth son of Azriel; <verse eid="1CH 27:19"/></para>

<para style="q1"><verse number="20" style="v" sid="1CH 27:20"/>over the sons of Ephraim <char style="add">was</char> Hoshea son of Azaziah; </para>

<para style="q1" vid="1CH 27:20">over the half-tribe of Manasseh, Joel son of Pedaiah; <verse eid="1CH 27:20"/></para>

<para style="q1"><verse number="21" style="v" sid="1CH 27:21"/>over the half of Manasseh in Gilead <char style="add">was</char> Iddo son of Zechariah; </para>

<para style="q1" vid="1CH 27:21">over Benjamin, Jaasiel son of Abner; <verse eid="1CH 27:21"/></para>

<para style="q1"><verse number="22" style="v" sid="1CH 27:22"/>over Dan <char style="add">was</char> Azarel son of Jeroham. </para>

<para style="p" vid="1CH 27:22">These <char style="add">were</char> the leaders of the tribes of Israel. <verse eid="1CH 27:22"/></para>

<para style="p"><verse number="23" style="v" sid="1CH 27:23"/>David did not take their number from a son of twenty years and under, because YHWH had said He would multiply Israel like the stars of the heavens. <verse eid="1CH 27:23"/></para>

<para style="p"><verse number="24" style="v" sid="1CH 27:24"/>Joab son of Zeruiah began to number, and he did not finish, and there was wrath for this upon Israel. The count did not go up into the number of the Words of the Days of King David. <verse eid="1CH 27:24"/></para>

<para style="s">David’s Various Overseers</para>

<para style="q1"><verse number="25" style="v" sid="1CH 27:25"/>And over the treasuries of the king <char style="add">was</char> Azmaveth son of Adiel; </para>

<para style="q1" vid="1CH 27:25">and over the storehouses in the field, in the cities, and in the villages, and in the towers, Jonathan son of Uzziah; <verse eid="1CH 27:25"/></para>

<para style="q1"><verse number="26" style="v" sid="1CH 27:26"/>and over those who did the work of the field for the service of the ground <char style="add">was</char> Ezri son of Chelub; <verse eid="1CH 27:26"/></para>

<para style="q1"><verse number="27" style="v" sid="1CH 27:27"/>and over the vineyards <char style="add">was</char> Shimei the Ramathite; </para>

<para style="q1" vid="1CH 27:27">and over the vineyards for the treasuries of wine <char style="add">was</char> Zabdi the Shiphmite; <verse eid="1CH 27:27"/></para>

<para style="q1"><verse number="28" style="v" sid="1CH 27:28"/>and over the olive trees and the sycamore trees that <char style="add">are</char> in the Shephelah<note caller="+" style="f"><char style="fr" closed="false">27.28 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">foothills</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">lowlands</char><char style="ft" closed="false">; that is, the western foothills of Judea</char></note> <char style="add">was</char> Baal-hanan the Gederite; </para>

<para style="q1" vid="1CH 27:28">and over the store of the oil <char style="add">was</char> Joash; <verse eid="1CH 27:28"/></para>

<para style="q1"><verse number="29" style="v" sid="1CH 27:29"/>and over the herd that fed in Sharon <char style="add">was</char> Shitrai the Sharonite; </para>

<para style="q1" vid="1CH 27:29">and over the herd in the valleys <char style="add">was</char> Shaphat son of Adlai; <verse eid="1CH 27:29"/></para>

<para style="q1"><verse number="30" style="v" sid="1CH 27:30"/>and over the camels <char style="add">was</char> Obil the Ishmaelite; </para>

<para style="q1" vid="1CH 27:30">and over the donkeys <char style="add">was</char> Jehdeiah the Meronothite; <verse eid="1CH 27:30"/></para>

<para style="q1"><verse number="31" style="v" sid="1CH 27:31"/>and over the flock <char style="add">was</char> Jaziz the Hagrite. </para>

<para style="q1" vid="1CH 27:31">All these <char style="add">were</char> heads of the property that <char style="add">was</char> unto King David. <verse eid="1CH 27:31"/></para>

<para style="s">The Counselors</para>

<para style="q1"><verse number="32" style="v" sid="1CH 27:32"/>And Jonathan uncle of David—<char style="add">was</char> a counselor, a wise man, and he <char style="add">was</char> a scribe; </para>

<para style="q1" vid="1CH 27:32">and Jehiel son of Hachmoni <char style="add">was</char> with the sons of the king; <verse eid="1CH 27:32"/></para>

<para style="q1"><verse number="33" style="v" sid="1CH 27:33"/>and Ahithophel <char style="add">was</char> counselor of the king; </para>

<para style="q1" vid="1CH 27:33">and Hushai the Archite <char style="add">was</char> companion of the king. <verse eid="1CH 27:33"/></para>

<para style="q1"><verse number="34" style="v" sid="1CH 27:34"/>And after Ahithophel <char style="add">was</char> Jehoiada son of Benaiah, and Abiathar; </para>

<para style="q1" vid="1CH 27:34">and the head of the host of the king <char style="add">was</char> Joab. <verse eid="1CH 27:34"/></para>

<chapter eid="1CH 27"/>

<chapter number="28" style="c" sid="1CH 28"/>

<para style="s">David Commissions Solomon</para>

<para style="p"><verse number="1" style="v" sid="1CH 28:1"/>And David assembled all the heads of Israel, the heads of the tribes, and the heads of the divisions who served the king, and the heads of the thousands, and the heads of the hundreds, and the heads of all the property and possessions of the king and of his sons, with the officials and the mighty men, and all the mighty men of valor at Jerusalem. <verse eid="1CH 28:1"/></para>

<para style="p"><verse number="2" style="v" sid="1CH 28:2"/>And King David rose to his feet and said, “Hear me, my brothers and my people. I <char style="add">had</char> in my heart to build a house of rest for the ark of the covenant of YHWH, and for the footstool of our God, and I had made preparations to build it. <verse eid="1CH 28:2"/></para>

<para style="p"><verse number="3" style="v" sid="1CH 28:3"/>And God said to me, ‘You shall not build a house for My name, because you <char style="add">are</char> a man of war, and you have shed blood.’ <verse eid="1CH 28:3"/></para>

<para style="p"><verse number="4" style="v" sid="1CH 28:4"/>And YHWH, God of Israel, chose me above all the house of my father to be king over Israel forever. For among Judah he chose for a leader, and in the house of Judah, the house of my father, and among the sons of my father, He was pleased with me to make <char style="add">me</char> king over all Israel. <verse eid="1CH 28:4"/></para>

<para style="p"><verse number="5" style="v" sid="1CH 28:5"/>And of all my sons—for many sons YHWH has given me—also He has chosen Solomon my son to sit on the throne of the kingdom of YHWH over Israel. <verse eid="1CH 28:5"/></para>

<para style="p"><verse number="6" style="v" sid="1CH 28:6"/>And He said to me, ‘Solomon your son—he shall build My house and My courts, for I have chosen him <char style="add">to be</char> My son, and I will be his Father. <verse eid="1CH 28:6"/></para>

<para style="p"><verse number="7" style="v" sid="1CH 28:7"/>And I will establish his kingdom even to forever, if he is strong to do My commandments and My ordinances, as this day.’ <verse eid="1CH 28:7"/></para>

<para style="p"><verse number="8" style="v" sid="1CH 28:8"/>And now in the eyes of all Israel the assembly of YHWH, and in the ears of our God, be careful and seek out all the commandments of YHWH your⁺ God, that you⁺ may possess the good land for your⁺ children and leave <char style="add">it</char> as an inheritance after you⁺ even to forever. <verse eid="1CH 28:8"/></para>

<para style="p"><verse number="9" style="v" sid="1CH 28:9"/>And as for you, Solomon my son, know the God of your father and serve Him with a perfect heart and with a willing mind, for YHWH searches all hearts, and He understands all the intent of thoughts. If you seek Him, He will be found by you; but if you forsake Him, He will cast you off forever. <verse eid="1CH 28:9"/></para>

<para style="p"><verse number="10" style="v" sid="1CH 28:10"/>See now, for YHWH has chosen you to build a house for the sanctuary. Be strong and do it.” <verse eid="1CH 28:10"/></para>

<para style="s">The Plans for the Temple</para>

<para style="p"><verse number="11" style="v" sid="1CH 28:11"/>And David gave to Solomon his son the pattern of the porch <char style="add">of the temple</char>,<note caller="+" style="f"><char style="fr" closed="false">28.11 </char><char style="ft" closed="false"> LXX; Hebrew does not include </char><char style="fq" closed="false">of the temple</char><char style="ft" closed="false">.</char></note> and its houses, and its treasuries, and its upper chambers, and its inner chambers, and the house of the mercy seat,<note caller="+" style="f"><char style="fr" closed="false">28.11 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">atonement cover</char></note> <verse eid="1CH 28:11"/></para>

<para style="p"><verse number="12" style="v" sid="1CH 28:12"/>and the pattern of all that was by the Spirit with him,<note caller="+" style="f"><char style="fr" closed="false">28.12 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">all that he had in mind</char></note> of the courts of the house of YHWH, and of all the chambers all around, of the treasuries of the house of God, and of the treasuries of the holy things, <verse eid="1CH 28:12"/></para>

<para style="p"><verse number="13" style="v" sid="1CH 28:13"/>and for the divisions of the priests and the Levites, and for all the work of the service of the house of YHWH, and for all the articles of service in the house of YHWH: <verse eid="1CH 28:13"/></para>

<para style="q1"><verse number="14" style="v" sid="1CH 28:14"/>Even the gold by weight for the gold, for all articles of every kind of service; </para>

<para style="q1" vid="1CH 28:14">and for all articles of silver by weight, and for all articles of every kind of service; <verse eid="1CH 28:14"/></para>

<para style="q1"><verse number="15" style="v" sid="1CH 28:15"/>and the weight for the lampstands of gold, and their lamps of gold, by weight of each lampstand and for each lampstand, and its lamps; </para>

<para style="q1" vid="1CH 28:15">and for the lampstands of silver, by weight for the lampstand and its lamps, according to the service of each lampstand and for each lampstand; <verse eid="1CH 28:15"/></para>

<para style="q1"><verse number="16" style="v" sid="1CH 28:16"/>and the gold by weight for the tables of the showbread, for each table; and the silver for the tables of silver; <verse eid="1CH 28:16"/></para>

<para style="q1"><verse number="17" style="v" sid="1CH 28:17"/>and the forks, and the sprinkling bowls, and the pitchers of pure gold; </para>

<para style="q1" vid="1CH 28:17">and the golden bowls by weight for every bowl; </para>

<para style="q1" vid="1CH 28:17">and for the silver bowls, by weight for every bowl; <verse eid="1CH 28:17"/></para>

<para style="q1"><verse number="18" style="v" sid="1CH 28:18"/>and for the altar of incense, the refined gold by weight; </para>

<para style="q1" vid="1CH 28:18">and for the pattern of the chariot of the gold cherubim, spreading and covering over the ark of the covenant of YHWH. <verse eid="1CH 28:18"/></para>

<para style="p"><verse number="19" style="v" sid="1CH 28:19"/>“The entirety <char style="add">is</char> in writing from the hand of YHWH upon me. He has made me understand all the works of the pattern.” <verse eid="1CH 28:19"/></para>

<para style="p"><verse number="20" style="v" sid="1CH 28:20"/>And David said to Solomon his son, “Be strong and be courageous and do <char style="add">it</char>. Do not fear and do not be dismayed, for YHWH God, my God, <char style="add">is</char> with you. He will not leave you and he will not forsake you until the completion of all the work of the service of the house of YHWH. <verse eid="1CH 28:20"/></para>

<para style="p"><verse number="21" style="v" sid="1CH 28:21"/>And behold, the divisions of the priests and the Levites for all the service of the house of God, and with you for all manner of workmanship <char style="add">is</char> every willing one with wisdom for every service, and the heads and all the people <char style="add">are</char> according to all your command.” <verse eid="1CH 28:21"/></para>

<chapter eid="1CH 28"/>

<chapter number="29" style="c" sid="1CH 29"/>

<para style="s">Offerings for the Temple</para>

<para style="p"><verse number="1" style="v" sid="1CH 29:1"/>And David the king said to all the assembly, “Solomon My son—the one whom God has chosen—<char style="add">is</char> young and tender, and the work <char style="add">is</char> great, because the palace <char style="add">is</char> not for man, but for YHWH God. <verse eid="1CH 29:1"/></para>

<para style="p"><verse number="2" style="v" sid="1CH 29:2"/>And with all my power I have provided for the house of my God: The gold for the <char style="add">things of</char> gold, and the silver for the <char style="add">things of</char> silver, and the bronze for the <char style="add">things of</char> bronze, the iron for the <char style="add">things of</char> iron, and the wood for the <char style="add">things of</char> wood, onyx stones, and settings, and stones of glistening and various colors, and all precious stone, and stones of marble, in abundance. <verse eid="1CH 29:2"/></para>

<para style="p"><verse number="3" style="v" sid="1CH 29:3"/>And again, in my delighting in the house of my God, is unto me a peculiar treasure of gold and silver I have given to the house of my God above all that I have prepared for the house of the sanctuary: <verse eid="1CH 29:3"/></para>

<para style="p"><verse number="4" style="v" sid="1CH 29:4"/>Three thousand talents of gold<note caller="+" style="f"><char style="fr" closed="false">29.4 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">3,000 talents</char><char style="ft" closed="false"> is approximately 113 tons or 103 metric tons of gold.</char></note> (of the gold of Ophir) and seven thousand talents of refined silver,<note caller="+" style="f"><char style="fr" closed="false">29.4 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">7,000 talents</char><char style="ft" closed="false"> is approximately 264 tons or 239.5 metric tons of silver.</char></note> to overlay the walls of the houses, <verse eid="1CH 29:4"/></para>

<para style="p"><verse number="5" style="v" sid="1CH 29:5"/>even the gold for the <char style="add">things of</char> gold, and the silver for the <char style="add">things of</char> silver, and for all the work by the hand of craftsmen. And who is willing to consecrate himself today to YHWH?” <verse eid="1CH 29:5"/></para>

<para style="p"><verse number="6" style="v" sid="1CH 29:6"/>And the heads of the fathers, and the heads of the tribes of Israel, and the heads of the thousands and of the hundreds, and the heads of the work of the king, offered freely. <verse eid="1CH 29:6"/></para>

<para style="p"><verse number="7" style="v" sid="1CH 29:7"/>And they gave for the work of the house of God five thousand talents of gold,<note caller="+" style="f"><char style="fr" closed="false">29.7 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">5,000 talents</char><char style="ft" closed="false"> is approximately 188.5 tons or 171 metric tons of gold.</char></note> and a myriad of darics,<note caller="+" style="f"><char style="fr" closed="false">29.7 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">10,000 gold drachmas</char><char style="ft" closed="false">; that is, approximately 185.2 pounds or 84 kilograms of gold coins</char></note> and ten thousand talents of silver,<note caller="+" style="f"><char style="fr" closed="false">29.7 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">10,000 talents</char><char style="ft" closed="false"> is approximately 377 tons or 342 metric tons of silver.</char></note> and a myriad and eight thousand talents of bronze,<note caller="+" style="f"><char style="fr" closed="false">29.7 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">18,000 talents</char><char style="ft" closed="false"> is approximately 678.6 tons or 615.6 metric tons of bronze.</char></note> and a hundred thousand talents of iron.<note caller="+" style="f"><char style="fr" closed="false">29.7 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">100,000 talents</char><char style="ft" closed="false"> is approximately 3,770 tons or 3,420 metric tons of iron.</char></note> <verse eid="1CH 29:7"/></para>

<para style="p"><verse number="8" style="v" sid="1CH 29:8"/>And he with whom stones were found gave <char style="add">them</char> to the treasury of the house of YHWH, by the hand of Jehiel<note caller="+" style="f"><char style="fr" closed="false">29.8 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">Jehiel</char><char style="ft" closed="false"> is a variant of </char><char style="fq" closed="false">Jehieli</char><char style="ft" closed="false">; see 1 Chronicles 26:21.</char></note> the Gershonite. <verse eid="1CH 29:8"/></para>

<para style="p"><verse number="9" style="v" sid="1CH 29:9"/>And the people rejoiced, because they offered freely, for with a loyal heart they offered freely to YHWH. And also David the king rejoiced <char style="add">with</char> great joy. <verse eid="1CH 29:9"/></para>

<para style="s">David’s Prayer of Blessing</para>

<para style="p"><verse number="10" style="v" sid="1CH 29:10"/>And David blessed YHWH before all the assembly, and David said, </para>

<para style="p" vid="1CH 29:10">“Blessed are You, O YHWH, God of Israel, our Father, from forever and even to forever. <verse eid="1CH 29:10"/></para>

<para style="p"><verse number="11" style="v" sid="1CH 29:11"/>To You, O YHWH, <char style="add">is</char> the greatness, and the power, and the glory, and the victory, and the majesty, because of everything in the heavens and on earth. To You, O YHWH, <char style="add">is</char> the kingdom, and You are exalted over all as head. <verse eid="1CH 29:11"/></para>

<para style="p"><verse number="12" style="v" sid="1CH 29:12"/>And the riches and the honor <char style="add">are</char> from before You, and You reign over all, and in Your hand <char style="add">is</char> power and might, and in Your hand <char style="add">is</char> to exalt and to give strength to all. <verse eid="1CH 29:12"/></para>

<para style="p"><verse number="13" style="v" sid="1CH 29:13"/>And now, our God, we thank You and praise Your glorious name. <verse eid="1CH 29:13"/></para>

<para style="p"><verse number="14" style="v" sid="1CH 29:14"/>But who <char style="add">am</char> I, and who <char style="add">are</char> my people, that we should retain power like this to offer freely? For from You <char style="add">are</char> all things, and from Your hand we have given to You. <verse eid="1CH 29:14"/></para>

<para style="p"><verse number="15" style="v" sid="1CH 29:15"/>For we <char style="add">are</char> sojourners before You, and pilgrims, as all our fathers. As a shadow <char style="add">are</char> our days on the earth, and without hope. <verse eid="1CH 29:15"/></para>

<para style="p"><verse number="16" style="v" sid="1CH 29:16"/>O YHWH our God, all this abundance that we have prepared to build for You a house—for Your holy name—is from Your hand, and all <char style="add">is</char> unto You. <verse eid="1CH 29:16"/></para>

<para style="p"><verse number="17" style="v" sid="1CH 29:17"/>And I know, my God, that You examine the heart, and in uprightness You are pleased. I, in the uprightness of my heart, I have offered freely all these <char style="add">things</char>; and now Your people found here I have seen with joy to offer freely to You. <verse eid="1CH 29:17"/></para>

<para style="p"><verse number="18" style="v" sid="1CH 29:18"/>O YHWH, God of Abraham, <char style="add">and</char> Isaac, and Israel, our fathers, keep this forever in the intent of the thoughts of the heart of Your people, and fix their heart toward You. <verse eid="1CH 29:18"/></para>

<para style="p"><verse number="19" style="v" sid="1CH 29:19"/>And to Solomon my son give a perfect heart, to keep Your commandments, Your testimonies, and Your statutes, and to do the whole, even to build the palace for which I have prepared.” <verse eid="1CH 29:19"/></para>

<para style="p"><verse number="20" style="v" sid="1CH 29:20"/>And David said to all the assembly, “Bless now YHWH your⁺ God.” </para>

<para style="p" vid="1CH 29:20">And all the assembly blessed YHWH, the God of their fathers, and they bowed down, and paid homage to YHWH and to the king. <verse eid="1CH 29:20"/></para>

<para style="s">Solomon Anointed King1 Kings 1:32–40</para>

<para style="p"><verse number="21" style="v" sid="1CH 29:21"/>And they made sacrifices to YHWH and offered burnt offerings to YHWH on that next day: A thousand bulls, a thousand rams, a thousand lambs, with their drink offerings and sacrifices in abundance for all Israel. <verse eid="1CH 29:21"/></para>

<para style="p"><verse number="22" style="v" sid="1CH 29:22"/>And they ate and drank before the face of YHWH on that day with great joy. </para>

<para style="p" vid="1CH 29:22">And Solomon son of David they made king a second <char style="add">time</char>, and they anointed <char style="add">him</char> before YHWH for a leader, and Zadok for priest. <verse eid="1CH 29:22"/></para>

<para style="p"><verse number="23" style="v" sid="1CH 29:23"/>And Solomon sat on the throne of YHWH as king instead of David his father, and he prospered. And all Israel listened to him. <verse eid="1CH 29:23"/></para>

<para style="p"><verse number="24" style="v" sid="1CH 29:24"/>And all the leaders, and the mighty men, and also all the sons of King David gave a hand under King Solomon. <verse eid="1CH 29:24"/></para>

<para style="p"><verse number="25" style="v" sid="1CH 29:25"/>And YHWH exceedingly exalted Solomon in the eyes of all Israel, and He bestowed on him royal majesty as had not been on any king in Israel before him. <verse eid="1CH 29:25"/></para>

<para style="s">David’s Reign and Death1 Kings 2:10–12</para>

<para style="p"><verse number="26" style="v" sid="1CH 29:26"/>And David son of Jesse reigned over all Israel. <verse eid="1CH 29:26"/></para>

<para style="p"><verse number="27" style="v" sid="1CH 29:27"/>And the days that he reigned over Israel <char style="add">were</char> forty years—in Hebron he reigned seven years, and in Jerusalem He reigned thirty-three. <verse eid="1CH 29:27"/></para>

<para style="p"><verse number="28" style="v" sid="1CH 29:28"/>And he died in a good old age, full of days and riches and honor. And Solomon his son reigned in his place. <verse eid="1CH 29:28"/></para>

<para style="p"><verse number="29" style="v" sid="1CH 29:29"/>And the acts of David the king, the first and the last, indeed they <char style="add">are</char> written in the words of Samuel the Seer and in the words of Nathan the Prophet, and in the words of Gad the Seer, <verse eid="1CH 29:29"/></para>

<para style="p"><verse number="30" style="v" sid="1CH 29:30"/>with all his reign, and his might, and the times that happened to him and to Israel and to all the kingdoms of the lands. <verse eid="1CH 29:30"/></para>

<chapter eid="1CH 29"/>

</usx>
