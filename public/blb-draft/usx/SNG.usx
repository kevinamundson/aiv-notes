<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.1">
<book code="SNG" style="id">BLB-Draft</book>

<para style="h">Song of Solomon</para>

<para style="toc1">Song of Solomon</para>

<para style="rem">sourceUrl=https://literalbible.com/blb.docx fetchedAtUtc=2026-09-01T15:43:00Z status=draft id=BLB-Draft spec=USFM-USX 3.1.1 char:add=docx-italic note:f=docx-footnotes note:x=docx-heading-crossrefs</para>

<chapter number="1" style="c" sid="SNG 1"/>

<para style="s">The Bride Confesses Her Love</para>

<para style="p"><verse number="1" style="v" sid="SNG 1:1"/><note caller="-" style="x"><char style="xt" closed="false">1 Peter 3:1–7</char></note><note caller="-" style="x"><char style="xt" closed="false">Ephesians 5:22–33</char></note>The Song of Songs that <char style="add">is</char> of Solomon.<note caller="+" style="f"><char style="fr" closed="false">1.1 </char><char style="ft" closed="false"> Most translators add subheadings for speaker identifications such as </char><char style="fq" closed="false">The Bride</char><char style="ft" closed="false">, </char><char style="fq" closed="false">The Groom</char><char style="ft" closed="false">, and </char><char style="fq" closed="false">The Friends</char><char style="ft" closed="false"> based on the gender and number of the Hebrew words.</char></note> <verse eid="SNG 1:1"/></para>

<para style="s2">The Bride</para>

<para style="q1"><verse number="2" style="v" sid="SNG 1:2"/>Let him kiss me with the kisses of his mouth! </para>

<para style="q2" vid="SNG 1:2">For your love <char style="add">is</char> better than wine. <verse eid="SNG 1:2"/></para>

<para style="q1"><verse number="3" style="v" sid="SNG 1:3"/>Your oils <char style="add">are</char> good for fragrance; </para>

<para style="q2" vid="SNG 1:3">your name <char style="add">is</char> oil poured out; </para>

<para style="q2" vid="SNG 1:3">upon thus the maidens love you. <verse eid="SNG 1:3"/></para>

<para style="q1"><verse number="4" style="v" sid="SNG 1:4"/>Draw me after you, let us run! </para>

<para style="q2" vid="SNG 1:4">The king has brought me <char style="add">into</char> his chambers. </para>

<para style="q1" vid="SNG 1:4">We will rejoice and will be glad in you; </para>

<para style="q2" vid="SNG 1:4">we will cause your love to be remembered more than wine; </para>

<para style="q1" vid="SNG 1:4">rightly do they love you. <verse eid="SNG 1:4"/></para>

<para style="s2">The Friends</para>

<para style="s2">The Bride</para>

<para style="q1"><verse number="5" style="v" sid="SNG 1:5"/>Black <char style="add">am</char> I, and lovely, O daughters of Jerusalem, </para>

<para style="q2" vid="SNG 1:5">like the tents of Kedar, like the curtains of Solomon. <verse eid="SNG 1:5"/></para>

<para style="q1"><verse number="6" style="v" sid="SNG 1:6"/>Do not look at me because I <char style="add">am</char> black, </para>

<para style="q2" vid="SNG 1:6"><char style="add">for</char> the sun has gazed upon me. </para>

<para style="q1" vid="SNG 1:6">The sons of my mother were hot with me; </para>

<para style="q2" vid="SNG 1:6">they set me keeping the vineyards; </para>

<para style="q2" vid="SNG 1:6">my own vineyard I have not kept. <verse eid="SNG 1:6"/></para>

<para style="q1"><verse number="7" style="v" sid="SNG 1:7"/>Declare to me, O one my soul loves, </para>

<para style="q2" vid="SNG 1:7">where do you pasture, </para>

<para style="q2" vid="SNG 1:7">where do you let them rest at midday? </para>

<para style="q1" vid="SNG 1:7">For why should I be as one veiling herself </para>

<para style="q2" vid="SNG 1:7"><char style="add">to go</char> alongside the flocks of your companions? <verse eid="SNG 1:7"/></para>

<para style="s2">The Friends</para>

<para style="q1"><verse number="8" style="v" sid="SNG 1:8"/>If you do not know <char style="add">it</char> for yourself, O fairest among the women, </para>

<para style="q2" vid="SNG 1:8">go forth yourself in the tracks of the flock, </para>

<para style="q1" vid="SNG 1:8">and pasture your young goats </para>

<para style="q2" vid="SNG 1:8">beside the tents of the shepherds. <verse eid="SNG 1:8"/></para>

<para style="s2">The Bridegroom</para>

<para style="q1"><verse number="9" style="v" sid="SNG 1:9"/>To a mare among the chariots of Pharaoh </para>

<para style="q2" vid="SNG 1:9">I have likened you, my darling. <verse eid="SNG 1:9"/></para>

<para style="q1"><verse number="10" style="v" sid="SNG 1:10"/>Lovely are your cheeks with ornaments, </para>

<para style="q2" vid="SNG 1:10">your neck with strings of jewels. <verse eid="SNG 1:10"/></para>

<para style="s2">The Friends</para>

<para style="q1"><verse number="11" style="v" sid="SNG 1:11"/>Ornaments of gold we will make for you, </para>

<para style="q2" vid="SNG 1:11">with studs of silver. <verse eid="SNG 1:11"/></para>

<para style="s2">The Bride</para>

<para style="q1"><verse number="12" style="v" sid="SNG 1:12"/>While the king <char style="add">was</char> at his table, </para>

<para style="q2" vid="SNG 1:12">my spikenard gave forth its fragrance. <verse eid="SNG 1:12"/></para>

<para style="q1"><verse number="13" style="v" sid="SNG 1:13"/>A bundle of myrrh <char style="add">is</char> my beloved to me; </para>

<para style="q2" vid="SNG 1:13">between my breasts it lodges. <verse eid="SNG 1:13"/></para>

<para style="q1"><verse number="14" style="v" sid="SNG 1:14"/>A cluster of henna blossoms <char style="add">is</char> my beloved to me </para>

<para style="q2" vid="SNG 1:14">in the vineyards of En-gedi. <verse eid="SNG 1:14"/></para>

<para style="s2">The Bridegroom</para>

<para style="q1"><verse number="15" style="v" sid="SNG 1:15"/>Behold, you <char style="add">are</char> beautiful, my darling, </para>

<para style="q2" vid="SNG 1:15">behold, you <char style="add">are</char> beautiful! </para>

<para style="q2" vid="SNG 1:15">Your eyes are doves. <verse eid="SNG 1:15"/></para>

<para style="s2">The Bride</para>

<para style="q1"><verse number="16" style="v" sid="SNG 1:16"/>Behold, you <char style="add">are</char> beautiful, my beloved, </para>

<para style="q2" vid="SNG 1:16">truly lovely indeed! </para>

<para style="q2" vid="SNG 1:16">Our bed <char style="add">is</char> green. <verse eid="SNG 1:16"/></para>

<para style="s2">The Bridegroom</para>

<para style="q1"><verse number="17" style="v" sid="SNG 1:17"/>The beams of our house <char style="add">are</char> cedars, </para>

<para style="q2" vid="SNG 1:17">our rafters <char style="add">are</char> firs. <verse eid="SNG 1:17"/></para>

<chapter eid="SNG 1"/>

<chapter number="2" style="c" sid="SNG 2"/>

<para style="s">The Bride’s Admiration</para>

<para style="s2">The Bride</para>

<para style="q1"><verse number="1" style="v" sid="SNG 2:1"/>I <char style="add">am</char> a rose of Sharon,<note caller="+" style="f"><char style="fr" closed="false">2.1 </char><char style="ft" closed="false"> Sharon Plain is a region in the coastal plain of Israel</char></note> </para>

<para style="q2" vid="SNG 2:1">a lily of the valleys. <verse eid="SNG 2:1"/></para>

<para style="s2">The Bridegroom</para>

<para style="q1"><verse number="2" style="v" sid="SNG 2:2"/>Like a lily among the thorns, </para>

<para style="q2" vid="SNG 2:2">so is my love among the daughters. <verse eid="SNG 2:2"/></para>

<para style="s2">The Bride</para>

<para style="q1"><verse number="3" style="v" sid="SNG 2:3"/>Like an apple tree among the trees of the woods, </para>

<para style="q2" vid="SNG 2:3">so <char style="add">is</char> my beloved among the sons; </para>

<para style="q1" vid="SNG 2:3">in his shade I have delighted and sat down, </para>

<para style="q2" vid="SNG 2:3">and his fruit <char style="add">is</char> sweet to my palate. <verse eid="SNG 2:3"/></para>

<para style="q1"><verse number="4" style="v" sid="SNG 2:4"/>He has brought me to the house of wine,<note caller="+" style="f"><char style="fr" closed="false">2.4 </char><char style="ft" closed="false"> That is, the banquet hall</char></note> </para>

<para style="q2" vid="SNG 2:4">and his banner over me <char style="add">was</char> love. <verse eid="SNG 2:4"/></para>

<para style="q1"><verse number="5" style="v" sid="SNG 2:5"/>Sustain me with raisin-cakes, </para>

<para style="q2" vid="SNG 2:5">refresh me with apples—</para>

<para style="q2" vid="SNG 2:5">for I <char style="add">am</char> sick with love. <verse eid="SNG 2:5"/></para>

<para style="q1"><verse number="6" style="v" sid="SNG 2:6"/>His left hand <char style="add">is</char> under my head, </para>

<para style="q2" vid="SNG 2:6">and his right hand embraces me. <verse eid="SNG 2:6"/></para>

<para style="q1"><verse number="7" style="v" sid="SNG 2:7"/>I adjure you⁺, O daughters of Jerusalem, </para>

<para style="q2" vid="SNG 2:7">by the gazelles or by the does of the field—</para>

<para style="q1" vid="SNG 2:7">do not arouse or awaken love, </para>

<para style="q2" vid="SNG 2:7">until it pleases. <verse eid="SNG 2:7"/></para>

<para style="q1"><verse number="8" style="v" sid="SNG 2:8"/>The voice of my beloved! </para>

<para style="q2" vid="SNG 2:8">Behold, this one is coming, </para>

<para style="q1" vid="SNG 2:8">leaping over the mountains, </para>

<para style="q2" vid="SNG 2:8">bounding over the hills. <verse eid="SNG 2:8"/></para>

<para style="q1"><verse number="9" style="v" sid="SNG 2:9"/>My beloved <char style="add">is</char> being like to a gazelle, or to a young stag of the deer. </para>

<para style="q2" vid="SNG 2:9">Behold, this one is standing behind our wall, </para>

<para style="q1" vid="SNG 2:9">gazing through the windows, </para>

<para style="q2" vid="SNG 2:9">peering through the lattices. <verse eid="SNG 2:9"/></para>

<para style="q1"><verse number="10" style="v" sid="SNG 2:10"/>My beloved answered and said to me, </para>

<para style="q2" vid="SNG 2:10">“Rise up, my my darling, </para>

<para style="q2" vid="SNG 2:10">my beautiful one, come away yourself! <verse eid="SNG 2:10"/></para>

<para style="q1"><verse number="11" style="v" sid="SNG 2:11"/>For, behold, the winter has passed by; </para>

<para style="q2" vid="SNG 2:11">the rain has passed; it has gone itself. <verse eid="SNG 2:11"/></para>

<para style="q1"><verse number="12" style="v" sid="SNG 2:12"/>The blossoms have appeared in the land, </para>

<para style="q2" vid="SNG 2:12">the time of singing<note caller="+" style="f"><char style="fr" closed="false">2.12 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">pruning</char></note> has come, </para>

<para style="q1" vid="SNG 2:12">and the voice of the turtledove </para>

<para style="q2" vid="SNG 2:12">is heard in our land; <verse eid="SNG 2:12"/></para>

<para style="q1"><verse number="13" style="v" sid="SNG 2:13"/>the fig tree puts forth her green figs, </para>

<para style="q2" vid="SNG 2:13">and the vines <char style="add">in</char> blossom have given forth the fragrance. </para>

<para style="q1" vid="SNG 2:13">Arise, come my darling, </para>

<para style="q2" vid="SNG 2:13">my beautiful one, and come away yourself!” <verse eid="SNG 2:13"/></para>

<para style="s2">The Bridegroom</para>

<para style="q1"><verse number="14" style="v" sid="SNG 2:14"/>O my dove in the clefts of the rock, </para>

<para style="q2" vid="SNG 2:14">in the crevices of the cliff, </para>

<para style="q1" vid="SNG 2:14">let me see your face, </para>

<para style="q2" vid="SNG 2:14">let me hear your voice; </para>

<para style="q1" vid="SNG 2:14">for your voice <char style="add">is</char> sweet </para>

<para style="q2" vid="SNG 2:14">and your appearance <char style="add">is</char> lovely. <verse eid="SNG 2:14"/></para>

<para style="s2">The Friends</para>

<para style="q1"><verse number="15" style="v" sid="SNG 2:15"/>Catch for us the foxes, </para>

<para style="q2" vid="SNG 2:15">the little foxes ruining the vineyards, </para>

<para style="q2" vid="SNG 2:15">and our vineyards <char style="add">are</char> in blossom. <verse eid="SNG 2:15"/></para>

<para style="s2">The Bride</para>

<para style="q1"><verse number="16" style="v" sid="SNG 2:16"/>My beloved <char style="add">is</char> unto me and I unto him; </para>

<para style="q2" vid="SNG 2:16">he is grazing among the lilies. <verse eid="SNG 2:16"/></para>

<para style="q1"><verse number="17" style="v" sid="SNG 2:17"/>Until the day breathes and the shadows flee, </para>

<para style="q2" vid="SNG 2:17">may you turn and be likened </para>

<para style="q1" vid="SNG 2:17">yourself, my beloved, to a gazelle </para>

<para style="q2" vid="SNG 2:17">or to a young stag of the deer, upon the mountains of Bether.<note caller="+" style="f"><char style="fr" closed="false">2.17 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the rugged mountains</char></note> <verse eid="SNG 2:17"/></para>

<chapter eid="SNG 2"/>

<chapter number="3" style="c" sid="SNG 3"/>

<para style="s">The Bride’s Dream</para>

<para style="q1"><verse number="1" style="v" sid="SNG 3:1"/>On my bed in the night </para>

<para style="q2" vid="SNG 3:1">I sought him whom my soul loves; </para>

<para style="q1" vid="SNG 3:1">I sought him, </para>

<para style="q2" vid="SNG 3:1">and I did not find him. <verse eid="SNG 3:1"/></para>

<para style="q1"><verse number="2" style="v" sid="SNG 3:2"/>Now I will rise and go about the city, </para>

<para style="q2" vid="SNG 3:2">in the streets and in the broad places; </para>

<para style="q1" vid="SNG 3:2">I will seek the one whom my soul loves. </para>

<para style="q2" vid="SNG 3:2">I sought him, and I did not find him. <verse eid="SNG 3:2"/></para>

<para style="q1"><verse number="3" style="v" sid="SNG 3:3"/>The guards found me in <char style="add">their</char> going round about the city. </para>

<para style="q2" vid="SNG 3:3">“The one my soul loves, have you⁺ seen <char style="add">him</char>?” <verse eid="SNG 3:3"/></para>

<para style="q1"><verse number="4" style="v" sid="SNG 3:4"/>Scarcely had I passed by them when I found the one my soul loves; </para>

<para style="q2" vid="SNG 3:4">I held him, and I would not let him go, </para>

<para style="q1" vid="SNG 3:4">until I had brought him to the house of my mother, </para>

<para style="q2" vid="SNG 3:4">and into the chamber of her who conceived me. <verse eid="SNG 3:4"/></para>

<para style="q1"><verse number="5" style="v" sid="SNG 3:5"/>I adjure you⁺, O daughters of Jerusalem, </para>

<para style="q2" vid="SNG 3:5">by the gazelles or by the does of the field, </para>

<para style="q1" vid="SNG 3:5">do not arouse or awaken love, </para>

<para style="q2" vid="SNG 3:5">until it pleases. <verse eid="SNG 3:5"/></para>

<para style="s">Solomon Arrives on His Wedding Day</para>

<para style="q1"><verse number="6" style="v" sid="SNG 3:6"/>Who <char style="add">is</char> this coming up from the wilderness, </para>

<para style="q2" vid="SNG 3:6">like pillars of smoke, </para>

<para style="q1" vid="SNG 3:6">scented with myrrh and frankincense, </para>

<para style="q2" vid="SNG 3:6">with all the fragrant powders of the merchant? <verse eid="SNG 3:6"/></para>

<para style="q1"><verse number="7" style="v" sid="SNG 3:7"/>Behold, <char style="add">it is</char> the couch<note caller="+" style="f"><char style="fr" closed="false">3.7 </char><char style="ft" closed="false"> That is, the couch on which servants carry a king</char></note> of Solomon! </para>

<para style="q2" vid="SNG 3:7">Sixty mighty men <char style="add">are</char> around it, the mighty ones of Israel. <verse eid="SNG 3:7"/></para>

<para style="q1"><verse number="8" style="v" sid="SNG 3:8"/>All of them are grasping a sword, </para>

<para style="q2" vid="SNG 3:8">studied in warfare; </para>

<para style="q1" vid="SNG 3:8">each man <char style="add">has</char> his sword upon his thigh, </para>

<para style="q2" vid="SNG 3:8">against the dread in the nights. <verse eid="SNG 3:8"/></para>

<para style="q1"><verse number="9" style="v" sid="SNG 3:9"/>King Solomon has made a carriage for himself </para>

<para style="q2" vid="SNG 3:9">from the trees of the Lebanon. <verse eid="SNG 3:9"/></para>

<para style="q1"><verse number="10" style="v" sid="SNG 3:10"/>Its pillars He has made of silver, </para>

<para style="q2" vid="SNG 3:10">its back of gold, its seat of purple; </para>

<para style="q1" vid="SNG 3:10">its midst is inlaid with love, </para>

<para style="q2" vid="SNG 3:10">by the daughters of Jerusalem. <verse eid="SNG 3:10"/></para>

<para style="q1"><verse number="11" style="v" sid="SNG 3:11"/>Go forth and gaze, O daughters of Zion, </para>

<para style="q2" vid="SNG 3:11">at King Solomon, </para>

<para style="q1" vid="SNG 3:11">at the crown with which his mother crowned him </para>

<para style="q2" vid="SNG 3:11">on the day of his wedding, </para>

<para style="q2" vid="SNG 3:11">and on the day of the joy of his heart. <verse eid="SNG 3:11"/></para>

<chapter eid="SNG 3"/>

<chapter number="4" style="c" sid="SNG 4"/>

<para style="s">Solomon Admires His Bride</para>

<para style="s2">The Bridegroom</para>

<para style="q1"><verse number="1" style="v" sid="SNG 4:1"/>Behold, you <char style="add">are</char> beautiful, my darling, </para>

<para style="q2" vid="SNG 4:1">behold, you <char style="add">are</char> beautiful! </para>

<para style="q1" vid="SNG 4:1">Your eyes <char style="add">are</char> doves </para>

<para style="q2" vid="SNG 4:1">behind your veil; </para>

<para style="q1" vid="SNG 4:1">your hair <char style="add">is</char> like a flock of the goats </para>

<para style="q2" vid="SNG 4:1">streaming down from Mount Gilead. <verse eid="SNG 4:1"/></para>

<para style="q1"><verse number="2" style="v" sid="SNG 4:2"/>Your teeth <char style="add">are</char> like a flock shorn, </para>

<para style="q2" vid="SNG 4:2">having come up from the washing, </para>

<para style="q1" vid="SNG 4:2">all of which have twins, </para>

<para style="q2" vid="SNG 4:2">and there is not a bereaved one among them. <verse eid="SNG 4:2"/></para>

<para style="q1"><verse number="3" style="v" sid="SNG 4:3"/>Like a thread of scarlet <char style="add">are</char> your lips, </para>

<para style="q2" vid="SNG 4:3">and your mouth is lovely. </para>

<para style="q1" vid="SNG 4:3">Like the halves of the pomegranate <char style="add">is</char> your temple, </para>

<para style="q2" vid="SNG 4:3">behind your veil. <verse eid="SNG 4:3"/></para>

<para style="q1"><verse number="4" style="v" sid="SNG 4:4"/>Like the tower of David <char style="add">is</char> your neck, </para>

<para style="q2" vid="SNG 4:4">built with rows of stones; </para>

<para style="q1" vid="SNG 4:4">a thousand shields hang on it, </para>

<para style="q2" vid="SNG 4:4">all the shields of the mighty ones. <verse eid="SNG 4:4"/></para>

<para style="q1"><verse number="5" style="v" sid="SNG 4:5"/>Your two breasts <char style="add">are</char> like two fawns, </para>

<para style="q2" vid="SNG 4:5">twins of a gazelle, grazing among the lilies. <verse eid="SNG 4:5"/></para>

<para style="q1"><verse number="6" style="v" sid="SNG 4:6"/>Until the day breathes, and the shadows flee, </para>

<para style="q2" vid="SNG 4:6">I will go my way </para>

<para style="q1" vid="SNG 4:6">to the mountain of myrrh, and to </para>

<para style="q2" vid="SNG 4:6">the hill of frankincense. <verse eid="SNG 4:6"/></para>

<para style="q1"><verse number="7" style="v" sid="SNG 4:7"/>All of you <char style="add">is</char> beautiful, my darling, </para>

<para style="q2" vid="SNG 4:7">and <char style="add">there is</char> not a blemish on you. <verse eid="SNG 4:7"/></para>

<para style="q1"><verse number="8" style="v" sid="SNG 4:8"/>Come with me from Lebanon, my bride, </para>

<para style="q2" vid="SNG 4:8">with me from Lebanon! </para>

<para style="q1" vid="SNG 4:8">Descend<note caller="+" style="f"><char style="fr" closed="false">4.8 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">Look down</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">Travel</char></note> from the top of Amana, </para>

<para style="q2" vid="SNG 4:8">from the top of Senir and Hermon, </para>

<para style="q1" vid="SNG 4:8">from the dens of the lions, </para>

<para style="q2" vid="SNG 4:8">from the mountains of the leopards. <verse eid="SNG 4:8"/></para>

<para style="q1"><verse number="9" style="v" sid="SNG 4:9"/>You have captured my heart, </para>

<para style="q2" vid="SNG 4:9">my sister, my bride; </para>

<para style="q1" vid="SNG 4:9">you have captured my heart with one of your eyes, </para>

<para style="q2" vid="SNG 4:9">with one jewel of your neck. <verse eid="SNG 4:9"/></para>

<para style="q1"><verse number="10" style="v" sid="SNG 4:10"/>How beautiful <char style="add">is</char> your love, </para>

<para style="q2" vid="SNG 4:10">my sister, my bride! </para>

<para style="q1" vid="SNG 4:10">How much better <char style="add">is</char> your love than wine, </para>

<para style="q2" vid="SNG 4:10">and the scent of your oils than all spices! <verse eid="SNG 4:10"/></para>

<para style="q1"><verse number="11" style="v" sid="SNG 4:11"/>Your lips drip with nectar, </para>

<para style="q2" vid="SNG 4:11">my bride; </para>

<para style="q1" vid="SNG 4:11">honey and milk <char style="add">are</char> under your tongue, </para>

<para style="q2" vid="SNG 4:11">and the fragrance of your garments </para>

<para style="q2" vid="SNG 4:11"><char style="add">is</char> like the fragrance of Lebanon. <verse eid="SNG 4:11"/></para>

<para style="q1"><verse number="12" style="v" sid="SNG 4:12"/>A garden locked up <char style="add">is</char> my sister, my bride—</para>

<para style="q2" vid="SNG 4:12">a spring locked up, a fountain sealed. <verse eid="SNG 4:12"/></para>

<para style="q1"><verse number="13" style="v" sid="SNG 4:13"/>Your shoots <char style="add">are</char> an orchard of pomegranates, </para>

<para style="q2" vid="SNG 4:13">with the choicest of fruits, henna with nard, <verse eid="SNG 4:13"/></para>

<para style="q1"><verse number="14" style="v" sid="SNG 4:14"/>nard and saffron, calamus and cinnamon, </para>

<para style="q2" vid="SNG 4:14">with all trees of frankincense, </para>

<para style="q1" vid="SNG 4:14">myrrh and aloes, </para>

<para style="q2" vid="SNG 4:14">with all the finest spices, <verse eid="SNG 4:14"/></para>

<para style="q1"><verse number="15" style="v" sid="SNG 4:15"/>a fountain of gardens, </para>

<para style="q2" vid="SNG 4:15">a well of living water,<note caller="+" style="f"><char style="fr" closed="false">4.15 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">flowing water</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">fresh water</char></note> </para>

<para style="q2" vid="SNG 4:15">and flowing down from Lebanon. <verse eid="SNG 4:15"/></para>

<para style="s2">The Bride</para>

<para style="q1"><verse number="16" style="v" sid="SNG 4:16"/>Awake, north <char style="add">wind</char>, </para>

<para style="q2" vid="SNG 4:16">and come, south wind! </para>

<para style="q1" vid="SNG 4:16">Breathe on my garden, </para>

<para style="q2" vid="SNG 4:16"><char style="add">that</char> its spices may flow out. </para>

<para style="q1" vid="SNG 4:16">Let my beloved come to his garden, </para>

<para style="q2" vid="SNG 4:16">and eat the fruit of its excellencies. <verse eid="SNG 4:16"/></para>

<chapter eid="SNG 4"/>

<chapter number="5" style="c" sid="SNG 5"/>

<para style="s">The Bride and Her Beloved</para>

<para style="s2">The Bridegroom</para>

<para style="q1"><verse number="1" style="v" sid="SNG 5:1"/>I have come to my garden, my sister, my bride; </para>

<para style="q2" vid="SNG 5:1">I have plucked my myrrh with my spice; </para>

<para style="q1" vid="SNG 5:1">I have eaten my honeycomb with my honey; </para>

<para style="q2" vid="SNG 5:1">I have drunk my wine with my milk. </para>

<para style="q1" vid="SNG 5:1">Eat, friends, drink, </para>

<para style="q2" vid="SNG 5:1">and drink freely, O beloved ones! <verse eid="SNG 5:1"/></para>

<para style="s2">The Friends</para>

<para style="s2">The Bride</para>

<para style="q1"><verse number="2" style="v" sid="SNG 5:2"/>I <char style="add">was</char> asleep, and my heart was aroused. </para>

<para style="q2" vid="SNG 5:2">A sound! My beloved is knocking: </para>

<para style="q1" vid="SNG 5:2">“Open to me, my sister, my darling, </para>

<para style="q2" vid="SNG 5:2">my dove, my flawless one. </para>

<para style="q1" vid="SNG 5:2">For my head is full of dew, </para>

<para style="q2" vid="SNG 5:2">my locks of the drops of the night.” <verse eid="SNG 5:2"/></para>

<para style="q1"><verse number="3" style="v" sid="SNG 5:3"/>I have taken off my garment—</para>

<para style="q2" vid="SNG 5:3">how do I put it on? </para>

<para style="q1" vid="SNG 5:3">I have washed my feet—</para>

<para style="q2" vid="SNG 5:3">how do I soil them? <verse eid="SNG 5:3"/></para>

<para style="q1"><verse number="4" style="v" sid="SNG 5:4"/>My beloved stretched out his hand to the latch, </para>

<para style="q2" vid="SNG 5:4">and my bowels murmered for him. <verse eid="SNG 5:4"/></para>

<para style="q1"><verse number="5" style="v" sid="SNG 5:5"/>I arose to open up for my beloved, </para>

<para style="q2" vid="SNG 5:5">and my hands dripped with myrrh, </para>

<para style="q1" vid="SNG 5:5">and my fingers covered over with myrrh </para>

<para style="q2" vid="SNG 5:5">on the palms of the bolt. <verse eid="SNG 5:5"/></para>

<para style="q1"><verse number="6" style="v" sid="SNG 5:6"/>I opened for my beloved, </para>

<para style="q2" vid="SNG 5:6">and my beloved had turned away <char style="add">and</char> had gone! </para>

<para style="q1" vid="SNG 5:6">My heart went forth at his speaking. </para>

<para style="q2" vid="SNG 5:6">I sought him, and could not find him; </para>

<para style="q2" vid="SNG 5:6">I called <char style="add">to</char> him, and he did not answer me. <verse eid="SNG 5:6"/></para>

<para style="q1"><verse number="7" style="v" sid="SNG 5:7"/>The guards found me in <char style="add">their</char> going round about the city. </para>

<para style="q2" vid="SNG 5:7">They struck me, they bruised me, </para>

<para style="q1" vid="SNG 5:7">the guards of the walls; </para>

<para style="q2" vid="SNG 5:7">they lifted my wrap from me. <verse eid="SNG 5:7"/></para>

<para style="q1"><verse number="8" style="v" sid="SNG 5:8"/>I adjure you⁺, O daughters of Jerusalem, </para>

<para style="q2" vid="SNG 5:8">if you⁺ find my beloved, </para>

<para style="q1" vid="SNG 5:8">what you⁺ should declare to him: </para>

<para style="q2" vid="SNG 5:8">I <char style="add">am</char> sick with love. <verse eid="SNG 5:8"/></para>

<para style="s2">The Friends</para>

<para style="q1"><verse number="9" style="v" sid="SNG 5:9"/>How <char style="add">is</char> your beloved above <char style="add">any</char> beloved, </para>

<para style="q2" vid="SNG 5:9">O beautiful one among the women? </para>

<para style="q1" vid="SNG 5:9">How <char style="add">is</char> your beloved above <char style="add">any</char> beloved, </para>

<para style="q2" vid="SNG 5:9">that thus you adjure us? <verse eid="SNG 5:9"/></para>

<para style="s2">The Bride</para>

<para style="q1"><verse number="10" style="v" sid="SNG 5:10"/>My beloved is dazzling and ruddy, </para>

<para style="q2" vid="SNG 5:10">distinguished above a myriad. <verse eid="SNG 5:10"/></para>

<para style="q1"><verse number="11" style="v" sid="SNG 5:11"/>His head <char style="add">is</char> gold, pure gold; </para>

<para style="q2" vid="SNG 5:11">his locks <char style="add">are</char> wavy, black like the raven. <verse eid="SNG 5:11"/></para>

<para style="q1"><verse number="12" style="v" sid="SNG 5:12"/>His eyes are like doves </para>

<para style="q2" vid="SNG 5:12">beside channels of waters, </para>

<para style="q1" vid="SNG 5:12">washed with milk, </para>

<para style="q2" vid="SNG 5:12">sitting beside a full pool. <verse eid="SNG 5:12"/></para>

<para style="q1"><verse number="13" style="v" sid="SNG 5:13"/>His cheeks <char style="add">are</char> like a bed of spice, </para>

<para style="q2" vid="SNG 5:13">towers of perfume. </para>

<para style="q1" vid="SNG 5:13">His lips lilies, </para>

<para style="q2" vid="SNG 5:13">dripping with flowing myrrh. <verse eid="SNG 5:13"/></para>

<para style="q1"><verse number="14" style="v" sid="SNG 5:14"/>His hands <char style="add">are</char> rods of gold, </para>

<para style="q2" vid="SNG 5:14">set with beryl; </para>

<para style="q1" vid="SNG 5:14">his belly <char style="add">is</char> a plate of ivory, </para>

<para style="q2" vid="SNG 5:14">covered with sapphires; <verse eid="SNG 5:14"/></para>

<para style="q1"><verse number="15" style="v" sid="SNG 5:15"/>his legs <char style="add">are</char> pillars of marble, </para>

<para style="q2" vid="SNG 5:15">set on bases of pure gold; </para>

<para style="q1" vid="SNG 5:15">his appearance <char style="add">is</char> like the Lebanon, </para>

<para style="q2" vid="SNG 5:15">being excellent like the cedars. <verse eid="SNG 5:15"/></para>

<para style="q1"><verse number="16" style="v" sid="SNG 5:16"/>His mouth<note caller="+" style="f"><char style="fr" closed="false">5.16 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">palate</char></note> <char style="add">is</char> sweetness, </para>

<para style="q2" vid="SNG 5:16">and all of him <char style="add">is</char> desireable. </para>

<para style="q1" vid="SNG 5:16">This <char style="add">is</char> my beloved, and this <char style="add">is</char> my friend, </para>

<para style="q2" vid="SNG 5:16">O daughters of Jerusalem! <verse eid="SNG 5:16"/></para>

<chapter eid="SNG 5"/>

<chapter number="6" style="c" sid="SNG 6"/>

<para style="s">Together in the Garden</para>

<para style="s2">The Friends</para>

<para style="q1"><verse number="1" style="v" sid="SNG 6:1"/>Where has your beloved gone, </para>

<para style="q2" vid="SNG 6:1">O fairest among the women? </para>

<para style="q1" vid="SNG 6:1">Where has your beloved turned aside, </para>

<para style="q2" vid="SNG 6:1">that we may seek him with you? <verse eid="SNG 6:1"/></para>

<para style="s2">The Bride</para>

<para style="q1"><verse number="2" style="v" sid="SNG 6:2"/>My beloved has gone to his garden, </para>

<para style="q2" vid="SNG 6:2">to the beds of spice, </para>

<para style="q1" vid="SNG 6:2">to graze in the gardens </para>

<para style="q2" vid="SNG 6:2">and to gather up the lilies. <verse eid="SNG 6:2"/></para>

<para style="q1"><verse number="3" style="v" sid="SNG 6:3"/>I <char style="add">am</char> unto my beloved and my beloved <char style="add">is</char> unto me; </para>

<para style="q2" vid="SNG 6:3">he is grazing among the lilies. <verse eid="SNG 6:3"/></para>

<para style="s2">The Bridegroom</para>

<para style="q1"><verse number="4" style="v" sid="SNG 6:4"/>You <char style="add">are</char> beautiful as Tirzah, my darling, </para>

<para style="q2" vid="SNG 6:4">lovely as Jerusalem, </para>

<para style="q2" vid="SNG 6:4">awesome as bannered hosts. <verse eid="SNG 6:4"/></para>

<para style="q1"><verse number="5" style="v" sid="SNG 6:5"/>Turn away your eyes from me, </para>

<para style="q2" vid="SNG 6:5">for they have overcome me. </para>

<para style="q1" vid="SNG 6:5">Your hair <char style="add">is</char> like a flock of the goats </para>

<para style="q2" vid="SNG 6:5">streaming down from the Gilead. <verse eid="SNG 6:5"/></para>

<para style="q1"><verse number="6" style="v" sid="SNG 6:6"/>Your teeth <char style="add">are</char> like a flock of ewes </para>

<para style="q2" vid="SNG 6:6">that have come up from the washing; </para>

<para style="q1" vid="SNG 6:6">each has its twin, </para>

<para style="q2" vid="SNG 6:6">and not a bereaved one <char style="add">is</char> among them. <verse eid="SNG 6:6"/></para>

<para style="q1"><verse number="7" style="v" sid="SNG 6:7"/>Like the halves of the pomegranate <char style="add">is</char> your temple </para>

<para style="q2" vid="SNG 6:7">behind your veil. <verse eid="SNG 6:7"/></para>

<para style="q1"><verse number="8" style="v" sid="SNG 6:8"/>Sixty <char style="add">are</char> they, the queens, and eighty the concubines, </para>

<para style="q2" vid="SNG 6:8">and maidens without number. <verse eid="SNG 6:8"/></para>

<para style="q1"><verse number="9" style="v" sid="SNG 6:9"/>One she <char style="add">is</char>, my dove, my perfect one; </para>

<para style="q2" vid="SNG 6:9">one she <char style="add">is</char>, pure for her mother, she who bore her. </para>

<para style="q1" vid="SNG 6:9">The daughters saw her, and called her blessed; </para>

<para style="q2" vid="SNG 6:9">and the queens and the concubines, they praised her. <verse eid="SNG 6:9"/></para>

<para style="s2">The Friends</para>

<para style="q1"><verse number="10" style="v" sid="SNG 6:10"/>Who <char style="add">is</char> this one shining like the dawn, </para>

<para style="q2" vid="SNG 6:10">beautiful as the moon, </para>

<para style="q1" vid="SNG 6:10">pure as the sun, </para>

<para style="q2" vid="SNG 6:10">awesome as bannered hosts? <verse eid="SNG 6:10"/></para>

<para style="s2">The Bridegroom</para>

<para style="q1"><verse number="11" style="v" sid="SNG 6:11"/>To the garden of the nut tree I went down, </para>

<para style="q2" vid="SNG 6:11">to look on the green of the valley, </para>

<para style="q1" vid="SNG 6:11">to see the vine had sprouted </para>

<para style="q2" vid="SNG 6:11"><char style="add">and</char> the pomegranates had bloomed. <verse eid="SNG 6:11"/></para>

<para style="q1"><verse number="12" style="v" sid="SNG 6:12"/>I did not know <char style="add">it</char>, my soul had set me </para>

<para style="q2" vid="SNG 6:12"><char style="add">among</char> the chariots of my noble people.<note caller="+" style="f"><char style="fr" closed="false">6.12 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">among the royal chariots of my people</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">among the chariots of Amminadab</char></note> <verse eid="SNG 6:12"/></para>

<para style="s2">The Friends</para>

<para style="q1"><verse number="13" style="v" sid="SNG 6:13"/>Return, return, O Shulammite! </para>

<para style="q2" vid="SNG 6:13">Return, return, that we may gaze on you. </para>

<para style="q1" vid="SNG 6:13">Why should you⁺ gaze on the Shulammite </para>

<para style="q2" vid="SNG 6:13">as <char style="add">on</char> the dance in of Mahanaim?<note caller="+" style="f"><char style="fr" closed="false">6.13 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">the dance of the two camps</char></note> <verse eid="SNG 6:13"/></para>

<chapter eid="SNG 6"/>

<chapter number="7" style="c" sid="SNG 7"/>

<para style="s">Admiration by the Bridegroom</para>

<para style="q1"><verse number="1" style="v" sid="SNG 7:1"/>How beautiful <char style="add">are</char> your feet in the sandals, </para>

<para style="q2" vid="SNG 7:1">O daughter of a noble! </para>

<para style="q1" vid="SNG 7:1">The curves of your thighs are like jewels, </para>

<para style="q2" vid="SNG 7:1">the work of the hands of an artisan. <verse eid="SNG 7:1"/></para>

<para style="q1"><verse number="2" style="v" sid="SNG 7:2"/>Your navel <char style="add">is</char> a bowl of roundness—</para>

<para style="q2" vid="SNG 7:2">it is not lacking <char style="add">in</char> mixed wine. </para>

<para style="q1" vid="SNG 7:2">Your belly <char style="add">is</char> a mound of wheat, </para>

<para style="q2" vid="SNG 7:2">fenced around with the lilies. <verse eid="SNG 7:2"/></para>

<para style="q1"><verse number="3" style="v" sid="SNG 7:3"/>Your two breasts <char style="add">are</char> like two fawns, </para>

<para style="q2" vid="SNG 7:3">twins of a gazelle. <verse eid="SNG 7:3"/></para>

<para style="q1"><verse number="4" style="v" sid="SNG 7:4"/>Your neck <char style="add">is</char> like a tower </para>

<para style="q2" vid="SNG 7:4">of ivory. </para>

<para style="q1" vid="SNG 7:4">Your eyes <char style="add">are</char> the pools in Heshbon </para>

<para style="q2" vid="SNG 7:4">by the gate of Bath-Rabbim. </para>

<para style="q1" vid="SNG 7:4">Your nose <char style="add">is</char> like the tower of Lebanon, </para>

<para style="q2" vid="SNG 7:4">looking <char style="add">to</char> the face of Damascus. <verse eid="SNG 7:4"/></para>

<para style="q1"><verse number="5" style="v" sid="SNG 7:5"/>Your head <char style="add">is</char> upon you like Carmel, </para>

<para style="q2" vid="SNG 7:5">and the hair of your head <char style="add">is</char> like purple—</para>

<para style="q2" vid="SNG 7:5">a king is bound in the tresses! <verse eid="SNG 7:5"/></para>

<para style="q1"><verse number="6" style="v" sid="SNG 7:6"/>How beautiful and how pleasant, </para>

<para style="q2" vid="SNG 7:6">O <char style="add">my</char> love, in your delights! <verse eid="SNG 7:6"/></para>

<para style="q1"><verse number="7" style="v" sid="SNG 7:7"/>This stature of yours is like a palm tree, </para>

<para style="q2" vid="SNG 7:7">and your breasts <char style="add">are</char> like clusters of fruit. <verse eid="SNG 7:7"/></para>

<para style="q1"><verse number="8" style="v" sid="SNG 7:8"/>I said, “I will go up on the palm <char style="add">tree</char>, </para>

<para style="q2" vid="SNG 7:8">I will grab hold of its boughs.” </para>

<para style="q1" vid="SNG 7:8">And may your breasts be now like the clusters of the vine, </para>

<para style="q2" vid="SNG 7:8">and the fragrance of your breath like the apples, <verse eid="SNG 7:8"/></para>

<para style="q2"><verse number="9" style="v" sid="SNG 7:9"/>and your mouth<note caller="+" style="f"><char style="fr" closed="false">7.9 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">palate</char><char style="ft" closed="false"> </char></note> like wine of the best. </para>

<para style="q1" vid="SNG 7:9">It is flowing to my beloved smoothly, </para>

<para style="q2" vid="SNG 7:9">gliding over lips and teeth.<note caller="+" style="f"><char style="fr" closed="false">7.9 </char><char style="ft" closed="false"> LXX, Syriac, and Vulgate; Hebrew </char><char style="fq" closed="false">gliding gently over lips as we sleep</char></note> <verse eid="SNG 7:9"/></para>

<para style="s2">The Bride</para>

<para style="q1"><verse number="10" style="v" sid="SNG 7:10"/>I <char style="add">am</char> unto my beloved, </para>

<para style="q2" vid="SNG 7:10">and for me <char style="add">is</char> his desire. <verse eid="SNG 7:10"/></para>

<para style="q1"><verse number="11" style="v" sid="SNG 7:11"/>Come, my beloved, </para>

<para style="q2" vid="SNG 7:11">let us go forth to the field; </para>

<para style="q2" vid="SNG 7:11">let us spend the night among the wildflowers.<note caller="+" style="f"><char style="fr" closed="false">7.11 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">among the henna blossoms</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">in the villages</char></note> <verse eid="SNG 7:11"/></para>

<para style="q1"><verse number="12" style="v" sid="SNG 7:12"/>Let us go out early to the vineyards; </para>

<para style="q2" vid="SNG 7:12">let us see if the vine has sprouted, </para>

<para style="q1" vid="SNG 7:12"><char style="add">if</char> the blossoms have opened <char style="add">and</char> the pomegranates have budded; </para>

<para style="q2" vid="SNG 7:12">there I will give my love to you. <verse eid="SNG 7:12"/></para>

<para style="q1"><verse number="13" style="v" sid="SNG 7:13"/>The mandrakes give off a scent, </para>

<para style="q2" vid="SNG 7:13">and at our door is every delicacy, </para>

<para style="q1" vid="SNG 7:13">new and old, </para>

<para style="q2" vid="SNG 7:13">my beloved, which I have stored up for you. <verse eid="SNG 7:13"/></para>

<chapter eid="SNG 7"/>

<chapter number="8" style="c" sid="SNG 8"/>

<para style="s">Longing for Her Beloved</para>

<para style="q1"><verse number="1" style="v" sid="SNG 8:1"/>Who will give you as a brother to me, </para>

<para style="q2" vid="SNG 8:1">one having nursed at the breasts of my mother! </para>

<para style="q1" vid="SNG 8:1">If I found you outside, I would kiss you; </para>

<para style="q2" vid="SNG 8:1">yes, no one would despise me. <verse eid="SNG 8:1"/></para>

<para style="q1"><verse number="2" style="v" sid="SNG 8:2"/>I would lead you, I would bring you </para>

<para style="q2" vid="SNG 8:2">into the house of my mother, she who taught me; </para>

<para style="q1" vid="SNG 8:2">I would give you to drink from the wine of spice, </para>

<para style="q2" vid="SNG 8:2">from the juice of my pomegranate. <verse eid="SNG 8:2"/></para>

<para style="q1"><verse number="3" style="v" sid="SNG 8:3"/>His left hand <char style="add">is</char> under my head, </para>

<para style="q2" vid="SNG 8:3">and his right hand embraces me. <verse eid="SNG 8:3"/></para>

<para style="q1"><verse number="4" style="v" sid="SNG 8:4"/>I adjure you⁺, O daughters of Jerusalem, </para>

<para style="q2" vid="SNG 8:4">why stir up and why awaken love </para>

<para style="q2" vid="SNG 8:4">until it pleases. <verse eid="SNG 8:4"/></para>

<para style="s2">The Friends</para>

<para style="q1"><verse number="5" style="v" sid="SNG 8:5"/>Who <char style="add">is</char> this coming up from the wilderness, </para>

<para style="q2" vid="SNG 8:5">leaning upon her beloved? </para>

<para style="q1" vid="SNG 8:5">Under the apple tree I awakened you; </para>

<para style="q2" vid="SNG 8:5">there your mother conceived you; </para>

<para style="q2" vid="SNG 8:5">there she travailed and brought you forth. <verse eid="SNG 8:5"/></para>

<para style="s2">The Bride</para>

<para style="q1"><verse number="6" style="v" sid="SNG 8:6"/>Set me as a seal upon your heart, </para>

<para style="q2" vid="SNG 8:6">as a seal upon your arm. </para>

<para style="q1" vid="SNG 8:6">For strong as death <char style="add">is</char> love, </para>

<para style="q2" vid="SNG 8:6">cruel as Sheol <char style="add">is</char> jealousy;<note caller="+" style="f"><char style="fr" closed="false">8.6 </char><char style="ft" closed="false"> Or </char><char style="fq" closed="false">zeal</char><char style="ft" closed="false"> or </char><char style="fq" closed="false">passion</char></note> </para>

<para style="q1" vid="SNG 8:6">its flames <char style="add">are</char> flames of fire, </para>

<para style="q2" vid="SNG 8:6">a blazing flame. <verse eid="SNG 8:6"/></para>

<para style="q1"><verse number="7" style="v" sid="SNG 8:7"/>Many waters are not able to quench love, </para>

<para style="q2" vid="SNG 8:7">and the rivers cannot wash it away. </para>

<para style="q1" vid="SNG 8:7">If a man would give all the wealth of his house for love, </para>

<para style="q2" vid="SNG 8:7">they would despise it <char style="add">with great</char> despising. <verse eid="SNG 8:7"/></para>

<para style="s2">The Friends</para>

<para style="q1"><verse number="8" style="v" sid="SNG 8:8"/>A little sister <char style="add">is</char> unto us, </para>

<para style="q2" vid="SNG 8:8">and breasts are not unto her. </para>

<para style="q1" vid="SNG 8:8">What shall we do for our sister, </para>

<para style="q2" vid="SNG 8:8">on the day one should speak for her? <verse eid="SNG 8:8"/></para>

<para style="q1"><verse number="9" style="v" sid="SNG 8:9"/>If she <char style="add">is</char> a wall, </para>

<para style="q2" vid="SNG 8:9">we will build upon her a tower of silver; </para>

<para style="q1" vid="SNG 8:9">and if she <char style="add">is</char> a door, </para>

<para style="q2" vid="SNG 8:9">we will enclose her with a plank of cedar. <verse eid="SNG 8:9"/></para>

<para style="s2">The Bride</para>

<para style="q1"><verse number="10" style="v" sid="SNG 8:10"/>I <char style="add">am</char> a wall, </para>

<para style="q2" vid="SNG 8:10">and my breasts <char style="add">are</char> like towers. </para>

<para style="q1" vid="SNG 8:10">Then I have become in his eyes </para>

<para style="q2" vid="SNG 8:10">like one finding peace. <verse eid="SNG 8:10"/></para>

<para style="q1"><verse number="11" style="v" sid="SNG 8:11"/>There was a vineyard unto Solomon in Baal-hamon. </para>

<para style="q2" vid="SNG 8:11">He gave out the vineyard to those keeping <char style="add">it</char>; </para>

<para style="q1" vid="SNG 8:11">a man would bring for its fruit </para>

<para style="q2" vid="SNG 8:11">a thousand <char style="add">pieces</char> of silver.<note caller="+" style="f"><char style="fr" closed="false">8.11 </char><char style="ft" closed="false"> </char><char style="fq" closed="false">A thousand (pieces) of silver</char><char style="ft" closed="false"> is approximately 25.1 pounds or 11.4 kilograms of silver</char></note> <verse eid="SNG 8:11"/></para>

<para style="q1"><verse number="12" style="v" sid="SNG 8:12"/>My vineyard <char style="add">is</char>—my own—<char style="add">is</char> before me; </para>

<para style="q2" vid="SNG 8:12">the thousand <char style="add">is</char> unto you, O Solomon, </para>

<para style="q2" vid="SNG 8:12">and two hundred to those keeping watch over its fruit. <verse eid="SNG 8:12"/></para>

<para style="s2">The Bridegroom</para>

<para style="q1"><verse number="13" style="v" sid="SNG 8:13"/>O <char style="add">you</char> dwelling in the gardens, </para>

<para style="q2" vid="SNG 8:13"><char style="add">my</char> companions are listening to your voice—</para>

<para style="q2" vid="SNG 8:13">let me hear it! <verse eid="SNG 8:13"/></para>

<para style="s2">The Bride</para>

<para style="q1"><verse number="14" style="v" sid="SNG 8:14"/>Flee, my beloved, </para>

<para style="q2" vid="SNG 8:14">and liken yourself to a gazelle, </para>

<para style="q1" vid="SNG 8:14">or to a young stag of the deer, </para>

<para style="q2" vid="SNG 8:14">on the mountains of spices. <verse eid="SNG 8:14"/></para>

<chapter eid="SNG 8"/>

</usx>
